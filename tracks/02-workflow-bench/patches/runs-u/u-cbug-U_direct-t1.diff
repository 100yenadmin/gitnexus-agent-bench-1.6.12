+/** `<stdio.h>` / `<sys/types.h>` — the system-header include spelling. */
+function isSystemIncludeSpelling(targetRaw: string): boolean {
+  const trimmed = targetRaw.trim();
+  return trimmed.startsWith('<') && trimmed.endsWith('>');
+}
