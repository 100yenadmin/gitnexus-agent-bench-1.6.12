+# ==================== #1270: spell attack bypass ============================
+
+def test_attack_roll_spell_followed_by_attack_allowed(caster):
+    """#1270 red-first: Guiding Bolt (attack-roll spell) followed by attack()
+    must bypass the action economy gate because in 5e the spell's casting time
+    includes the attack roll — they're one action, not two."""
+    cid, wiz, gob = caster
+    # Learn Guiding Bolt so we can cast it
+    server.learn_spells(cid, wiz, ["Guiding Bolt"])
+    server.prepare_spells(cid, wiz, ["Guiding Bolt"])
+    # Cast Guiding Bolt (SRD attack-roll spell)
+    cast_result = _cast(cid, wiz, "Guiding Bolt", target_id=gob)
+    assert cast_result["automated"] is False
+    assert cast_result["attack_roll"] is True
+    # Without the fix, the next attack() would fail with "already cast a spell"
+    # With the fix, it bypasses the gate and succeeds
+    atk = server.attack(cid, wiz, gob, attack_bonus=5, damage_dice="1d8+2")
+    assert atk["hit"] is not None  # attack resolved successfully
+
+
+def test_spell_attack_matches_target_requirement(caster):
+    """#1270: The spell-attack bypass only works when the attack()
+    target matches the pending spell attack's target."""
+    cid, wiz, gob = caster
+    server.learn_spells(cid, wiz, ["Guiding Bolt"])
+    server.prepare_spells(cid, wiz, ["Guiding Bolt"])
+    # Cast Guiding Bolt at the goblin
+    cast_result = _cast(cid, wiz, "Guiding Bolt", target_id=gob)
+    # Verify it's an attack-roll spell that's pending
+    assert cast_result["attack_roll"] is True
+    assert cast_result["automated"] is False
+    # Attack on the MATCHING target succeeds
+    atk = server.attack(cid, wiz, gob, attack_bonus=5, damage_dice="1d8+2")
+    assert atk["hit"] is not None
+
+
+def test_spell_attack_clears_after_resolution(caster):
+    """#1270: pending_spell_attack clears after attack() resolves on a
+    matching target. A second attack on ANY target is still rejected because
+    the action was already spent on the spell."""
+    cid, wiz, gob = caster
+    other_gob = server.create_character(cid, "Goblin2", kind="monster", max_hp=20)["id"]
+    server.add_combatant(cid, other_gob)
+    server.learn_spells(cid, wiz, ["Guiding Bolt"])
+    server.prepare_spells(cid, wiz, ["Guiding Bolt"])
+    # Cast and resolve first spell attack
+    _cast(cid, wiz, "Guiding Bolt", target_id=gob)
+    server.attack(cid, wiz, gob, attack_bonus=5, damage_dice="1d8+2")
+    # Now the pending record should be cleared, but the action is still spent
+    # so a second attack on another target is rejected with budget error
+    with pytest.raises(ValueError, match="already attacked|cannot attack"):
+        server.attack(cid, wiz, other_gob, attack_bonus=5, damage_dice="1d8+2")
+
+
+def test_spell_attack_clears_on_next_turn(caster):
+    """#1270: if a spell attack is cast but never resolved, it clears on
+    next_turn (the record doesn't carry over)."""
+    cid, wiz, gob = caster
+    server.learn_spells(cid, wiz, ["Guiding Bolt", "Fireball"])
+    server.prepare_spells(cid, wiz, ["Guiding Bolt", "Fireball"])
+    # Cast Guiding Bolt but DON'T resolve it
+    _cast(cid, wiz, "Guiding Bolt", target_id=gob)
+    # Advance to next turn
+    server.next_turn(cid)  # goblin's turn
+    server.next_turn(cid)  # back to wizard
+    # The pending spell should be cleared, so a fresh action is available
+    assert server.get_state(cid)["current_turn"] == wiz
+    # Should allow a new spell cast (not rejected for "already cast a spell")
+    fb = _cast(cid, wiz, "Fireball", target_id=gob)
+    assert fb["spell"] == "Fireball"
+
+
