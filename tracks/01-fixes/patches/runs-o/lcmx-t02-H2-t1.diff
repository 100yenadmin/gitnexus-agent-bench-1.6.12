+def _normalize_query_string(value: Any) -> str:
+    """Safely convert and normalize a query argument to a string.
+
+    Handles None, numeric values, and strings. Returns an empty string for None.
+    This allows the caller to check `if not query` to return the standard error.
+    """
+    if value is None:
+        return ""
+    # Convert to string (handles numbers, bools, etc.) and strip whitespace
+    return str(value).strip()
+
