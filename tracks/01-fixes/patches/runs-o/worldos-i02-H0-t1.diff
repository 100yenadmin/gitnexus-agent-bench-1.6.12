+def _nearest_walkable_rest_cell(
+    final_cell: tuple[int, int],
+    start: "tuple[int, int] | None",
+    blocked: set[tuple[int, int]],
+    width: int,
+    height: int,
+) -> "tuple[int, int] | None":
+    """#1511: find the nearest reachable walkable cell when a character's final combat cell
+    is impassable in the rest scene. Searches in expanding rings outward from final_cell,
+    preferring cells closer to start (if available) to minimize movement after combat ends.
+    Returns None if no walkable cell is reachable (rare, but guard against it)."""
+    if final_cell not in blocked:
+        return final_cell  # already walkable, use it
+    if start is None:
+        return None  # unplaced mover can't reach anywhere
+
+    candidates: list[tuple[tuple[int, int], int]] = []  # (cell, distance_from_start)
+    visited: set[tuple[int, int]] = {final_cell}
+    queue: list[tuple[int, int]] = [final_cell]
+
+    # BFS from final_cell to find nearby walkable cells
+    while queue:
+        next_queue: list[tuple[int, int]] = []
+        for cx, cy in queue:
+            for dx in (-1, 0, 1):
+                for dy in (-1, 0, 1):
+                    if dx == 0 and dy == 0:
+                        continue
+                    nx, ny = cx + dx, cy + dy
+                    if not (0 <= nx < width and 0 <= ny < height):
+                        continue
+                    cell = (nx, ny)
+                    if cell in visited:
+                        continue
+                    visited.add(cell)
+                    if cell not in blocked:
+                        # Check if reachable from start
+                        path = combat_grid.shortest_path(start, cell, blocked, width, height)
+                        if path is not None:
+                            dist = combat_grid.chebyshev_cells(start, cell)
+                            candidates.append((cell, dist))
+                    else:
+                        next_queue.append(cell)
+        queue = next_queue
+        if candidates:
+            break  # found nearby candidates, use the closest
+
+    if not candidates:
+        return None
+    candidates.sort(key=lambda t: t[1])
+    return candidates[0][0]
+
+
