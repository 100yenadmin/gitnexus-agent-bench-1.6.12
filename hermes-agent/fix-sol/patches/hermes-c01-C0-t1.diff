diff --git a/tests/hermes_cli/test_claude_code_process_discovery.py b/tests/hermes_cli/test_claude_code_process_discovery.py
new file mode 100644
index 00000000..f0017331
--- /dev/null
+++ b/tests/hermes_cli/test_claude_code_process_discovery.py
@@ -0,0 +1,52 @@
+"""Claude Code process providers resolve under a bare supervisor PATH."""
+
+import pytest
+
+import agent.anthropic_adapter as adapter
+from providers import register_provider
+from providers.base import ProviderProfile
+
+
+@pytest.mark.platforms("posix")
+@pytest.mark.parametrize("command", ["claude", "claude-code", "other-cli"])
+def test_process_provider_discovers_only_claude_prefixes(tmp_path, monkeypatch, command):
+    from hermes_cli.auth import (
+        AuthError,
+        get_external_process_provider_status,
+        resolve_external_process_provider_credentials,
+    )
+
+    monkeypatch.setenv("HOME", str(tmp_path))
+    monkeypatch.setenv("PATH", str(tmp_path / "empty-path"))
+    monkeypatch.setattr(adapter, "_CLAUDE_CODE_PREFIXES", ("~/.local/bin",))
+    installed = tmp_path / ".local" / "bin" / command
+    installed.parent.mkdir(parents=True)
+    installed.write_text("#!/bin/sh\nexit 0\n")
+    installed.chmod(0o755)
+    provider_id = f"{command}-acp-test"
+    register_provider(ProviderProfile(
+        name=provider_id,
+        auth_type="external_process",
+        process_command=command,
+        base_url=f"process://{provider_id}",
+    ))
+
+    if command == "other-cli":
+        with pytest.raises(AuthError, match="Could not find"):
+            resolve_external_process_provider_credentials(provider_id)
+        assert get_external_process_provider_status(provider_id)["configured"] is False
+    else:
+        creds = resolve_external_process_provider_credentials(provider_id)
+        status = get_external_process_provider_status(provider_id)
+        assert creds["command"] == status["resolved_command"] == str(installed)
+        assert status["configured"] is True
+
+    on_path = tmp_path / "bin" / command
+    on_path.parent.mkdir()
+    on_path.write_text("#!/bin/sh\nexit 0\n")
+    on_path.chmod(0o755)
+    monkeypatch.setenv("PATH", str(on_path.parent))
+    creds = resolve_external_process_provider_credentials(provider_id)
+    status = get_external_process_provider_status(provider_id)
+    assert creds["command"] == status["resolved_command"] == str(on_path)
+    assert status["configured"] is True
