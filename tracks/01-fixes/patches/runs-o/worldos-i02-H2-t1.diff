+def test_end_combat_moves_survivor_with_impassable_rest_cell(tmp_path, monkeypatch):
+    """When end_combat writes a survivor's final combat-grid cell to stage_cell, if that cell
+    is impassable terrain in the rest scene (e.g., a crate or wall), relocate the survivor to
+    the nearest walkable rest cell. This prevents the stuck-cell trap where a character ends
+    combat standing on a newly impassable cell."""
+    import server
+    from scene_grid import SceneGrid, SceneGridSpec, SceneCell, SceneCellDefault, SceneProp
+
+    monkeypatch.setenv("WORLDOS_STATE_DIR", str(tmp_path))
+    cid = server.create_campaign("Stuck cell test")["id"]
+    loc_id = server.add_location(cid, "Test Room")["id"]
+    pid = server.create_character(cid, "Hero", kind="player", max_hp=30)["id"]
+
+    # Create a simple scene with a crate at (4, 2)
+    cells = [SceneCell(c=4, r=2, type="prop", walkable=False, prop_ref="crate")]
+    props = [SceneProp(id="crate", kind="crates", cells=[(4, 2)], anchor_cell=(4, 2))]
+    c = server._require(cid)
+    c.locations[loc_id].scene_grid = SceneGrid(
+        scene_id="test", location_id=loc_id, kind="dungeon",
+        grid=SceneGridSpec(cols=5, rows=3, cell_size_ft=5),
+        cell_default=SceneCellDefault(type="floor", walkable=True, cost=1),
+        cells=cells, props=props,
+    )
+    server.save_campaign(c)
+
+    # Start combat
+    server.spawn_monster(cid, "Goblin")
+    mid = next(ch.id for ch in store.load_campaign(cid).characters.values() if ch.kind == "monster")
+    server.start_combat(cid, [pid, mid])
+
+    # Simulate hero's final position on the crate at (4, 2) during combat
+    # (This could happen if the crate didn't exist during combat but was added by PR #1507)
+    c = server._require(cid)
+    for cb in c.combat.order:
+        if cb.character_id == pid:
+            cb.x, cb.y = 4, 2
+    server.save_campaign(c)
+
+    # End combat — hero should be relocated away from the impassable crate at (4, 2)
+    server.end_combat(cid)
+    c = server._require(cid)
+    hero = c.characters[pid]
+
+    # Hero's stage_cell should not be on the crate; it should be at a nearby walkable cell
+    assert hero.stage_cell is not None, "hero should have a stage_cell after combat"
+    assert hero.stage_cell != (4, 2), "hero should not be stuck on the crate"
+    # Verify it's a walkable cell (checking it's not blocked by terrain, only by occupancy)
+    loc = c.locations[loc_id]
+    _w, _h, blocked = server.rest_blocked_cells(c, loc, exclude_id=pid)
+    assert hero.stage_cell not in blocked, f"hero relocated to blocked cell {hero.stage_cell}"
+
