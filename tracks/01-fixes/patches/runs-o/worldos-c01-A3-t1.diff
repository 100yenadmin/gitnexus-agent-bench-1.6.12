index 0000000..dec41ba
--- /dev/null
+++ b/servers/engine/tests/test_turn_action_economy.py
@@ -0,0 +1,232 @@
+"""Turn-wide action economy (#778): the action is ONE resource per turn shared by
+cast_spell / attack / use_action, decided by the spell's casting time."""
+
+import pytest
+
+import combat
+import models
+import server
+import store
+
+
+@pytest.fixture
+def fight(tmp_path, monkeypatch):
+    monkeypatch.setenv("WORLDOS_STATE_DIR", str(tmp_path))
+    cid = server.create_campaign("turn-economy")["id"]
+    ids = [
+        server.create_character(cid, n, kind=k, max_hp=60, armor_class=12)["id"]
+        for n, k in (("A", "player"), ("B", "player"), ("M", "monster"))
+    ]
+    server.start_combat(cid, ids)
+    cur = server.get_state(cid)["current_turn"]
+    other = next(i for i in ids if i != cur)
+    server.update_character(cid, cur, {
+        "spell_slots": {str(l): {"maximum": 4, "used": 0} for l in (1, 2, 3)},
+    })
+    return cid, cur, other
+
+
+def _cast(cid, cur, other, name, **kw):
+    return server.cast_spell(cid, cur, name, target_id=other, **kw)
+
+
+def _attack(cid, cur, other):
+    return server.attack(cid, cur, other, attack_bonus=5, damage_dice="1d6")
+
+
+# --- pure helpers ---------------------------------------------------------------
+
+@pytest.mark.parametrize("raw, kind", [
+    ("1 bonus action", "bonus"), ("bonus-action", "bonus"),
+    ("1 action", "action"), ("action", "action"), (None, "action"),
+    ("reaction", "reaction"), ("1 reaction", "reaction"),
+    ("minute", "long"), ("10 minutes", "long"), ("hour", "long"), ("1 hour", "long"),
+])
+def test_casting_time_kind(raw, kind):
+    assert combat.casting_time_kind(raw) == kind
+
+
+@pytest.mark.parametrize("used, made, extra, expected", [
+    (False, 0, 0, 0), (True, 0, 0, 1), (True, 1, 0, 1), (True, 2, 0, 2),
+    (True, 1, 1, 1), (True, 2, 1, 1), (True, 3, 1, 2),
+])
+def test_actions_spent(used, made, extra, expected):
+    assert combat.actions_spent(used, made, extra) == expected
+
+
+# --- too permissive: one action per turn across tools ---------------------------
+
+def test_cast_then_cast_rejected(fight):
+    cid, cur, other = fight
+    _cast(cid, cur, other, "Fire Bolt")
+    with pytest.raises(ValueError, match="already used its action"):
+        _cast(cid, cur, other, "Fire Bolt")
+
+
+def test_rejected_cast_spends_no_slot(fight):
+    cid, cur, other = fight
+    _cast(cid, cur, other, "Fire Bolt")
+    with pytest.raises(ValueError, match="already used its action"):
+        _cast(cid, cur, other, "Fireball")
+    assert server.get_character(cid, cur)["spell_slots"]["3"]["used"] == 0
+
+
+def test_cast_then_attack_rejected(fight):
+    cid, cur, other = fight
+    _cast(cid, cur, other, "Fire Bolt")
+    with pytest.raises(ValueError, match="already cast a spell"):
+        _attack(cid, cur, other)
+
+
+def test_cast_then_attack_rejected_with_extra_attack(fight):
+    cid, cur, other = fight
+    server.update_character(cid, cur, {"extra_attacks": 1})
+    _cast(cid, cur, other, "Fire Bolt")
+    with pytest.raises(ValueError, match="already cast a spell"):
+        _attack(cid, cur, other)
+
+
+def test_attack_then_cast_rejected(fight):
+    cid, cur, other = fight
+    _attack(cid, cur, other)
+    with pytest.raises(ValueError, match="already used its action"):
+        _cast(cid, cur, other, "Fire Bolt")
+
+
+def test_extra_attack_partial_then_cast_rejected(fight):
+    cid, cur, other = fight
+    server.update_character(cid, cur, {"extra_attacks": 1})
+    _attack(cid, cur, other)  # 1 of 2 strikes — the Attack action is still spent
+    with pytest.raises(ValueError, match="already used its action"):
+        _cast(cid, cur, other, "Fire Bolt")
+
+
+def test_skip_then_attack_rejected(fight):
+    cid, cur, other = fight
+    assert server.use_action(cid, cur, "skip")["ok"] is True
+    with pytest.raises(ValueError, match="skipped this turn"):
+        _attack(cid, cur, other)
+
+
+def test_skip_then_cast_rejected(fight):
+    cid, cur, other = fight
+    server.use_action(cid, cur, "skip")
+    with pytest.raises(ValueError, match="already used its action"):
+        _cast(cid, cur, other, "Fire Bolt")
+
+
+def test_generic_action_then_cast_rejected(fight):
+    cid, cur, other = fight
+    assert server.use_action(cid, cur, "action")["ok"] is True
+    with pytest.raises(ValueError, match="already used its action"):
+        _cast(cid, cur, other, "Fire Bolt")
+
+
+def test_cast_then_use_action_rejected(fight):
+    cid, cur, other = fight
+    _cast(cid, cur, other, "Fire Bolt")
+    assert server.use_action(cid, cur, "action")["ok"] is False
+
+
+# --- too restrictive: a bonus-action spell spends only the bonus action ----------
+
+@pytest.mark.parametrize("bonus_spell", ["Healing Word", "Misty Step"])  # curated / SRD spelling
+def test_bonus_cast_then_action_cast_allowed(fight, bonus_spell):
+    cid, cur, other = fight
+    _cast(cid, cur, other, bonus_spell)
+    st = store.load_campaign(cid).combat
+    assert st.bonus_action_used is True and st.action_used is False
+    _cast(cid, cur, other, "Fireball")  # the action is still free
+
+
+def test_bonus_cast_then_use_action_allowed(fight):
+    cid, cur, other = fight
+    _cast(cid, cur, other, "Healing Word")
+    assert server.use_action(cid, cur, "action")["ok"] is True
+
+
+def test_bonus_cast_then_attack_allowed(fight):
+    cid, cur, other = fight
+    _cast(cid, cur, other, "Healing Word")
+    assert _attack(cid, cur, other)["attacks_made_this_turn"] == 1
+
+
+def test_second_bonus_cast_rejected(fight):
+    cid, cur, other = fight
+    _cast(cid, cur, other, "Healing Word")
+    with pytest.raises(ValueError, match="already used its bonus action"):
+        _cast(cid, cur, other, "Misty Step")
+
+
+def test_action_cast_then_bonus_cast_allowed(fight):
+    cid, cur, other = fight
+    _cast(cid, cur, other, "Fire Bolt")
+    _cast(cid, cur, other, "Healing Word")
+
+
+# --- long casting times -----------------------------------------------------------
+
+@pytest.mark.parametrize("spell, lvl", [("Identify", "1"), ("Glyph of Warding", "3")])  # minute / hour
+def test_minute_or_hour_cast_refused_in_combat(fight, spell, lvl):
+    cid, cur, other = fight
+    with pytest.raises(ValueError, match="casting time"):
+        _cast(cid, cur, other, spell)
+    assert server.get_character(cid, cur)["spell_slots"][lvl]["used"] == 0
+
+
+# --- Action Surge + attacks keep working -----------------------------------------
+
+def test_action_surge_allows_one_more_action(fight):
+    cid, cur, other = fight
+    server.set_class_resource(cid, cur, "action_surge", max=1, recharge="short")
+    _cast(cid, cur, other, "Fire Bolt")
+    server.use_resource(cid, cur, "action_surge")
+    _cast(cid, cur, other, "Fire Bolt")  # the surged action
+    with pytest.raises(ValueError, match="already used its action"):
+        _cast(cid, cur, other, "Fire Bolt")
+    with pytest.raises(ValueError, match="already cast a spell"):
+        _attack(cid, cur, other)
+
+
+def test_action_surge_cast_then_attack(fight):
+    cid, cur, other = fight
+    server.set_class_resource(cid, cur, "action_surge", max=1, recharge="short")
+    _cast(cid, cur, other, "Fire Bolt")
+    server.use_resource(cid, cur, "action_surge")
+    _attack(cid, cur, other)
+    with pytest.raises(ValueError):
+        _attack(cid, cur, other)
+
+
+def test_action_surge_attack_then_cast(fight):
+    cid, cur, other = fight
+    server.set_class_resource(cid, cur, "action_surge", max=1, recharge="short")
+    _attack(cid, cur, other)
+    server.use_resource(cid, cur, "action_surge")
+    _cast(cid, cur, other, "Fire Bolt")
+    with pytest.raises(ValueError, match="already cast a spell"):
+        _attack(cid, cur, other)
+
+
+def test_generic_action_then_attacks_still_work(fight):
+    cid, cur, other = fight
+    server.update_character(cid, cur, {"extra_attacks": 1})
+    assert server.use_action(cid, cur, "action")["ok"] is True
+    _attack(cid, cur, other)
+    assert _attack(cid, cur, other)["attacks_made_this_turn"] == 2
+
+
+# --- reset + snapshot compatibility ----------------------------------------------
+
+def test_next_turn_resets_action_purpose(fight):
+    cid, cur, other = fight
+    _cast(cid, cur, other, "Fire Bolt")
+    assert store.load_campaign(cid).combat.action_purpose == "cast"
+    server.next_turn(cid)
+    assert store.load_campaign(cid).combat.action_purpose == ""
+
+
+def test_old_snapshot_loads_action_purpose_default():
+    dumped = models.Combat().model_dump()
+    dumped.pop("action_purpose")
+    assert models.Combat.model_validate(dumped).action_purpose == ""
