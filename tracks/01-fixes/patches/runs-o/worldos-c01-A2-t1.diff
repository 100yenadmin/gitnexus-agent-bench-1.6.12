index a093922..cc9c405 100644
--- a/servers/engine/spells.py
+++ b/servers/engine/spells.py
@@ -52,6 +52,23 @@ def srd_spell(name: str):
     return _srd524().get(name.strip().lower())
 
 
+def casting_time_kind(curated: Optional[dict], srd: Optional[dict]) -> str:
+    """Normalize a spell's casting time to "action" | "bonus" | "reaction" | "minute" |
+    "hour" (#778). Reads the curated prose ("1 bonus action", "10 minutes") first, then the
+    srd524 token ("bonus-action", "minute"). Unknown/missing == "action" (the 5e default)."""
+    raw = (curated or {}).get("casting_time") or (srd or {}).get("casting_time") or ""
+    s = str(raw).lower().replace("-", " ").replace("_", " ")
+    if "bonus" in s:
+        return "bonus"
+    if "reaction" in s:
+        return "reaction"
+    if "minute" in s:
+        return "minute"
+    if "hour" in s:
+        return "hour"
+    return "action"
+
+
 def canonical_name(name: str) -> Optional[str]:
     """The canonical-cased SRD spell name for `name` (case-insensitive), or None if
     `name` is not any of the ~339 SRD spells. Prefers the hand-authored curated record's
diff --git a/servers/engine/tests/test_action_economy_shared.py b/servers/engine/tests/test_action_economy_shared.py
new file mode 100644
index 0000000..980d528
--- /dev/null
+++ b/servers/engine/tests/test_action_economy_shared.py
@@ -0,0 +1,171 @@
+"""#778: the turn's action is ONE shared resource across cast_spell / attack / use_action,
+decided by the spell's casting time (curated "1 bonus action" and srd524 "bonus-action")."""
+import pytest
+
+import spells
+from models import Combat
+
+
+@pytest.fixture
+def server(tmp_path, monkeypatch):
+    monkeypatch.setenv("WORLDOS_STATE_DIR", str(tmp_path))
+    import server as server_mod
+
+    return server_mod
+
+
+def _fight(server):
+    """3-combatant fight; returns (cid, current_id, other_id). The current combatant is
+    made a level-5 cleric with slots (innate=True skips slots for srd-only spells)."""
+    cid = server.create_campaign("economy")["id"]
+    ids = [
+        server.create_character(cid, n, kind=k, max_hp=60, armor_class=12)["id"]
+        for n, k in (("A", "player"), ("B", "player"), ("M", "monster"))
+    ]
+    server.start_combat(cid, ids)
+    cur = server.get_state(cid)["current_turn"]
+    other = next(i for i in ids if i != cur)
+    server.update_character(cid, cur, {"class_name": "Cleric", "level": 5,
+                                       "abilities": {"wisdom": 16}})
+    # Empty known/prepared lists == the lenient cast gate (any SRD spell castable).
+    server.update_character(cid, cur, {"spells_known": [], "spells_prepared": []})
+    return cid, cur, other
+
+
+def _hit(server, cid, a, t):
+    return server.attack(cid, a, t, attack_bonus=5, damage_dice="1d4")
+
+
+# --- casting-time normalization ------------------------------------------------------------
+
+def test_casting_time_kind_reads_both_spellings():
+    assert spells.casting_time_kind({"casting_time": "1 bonus action"}, None) == "bonus"
+    assert spells.casting_time_kind(None, {"casting_time": "bonus-action"}) == "bonus"
+    assert spells.casting_time_kind(None, {"casting_time": "action"}) == "action"
+    assert spells.casting_time_kind({"casting_time": "1 action"}, None) == "action"
+    assert spells.casting_time_kind(None, {"casting_time": "minute"}) == "minute"
+    assert spells.casting_time_kind({"casting_time": "8 hours"}, None) == "hour"
+    assert spells.casting_time_kind(None, {"casting_time": "reaction"}) == "reaction"
+    assert spells.casting_time_kind(None, None) == "action"
+
+
+# --- too permissive ----------------------------------------------------------------------
+
+def test_cast_then_cast_is_refused(server):
+    cid, cur, other = _fight(server)
+    server.cast_spell(cid, cur, "Sacred Flame", target_id=other)
+    with pytest.raises(ValueError, match="already used its action"):
+        server.cast_spell(cid, cur, "Fireball", target_id=other, innate=True)
+
+
+def test_cast_then_attack_is_refused(server):
+    cid, cur, other = _fight(server)
+    server.cast_spell(cid, cur, "Sacred Flame", target_id=other)
+    hp = server.get_character(cid, other)["current_hp"]
+    with pytest.raises(ValueError, match="already cast a spell"):
+        _hit(server, cid, cur, other)
+    assert server.get_character(cid, other)["current_hp"] == hp
+
+
+def test_attack_then_cast_is_refused(server):
+    cid, cur, other = _fight(server)
+    _hit(server, cid, cur, other)
+    with pytest.raises(ValueError, match="already used its action"):
+        server.cast_spell(cid, cur, "Sacred Flame", target_id=other)
+
+
+def test_skip_then_attack_is_refused(server):
+    cid, cur, other = _fight(server)
+    assert server.use_action(cid, cur, "skip")["ok"] is True
+    with pytest.raises(ValueError, match="skipped this turn"):
+        _hit(server, cid, cur, other)
+    with pytest.raises(ValueError, match="already used its action"):
+        server.cast_spell(cid, cur, "Sacred Flame", target_id=other)
+
+
+def test_long_casting_time_refused_in_combat(server):
+    cid, cur, other = _fight(server)
+    with pytest.raises(ValueError, match="casting time"):
+        server.cast_spell(cid, cur, "Identify", innate=True)  # srd524 "minute"
+    # Rejected before any state change: the action is still free.
+    assert server.use_action(cid, cur, "action")["ok"] is True
+
+
+# --- too restrictive ---------------------------------------------------------------------
+
+def test_bonus_action_spell_spends_only_the_bonus_action(server):
+    cid, cur, other = _fight(server)
+    out = server.cast_spell(cid, cur, "Healing Word", target_id=other)
+    assert out["spell"] == "Healing Word"
+    r = server.use_action(cid, cur, "action")
+    assert r["ok"] is True and r["bonus_available"] is False
+
+
+def test_bonus_action_spell_then_action_spell(server):
+    cid, cur, other = _fight(server)
+    server.cast_spell(cid, cur, "Healing Word", target_id=other)
+    server.cast_spell(cid, cur, "Fireball", target_id=other, innate=True)
+    with pytest.raises(ValueError, match="bonus action"):
+        server.cast_spell(cid, cur, "Healing Word", target_id=other)
+
+
+def test_srd_bonus_action_spelling_counts(server):
+    # Misty Step lives only in the srd524 dump ("bonus-action").
+    assert spells.casting_time_kind(None, spells.srd_spell("Misty Step")) == "bonus"
+    cid, cur, other = _fight(server)
+    server.cast_spell(cid, cur, "Misty Step", innate=True)
+    server.cast_spell(cid, cur, "Sacred Flame", target_id=other)  # action still free
+
+
+def test_bonus_cast_then_attack_still_allowed(server):
+    cid, cur, other = _fight(server)
+    server.cast_spell(cid, cur, "Healing Word", target_id=other)
+    assert _hit(server, cid, cur, other)["attacks_made_this_turn"] == 1
+
+
+# --- Action Surge, generic action, Extra Attack ------------------------------------------
+
+def test_action_surge_allows_one_more_action_after_cast(server):
+    cid, cur, other = _fight(server)
+    server.set_class_resource(cid, cur, "action_surge", max=1, recharge="short")
+    server.cast_spell(cid, cur, "Sacred Flame", target_id=other)
+    server.use_resource(cid, cur, "action_surge")
+    _hit(server, cid, cur, other)  # the surged action
+    with pytest.raises(ValueError):
+        _hit(server, cid, cur, other)
+    with pytest.raises(ValueError, match="already used its action"):
+        server.cast_spell(cid, cur, "Sacred Flame", target_id=other)
+
+
+def test_action_surge_allows_cast_after_attack(server):
+    cid, cur, other = _fight(server)
+    server.set_class_resource(cid, cur, "action_surge", max=1, recharge="short")
+    _hit(server, cid, cur, other)
+    server.use_resource(cid, cur, "action_surge")
+    server.cast_spell(cid, cur, "Sacred Flame", target_id=other)
+    with pytest.raises(ValueError, match="already cast a spell"):
+        _hit(server, cid, cur, other)
+
+
+def test_generic_action_then_attacks_and_extra_attack(server):
+    cid, cur, other = _fight(server)
+    server.update_character(cid, cur, {"extra_attacks": 1})
+    assert server.use_action(cid, cur, "action")["ok"] is True
+    assert _hit(server, cid, cur, other)["attacks_made_this_turn"] == 1
+    assert _hit(server, cid, cur, other)["attacks_made_this_turn"] == 2
+    with pytest.raises(ValueError, match="no attacks left"):
+        _hit(server, cid, cur, other)
+
+
+def test_next_turn_resets_action_purpose(server):
+    cid, cur, other = _fight(server)
+    server.use_action(cid, cur, "skip")
+    server.next_turn(cid)
+    c = server._require(cid)
+    assert c.combat.action_purpose == ""
+
+
+def test_old_snapshot_loads_action_purpose_default():
+    old = Combat().model_dump(mode="json")
+    old.pop("action_purpose")
+    assert Combat.model_validate(old).action_purpose == ""
