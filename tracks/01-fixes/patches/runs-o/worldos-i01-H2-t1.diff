+def test_pick_action_routes_around_walls_when_moving():
+    # Greedy-v1 should route around walls, not try to move through them.
+    # Setup: 12x12 grid, monster at (2, 5), foe at (8, 5), wall at x=5 for y=1..10.
+    # The monster should move to a cell it can actually reach without crossing the wall.
+    import combat_grid
+    atks = [AttackOption(name="Bite", to_hit=4, damage_expr="1d8", reach_ft=5)]
+    wall_cells = [(5, y) for y in range(1, 11)]  # wall at x=5 for y=1..10
+    view = _mk_view(
+        atks,
+        [_foe("t", cell=(8, 5))],
+        grid=True,
+        actor_cell=(2, 5),
+        w=12,
+        h=12,
+        blocking=tuple(wall_cells),
+    )
+    intent = combat_ai.pick_action(actor=object(), combat_state=view)
+    assert intent.kind == "move"
+    assert intent.to_cell is not None
+    # Verify the chosen cell is reachable without crossing the wall
+    budget = combat_grid.movement_budget_cells(30, 5, False)
+    occupied = {(8, 5)}  # only the foe is occupied
+    blocking = set(wall_cells)
+    reachable = combat_grid.reachable(
+        (2, 5), budget, occupied, 12, 12, impassable=blocking
+    )
+    assert intent.to_cell in reachable, f"Move to {intent.to_cell} should be reachable without crossing wall"
+    # Verify it didn't pick a cell that requires crossing the wall (on the far side)
+    assert intent.to_cell[0] < 5, f"Should not move beyond wall at x=5, got {intent.to_cell}"
+
+
+def test_pick_action_prefers_clear_ground_over_difficult_terrain():
+    # Greedy-v1 should prefer a clear path over difficult terrain when available (terrain-aware routing).
+    import combat_grid
+    atks = [AttackOption(name="Bite", to_hit=4, damage_expr="1d8", reach_ft=5)]
+    # Difficult cells on the left side of the foe; a clear path exists on the right
+    difficult_cells = [(8, 0), (8, 1), (8, 2), (8, 3), (8, 4)]
+    view = _mk_view(
+        atks,
+        [_foe("t", cell=(8, 6))],
+        grid=True,
+        actor_cell=(2, 6),
+        w=12,
+        h=12,
+        difficult=tuple(difficult_cells),
+    )
+    intent = combat_ai.pick_action(actor=object(), combat_state=view)
+    assert intent.kind == "move"
+    assert intent.to_cell is not None
+    # The chosen cell should be reachable using terrain-aware routing
+    budget = combat_grid.movement_budget_cells(30, 5, False)
+    occupied = {(8, 6)}
+    difficult = set(difficult_cells)
+    reachable = combat_grid.reachable(
+        (2, 6), budget, occupied, 12, 12, difficult=difficult
+    )
+    assert intent.to_cell in reachable, f"Move to {intent.to_cell} should respect difficult terrain"
+
