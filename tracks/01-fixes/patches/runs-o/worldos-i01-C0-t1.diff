diff --git a/servers/engine/tests/test_combat_greedy_terrain.py b/servers/engine/tests/test_combat_greedy_terrain.py
new file mode 100644
index 0000000..43788d9
--- /dev/null
+++ b/servers/engine/tests/test_combat_greedy_terrain.py
@@ -0,0 +1,106 @@
+"""Greedy-v1 and fallback movement obey the engine's grid terrain rules (#1269)."""
+from dataclasses import replace
+from types import SimpleNamespace
+
+import pytest
+
+import combat_ai
+import combat_grid
+from combat_ai import AttackOption, CombatantView, CombatView
+
+
+def _view(*, foe_cell=(8, 5), blocking=(), difficult=(), speed=30):
+    return CombatView(
+        actor_id="monster", actor_cell=(2, 5), actor_zone="", actor_side="enemy",
+        speed=speed, dashed=False, grid_enabled=True,
+        grid_width=12, grid_height=12, cell_size=5,
+        foes=(CombatantView(
+            id="foe", name="foe", side="party", current_hp=20, max_hp=20,
+            armor_class=12, cell=foe_cell,
+        ),),
+        allies=(),
+        attacks=(AttackOption(name="Bite", to_hit=4, damage_expr="1d8", reach_ft=5),),
+        blocking=tuple(blocking), difficult=tuple(difficult),
+    )
+
+
+def _assert_legal_move(view, intent):
+    occupied = {foe.cell for foe in view.foes} | {ally.cell for ally in view.allies}
+    blocking, difficult = set(view.blocking), set(view.difficult)
+    route = combat_grid.shortest_path(
+        view.actor_cell, intent.to_cell, occupied, view.grid_width, view.grid_height,
+        impassable=blocking, difficult=difficult,
+    )
+    assert route is not None
+    assert not set(route) & (blocking | occupied)
+    assert combat_grid.path_cost_cells(
+        view.actor_cell, intent.to_cell, route, difficult=difficult,
+    ) <= combat_grid.movement_budget_cells(view.speed, view.cell_size, view.dashed)
+
+
+@pytest.mark.parametrize("policy", ["greedy-v1", "unknown-policy", "tactical-v2"])
+@pytest.mark.parametrize("wall_y", [range(1, 12), range(12)])
+def test_approach_never_crosses_an_unreachable_wall(policy, wall_y):
+    view = _view(blocking=[(5, y) for y in wall_y])
+    intent = combat_ai.pick_action(object(), view, policy=policy)
+    assert intent.kind == "move"
+    assert intent.to_cell[0] < 5
+    _assert_legal_move(view, intent)
+
+
+def test_approach_routes_through_a_reachable_wall_gap():
+    view = _view(blocking=[(5, y) for y in range(12) if y != 5])
+    intent = combat_ai.pick_action(object(), view)
+    assert intent.kind == "move"
+    assert intent.to_cell[0] > 5
+    _assert_legal_move(view, intent)
+
+
+@pytest.mark.parametrize("policy", ["greedy-v1", "unknown-policy"])
+def test_approach_prefers_cheaper_ground_at_the_same_distance(policy):
+    # The old lexical winner (7, 4) costs six; clear (7, 5) costs five.
+    view = _view(difficult=[(7, 4)])
+    intent = combat_ai.pick_action(object(), view, policy=policy)
+    assert intent.kind == "move"
+    assert intent.to_cell == (7, 5)
+    _assert_legal_move(view, intent)
+
+
+def test_difficult_ground_limits_the_approach_budget():
+    view = _view(difficult=[(x, y) for x in range(12) for y in range(12)])
+    intent = combat_ai.pick_action(object(), view)
+    assert intent.kind == "move"
+    assert combat_grid.chebyshev_cells(view.actor_cell, intent.to_cell) <= 3
+    _assert_legal_move(view, intent)
+
+
+@pytest.mark.parametrize("speed", [0, 30])
+def test_no_reachable_approach_dodges(speed):
+    view = _view(speed=speed, blocking=[
+        (x, y) for x in range(1, 4) for y in range(4, 7) if (x, y) != (2, 5)
+    ])
+    assert combat_ai.pick_action(object(), view).kind == "dodge"
+
+
+@pytest.mark.parametrize("policy", ["greedy-v1", "unknown-policy", "tactical-v2"])
+def test_retreat_obeys_walls_and_prefers_cheaper_ground(monkeypatch, policy):
+    monkeypatch.setattr(combat_ai, "RETREAT_FRACTION", 0.5)
+    actor = SimpleNamespace(current_hp=1, max_hp=20)
+    view = _view(foe_cell=(1, 5), blocking=[(5, y) for y in range(12)],
+                 difficult=[(4, 11)])
+    intent = combat_ai.pick_action(actor, view, policy=policy)
+    assert intent.kind == "disengage"
+    assert intent.to_cell == (3, 11)
+    _assert_legal_move(view, intent)
+
+
+@pytest.mark.parametrize("policy", ["greedy-v1", "unknown-policy", "tactical-v2"])
+def test_open_floor_keeps_original_approach_and_retreat_cells(monkeypatch, policy):
+    view = _view()
+    assert combat_ai.pick_action(object(), view, policy=policy).to_cell == (7, 4)
+    monkeypatch.setattr(combat_ai, "RETREAT_FRACTION", 0.5)
+    actor = SimpleNamespace(current_hp=1, max_hp=20)
+    retreat = replace(view, foes=(_view(foe_cell=(1, 5)).foes[0],))
+    intent = combat_ai.pick_action(actor, retreat, policy=policy)
+    assert intent.kind == "disengage"
+    assert intent.to_cell == (8, 11)
