+# -- #836: deleted store identities and home-scoped lineage --------------------
+
+def _lineage(home, root="S"):
+    tag = hashlib.sha256(str((home / "state.db").resolve()).encode("utf-8")).hexdigest()[:16]
+    return f"{tag}:{root}"
+
+
+@pytest.mark.parametrize("delete_path", ["store", "doctor"])
+@pytest.mark.parametrize("with_bindings", [False, True])
+def test_deleted_messages_drop_only_their_host_uid_bindings(tmp_path, delete_path, with_bindings):
+    from hermes_lcm.command import handle_lcm_command
+
+    config = LCMConfig(database_path=str(tmp_path / "lcm.db"),
+                       ignore_session_patterns=["cron*"], doctor_clean_apply_enabled=True)
+    engine = LCMEngine(config=config, hermes_home=str(tmp_path))
+    engine.on_session_start("live", platform="cli", context_length=200_000)
+    store = engine._store
+    try:
+        doomed = store.append("cron_old", {"role": "user", "content": "scheduled"})
+        kept = store.append("live", {"role": "user", "content": "keep"})
+        if with_bindings:
+            for lineage in ("legacy-root", "other-home:root"):
+                store.add_host_uid_bindings(lineage, [
+                    (doomed, "old", "canonical", "seed"),
+                    (doomed, "version", "version", "seed"),
+                    (doomed, "alias", "alias_candidate", "seed"),
+                    (kept, "keep", "canonical", "seed"),
+                ])
+        before = _bindings(engine)
+        if delete_path == "store":
+            assert store.delete_session_messages("cron_old") == 1
+        else:
+            result = handle_lcm_command("doctor clean apply", engine)
+            assert "status: ok" in result
+            assert "messages_deleted: 1" in result
+        assert store.get_session_messages("cron_old") == []
+        assert len(store.get_session_messages("live")) == 1
+        assert _bindings(engine) == [b for b in before if b[0] == kept]
+        if not with_bindings:
+            assert store.count_host_uid_bindings() is None
+        assert not store.connection.in_transaction
+    finally:
+        engine.shutdown()
+
+
+@pytest.mark.parametrize("delete_path", ["store", "doctor"])
+def test_host_uid_binding_cleanup_rolls_back_with_message_delete(tmp_path, delete_path):
+    from hermes_lcm.command import _delete_clean_candidates_atomically
+
+    engine = _engine(tmp_path, session="live")
+    store = engine._store
+    try:
+        doomed = store.append("old", {"role": "user", "content": "scheduled"})
+        store.add_host_uid_bindings("root", [(doomed, "old", "canonical", "seed")])
+        before = _bindings(engine)
+        store.connection.execute("CREATE TRIGGER fail_delete BEFORE DELETE ON messages "
+                                 "BEGIN SELECT RAISE(ABORT, 'injected delete failure'); END")
+        store.connection.commit()
+        with pytest.raises(sqlite3.IntegrityError, match="injected delete failure"):
+            if delete_path == "store":
+                store.delete_session_messages("old")
+            else:
+                _delete_clean_candidates_atomically(engine, {"old"})
+        assert not store.connection.in_transaction
+        assert len(store.get_session_messages("old")) == 1
+        assert _bindings(engine) == before
+    finally:
+        engine.shutdown()
+
+
+def test_lineage_keys_isolate_shared_store_homes_and_resolve_symlinks(tmp_path):
+    homes = [tmp_path / name for name in ("one", "two")]
+    for home in homes:
+        home.mkdir()
+        _state_db(home, [("S", None, None)])
+    linked = tmp_path / "linked"
+    linked.symlink_to(homes[0], target_is_directory=True)
+    engine = LCMEngine(config=LCMConfig(database_path=str(tmp_path / "shared.db")), hermes_home=str(homes[0]))
+    engine.on_session_start("S", platform="cli", context_length=200_000)
+    try:
+        first_key = engine._host_uid_lineage_key()
+        assert first_key == (_lineage(homes[0]), None)
+        first = engine._store.append("S", {"role": "user", "content": "one"})
+        engine._store.add_host_uid_bindings(first_key[0], [(first, "same-uid", "canonical", "seed")])
+        engine._hermes_home = str(homes[1])
+        second_key = engine._host_uid_lineage_key()
+        assert second_key == (_lineage(homes[1]), None)
+        assert second_key != first_key
+        second = engine._store.append("S", {"role": "user", "content": "two"})
+        engine._store.add_host_uid_bindings(second_key[0], [(second, "same-uid", "canonical", "seed")])
+        assert engine._store.host_uid_bindings_for(first_key[0], ["same-uid"]) == {"same-uid": [(first, "canonical")]}
+        assert engine._store.host_uid_bindings_for(second_key[0], ["same-uid"]) == {"same-uid": [(second, "canonical")]}
+        engine._hermes_home = str(linked)
+        assert engine._host_uid_lineage_key() == first_key
+    finally:
+        engine.shutdown()
