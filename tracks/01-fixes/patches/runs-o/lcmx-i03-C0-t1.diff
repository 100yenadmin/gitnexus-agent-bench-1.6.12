diff --git a/tests/test_startup_writer_contention.py b/tests/test_startup_writer_contention.py
new file mode 100644
index 0000000..90e4d28
--- /dev/null
+++ b/tests/test_startup_writer_contention.py
@@ -0,0 +1,83 @@
+"""Current-schema engine clones must not need SQLite writer ownership (#363)."""
+
+import copy
+import sqlite3
+
+import pytest
+
+from hermes_lcm import db_bootstrap
+from hermes_lcm.config import LCMConfig
+from hermes_lcm.engine import LCMEngine
+
+
+@pytest.mark.parametrize("startup_work", ["none", "migration", "legacy-row"])
+def test_deepcopy_under_active_wal_writer(tmp_path, monkeypatch, startup_work):
+    monkeypatch.setattr(db_bootstrap, "SQLITE_BUSY_TIMEOUT_MS", 10)
+    db_path = tmp_path / "clone.db"
+    prototype = LCMEngine(
+        config=LCMConfig(database_path=str(db_path)),
+        hermes_home=str(tmp_path / "hermes"),
+    )
+    clone = None
+    writer = sqlite3.connect(db_path, timeout=0.01)
+    try:
+        store_id = prototype._store.append(
+            "original-session", {"role": "user", "content": "keep this message"}
+        )
+        db_bootstrap.join_background_integrity_scans()
+        if startup_work == "migration":
+            writer.execute(
+                "UPDATE metadata SET value = ? WHERE key = 'schema_version'",
+                (str(db_bootstrap.SCHEMA_VERSION - 1),),
+            )
+        elif startup_work == "legacy-row":
+            writer.execute(
+                "UPDATE messages SET ingested_at = NULL WHERE store_id = ?", (store_id,)
+            )
+        writer.commit()
+        before = writer.execute(
+            "SELECT store_id, session_id, content, timestamp, ingested_at FROM messages"
+        ).fetchall()
+        assert writer.execute("PRAGMA journal_mode=WAL").fetchone()[0] == "wal"
+        writer.execute("BEGIN IMMEDIATE")
+
+        if startup_work == "none":
+            clone = copy.deepcopy(prototype)
+            assert isinstance(clone, LCMEngine)
+            assert clone._store is not prototype._store
+            assert clone._dag is not prototype._dag
+            assert clone._lifecycle is not prototype._lifecycle
+            for helper in (clone._store, clone._dag, clone._lifecycle):
+                assert helper._conn.total_changes == 0
+            assert clone._store._conn.execute(
+                "SELECT store_id, session_id, content, timestamp, ingested_at FROM messages"
+            ).fetchall() == before
+        else:
+            with pytest.raises(sqlite3.OperationalError, match="database is locked"):
+                copy.deepcopy(prototype)
+        assert writer.in_transaction
+        writer.rollback()
+        assert writer.execute(
+            "SELECT store_id, session_id, content, timestamp, ingested_at FROM messages"
+        ).fetchall() == before
+
+        # Once writer ownership is available, real work must still complete.
+        if startup_work != "none":
+            clone = copy.deepcopy(prototype)
+            assert (
+                db_bootstrap.read_existing_schema_version(clone._store._conn)
+                == db_bootstrap.SCHEMA_VERSION
+            )
+            row = clone._store._conn.execute(
+                "SELECT timestamp, ingested_at FROM messages WHERE store_id = ?", (store_id,)
+            ).fetchone()
+            assert row[1] is not None
+            if startup_work == "legacy-row":
+                assert row[1] == row[0]
+    finally:
+        writer.rollback()
+        writer.close()
+        if clone is not None:
+            clone.shutdown()
+        prototype.shutdown()
+        db_bootstrap.join_background_integrity_scans()
