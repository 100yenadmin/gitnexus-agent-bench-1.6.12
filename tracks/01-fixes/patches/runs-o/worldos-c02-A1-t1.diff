+
+def _gb_cast(uid: str, caster: str, target: str) -> list[dict]:
+    return [_assistant_tool_use(uid, "mcp__engine__cast_spell",
+                                {"character_id": caster, "spell_name": "Guiding Bolt",
+                                 "target_id": target}),
