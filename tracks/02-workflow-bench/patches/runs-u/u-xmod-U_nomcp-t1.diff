+++ b/gitnexus/src/core/ingestion/workers/parse-retry.ts
@@ -0,0 +1,133 @@
+/**
+ * Bounded retry policy for parse-worker failures attributed to a single file.
+ *
+ * Before this layer, the first worker death attributed to a file quarantined
+ * it for the rest of the pool's life. That is right for a deterministic
+ * failure (the same bytes fail the same way in every worker) but wrong for a
+ * transient one: a worker killed by host memory pressure, a thread that hit
+ * its heap cap because of state accumulated over earlier files, or an
+ * `EMFILE`/`EAGAIN` resource blip. Those deserve a fresh worker before the
+ * file is given up on.
+ *
+ * This module is pure (no timers, no pool state) so the retry/no-retry
+ * decision is unit-testable on its own; `worker-pool.ts` owns the per-path
+ * attempt counters and the backoff wait.
+ */
+
+/** Where the pool observed the failure. */
+export type ParseFailureSource =
+  /** The worker thread exited mid-job (OOM kill, signal, native abort). */
+  | 'worker-exit'
+  /** An uncaught throw surfaced as the Worker `error` event. */
+  | 'worker-uncaught-error'
+  /** The worker caught an exception and posted `{type:'error'}`. */
+  | 'worker-reported-error'
+  /** The receiver could not deserialize a worker message (`messageerror`). */
+  | 'message-deserialization'
+  /** The worker posted a message without a `type` discriminant. */
+  | 'malformed-message';
+
+export interface ParseFailureSignal {
+  source: ParseFailureSource;
+  /** Error message, when the source carries one. */
+  message?: string;
+  /** Error stack, when available; its first line names the error class. */
+  stack?: string;
+  /** Node error code (e.g. `ERR_WORKER_OUT_OF_MEMORY`, `EMFILE`). */
+  code?: string;
+}
+
+export type ParseFailureClass = 'transient' | 'deterministic';
+
+export interface ParseRetryPolicy {
+  /** Retries after the first failure before the file is marked failed. */
+  maxRetries: number;
+  /** Delay before the first retry; doubles per subsequent retry. */
+  baseDelayMs: number;
+  /** Upper bound on any single backoff delay. */
+  maxDelayMs: number;
+}
+
+export const DEFAULT_PARSE_RETRY_POLICY: Readonly<ParseRetryPolicy> = Object.freeze({
+  maxRetries: 2,
+  baseDelayMs: 250,
+  maxDelayMs: 2_000,
+});
+
+export type ParseRetryDecision =
+  | { retry: true; attempt: number; delayMs: number }
+  | { retry: false; reason: 'deterministic' | 'exhausted' };
+
+/**
+ * Error codes / message markers that describe the environment, not the input.
+ * A fresh worker (fresh heap, released descriptors) can plausibly succeed.
+ */
+const TRANSIENT_CODES = new Set([
+  'ERR_WORKER_OUT_OF_MEMORY',
+  'ERR_WORKER_INIT_FAILED',
+  'EAGAIN',
+  'EBUSY',
+  'EMFILE',
+  'ENFILE',
+  'ENOMEM',
+  'ETIMEDOUT',
+]);
+const TRANSIENT_MESSAGE_RE =
+  /\b(?:ERR_WORKER_OUT_OF_MEMORY|ERR_WORKER_INIT_FAILED|EAGAIN|EBUSY|EMFILE|ENFILE|ENOMEM|ETIMEDOUT)\b|out of memory|heap limit|allocation failed/i;
+
+function hasTransientMarker(signal: ParseFailureSignal): boolean {
+  if (signal.code !== undefined && TRANSIENT_CODES.has(signal.code)) return true;
+  if (typeof signal.message === 'string' && TRANSIENT_MESSAGE_RE.test(signal.message)) return true;
+  // Only the stack's first line ("<Name>: <message>") — deeper frames are
+  // file paths and function names that could match by accident.
+  const headline = typeof signal.stack === 'string' ? signal.stack.split('\n', 1)[0] : '';
+  return TRANSIENT_MESSAGE_RE.test(headline);
+}
+
+/**
+ * Classify a worker failure. Thread exits are transient (the thread was
+ * killed from outside the parse logic). Thrown errors are deterministic —
+ * the parser/extractor threw on these bytes and will throw again — unless
+ * they carry a resource-exhaustion marker. Message (de)serialization and
+ * protocol failures are deterministic: the same payload fails the same way.
+ */
+export function classifyParseFailure(signal: ParseFailureSignal): ParseFailureClass {
+  switch (signal.source) {
+    case 'worker-exit':
+      return 'transient';
+    case 'worker-uncaught-error':
+    case 'worker-reported-error':
+      return hasTransientMarker(signal) ? 'transient' : 'deterministic';
+    case 'message-deserialization':
+    case 'malformed-message':
+      return 'deterministic';
+  }
+}
+
+/** Exponential backoff for retry `attempt` (1-based), capped at `maxDelayMs`. */
+export function parseRetryDelayMs(
+  attempt: number,
+  policy: ParseRetryPolicy = DEFAULT_PARSE_RETRY_POLICY,
+): number {
+  const exponent = Math.max(0, Math.floor(attempt) - 1);
+  return Math.min(policy.maxDelayMs, Math.max(0, policy.baseDelayMs) * 2 ** exponent);
+}
+
+/**
+ * Decide whether a file whose worker just failed should be retried.
+ * `retriesSoFar` counts retries already granted to this file, so with the
+ * default policy a transient failure is retried on the 1st and 2nd failure
+ * and the file is marked failed on the 3rd.
+ */
+export function decideParseRetry(
+  signal: ParseFailureSignal,
+  retriesSoFar: number,
+  policy: ParseRetryPolicy = DEFAULT_PARSE_RETRY_POLICY,
+): ParseRetryDecision {
+  if (classifyParseFailure(signal) === 'deterministic') {
+    return { retry: false, reason: 'deterministic' };
+  }
+  if (retriesSoFar >= policy.maxRetries) return { retry: false, reason: 'exhausted' };
+  const attempt = retriesSoFar + 1;
+  return { retry: true, attempt, delayMs: parseRetryDelayMs(attempt, policy) };
+}
