+def casting_time_kind(raw) -> str:
+    """Classify a spell's casting time into the action-economy resource it spends (#778):
+    "bonus" | "reaction" | "long" (minutes/hours — can't fit a 6-second turn) | "action".
+    Accepts both the curated spelling ("1 bonus action") and the SRD one ("bonus-action");
+    a missing value is treated as an action (the 5e default)."""
+    s = str(raw or "").lower().replace("-", " ").replace("_", " ")
+    if "bonus" in s:
+        return "bonus"
+    if "reaction" in s:
+        return "reaction"
+    if "minute" in s or "hour" in s:
+        return "long"
+    return "action"
+
+
+def actions_spent(action_used: bool, attacks_made: int, extra_attacks: int) -> int:
+    """How many whole actions the current combatant has spent this turn (#778). Attacks
+    are counted in Attack-action units (``extra_attacks + 1`` strikes each, partially used
+    actions round up); a used action with no strikes (a cast, a skip, a generic
+    use_action) counts as one. Compare against ``1 + surge_actions`` available."""
+    per_action = max(0, int(extra_attacks)) + 1
+    spent = -(-max(0, int(attacks_made)) // per_action)
+    return max(spent, 1 if action_used else 0)
+
+
