+@pytest.mark.parametrize("occupied,impassable", [
+    ({(0, 0)}, set()), (set(), {(0, 0)}), ({(0, 0)}, {(0, 0)}),
+])
+def test_blocked_start_can_be_left_but_is_never_a_destination(occupied, impassable):
+    occupied = occupied | {(2, 0)}
+    impassable = impassable | {(2, 1)}
+    assert combat_grid.shortest_path((0, 0), (1, 0), occupied, 3, 2,
+                                     impassable=impassable) == [(1, 0)]
+    assert combat_grid.shortest_path((0, 0), (0, 0), occupied, 3, 2,
+                                     impassable=impassable) == []
+    assert combat_grid.reachable((0, 0), 3, occupied, 3, 2,
+                                 impassable=impassable) == {(0, 1), (1, 0), (1, 1)}
