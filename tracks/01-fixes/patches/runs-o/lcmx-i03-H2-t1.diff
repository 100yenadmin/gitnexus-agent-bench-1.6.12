@@ -8759,6 +8759,53 @@ class TestLCMEngineCloning:
             if callable(shutdown):
                 shutdown()
 
+    def test_deepcopy_succeeds_on_current_schema_database_with_active_wal_writer(self, tmp_path):
+        """Verify deepcopy doesn't write to a current-schema database when another writer holds the lock.
+
+        Issue #363: LCMEngine cloning would fail under an active SQLite writer
+        because startup code ran UPDATEs even when the database was already at
+        current schema. With the fix, startup skips unnecessary writes when
+        columns already exist and have been populated, allowing the clone to
+        succeed even when another connection holds the write slot in WAL mode.
+        """
+        from hermes_lcm.engine import LCMEngine
+        import sqlite3
+        import threading
+
+        db_path = str(tmp_path / "lcm-wal-clone.db")
+        config = LCMConfig(database_path=db_path)
+
+        # Create and initialize the prototype, ensuring the schema is current
+        prototype = LCMEngine(config=config, hermes_home=str(tmp_path / "hermes"))
+        prototype.on_session_start(
+            "setup-session",
+            platform="test",
+            conversation_id="test:setup",
+        )
+        prototype.shutdown()
+
+        # Now simulate another connection holding a writer lock in WAL mode
+        writer_conn = sqlite3.connect(db_path, timeout=0.1, check_same_thread=False)
+        writer_conn.execute("PRAGMA journal_mode=WAL")
+
+        # Acquire a write lock on the second connection
+        writer_conn.execute("BEGIN IMMEDIATE")
+
+        try:
+            # The clone should succeed even with the write lock held, because
+            # the startup code won't attempt to write when the schema is current
+            prototype = LCMEngine(config=config, hermes_home=str(tmp_path / "hermes"))
+            clone = copy.deepcopy(prototype)
+
+            assert clone is not prototype
+            assert isinstance(clone, LCMEngine)
+            assert clone.name == "lcm"
+            clone.shutdown()
+            prototype.shutdown()
+        finally:
+            writer_conn.rollback()
+            writer_conn.close()
+
 
