diff --git a/gitnexus/test/unit/list-repos-name-filter.test.ts b/gitnexus/test/unit/list-repos-name-filter.test.ts
new file mode 100644
index 0000000..1ead10e
--- /dev/null
+++ b/gitnexus/test/unit/list-repos-name-filter.test.ts
@@ -0,0 +1,245 @@
+/**
+ * Unit tests for the `list_repos` `name_contains` filter: case-insensitive
+ * substring match on the repo name, applied BEFORE pagination so
+ * `pagination.total` / `hasMore` / `nextOffset` describe the filtered set.
+ */
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+
+// Keep LadybugDB and the embedder out of the unit test (same pattern as
+// calltool-dispatch.test.ts); listRepos itself is stubbed per test.
+const { lbugMocks } = vi.hoisted(() => ({
+  lbugMocks: {
+    initLbug: vi.fn().mockResolvedValue(undefined),
+    executeQuery: vi.fn().mockResolvedValue([]),
+    executeParameterized: vi.fn().mockResolvedValue([]),
+    ensureVectorExtension: vi.fn().mockResolvedValue(true),
+    closeLbug: vi.fn().mockResolvedValue(undefined),
+    isLbugReady: vi.fn().mockReturnValue(true),
+  },
+}));
+
+vi.mock('../../src/core/lbug/pool-adapter.js', async (importOriginal) => {
+  const actual = await importOriginal();
+  return { ...actual, ...lbugMocks };
+});
+
+vi.mock('../../src/mcp/core/lbug-adapter.js', async (importOriginal) => {
+  const actual = await importOriginal();
+  return { ...actual, ...lbugMocks };
+});
+
+vi.mock('../../src/mcp/core/embedder.js', () => ({
+  embedQuery: vi.fn().mockResolvedValue([]),
+  getEmbeddingDims: vi.fn().mockReturnValue(384),
+}));
+
+import {
+  LocalBackend,
+  filterReposByName,
+  parseListReposNameFilter,
+  type RepoListing,
+} from '../../src/mcp/local/local-backend.js';
+import { createMcpRepositoryPolicy } from '../../src/mcp/repository-policy.js';
+import { GITNEXUS_TOOLS } from '../../src/mcp/tools.js';
+
+const repo = (name: string, path = `/repos/${name}`): RepoListing => ({
+  name,
+  path,
+  indexedAt: '2026-01-01',
+  lastCommit: 'a'.repeat(40),
+});
+
+type Page = {
+  repositories: RepoListing[];
+  pagination: {
+    total: number;
+    limit: number;
+    offset: number;
+    returned: number;
+    hasMore: boolean;
+    nextOffset?: number;
+  };
+};
+
+describe('parseListReposNameFilter', () => {
+  it('returns undefined when the filter is omitted or null', () => {
+    expect(parseListReposNameFilter(undefined)).toBeUndefined();
+    expect(parseListReposNameFilter(null)).toBeUndefined();
+    expect(parseListReposNameFilter({})).toBeUndefined();
+    expect(parseListReposNameFilter({ name_contains: null })).toBeUndefined();
+  });
+
+  it('treats empty and whitespace-only strings as no filter', () => {
+    expect(parseListReposNameFilter({ name_contains: '' })).toBeUndefined();
+    expect(parseListReposNameFilter({ name_contains: '   ' })).toBeUndefined();
+  });
+
+  it('lower-cases and trims the needle', () => {
+    expect(parseListReposNameFilter({ name_contains: '  GitNexus ' })).toBe('gitnexus');
+  });
+
+  it('rejects non-string values', () => {
+    for (const bad of [42, true, ['a'], { a: 1 }]) {
+      expect(() => parseListReposNameFilter({ name_contains: bad })).toThrow(/name_contains/);
+    }
+  });
+});
+
+describe('filterReposByName', () => {
+  const repos = [repo('GitNexus'), repo('gitnexus-web'), repo('WorldOS'), repo('lcm-x')];
+
+  it('returns the input unchanged without a needle', () => {
+    expect(filterReposByName(repos, undefined)).toBe(repos);
+  });
+
+  it('matches substrings case-insensitively', () => {
+    expect(filterReposByName(repos, 'nexus').map((r) => r.name)).toEqual([
+      'GitNexus',
+      'gitnexus-web',
+    ]);
+    expect(filterReposByName(repos, 'os').map((r) => r.name)).toEqual(['WorldOS']);
+  });
+
+  it('matches against the name only, not the path', () => {
+    expect(filterReposByName([repo('alpha', '/srv/nexus/alpha')], 'nexus')).toEqual([]);
+  });
+});
+
+describe('LocalBackend list_repos name_contains', () => {
+  let backend: LocalBackend;
+
+  // 120 repos: every third one is a "service-*" repo with mixed casing, so the
+  // filtered set (40) spans multiple pages at a small limit.
+  const id = (i: number) => String(i).padStart(4, '0');
+  const all = Array.from({ length: 120 }, (_, i) =>
+    i % 3 === 0
+      ? repo(i % 2 === 0 ? `Service-${id(i)}` : `service-${id(i)}`)
+      : repo(`lib-${id(i)}`),
+  );
+
+  beforeEach(() => {
+    backend = new LocalBackend();
+    vi.spyOn(backend, 'listRepos').mockImplementation(async () => all.map((r) => ({ ...r })));
+  });
+
+  it('pagination.total reflects the filtered set', async () => {
+    const page: Page = await backend.callTool('list_repos', {
+      name_contains: 'SERVICE',
+      limit: 15,
+    });
+    expect(page.repositories).toHaveLength(15);
+    expect(page.repositories.every((r) => r.name.toLowerCase().includes('service'))).toBe(true);
+    expect(page.pagination).toEqual({
+      total: 40,
+      limit: 15,
+      offset: 0,
+      returned: 15,
+      hasMore: true,
+      nextOffset: 15,
+    });
+  });
+
+  it('pages through the filtered set without skips or duplicates', async () => {
+    const seen: string[] = [];
+    let offset: number | undefined = 0;
+    while (offset !== undefined) {
+      const page: Page = await backend.callTool('list_repos', {
+        name_contains: 'service',
+        limit: 15,
+        offset,
+      });
+      seen.push(...page.repositories.map((r) => r.name));
+      offset = page.pagination.nextOffset;
+      if (!page.pagination.hasMore) expect(offset).toBeUndefined();
+    }
+    expect(seen).toHaveLength(40);
+    expect(new Set(seen).size).toBe(40);
+  });
+
+  it('last filtered page reports hasMore=false and no nextOffset', async () => {
+    const page: Page = await backend.callTool('list_repos', {
+      name_contains: 'service',
+      limit: 15,
+      offset: 30,
+    });
+    expect(page.pagination).toEqual({
+      total: 40,
+      limit: 15,
+      offset: 30,
+      returned: 10,
+      hasMore: false,
+    });
+  });
+
+  it('a filter with no matches returns an empty page with total 0', async () => {
+    const page: Page = await backend.callTool('list_repos', { name_contains: 'nope' });
+    expect(page.repositories).toEqual([]);
+    expect(page.pagination).toMatchObject({ total: 0, returned: 0, hasMore: false });
+    expect(page.pagination).not.toHaveProperty('nextOffset');
+  });
+
+  it('without the filter, total covers every repo (unchanged behavior)', async () => {
+    const page: Page = await backend.callTool('list_repos', {});
+    expect(page.pagination.total).toBe(120);
+    const blank: Page = await backend.callTool('list_repos', { name_contains: '  ' });
+    expect(blank.pagination.total).toBe(120);
+  });
+
+  it('rejects a non-string filter', async () => {
+    await expect(backend.callTool('list_repos', { name_contains: 7 })).rejects.toThrow(
+      /name_contains/,
+    );
+  });
+});
+
+describe('MCP repository policy list_repos name_contains', () => {
+  const repos = [repo('Alpha'), repo('alphabet'), repo('Beta'), repo('Gamma')];
+
+  function createBackend() {
+    return {
+      listRepos: vi.fn().mockResolvedValue(repos.map((r) => ({ ...r }))),
+      countRepos: vi.fn().mockResolvedValue(repos.length),
+      cachedRepoCount: vi.fn().mockReturnValue(repos.length),
+      callTool: vi.fn(),
+      resolveRepo: vi.fn(),
+      selectToolRepository: vi.fn(),
+    } as unknown as LocalBackend;
+  }
+
+  it('filters the allowed set before paginating', async () => {
+    const backend = createBackend();
+    const policy = await createMcpRepositoryPolicy(backend, {
+      GITNEXUS_MCP_ALLOWED_REPOS: 'Alpha,alphabet,Beta',
+    });
+    const scoped = policy.scopeBackend(backend);
+
+    const page = (await scoped.callTool('list_repos', {
+      name_contains: 'ALPHA',
+      limit: 1,
+    })) as Page;
+    expect(page.repositories.map((r) => r.name)).toEqual(['Alpha']);
+    expect(page.pagination).toEqual({
+      total: 2,
+      limit: 1,
+      offset: 0,
+      returned: 1,
+      hasMore: true,
+      nextOffset: 1,
+    });
+
+    // Gamma matches "a" but is outside the allowlist, so it never counts.
+    const broad = (await scoped.callTool('list_repos', { name_contains: 'a' })) as Page;
+    expect(broad.repositories.map((r) => r.name)).toEqual(['Alpha', 'alphabet', 'Beta']);
+    expect(broad.pagination.total).toBe(3);
+    expect(backend.callTool).not.toHaveBeenCalled();
+  });
+});
+
+describe('list_repos tool schema', () => {
+  it('advertises an optional string name_contains parameter', () => {
+    const tool = GITNEXUS_TOOLS.find((t) => t.name === 'list_repos');
+    const props = tool?.inputSchema.properties as Record<string, { type: string }>;
+    expect(props.name_contains?.type).toBe('string');
+    expect(tool?.inputSchema.required ?? []).not.toContain('name_contains');
+  });
+});
