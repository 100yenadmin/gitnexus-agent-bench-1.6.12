+def test_retry_uncertain_skips_blank_summaries(monkeypatch, tmp_path):
+    """Retry-uncertain skips blank summaries but preserves their uncertain markers."""
+    engine = _engine(tmp_path)
+    dag = SummaryDAG(engine._store.db_path)
+    try:
+        valid_id = dag.add_node(SummaryNode(
+            session_id="session-a",
+            depth=0,
+            summary="valid",
+            source_token_count=100,
+            created_at=1.0,
+            latest_at=1.0,
+        ))
+        blank_id = dag.add_node(SummaryNode(
+            session_id="session-a",
+            depth=0,
+            summary="  ",  # blank
+            source_token_count=100,
+            created_at=2.0,
+            latest_at=2.0,
+        ))
+    finally:
+        dag.close()
+
+    store = VectorStore(engine._store.db_path, config=engine._config)
+    try:
+        store.register_profile("model-a", "ollama", 2)
+    finally:
+        store.close()
+
+    # Mark both as uncertain
+    _mark_uncertain(engine, [valid_id, blank_id])
+
+    provider = FakeProvider()
+    monkeypatch.setattr(command_mod, "resolve_provider", lambda _config, **_kw: provider)
+
+    result = handle_lcm_command("embed backfill --apply --retry-uncertain", engine)
+
+    # Only valid summary should be sent to provider
+    assert "embedded: 1" in result
+    assert len(provider.calls) == 1
+    assert len(provider.calls[0]) == 1
+    # Blank summary's uncertain marker should still be in inflight
+    # (the valid one's uncertain marker is cleared after successful embedding)
+    inflight = _inflight_rows(engine)
+    assert len(inflight) == 1  # only blank row
+    assert inflight[0][0] == str(blank_id)
+    assert inflight[0][1] == "uncertain"
+
+
+def test_blank_uncertain_marker_preserved_on_retry(monkeypatch, tmp_path):
+    """An existing uncertain marker for a blank row is kept, not cleared."""
+    engine = _engine(tmp_path)
+    dag = SummaryDAG(engine._store.db_path)
+    try:
+        blank_id = dag.add_node(SummaryNode(
+            session_id="session-a",
+            depth=0,
+            summary="",  # blank
+            source_token_count=100,
+            created_at=1.0,
+            latest_at=1.0,
+        ))
+    finally:
+        dag.close()
+
+    store = VectorStore(engine._store.db_path, config=engine._config)
+    try:
+        store.register_profile("model-a", "ollama", 2)
+    finally:
+        store.close()
+
+    # Create an uncertain marker for the blank summary
+    _mark_uncertain(engine, [blank_id])
+
+    provider = FakeProvider()
+    monkeypatch.setattr(command_mod, "resolve_provider", lambda _config, **_kw: provider)
+
+    # Try to retry-uncertain
+    result = handle_lcm_command("embed backfill --apply --retry-uncertain", engine)
+
+    # No embedding should happen (blank is skipped)
+    assert "embedded: 0" in result
+    # Provider should not be called
+    assert provider.calls == []
+    # Uncertain marker should still exist
+    inflight = _inflight_rows(engine)
+    assert len(inflight) == 1
+    assert inflight[0][1] == "uncertain"
