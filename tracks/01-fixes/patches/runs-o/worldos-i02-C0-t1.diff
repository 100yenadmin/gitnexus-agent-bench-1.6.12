+@pytest.mark.parametrize("start", [(4, 2), (2, 1)])
+def test_rest_blocked_cells_exempts_mover_on_terrain(room, start):
+    cid, hero, ally, loc_id = room
+    c = server._require(cid)
+    c.characters[hero].stage_cell = start
+    _, _, blocked = server.rest_blocked_cells(c, c.locations[loc_id], exclude_id=hero)
+    assert start not in blocked
+    assert (1, 0) in blocked
+    assert start in server.rest_blocked_cells(c, c.locations[loc_id])[2]
+
