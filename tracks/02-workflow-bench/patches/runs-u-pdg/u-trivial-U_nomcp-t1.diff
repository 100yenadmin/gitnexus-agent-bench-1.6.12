diff --git a/gitnexus/test/unit/status-json-alias.test.ts b/gitnexus/test/unit/status-json-alias.test.ts
new file mode 100644
index 0000000..df0a2a2
--- /dev/null
+++ b/gitnexus/test/unit/status-json-alias.test.ts
@@ -0,0 +1,48 @@
+import { spawnSync } from 'node:child_process';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { afterAll, describe, expect, it } from 'vitest';
+import { CLI_SPAWN_PREFIX } from '../helpers/cli-entry.js';
+
+// A non-git directory makes `status --json` emit a deterministic error payload.
+const nonRepoDir = fs.mkdtempSync(path.join(os.tmpdir(), 'gitnexus-status-json-alias-'));
+
+function runCli(args: string[]) {
+  return spawnSync(process.execPath, [...CLI_SPAWN_PREFIX, ...args], {
+    cwd: nonRepoDir,
+    encoding: 'utf8',
+    env: { ...process.env, GITNEXUS_LANG: 'en' },
+  });
+}
+
+function lastJsonLine(stdout: string): unknown {
+  const line = stdout
+    .split(/\r?\n/)
+    .map((l) => l.trim())
+    .filter((l) => l.startsWith('{'))
+    .pop();
+  expect(line, `no JSON line in stdout:\n${stdout}`).toBeDefined();
+  return JSON.parse(line!);
+}
+
+afterAll(() => {
+  fs.rmSync(nonRepoDir, { recursive: true, force: true });
+});
+
+describe('gitnexus status -j alias', () => {
+  it('lists -j as the short flag for --json in help', () => {
+    const result = runCli(['status', '--help']);
+    expect(result.status).toBe(0);
+    expect(result.stdout).toMatch(/-j, --json\s/);
+  });
+
+  it('produces the same JSON payload as --json', () => {
+    const short = runCli(['status', '-j']);
+    const long = runCli(['status', '--json']);
+    expect(short.status).toBe(long.status);
+    const shortJson = lastJsonLine(short.stdout);
+    expect(shortJson).toEqual(lastJsonLine(long.stdout));
+    expect(shortJson).toMatchObject({ schemaVersion: 1, error: 'not-git-repository' });
+  });
+});
