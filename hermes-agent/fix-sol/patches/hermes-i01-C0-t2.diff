+def _has_native_thinking(assistant_message: Any) -> bool:
+    """Signed thinking and native replay carriers are not user-facing answers.
+
+    Use response metadata rather than the route: plugins can replay Claude turns
+    through chat completions, while other models put real answers in reasoning.
+    """
+    for detail in getattr(assistant_message, "reasoning_details", None) or []:
+        if not isinstance(detail, dict):
+            continue
+        kind = detail.get("type")
+        if (
+            kind in ("thinking", "redacted_thinking")
+            and (detail.get("signature") or detail.get("data"))
+        ) or (isinstance(kind, str) and kind.endswith(".native_assistant")):
+            return True
+    return False
+
