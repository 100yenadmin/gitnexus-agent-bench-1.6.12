@@ -0,0 +1,95 @@
+/**
+ * Bounded per-file retry policy for parse-worker failures.
+ *
+ * When a worker fails while a file is attributably in flight, the pool used to
+ * quarantine that file immediately. That is right for a deterministic failure
+ * (the same input throws the same way every time) but wrong for a transient one
+ * — a worker killed by memory pressure from its batch-mates, a native addon
+ * crash that does not reproduce, an external signal. This module decides which
+ * is which and how long to back off before the retry, so the pool can give a
+ * transiently-failed file up to {@link MAX_TRANSIENT_PARSE_RETRIES} more
+ * attempts before it is marked failed (quarantined).
+ *
+ * Pure and side-effect free so the retry/no-retry decision is unit-testable
+ * without spawning workers.
+ */
+
+/**
+ * How a worker failure was observed by the pool.
+ *
+ * - `worker-exit`: the worker thread exited mid-job (native crash, OOM kill,
+ *   external signal). Transient — the process died, not the parse.
+ * - `worker-oom`: the worker hit its own V8 heap cap
+ *   (`ERR_WORKER_OUT_OF_MEMORY`). Transient — heap pressure depends on what
+ *   else shared the worker, and a requeued job runs on a fresh isolate.
+ * - `worker-reported-error`: the worker caught an exception and reported it as
+ *   `{type:'error'}`. Deterministic — a JS throw on the same input repeats.
+ * - `uncaught-error`: a non-OOM exception escaped the worker's try/catch.
+ *   Deterministic for the same reason.
+ * - `message-error`: the result could not be deserialized on the main thread.
+ *   Deterministic — the same file produces the same payload.
+ * - `malformed-message`: the worker sent a message with no type discriminant.
+ *   Deterministic — a worker protocol bug, not a transient condition.
+ */
+export type ParseWorkerFailureKind =
+  | 'worker-exit'
+  | 'worker-oom'
+  | 'worker-reported-error'
+  | 'uncaught-error'
+  | 'message-error'
+  | 'malformed-message';
+
+/** Retries beyond the first attempt that a transiently-failed file receives. */
+export const MAX_TRANSIENT_PARSE_RETRIES = 2;
+const PARSE_RETRY_BACKOFF_BASE_MS = 250;
+const PARSE_RETRY_BACKOFF_CAP_MS = 2_000;
+
+/** Whether a failure of this kind may succeed when the same file is re-run. */
+export function isTransientParseFailure(kind: ParseWorkerFailureKind): boolean {
+  return kind === 'worker-exit' || kind === 'worker-oom';
+}
+
+/**
+ * Capped exponential backoff before retry number `retryNumber` (1-based):
+ * 250ms, 500ms, 1000ms, … capped at 2000ms. Deterministic — retries are
+ * per-file and rare, so there is no thundering herd to de-synchronize.
+ */
+export function parseRetryBackoffMs(retryNumber: number): number {
+  const exponent = Math.max(0, retryNumber - 1);
+  return Math.min(PARSE_RETRY_BACKOFF_CAP_MS, PARSE_RETRY_BACKOFF_BASE_MS * 2 ** exponent);
+}
+
+export interface ParseRetryInput {
+  kind: ParseWorkerFailureKind;
+  /** Retries this file has already received in the current dispatch. */
+  priorRetries: number;
+  /**
+   * False when another failure would exhaust the pool's own resilience budget
+   * (circuit breaker / respawn budget) before the file could be quarantined.
+   * Retrying then would trade a quarantined file for a tripped pool.
+   */
+  poolHasHeadroom: boolean;
+  maxRetries?: number;
+}
+
+export type ParseRetryDecision =
+  | { action: 'retry'; retryNumber: number; delayMs: number }
+  | { action: 'fail'; reason: 'deterministic' | 'retries-exhausted' | 'no-pool-headroom' };
+
+/**
+ * Decide whether a file whose worker just failed is retried or marked failed.
+ * Deterministic failures are never retried; transient ones are retried with
+ * backoff until `maxRetries` is spent or the pool lacks headroom.
+ */
+export function decideParseRetry({
+  kind,
+  priorRetries,
+  poolHasHeadroom,
+  maxRetries = MAX_TRANSIENT_PARSE_RETRIES,
+}: ParseRetryInput): ParseRetryDecision {
+  if (!isTransientParseFailure(kind)) return { action: 'fail', reason: 'deterministic' };
+  if (priorRetries >= maxRetries) return { action: 'fail', reason: 'retries-exhausted' };
+  if (!poolHasHeadroom) return { action: 'fail', reason: 'no-pool-headroom' };
+  const retryNumber = priorRetries + 1;
+  return { action: 'retry', retryNumber, delayMs: parseRetryBackoffMs(retryNumber) };
+}
