+def _settle_stage_cell_on_rest_grid(c: "Campaign", ch: "Character") -> bool:
+    """#1511: after ``end_combat`` writes a survivor's final COMBAT cell into ``stage_cell``, make
+    sure that cell is legal on the room's REST grid. The fight's grid may have allowed a cell the
+    rest scene treats as a wall/prop (or one another stander occupies); such a survivor is moved to
+    the nearest walkable, unoccupied rest cell — preferring cells reachable from where they stand
+    (Chebyshev distance, then a stable (y, x) tiebreak), falling back to the nearest free cell
+    anywhere on the grid. ADDITIVE: no scene_grid / no stage_cell / an already-legal cell => no
+    write. Returns True when the stage_cell was changed."""
+    sc = getattr(ch, "stage_cell", None)
+    if sc is None:
+        return False
+    loc_id = ch.location_id or c.current_location_id
+    loc = c.locations.get(loc_id) if loc_id else None
+    grid = getattr(loc, "scene_grid", None) if loc is not None else None
+    if grid is None:
+        return False
+    width, height, blocked = rest_blocked_cells(c, loc, exclude_id=ch.id)
+    if width <= 0 or height <= 0:
+        return False
+    # rest_blocked_cells exempts the mover's own cell, so re-add raw terrain to judge it.
+    terrain = {(x, y) for x, y in scene_grid_mod.impassable_cells(grid, width, height)}
+    bad = blocked | terrain
+    cell = (int(sc[0]), int(sc[1]))
+    in_bounds = 0 <= cell[0] < width and 0 <= cell[1] < height
+    if in_bounds and cell not in bad:
+        return False
+    rank = lambda cand: (combat_grid.chebyshev_cells(cand, cell), cand[1], cand[0])  # noqa: E731
+    pool: set[tuple[int, int]] = set()
+    if in_bounds:
+        pool = combat_grid.reachable(cell, width * height, set(), width, height, impassable=bad)
+    if not pool:
+        pool = {(x, y) for x in range(width) for y in range(height)} - bad
+    if not pool:
+        return False  # nowhere legal to stand — leave the write-back as-is
+    ch.stage_cell = min(pool, key=rank)
+    return True
+
+
