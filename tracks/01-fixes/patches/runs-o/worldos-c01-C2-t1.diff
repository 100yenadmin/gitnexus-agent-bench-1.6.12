diff --git a/servers/engine/tests/test_combat_action_economy.py b/servers/engine/tests/test_combat_action_economy.py
new file mode 100644
index 0000000..e70eedf
--- /dev/null
+++ b/servers/engine/tests/test_combat_action_economy.py
@@ -0,0 +1,151 @@
+"""Shared action economy across combat tools (#778)."""
+
+import json
+
+import pytest
+
+import server
+import spells
+import store
+
+
+@pytest.fixture
+def fight(tmp_path, monkeypatch):
+    monkeypatch.setenv("WORLDOS_STATE_DIR", str(tmp_path))
+    cid = server.create_campaign("action-economy")["id"]
+    ids = [
+        server.create_character(cid, name, kind="player", max_hp=100)["id"]
+        for name in ("Caster", "Target")
+    ]
+    server.start_combat(cid, ids)
+    cur = server.get_state(cid)["current_turn"]
+    other = next(i for i in ids if i != cur)
+    server.update_character(cid, cur, {"spell_slots": {
+        "1": {"maximum": 4}, "3": {"maximum": 3},
+    }})
+    return cid, cur, other
+
+
+def _act(fight, kind):
+    cid, cur, other = fight
+    if kind == "cast":
+        return server.cast_spell(cid, cur, "Fire Bolt")
+    if kind == "attack":
+        return server.attack(cid, cur, other, attack_bonus=0, damage_dice="1")
+    return server.use_action(cid, cur, kind)
+
+
+@pytest.mark.parametrize("first,second,message", [
+    ("cast", "cast", "already used its action"),
+    ("cast", "attack", "already cast a spell"),
+    ("attack", "cast", "already used its action"),
+    ("skip", "attack", "skipped this turn"),
+    ("skip", "cast", "already used its action"),
+    ("action", "cast", "already used its action"),
+])
+def test_tools_share_action_and_reject_without_mutation(fight, first, second, message):
+    _act(fight, first)
+    before = store.load_campaign(fight[0]).model_dump(mode="json")
+    with pytest.raises(ValueError, match=message):
+        _act(fight, second)
+    assert store.load_campaign(fight[0]).model_dump(mode="json") == before
+
+
+@pytest.mark.parametrize("kind", ["action", "dash", "disengage", "skip"])
+def test_action_cast_blocks_use_action(fight, kind):
+    _act(fight, "cast")
+    assert _act(fight, kind)["ok"] is False
+
+
+@pytest.mark.parametrize("source", ["curated", "srd"])
+@pytest.mark.parametrize("following", ["action", "cast", "fireball", "attack"])
+def test_bonus_cast_leaves_action_available(fight, monkeypatch, source, following):
+    cid, cur, _ = fight
+    if source == "srd":
+        # Force the real SRD record ("bonus-action") rather than the curated
+        # Healing Word record ("1 bonus action").
+        original = spells.spell_data
+        def srd_only(name):
+            if name == "Healing Word":
+                raise ValueError("use SRD")
+            return original(name)
+        monkeypatch.setattr(spells, "spell_data", srd_only)
+    server.cast_spell(cid, cur, "Healing Word")
+    c = store.load_campaign(cid)
+    assert c.combat.bonus_action_used is True
+    assert c.combat.action_used is False
+    assert c.combat.action_purpose == ""
+    if following == "fireball":
+        assert server.cast_spell(cid, cur, "Fireball")["spell"] == "Fireball"
+    else:
+        result = _act(fight, following)
+        assert result.get("ok", True)
+    assert store.load_campaign(cid).combat.action_used is True
+
+
+def test_bonus_cast_cannot_spend_bonus_twice(fight):
+    cid, cur, _ = fight
+    server.cast_spell(cid, cur, "Healing Word")
+    before = store.load_campaign(cid).model_dump(mode="json")
+    with pytest.raises(ValueError, match="already used its bonus action"):
+        server.cast_spell(cid, cur, "Healing Word")
+    assert store.load_campaign(cid).model_dump(mode="json") == before
+
+
+@pytest.mark.parametrize("spell", ["Alarm", "Antipathy/Sympathy"])
+def test_long_casts_rejected_in_combat_before_spending(fight, spell):
+    cid, cur, _ = fight
+    before = store.load_campaign(cid).model_dump(mode="json")
+    with pytest.raises(ValueError, match="casting time"):
+        server.cast_spell(cid, cur, spell, innate=True)
+    assert store.load_campaign(cid).model_dump(mode="json") == before
+
+
+@pytest.mark.parametrize("first,second", [
+    ("cast", "cast"), ("cast", "attack"), ("attack", "cast"),
+    ("cast", "action"), ("skip", "attack"),
+])
+def test_action_surge_grants_exactly_one_more_action(fight, first, second):
+    cid, cur, _ = fight
+    server.set_class_resource(cid, cur, "action_surge", max=1, recharge="short")
+    _act(fight, first)
+    server.use_resource(cid, cur, "action_surge")
+    assert _act(fight, second).get("ok", True)
+    with pytest.raises(ValueError):
+        _act(fight, "cast")
+    if second == "attack":
+        with pytest.raises(ValueError):
+            _act(fight, "attack")
+
+
+def test_generic_action_allows_extra_attack_but_not_cast(fight):
+    cid, cur, _ = fight
+    server.update_character(cid, cur, {"extra_attacks": 1})
+    assert _act(fight, "action")["ok"] is True
+    _act(fight, "attack")
+    _act(fight, "attack")
+    with pytest.raises(ValueError, match="no attacks left"):
+        _act(fight, "attack")
+    with pytest.raises(ValueError, match="already used its action"):
+        _act(fight, "cast")
+
+
+@pytest.mark.parametrize("kind", ["cast", "skip"])
+def test_next_turn_resets_action_purpose(fight, kind):
+    _act(fight, kind)
+    assert store.load_campaign(fight[0]).combat.action_purpose == kind
+    server.next_turn(fight[0])
+    c = store.load_campaign(fight[0])
+    assert c.combat.action_purpose == ""
+    assert c.combat.action_used is False
+    server.cast_spell(fight[0], c.combat.current_combatant_id, "Fire Bolt")
+
+
+def test_old_snapshot_defaults_action_purpose(fight):
+    cid, _, _ = fight
+    c = store.load_campaign(cid)
+    path = store.save_campaign(c)
+    old = json.loads(path.read_text())
+    del old["combat"]["action_purpose"]
+    path.write_text(json.dumps(old))
+    assert store.load_campaign(cid).combat.action_purpose == ""
