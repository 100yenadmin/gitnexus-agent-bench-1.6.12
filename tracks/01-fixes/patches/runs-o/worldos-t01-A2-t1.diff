+
+
+# ── #1447 follow-up: the move verb's advisory / rejection notes reach the resolved result ──
+
+
+def test_in_budget_move_result_has_no_extra_keys(grid_fight):
+    """A legal, in-budget move's result is exactly {to_cell, to_zone} — no advisory keys."""
+    cid, hero, gob = grid_fight
+    out = combat_loop.resolve_player_turn(cid, hero, Intent(kind="move", to_cell=(3, 0)))
+    assert out["ok"] is True, out
+    result = out["resolved"]["result"]
+    assert set(result) == {"to_cell", "to_zone"}, result
+    assert tuple(result["to_cell"]) == (3, 0)
+
+
+def test_over_budget_move_surfaces_movement_illegal(grid_fight):
+    """Speed 30 at cell size 5 = a 6-cell budget; a 7-cell move is advisory-only — it still
+    happens, and the verb's movement_illegal note is carried into resolved["result"]."""
+    cid, hero, gob = grid_fight
+    out = combat_loop.resolve_player_turn(cid, hero, Intent(kind="move", to_cell=(7, 0)))
+    assert out["ok"] is True, out
+    assert _cell(cid, hero) == (7, 0)  # advisory: the move still lands
+    note = out["resolved"]["result"].get("movement_illegal")
+    assert note, out["resolved"]
+    assert note.get("budget_cells") == 6
+    assert "move_blocked" not in out["resolved"]["result"]
+
+
+def test_blocked_move_surfaces_move_blocked(tmp_path, monkeypatch):
+    """A move onto an impassable cell is rejected (mover stays put) and the verb's move_blocked
+    note is carried into resolved["result"]."""
+    monkeypatch.setenv("WORLDOS_STATE_DIR", str(tmp_path))
+    cid = server.create_campaign("ArbiterBlocked")["id"]
+    hero = server.create_character(cid, "Hero", kind="player", max_hp=30, armor_class=14)["id"]
+    gob = server.create_character(cid, "Goblin", kind="monster", max_hp=15, armor_class=12)["id"]
+    server.start_combat(cid, [hero, gob], surpriser_ids=[hero])
+    server.set_grid(cid, 20, 20, obstacles=[[3, 0]])
+    server.place_combatant_at_coords(cid, hero, 0, 0)
+    server.place_combatant_at_coords(cid, gob, 10, 0)
+
+    out = combat_loop.resolve_player_turn(cid, hero, Intent(kind="move", to_cell=(3, 0)))
+    assert out["ok"] is True, out
+    assert _cell(cid, hero) == (0, 0)  # rejected: stayed put
+    note = out["resolved"]["result"].get("move_blocked")
+    assert note, out["resolved"]
+    assert note["target"] == [3, 0]
+    assert "movement_illegal" not in out["resolved"]["result"]
