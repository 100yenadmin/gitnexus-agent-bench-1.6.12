+
+
+# ── #1447 follow-up: move-verb advisories surface in the resolved result ─────────────
+
+
+def test_clean_move_result_has_no_advisory_keys(grid_fight):
+    """A legal in-budget move's result is exactly {to_cell, to_zone} — no extra keys."""
+    cid, hero, gob = grid_fight
+    out = combat_loop.resolve_player_turn(cid, hero, Intent(kind="move", to_cell=(3, 0)))
+    assert out["ok"] is True, out
+    assert set(out["resolved"]["result"]) == {"to_cell", "to_zone"}
+    assert out["resolved"]["result"]["to_cell"] == (3, 0)
+
+
+def test_over_budget_move_surfaces_movement_illegal(grid_fight):
+    """Speed 30 at 5 ft/cell = 6-cell budget; a 7-cell move is advisory-only (it still happens)
+    and the verb's movement_illegal note reaches the resolved result."""
+    cid, hero, gob = grid_fight
+    out = combat_loop.resolve_player_turn(cid, hero, Intent(kind="move", to_cell=(7, 0)))
+    assert out["ok"] is True, out
+    result = out["resolved"]["result"]
+    assert "movement_illegal" in result, result
+    assert result["movement_illegal"].get("budget_cells") == 6
+    assert "move_blocked" not in result
+    assert _cell(cid, hero) == (7, 0)
+
+
+def test_impassable_move_surfaces_move_blocked(grid_fight):
+    """A move onto an impassable cell is refused (the hero stays put) and the verb's
+    move_blocked note reaches the resolved result."""
+    cid, hero, gob = grid_fight
+    server.set_grid(cid, 20, 20, obstacles=[[3, 0]])
+    out = combat_loop.resolve_player_turn(cid, hero, Intent(kind="move", to_cell=(3, 0)))
+    assert out["ok"] is True, out
+    result = out["resolved"]["result"]
+    assert "move_blocked" in result, result
+    assert _cell(cid, hero) == (0, 0)
