+
+describe('C: system includes never resolve into the repository, quoted includes still do', () => {
+  const resolver = SCOPE_RESOLVERS.get(SupportedLanguages.C)!;
+  const files = new Set([
+    'src/main.c',
+    'src/stdio.h',
+    'vendor/sys/types.h',
+    'include/util.h',
+    'lib/core/config.h',
+  ]);
+  // What `scanHeaderFiles` hands over: headers live outside `allFilePaths`.
+  const headers: ReadonlySet<string> = new Set(['vendor/sys/types.h', 'include/util.h']);
+  const resolve = (targetRaw: string, config: unknown = undefined) =>
+    filesOf(resolver.resolveImportTarget(targetRaw, 'src/main.c', files, config));
+
+  it.each([
+    ['<stdio.h>', undefined],
+    ['<stdio.h>', headers],
+    ['<sys/types.h>', undefined],
+    ['<sys/types.h>', headers],
+    ['<util.h>', headers],
+    [' <stdio.h> ', undefined],
+  ])('%s resolves to nothing even with a same-named in-repo header', (targetRaw, config) => {
+    expect(resolve(targetRaw, config)).toEqual([]);
+  });
+
+  it.each([
+    // same-directory sibling — the `#include "…"` first lookup
+    ['stdio.h', undefined, 'src/stdio.h'],
+    // exact repo path
+    ['lib/core/config.h', undefined, 'lib/core/config.h'],
+    // suffix fallback, including against the scanned-header augmentation
+    ['core/config.h', undefined, 'lib/core/config.h'],
+    ['sys/types.h', headers, 'vendor/sys/types.h'],
+    ['util.h', headers, 'include/util.h'],
+    // relative path out of the including file's directory
+    ['../include/util.h', headers, 'include/util.h'],
+  ])('quoted %s still resolves', (targetRaw, config, expected) => {
+    expect(resolve(targetRaw, config)).toEqual([expected]);
+  });
+
+  // The pipeline path end to end: parsed `#include` → ParsedImport → resolver.
+  // Both directives name `stdio.h` and the decoy `src/stdio.h` sits beside
+  // main.c, so only the delimiter can tell them apart.
+  function resolveDirective(source: string): readonly string[] {
+    const tree = getCParser().parse(source);
+    const include = tree.rootNode.namedChildren.find((n) => n?.type === 'preproc_include');
+    const split = splitCInclude(include as SyntaxNode);
+    const parsed = split === null ? null : interpretCImport(split);
+    if (parsed === null) return [];
+    return resolve(parsed.targetRaw ?? '');
+  }
+
+  it('`#include <stdio.h>` never reaches the in-repo src/stdio.h', () => {
+    expect(resolveDirective('#include <stdio.h>\n')).toEqual([]);
+  });
+
+  it('`#include "stdio.h"` does reach it', () => {
+    expect(resolveDirective('#include "stdio.h"\n')).toEqual(['src/stdio.h']);
+  });
+});
