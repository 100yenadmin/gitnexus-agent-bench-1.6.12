diff --git a/tests/agent/test_response_reused.py b/tests/agent/test_response_reused.py
new file mode 100644
index 00000000..b52f84fa
--- /dev/null
+++ b/tests/agent/test_response_reused.py
@@ -0,0 +1,105 @@
+"""Final response reuse is provenance, not equality with earlier model text."""
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from run_agent import AIAgent
+
+
+def _response(text, tool=False):
+    calls = [SimpleNamespace(
+        id="todo1", type="function",
+        function=SimpleNamespace(name="todo_list", arguments='{"todos": []}'),
+    )] if tool else None
+    return SimpleNamespace(
+        choices=[SimpleNamespace(
+            message=SimpleNamespace(content=text, tool_calls=calls),
+            finish_reason="tool_calls" if tool else "stop",
+        )], model="test/model", usage=None,
+    )
+
+
+@pytest.fixture
+def agent():
+    with (
+        patch("model_tools.get_tool_definitions", return_value=[]),
+        patch("model_tools.check_toolset_requirements", return_value={}),
+        patch("agent.process_bootstrap.OpenAI"),
+    ):
+        instance = AIAgent(
+            api_key="test-key", base_url="https://example.invalid/v1",
+            provider="openai-compat", model="test/model", quiet_mode=True,
+            skip_context_files=True, skip_memory=True,
+        )
+    instance._cached_system_prompt = "stable test prompt"
+    instance._session_db = None
+    instance.save_trajectories = False
+    instance.compression_enabled = False
+    instance._cleanup_task_resources = lambda *_a, **_kw: None
+    instance.valid_tool_names = {"todo_list"}
+    return instance
+
+
+@pytest.mark.parametrize("followup,append_footer,reused", [
+    ("", False, True),
+    ("Here is the answer.", False, False),
+    ("", True, False),
+])
+def test_housekeeping_reuse_requires_unchanged_fallback(agent, monkeypatch, followup, append_footer, reused):
+    answers = iter([_response("Here is the answer.", tool=True), _response(followup)])
+    agent._interruptible_api_call = lambda _kwargs: next(answers)
+    delivered = []
+    agent.interim_assistant_callback = lambda text, **_kw: delivered.append(text)
+    if append_footer:
+        monkeypatch.setattr(
+            "agent.turn_finalizer._append_file_mutation_footer",
+            lambda _agent, text, _logger: text + "\n\nAdditional note.",
+        )
+    with patch("hermes_cli.plugins.invoke_hook", return_value=[]):
+        result = agent.run_conversation("answer and update todos")
+
+    assert delivered == ["Here is the answer."]
+    assert result["response_reused"] is reused
+    assert result["final_response"] == "Here is the answer." + (
+        "\n\nAdditional note." if append_footer else ""
+    )
+    if not followup:
+        assert result["turn_exit_reason"] == "fallback_prior_turn_content"
+
+
+@pytest.mark.parametrize("previewed,append_footer,reused", [
+    (True, False, True), (False, False, False), (True, True, False),
+])
+def test_budget_candidate_reuse_requires_preview_and_unchanged_text(
+    agent, monkeypatch, previewed, append_footer, reused,
+):
+    agent.max_iterations = 1
+    agent.iteration_budget.max_total = 1
+    delivered = []
+
+    def model_call(_kwargs):
+        if previewed:
+            delivered.append("Here is the answer.")
+            agent._record_streamed_assistant_text("Here is the answer.")
+        return _response("Here is the answer.")
+
+    agent._interruptible_api_call = model_call
+    monkeypatch.setenv("HERMES_VERIFY_ON_STOP", "1")
+    if append_footer:
+        monkeypatch.setattr(
+            "agent.turn_finalizer._append_file_mutation_footer",
+            lambda _agent, text, _logger: text + "\n\nAdditional note.",
+        )
+    with (
+        patch("agent.verification_stop.build_verify_on_stop_nudge", return_value="verify it"),
+        patch("hermes_cli.plugins.invoke_hook", return_value=[]),
+    ):
+        result = agent.run_conversation("edit changed.py")
+
+    assert delivered == (["Here is the answer."] if previewed else [])
+    assert result["turn_exit_reason"] == "max_iterations_reached(1/1)"
+    assert result["response_reused"] is reused
+    assert result["final_response"] == "Here is the answer." + (
+        "\n\nAdditional note." if append_footer else ""
+    )
diff --git a/tests/tui_gateway/test_turn_payload_response_reused.py b/tests/tui_gateway/test_turn_payload_response_reused.py
new file mode 100644
index 00000000..f7d60704
--- /dev/null
+++ b/tests/tui_gateway/test_turn_payload_response_reused.py
@@ -0,0 +1,37 @@
+"""Completion events forward reuse provenance only for a nonempty final."""
+import contextlib
+from types import SimpleNamespace
+
+import pytest
+
+import tui_gateway.server as srv
+
+
+@pytest.mark.parametrize("text,flag,expected", [
+    ("Here is the answer.", True, True),
+    ("Here is the answer.", False, False),
+    ("Here is the answer.", None, False),
+    ("", True, False),
+])
+def test_complete_turn_payload_preserves_reuse_on_wire(monkeypatch, text, flag, expected):
+    monkeypatch.setattr(srv, "_get_usage", lambda _agent: {})
+    monkeypatch.setattr(srv, "render_message", lambda _text, _cols: None)
+    monkeypatch.setattr(srv, "_clear_inflight_turn", lambda _session: None)
+    agent = SimpleNamespace(_session_title_hint="Scratch")
+    result = {"final_response": text}
+    if flag is not None:
+        result["response_reused"] = flag
+    st = SimpleNamespace(
+        result=result, agent=agent, terminal_callback=None,
+        receipt_committed=True, receipt_attempted=False, marker_key="", error_retained=False,
+        error_detail="", prompt_text="ping",
+    )
+    session = {"pending_title": None, "session_key": "k",
+               "history_lock": contextlib.nullcontext(), "agent": agent}
+    payload, _, _ = srv._complete_turn_payload(session, st, None, 80)
+    frame = srv._event_frame("message.complete", "sid", payload)
+    for value in (payload, frame["params"]["payload"]):
+        if expected:
+            assert value["response_reused"] is True
+        else:
+            assert "response_reused" not in value
