+@pytest.mark.parametrize("path", ["store", "doctor"])
+def test_issue_836_failed_delete_rolls_back_bindings(tmp_path, path):
+    engine = _engine(tmp_path, session="active")
+    store = engine._store
+    try:
+        deleted = store.append("junk", _m("user", "delete"))
+        store.add_host_uid_bindings("home:root", [(deleted, "delete", "canonical", None)])
+        before = _bindings(engine)
+        store.connection.execute("CREATE TRIGGER reject_delete BEFORE DELETE ON messages "
+                                 "BEGIN SELECT RAISE(ABORT, 'delete failed'); END")
+        with pytest.raises(sqlite3.IntegrityError, match="delete failed"):
+            if path == "store":
+                store.delete_session_messages("junk")
+            else:
+                _delete_clean_candidates_atomically(engine, {"junk"})
+        assert not store.connection.in_transaction
+        assert _bindings(engine) == before
+        assert store.get_session_messages("junk")
+    finally:
+        engine.shutdown()
+
