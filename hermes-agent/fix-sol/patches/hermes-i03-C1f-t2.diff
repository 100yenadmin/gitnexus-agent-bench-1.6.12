+    @pytest.mark.parametrize("literal", [
+        '{"provider": "openai-codex", "default": "gpt-6.1-sol"}',
+        '{provider: openai-codex, default: gpt-6.1-sol}',
+        'provider: openai-codex\ndefault: gpt-6.1-sol',
+    ])
+    def test_model_mapping_requires_force(self, _isolated_hermes_home, capsys, literal):
+        self._write_config(_isolated_hermes_home, {
+            "model": {"default": "glm-5.3-flash", "provider": "zai"},
+        })
+        before = (_isolated_hermes_home / "config.yaml").read_bytes()
+
+        with pytest.raises(SystemExit) as exc:
+            set_config_value("model", literal)
+
+        assert exc.value.code == 1
+        message = capsys.readouterr().err
+        assert "model.provider" in message
+        assert "model.default" in message
+        assert "--force" in message
+        assert (_isolated_hermes_home / "config.yaml").read_bytes() == before
+
+    @pytest.mark.parametrize("literal", [
+        '{"provider": "openrouter", "default": "z-ai/glm-5.3-flash"}',
+        '{provider: openrouter, default: z-ai/glm-5.3-flash}',
+        'provider: openrouter\ndefault: z-ai/glm-5.3-flash',
+    ])
+    def test_model_mapping_force_replaces_section(self, _isolated_hermes_home, literal):
+        self._write_config(_isolated_hermes_home, {
+            "model": {
+                "default": "glm-5.3-flash", "provider": "zai",
+                "context_length": 128_000, "base_url": "https://old.example/v1",
+            },
+            "agent": {"max_turns": 42},
+        })
+
+        set_config_value("model", literal, force=True)
+
+        parsed = yaml.safe_load(_read_config(_isolated_hermes_home))
+        assert parsed == {
+            "model": {"provider": "openrouter", "default": "z-ai/glm-5.3-flash"},
+            "agent": {"max_turns": 42},
+        }
+
+    @pytest.mark.parametrize("key", ["model", "model.default"])
+    @pytest.mark.parametrize("model_id", ["gpt-5.6-sol", "z-ai/glm-5.3-flash"])
+    def test_plain_model_ids_preserve_provider(self, _isolated_hermes_home, key, model_id):
+        self._write_config(_isolated_hermes_home, {
