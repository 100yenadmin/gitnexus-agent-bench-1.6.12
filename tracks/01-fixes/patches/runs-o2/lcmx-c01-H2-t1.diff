+def test_tool_group_safe_end_outside_group():
+    messages = [_user("a"), _user("b"), _user("c")]
+    assert tool_group_safe_end(messages, 2) == 2
+
+
+def test_tool_group_safe_end_at_assistant_with_no_results():
+    messages = [
+        _user("old"),
+        {
+            "role": "assistant",
+            "content": "calling tools",
+            "tool_calls": [
+                {"id": "call-a", "function": {"name": "a", "arguments": "{}"}},
+            ],
+        },
+    ]
+    assert tool_group_safe_end(messages, 2) == 2
+
+
+def test_tool_group_safe_end_ends_inside_tool_results_with_prefix():
+    messages = [
+        _user("old"),
+        *_tool_group(payload_a="a " * 100, payload_b="b"),
+    ]
+    # Chunk ends after first tool result; should retreat to assistant
+    assert tool_group_safe_end(messages, 3) == 1
+
+
+def test_tool_group_safe_end_ends_at_assistant_of_tool_group():
+    messages = [
+        _user("old"),
+        *_tool_group(payload_a="a " * 100, payload_b="b"),
+    ]
+    # Chunk ends at assistant with tool_calls; should retreat
+    assert tool_group_safe_end(messages, 2) == 1
+
+
+def test_tool_group_safe_end_group_at_chunk_start_extends():
+    messages = _tool_group(payload_a="a " * 100, payload_b="b")
+    # Tool group starts at beginning of chunk; should extend through all results
+    assert tool_group_safe_end(messages, 2) == 3
+
+
