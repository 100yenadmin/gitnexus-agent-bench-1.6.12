diff --git a/servers/engine/tests/test_spell_attack_leg.py b/servers/engine/tests/test_spell_attack_leg.py
new file mode 100644
index 0000000..b429307
--- /dev/null
+++ b/servers/engine/tests/test_spell_attack_leg.py
@@ -0,0 +1,156 @@
+"""#1270: the attack-roll leg of a cast spell is part of the casting action.
+
+Guiding Bolt (srd, not auto-resolved) spends its slot + action in cast_spell and returns
+`automated: false, attack_roll: true`; the DM resolves the hit with attack(). The #778
+cast→attack gate used to refuse that strike, so the bolt dealt 0. Now cast_spell records
+`Combat.pending_spell_attack` and exactly ONE same-turn attack() by the caster on a listed
+target bypasses the gate; everything else stays refused."""
+
+import pytest
+
+import server
+import store
+from dice import DiceRoll
+from models import Combat
+
+
+def _d20_roll(natural: int):
+    def _roll(expression: str, advantage: bool = False, disadvantage: bool = False,
+              seed=None, crit_min: int = 20) -> DiceRoll:
+        if expression.startswith("1d20"):
+            mod = int(expression.split("+", 1)[1]) if "+" in expression else 0
+            return DiceRoll(
+                expression=expression, total=natural + mod, rolls=[natural], modifier=mod,
+                detail=f"{expression}[{natural}]", is_d20=True, natural=natural,
+                crit=(natural == 20), fumble=(natural == 1),
+            )
+        return DiceRoll(expression=expression, total=6, rolls=[3], detail=f"{expression}[3] = 6")
+    return _roll
+
+
+@pytest.fixture
+def fight(tmp_path, monkeypatch):
+    """Maren (Cleric, Guiding Bolt) is current; two goblins."""
+    monkeypatch.setenv("WORLDOS_STATE_DIR", str(tmp_path))
+    cid = server.create_campaign("GB1270")["id"]
+    maren = server.create_character(
+        cid, "Maren", kind="player", class_name="Cleric", apply_srd_defaults=True,
+        abilities={"wisdom": 16},
+    )["id"]
+    server.update_character(cid, maren, patch={"initiative_bonus": 100})
+    server.learn_spells(cid, maren, ["Guiding Bolt"])
+    server.prepare_spells(cid, maren, ["Guiding Bolt"])
+    g1 = server.create_character(cid, "Goblin A", kind="monster", max_hp=30, armor_class=10)["id"]
+    g2 = server.create_character(cid, "Goblin B", kind="monster", max_hp=30, armor_class=10)["id"]
+    server.start_combat(cid, [maren, g1, g2])
+    assert server.get_state(cid)["current_turn"] == maren
+    return cid, maren, g1, g2
+
+
+def _psa(cid):
+    return store.load_campaign(cid).combat.pending_spell_attack
+
+
+def _bolt(cid, maren, target):
+    out = server.cast_spell(cid, maren, "Guiding Bolt", target_id=target)
+    assert out["automated"] is False and out["attack_roll"] is True
+    return out
+
+
+def _strike(cid, attacker, target):
+    return server.attack(cid, attacker, target, attack_bonus=5, damage_dice="4d6",
+                         damage_type="radiant", is_ranged=True)
+
+
+def test_cast_records_pending_spell_attack(fight):
+    cid, maren, g1, _g2 = fight
+    _bolt(cid, maren, g1)
+    psa = _psa(cid)
+    assert psa is not None
+    assert psa.source_id == maren and psa.target_ids == [g1]
+    assert psa.spell == "Guiding Bolt" and psa.round == store.load_campaign(cid).combat.round
+
+
+def test_spell_attack_leg_bypasses_gate_and_deals_damage(fight, monkeypatch):
+    cid, maren, g1, _g2 = fight
+    _bolt(cid, maren, g1)
+    monkeypatch.setattr(server.dice_mod, "roll", _d20_roll(15))
+    res = _strike(cid, maren, g1)
+    assert res["hit"] is True
+    assert res["spell_attack_leg"] == "Guiding Bolt"
+    assert server.get_character(cid, g1)["current_hp"] < 30  # the bolt actually hurt
+    assert _psa(cid) is None  # one-shot: consumed
+    assert server.get_character(cid, maren)["pending_on_hit_riders"] == []
+
+
+def test_second_independent_attack_still_refused(fight, monkeypatch):
+    cid, maren, g1, _g2 = fight
+    _bolt(cid, maren, g1)
+    monkeypatch.setattr(server.dice_mod, "roll", _d20_roll(15))
+    _strike(cid, maren, g1)
+    with pytest.raises(ValueError, match="already cast a spell"):
+        _strike(cid, maren, g1)
+
+
+def test_attack_on_unlisted_target_refused(fight):
+    cid, maren, g1, g2 = fight
+    _bolt(cid, maren, g1)
+    with pytest.raises(ValueError, match="already cast a spell"):
+        _strike(cid, maren, g2)
+    assert _psa(cid) is not None  # a refused strike changes nothing
+
+
+def test_double_cast_still_refused(fight):
+    cid, maren, g1, _g2 = fight
+    _bolt(cid, maren, g1)
+    with pytest.raises(ValueError, match="already used its action"):
+        server.cast_spell(cid, maren, "Guiding Bolt", target_id=g1)
+
+
+def test_auto_resolved_spell_records_nothing_and_stays_refused(fight):
+    cid, maren, g1, _g2 = fight
+    server.learn_spells(cid, maren, ["Fire Bolt"])
+    out = server.cast_spell(cid, maren, "Fire Bolt", target_id=g1)
+    assert out["automated"] is True
+    assert _psa(cid) is None
+    with pytest.raises(ValueError, match="already cast a spell"):
+        _strike(cid, maren, g1)
+
+
+def test_other_attacker_cannot_use_the_record(fight):
+    cid, maren, g1, g2 = fight
+    _bolt(cid, maren, g1)
+    # Goblin B is off-turn: its strike is a reaction, never the spell leg; record untouched.
+    _strike(cid, g2, maren)
+    assert _psa(cid) is not None
+
+
+def test_next_turn_clears_record(fight):
+    cid, maren, g1, _g2 = fight
+    _bolt(cid, maren, g1)
+    server.next_turn(cid)
+    assert _psa(cid) is None
+
+
+def test_target_death_clears_riders_and_record(fight):
+    cid, maren, g1, _g2 = fight
+    _bolt(cid, maren, g1)
+    assert server.get_character(cid, maren)["pending_on_hit_riders"]
+    server.apply_damage(cid, g1, 100)
+    assert server.get_character(cid, g1)["dead"] is True
+    assert server.get_character(cid, maren)["pending_on_hit_riders"] == []
+    assert _psa(cid) is None
+
+
+def test_remove_combatant_clears_riders_and_record(fight):
+    cid, maren, g1, _g2 = fight
+    _bolt(cid, maren, g1)
+    server.remove_combatant(cid, g1)
+    assert server.get_character(cid, maren)["pending_on_hit_riders"] == []
+    assert _psa(cid) is None
+
+
+def test_old_snapshot_loads_with_none():
+    data = Combat().model_dump(mode="json")
+    data.pop("pending_spell_attack")
+    assert Combat.model_validate(data).pending_spell_attack is None
