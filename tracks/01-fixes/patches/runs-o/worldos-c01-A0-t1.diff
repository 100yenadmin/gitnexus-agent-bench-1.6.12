+def _whole_actions(c: "Campaign", actor: "Character") -> tuple[int, int, int]:
+    """#778: the current turn's action economy in WHOLE actions, shared by attack(),
+    cast_spell and use_action. Returns ``(per_action, total, spent)``:
+      * per_action — attacks one Attack action grants (Extra Attack / Multiattack aware);
+      * total — actions available this turn (1 + Action Surges spent);
+      * spent — actions already used: the Attack actions begun (attacks made, rounded up
+        to whole actions) or, with no attack made, 1 once action_used is set.
+    A non-attack action (a cast, a skip) is recorded by advancing action_attacks_made to
+    the next whole-action boundary, so the attack budget and this count stay one ledger."""
+    per = combat.attacks_allowed(
+        getattr(actor, "extra_attacks", 0), 0, _attacker_multiattack_count(actor, c)
+    )
+    total = 1 + max(0, int(c.combat.surge_actions))
+    made = max(0, int(c.combat.action_attacks_made))
+    spent = -(-made // per)
+    if c.combat.action_used:
+        spent = max(spent, 1)
+    return per, total, spent
+
+
+def _spend_whole_action(c: "Campaign", actor: "Character", purpose: str) -> None:
+    """#778: consume one whole action for a non-attack ``purpose`` ("cast" | "skip").
+    Caller has already checked one is available (spent < total)."""
+    per, total, spent = _whole_actions(c, actor)
+    c.combat.action_attacks_made = min(spent + 1, total) * per
+    c.combat.action_used = True
+    c.combat.action_purpose = purpose
+
