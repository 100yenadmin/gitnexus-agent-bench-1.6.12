+/**
+ * Validate the optional `list_repos` `name_contains` filter and apply it.
+ *
+ * @internal Exported for unit testing and for the repository-policy wrapper.
+ *
+ * Case-insensitive substring match on the repository name. An omitted value
+ * (only `undefined`) disables the filter; a non-string is REJECTED, matching
+ * the strictness of {@link parseListReposPagination}. Runs BEFORE slicing so
+ * the pagination object describes the filtered set.
+ */
+export function filterReposByName<T extends { name: string }>(
+  repos: T[],
+  params: { name_contains?: unknown } | null | undefined,
+): T[] {
+  const needle = params?.name_contains;
+  if (needle === undefined) return repos;
+  if (typeof needle !== 'string') {
+    throw new Error(
+      `list_repos: "name_contains" must be a string (received ${JSON.stringify(needle)})`,
+    );
+  }
+  const lowered = needle.toLowerCase();
+  if (lowered === '') return repos;
+  return repos.filter((repo) => repo.name.toLowerCase().includes(lowered));
+}
