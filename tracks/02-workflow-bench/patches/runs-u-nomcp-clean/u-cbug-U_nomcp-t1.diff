+/**
+ * Is `targetRaw` the angle-bracket spelling of a system include
+ * (`<stdio.h>`)?
+ *
+ * Quoted includes reach the resolver as their bare content (`util.h`); a
+ * system include keeps its brackets so the distinction survives to resolution
+ * — the same convention the Objective-C resolver uses. The decomposer strips
+ * the brackets into `@import.system`, and `interpretCImport` drops those
+ * imports today, so this is the resolver's own guarantee rather than a
+ * reliance on that upstream filter.
+ */
+export function isCSystemIncludeSpelling(targetRaw: string): boolean {
+  const target = targetRaw.trim();
+  return target.length >= 2 && target.startsWith('<') && target.endsWith('>');
+}
