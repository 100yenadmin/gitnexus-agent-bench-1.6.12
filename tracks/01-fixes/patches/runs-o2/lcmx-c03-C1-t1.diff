+@pytest.mark.parametrize("path", ["store", "doctor"])
+@pytest.mark.parametrize("with_bindings", [False, True])
+def test_issue_836_deletes_only_affected_bindings(tmp_path, path, with_bindings):
+    engine = _engine(tmp_path, session="active")
+    store = engine._store
+    try:
+        kept = store.append("active", _m("user", "keep"))
+        deleted = store.append("junk", _m("user", "delete"))
+        if with_bindings:
+            store.add_host_uid_bindings("home:root", [
+                (kept, "keep", "canonical", None),
+                (deleted, "delete", "canonical", None),
+                (deleted, "alias", "alias", None),
+            ])
+        if path == "store":
+            assert store.delete_session_messages("junk") == 1
+        else:
+            assert _delete_clean_candidates_atomically(engine, {"junk", "active"})["messages_deleted"] == 1
+        assert store.get_session_messages("active")
+        assert not store.get_session_messages("junk")
+        if with_bindings:
+            assert [(b[0], b[1]) for b in _bindings(engine)] == [(kept, "keep")]
+            # Reuse the id as a legacy INTEGER PRIMARY KEY store can do.
+            store.connection.execute(
+                "INSERT INTO messages(store_id, session_id, role, content, timestamp) VALUES (?, 'new', 'user', 'new', 1)",
+                (deleted,),
+            )
+            store.connection.commit()
+            assert store.host_uid_uids_of_stores("home:root", [deleted]) == {}
+        else:
+            assert not _has_table(engine)
+    finally:
+        engine.shutdown()
+
