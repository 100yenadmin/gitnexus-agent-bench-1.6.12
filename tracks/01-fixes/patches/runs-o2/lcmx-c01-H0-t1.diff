+def test_tool_group_safe_end_returns_unchanged_outside_group():
+    messages = [_user("old"), _user("new")]
+    assert tool_group_safe_end(messages, 2) == 2
+    assert tool_group_safe_end(messages, 1) == 1
+    assert tool_group_safe_end(messages, 0) == 0
+
+
+def test_tool_group_safe_end_returns_unchanged_empty_list():
+    messages = []
+    assert tool_group_safe_end(messages, 0) == 0
+    assert tool_group_safe_end(messages, 1) == 1
+
+
+def test_tool_group_safe_end_returns_unchanged_orphan_tool_result():
+    messages = [_user("old"), {"role": "tool", "tool_call_id": "missing", "content": "result"}]
+    assert tool_group_safe_end(messages, 2) == 2
+
+
+def test_tool_group_safe_end_retreats_to_assistant_when_in_middle_of_group():
+    messages = [_user("old"), *_tool_group(payload_a="a" * 100, payload_b="b")]
+    # messages[0] = user, messages[1] = assistant+toolcalls, messages[2] = tool(call-a), messages[3] = tool(call-b)
+    # If we stop at end=3, we're in the middle of the group (missing call-b result)
+    # Should retreat to index 1 (the assistant)
+    assert tool_group_safe_end(messages, 3) == 1
+
+
+def test_tool_group_safe_end_extends_when_group_at_start():
+    messages = _tool_group(payload_a="a" * 100, payload_b="b")
+    # messages[0] = assistant+toolcalls, messages[1] = tool(call-a), messages[2] = tool(call-b)
+    # If we stop at end=2, we're in the middle (missing call-b result)
+    # Since group starts at 0, should extend through all declared results
+    assert tool_group_safe_end(messages, 2) == 3
+
+
+def test_tool_group_safe_end_allows_complete_group():
+    messages = [_user("old"), *_tool_group(payload_a="a" * 100, payload_b="b")]
+    # If we include the complete group up to end=4, should return 4
+    assert tool_group_safe_end(messages, 4) == 4
+
+
+def test_tool_group_safe_end_handles_tool_result_without_id():
+    messages = [
+        _user("old"),
+        {
+            "role": "assistant",
+            "content": "calling tools",
+            "tool_calls": [{"id": "call-a", "function": {"name": "a", "arguments": "{}"}}],
+        },
+        {"role": "tool", "tool_call_id": None, "content": "result"},
+    ]
+    # Tool result without an id at position 2, should return unchanged
+    assert tool_group_safe_end(messages, 3) == 3
+
+
+def test_tool_group_safe_end_fixes_orphan_rows_on_leaf_chunk_cut():
+    """Verify the fix for issue #559: leaf chunk cut in middle of tool group."""
+    messages = [
+        _user("context " * 100),
+        *_tool_group(payload_a="a" * 1000, payload_b="b" * 1000),
+    ]
+    # messages[0] = user, messages[1] = assistant+toolcalls, messages[2] = tool, messages[3] = tool
+    # If we simulate a greedy token-based selection that stops at end=3 (missing the last tool result),
+    # tool_group_safe_end should retreat to keep the group intact
+    safe_end = tool_group_safe_end(messages, 3)
+    # Should either retreat to the assistant (1) or extend to include all results (4)
+    assert safe_end in (1, 4)
+    # In this case since the group doesn't start at 0, it should retreat to assistant
+    assert safe_end == 1
