index 0000000..d7d4740
--- /dev/null
+++ b/servers/engine/tests/test_action_economy_shared.py
@@ -0,0 +1,212 @@
+"""#778: the turn's action is ONE shared resource across cast_spell / attack / use_action,
+decided by the spell's casting time (curated "1 bonus action" and SRD "bonus-action" alike)."""
+import pytest
+
+import combat
+import store
+from models import Combat
+
+
+@pytest.fixture
+def server(tmp_path, monkeypatch):
+    monkeypatch.setenv("WORLDOS_STATE_DIR", str(tmp_path))
+    import server as srv
+    return srv
+
+
+def _fight(server):
+    cid = server.create_campaign("economy")["id"]
+    ids = [
+        server.create_character(cid, n, kind=k, max_hp=30, armor_class=12)["id"]
+        for n, k in (("A", "player"), ("B", "player"), ("M", "monster"))
+    ]
+    server.start_combat(cid, ids)
+    cur = server.get_state(cid)["current_turn"]
+    other = next(i for i in ids if i != cur)
+    # Level-1 slots for the curated Healing Word (leveled SRD-only spells cast innate=True).
+    server.update_character(cid, cur, {"spell_slots": {"1": {"maximum": 4, "used": 0}}})
+    return cid, cur, other
+
+
+def _swing(server, cid, cur, other):
+    return server.attack(cid, cur, other, attack_bonus=5, damage_dice="1d6")
+
+
+# --- pure helpers ---------------------------------------------------------------------
+@pytest.mark.parametrize("ct,expected", [
+    ("1 action", "action"), ("action", "action"), ("", "action"), (None, "action"),
+    ("1 bonus action", "bonus"), ("bonus-action", "bonus"),
+    ("1 reaction", "reaction"), ("reaction", "reaction"),
+    ("1 minute", "long"), ("minute", "long"), ("10 minutes", "long"), ("hour", "long"),
+])
+def test_spell_casting_cost_classifies_both_spellings(ct, expected):
+    assert combat.spell_casting_cost(ct) == expected
+
+
+def test_actions_spent_counts_attack_chunks_and_bare_actions():
+    assert combat.actions_spent(action_used=False, attacks_made=0, per_action=2) == 0
+    assert combat.actions_spent(action_used=True, attacks_made=0, per_action=2) == 1
+    assert combat.actions_spent(action_used=True, attacks_made=1, per_action=2) == 1
+    assert combat.actions_spent(action_used=True, attacks_made=3, per_action=2) == 2
+
+
+def test_old_snapshot_loads_action_purpose_default():
+    cb = Combat.model_validate({"active": True, "action_used": True})
+    assert cb.action_purpose == ""
+
+
+# --- too permissive -------------------------------------------------------------------
+def test_cast_then_cast_rejected(server):
+    cid, cur, other = _fight(server)
+    server.cast_spell(cid, cur, "Fire Bolt", target_id=other)
+    with pytest.raises(ValueError, match="already used its action"):
+        server.cast_spell(cid, cur, "Fire Bolt", target_id=other)
+
+
+def test_cast_then_attack_rejected(server):
+    cid, cur, other = _fight(server)
+    server.cast_spell(cid, cur, "Fire Bolt", target_id=other)
+    with pytest.raises(ValueError, match="already cast a spell"):
+        _swing(server, cid, cur, other)
+
+
+def test_attack_then_cast_rejected(server):
+    cid, cur, other = _fight(server)
+    _swing(server, cid, cur, other)
+    with pytest.raises(ValueError, match="already used its action"):
+        server.cast_spell(cid, cur, "Fire Bolt", target_id=other)
+
+
+def test_extra_attack_partial_then_cast_rejected(server):
+    cid, cur, other = _fight(server)
+    server.update_character(cid, cur, {"extra_attacks": 1})
+    _swing(server, cid, cur, other)  # 1 of 2 strikes — the Attack action is still spent
+    with pytest.raises(ValueError, match="already used its action"):
+        server.cast_spell(cid, cur, "Fire Bolt", target_id=other)
+
+
+def test_skip_then_attack_rejected(server):
+    cid, cur, other = _fight(server)
+    assert server.use_action(cid, cur, "skip")["ok"] is True
+    with pytest.raises(ValueError, match="skipped this turn"):
+        _swing(server, cid, cur, other)
+
+
+def test_skip_then_cast_rejected(server):
+    cid, cur, other = _fight(server)
+    server.use_action(cid, cur, "skip")
+    with pytest.raises(ValueError, match="already used its action"):
+        server.cast_spell(cid, cur, "Fire Bolt", target_id=other)
+
+
+def test_rejected_cast_spends_nothing(server):
+    cid, cur, other = _fight(server)
+    _swing(server, cid, cur, other)
+    before = store.load_campaign(cid).combat.model_dump()
+    with pytest.raises(ValueError):
+        server.cast_spell(cid, cur, "Fire Bolt", target_id=other)
+    assert store.load_campaign(cid).combat.model_dump() == before
+
+
+# --- too restrictive ------------------------------------------------------------------
+def test_bonus_action_spell_spends_only_the_bonus_action(server):
+    cid, cur, other = _fight(server)
+    server.cast_spell(cid, cur, "Healing Word", target_id=other)
+    cb = store.load_campaign(cid).combat
+    assert cb.bonus_action_used is True and cb.action_used is False
+    assert cb.action_purpose == ""
+    assert server.use_action(cid, cur, "action")["ok"] is True
+
+
+def test_bonus_action_spell_then_action_spell(server):
+    cid, cur, other = _fight(server)
+    server.cast_spell(cid, cur, "Healing Word", target_id=other)  # curated "1 bonus action"
+    server.cast_spell(cid, cur, "Fireball", innate=True)  # SRD "action"
+    cb = store.load_campaign(cid).combat
+    assert cb.action_used and cb.bonus_action_used and cb.action_purpose == "cast"
+
+
+def test_srd_bonus_action_spelling_counts(server):
+    cid, cur, other = _fight(server)
+    server.cast_spell(cid, cur, "Misty Step", innate=True)  # SRD "bonus-action"
+    cb = store.load_campaign(cid).combat
+    assert cb.bonus_action_used is True and cb.action_used is False
+    _swing(server, cid, cur, other)  # action still free
+    with pytest.raises(ValueError, match="bonus action"):
+        server.cast_spell(cid, cur, "Healing Word", target_id=other)
+
+
+def test_bonus_spell_then_attack_ok(server):
+    cid, cur, other = _fight(server)
+    server.cast_spell(cid, cur, "Healing Word", target_id=other)
+    assert _swing(server, cid, cur, other)["attacks_made_this_turn"] == 1
+
+
+# --- casting time / Action Surge / generic action ---------------------------------------
+def test_minute_cast_rejected_in_combat(server):
+    cid, cur, other = _fight(server)
+    before = store.load_campaign(cid).combat.model_dump()
+    with pytest.raises(ValueError, match="casting time"):
+        server.cast_spell(cid, cur, "Animate Dead", innate=True)  # SRD "minute"
+    with pytest.raises(ValueError, match="casting time"):
+        server.cast_spell(cid, cur, "Clone", innate=True)  # SRD "hour"
+    assert store.load_campaign(cid).combat.model_dump() == before
+
+
+def test_action_surge_allows_one_more_action(server):
+    cid, cur, other = _fight(server)
+    server.set_class_resource(cid, cur, "action_surge", max=1, recharge="short")
+    server.cast_spell(cid, cur, "Fire Bolt", target_id=other)
+    server.use_resource(cid, cur, "action_surge")
+    _swing(server, cid, cur, other)  # the surged action is an Attack action
+    with pytest.raises(ValueError):
+        _swing(server, cid, cur, other)
+    with pytest.raises(ValueError, match="already used its action"):
+        server.cast_spell(cid, cur, "Fire Bolt", target_id=other)
+
+
+def test_action_surge_allows_attack_then_cast(server):
+    cid, cur, other = _fight(server)
+    server.set_class_resource(cid, cur, "action_surge", max=1, recharge="short")
+    _swing(server, cid, cur, other)
+    server.use_resource(cid, cur, "action_surge")
+    server.cast_spell(cid, cur, "Fire Bolt", target_id=other)
+    with pytest.raises(ValueError, match="already cast a spell"):
+        _swing(server, cid, cur, other)
+
+
+def test_action_surge_allows_two_casts(server):
+    cid, cur, other = _fight(server)
+    server.set_class_resource(cid, cur, "action_surge", max=1, recharge="short")
+    server.cast_spell(cid, cur, "Fire Bolt", target_id=other)
+    server.use_resource(cid, cur, "action_surge")
+    server.cast_spell(cid, cur, "Fire Bolt", target_id=other)
+    with pytest.raises(ValueError, match="already used its action"):
+        server.cast_spell(cid, cur, "Fire Bolt", target_id=other)
+
+
+def test_generic_action_then_attacks_still_work(server):
+    cid, cur, other = _fight(server)
+    server.update_character(cid, cur, {"extra_attacks": 1})
+    assert server.use_action(cid, cur, "action")["ok"] is True
+    _swing(server, cid, cur, other)
+    assert _swing(server, cid, cur, other)["attacks_made_this_turn"] == 2
+    with pytest.raises(ValueError, match="already used its action"):
+        server.cast_spell(cid, cur, "Fire Bolt", target_id=other)
+
+
+def test_next_turn_resets_action_purpose(server):
+    cid, cur, other = _fight(server)
+    server.cast_spell(cid, cur, "Fire Bolt", target_id=other)
+    assert store.load_campaign(cid).combat.action_purpose == "cast"
+    server.next_turn(cid)
+    cb = store.load_campaign(cid).combat
+    assert cb.action_purpose == "" and cb.action_used is False and cb.action_attacks_made == 0
+
+
+def test_cast_outside_combat_is_unaffected(server):
+    cid = server.create_campaign("calm")["id"]
+    w = server.create_character(cid, "W", kind="player", max_hp=10)["id"]
+    server.cast_spell(cid, w, "Fire Bolt")
+    server.cast_spell(cid, w, "Fire Bolt")
+    server.cast_spell(cid, w, "Animate Dead", innate=True)  # minute cast fine out of combat
