@@ -50,6 +50,50 @@ def _assistant_group_start(messages: Sequence[Dict[str, Any]], start: int) -> in
     return start
 
 
+def tool_group_safe_end(messages: Sequence[Dict[str, Any]], end: int) -> int:
+    """Move a prefix cut ``messages[:end]`` out of any assistant/tool group.
+
+    A group is an assistant row with ``tool_calls`` followed by its contiguous
+    tool results.  When the cut lands inside a group, retreat to the group's
+    assistant row; when that would empty the prefix, extend through the
+    group's declared results instead.  Unattributable groups (a result without
+    a ``tool_call_id`` or with an id the assistant did not declare) and cuts
+    outside any group return ``end`` unchanged.
+    """
+    message_count = len(messages)
+    if end <= 0 or end >= message_count:
+        return end
+    if messages[end].get("role") != "tool":
+        return end
+
+    group_start = -1
+    for index in range(end - 1, -1, -1):
+        role = str(messages[index].get("role") or "")
+        if role == "tool":
+            continue
+        if role == "assistant" and messages[index].get("tool_calls"):
+            group_start = index
+        break
+    if group_start < 0:
+        return end
+
+    declared = {
+        _tool_call_id(tool_call)
+        for tool_call in (messages[group_start].get("tool_calls") or [])
+    }
+    declared.discard("")
+    group_end = group_start + 1
+    while group_end < message_count and messages[group_end].get("role") == "tool":
+        result_id = str(messages[group_end].get("tool_call_id") or "").strip()
+        if not result_id or result_id not in declared:
+            return end
+        group_end += 1
+
+    if group_start > 0:
+        return group_start
+    return group_end
+
+
