@@ -0,0 +1,142 @@
+/**
+ * Bounded per-file retry for transient parse-worker failures.
+ *
+ * When a worker dies with a file attributed as in flight, the pool used to
+ * quarantine that file on the first death. A death is not always the file's
+ * fault, though: a worker can be OOM-killed for heap accumulated across earlier
+ * files, or hit a host-level resource hiccup (EAGAIN, EMFILE, ENOMEM). Those
+ * failures deserve another attempt on a fresh worker. A deterministic parse
+ * error — a JS throw on the file's own content, a malformed or undeserializable
+ * result — fails identically on every attempt, so it is quarantined at once.
+ *
+ * This module holds the pure decision (classify → retry or fail → backoff) so
+ * it can be unit-tested without spawning workers; `worker-pool.ts` owns the
+ * side effects (respawn, requeue, quarantine).
+ */
+
+/** Retries granted to a file after its first transient failure. */
+export const MAX_PARSE_RETRIES = 2;
+export const PARSE_RETRY_BACKOFF_BASE_MS = 250;
+export const PARSE_RETRY_BACKOFF_CAP_MS = 2_000;
+
+/**
+ * Where the pool observed the failure. Maps 1:1 onto the pool's death sites.
+ *  - `error-message`: the worker caught a throw and reported `{type:'error'}`.
+ *  - `error-event`:   an uncaught worker throw / async rejection.
+ *  - `exit`:          the worker thread exited mid-job (native crash, OOM kill).
+ *  - `messageerror`:  the result payload could not be deserialized.
+ *  - `malformed-message`: the worker sent a message with no type discriminant.
+ */
+export type ParseFailureSource =
+  | 'error-message'
+  | 'error-event'
+  | 'exit'
+  | 'messageerror'
+  | 'malformed-message';
+
+export interface ParseFailure {
+  source: ParseFailureSource;
+  message?: string;
+  /** `Error.code` (string) or exit code (number), when known. */
+  code?: string | number;
+}
+
+export type ParseFailureKind = 'transient' | 'deterministic';
+
+/**
+ * Error codes / message markers that describe the environment rather than the
+ * file: resource exhaustion, fork throttling, interrupted syscalls, a worker
+ * heap cap hit after accumulating earlier files' state.
+ */
+const TRANSIENT_CODES = new Set([
+  'EAGAIN',
+  'EBUSY',
+  'EMFILE',
+  'ENFILE',
+  'ENOMEM',
+  'EINTR',
+  'ETIMEDOUT',
+  'ECONNRESET',
+  'EPIPE',
+  'ERR_WORKER_OUT_OF_MEMORY',
+]);
+const TRANSIENT_MESSAGE_PATTERN = new RegExp(
+  `\\b(${[...TRANSIENT_CODES].join('|')})\\b|out of memory|heap out of memory|resource temporarily unavailable|too many open files`,
+  'i',
+);
+
+/**
+ * Classify a worker failure. Transient signals win; otherwise a process-level
+ * `exit` carries no evidence about the file and is treated as transient, while
+ * every JS-visible failure (a throw on the file's content, a malformed or
+ * undeserializable result) is deterministic — rerunning the same input on a
+ * fresh worker reproduces it.
+ */
+export function classifyParseFailure(failure: ParseFailure): ParseFailureKind {
+  if (typeof failure.code === 'string' && TRANSIENT_CODES.has(failure.code)) return 'transient';
+  if (failure.message !== undefined && TRANSIENT_MESSAGE_PATTERN.test(failure.message)) {
+    return 'transient';
+  }
+  return failure.source === 'exit' ? 'transient' : 'deterministic';
+}
+
+/**
+ * Whether a file that has already been retried `retriesSoFar` times should be
+ * retried again after a failure of `kind`.
+ */
+export function shouldRetryParseFailure(
+  kind: ParseFailureKind,
+  retriesSoFar: number,
+  maxRetries: number = MAX_PARSE_RETRIES,
+): boolean {
+  return kind === 'transient' && retriesSoFar < maxRetries;
+}
+
+/**
+ * Capped exponential backoff with equal jitter for retry number `retry`
+ * (1-based): half the ceiling is fixed so a retry always waits, the other half
+ * is random so workers that failed together don't respawn in lockstep.
+ */
+export function parseRetryBackoffMs(retry: number, random: () => number = Math.random): number {
+  const ceil = Math.min(
+    PARSE_RETRY_BACKOFF_CAP_MS,
+    PARSE_RETRY_BACKOFF_BASE_MS * 2 ** Math.max(0, retry - 1),
+  );
+  const half = Math.floor(ceil / 2);
+  return half + Math.floor(random() * (ceil - half + 1));
+}
+
+export type ParseRetryDecision =
+  | { action: 'retry'; kind: 'transient'; retry: number; delayMs: number }
+  | { action: 'fail'; kind: ParseFailureKind; retries: number };
+
+export interface ParseRetryTracker {
+  /** Record a failure attributed to `path` and decide what to do with it. */
+  recordFailure(path: string, failure: ParseFailure): ParseRetryDecision;
+  /** Retries already granted to `path`. */
+  retriesFor(path: string): number;
+}
+
+/**
+ * Per-dispatch retry ledger. A file is retried at most `maxRetries` times
+ * (so attempted at most `maxRetries + 1` times) before it is marked failed.
+ */
+export function createParseRetryTracker(
+  maxRetries: number = MAX_PARSE_RETRIES,
+  random: () => number = Math.random,
+): ParseRetryTracker {
+  const retries = new Map<string, number>();
+  return {
+    recordFailure(path, failure) {
+      const kind = classifyParseFailure(failure);
+      const soFar = retries.get(path) ?? 0;
+      if (kind === 'transient' && shouldRetryParseFailure(kind, soFar, maxRetries)) {
+        const retry = soFar + 1;
+        retries.set(path, retry);
+        return { action: 'retry', kind, retry, delayMs: parseRetryBackoffMs(retry, random) };
+      }
+      return { action: 'fail', kind, retries: soFar };
+    },
+    retriesFor: (path) => retries.get(path) ?? 0,
+  };
+}
