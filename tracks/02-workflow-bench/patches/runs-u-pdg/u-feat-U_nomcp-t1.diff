+/**
+ * Validate the optional `name_contains` filter of the `list_repos` tool and
+ * return the lower-cased needle, or `undefined` when no filter applies.
+ *
+ * @internal Exported for unit testing; not part of the public API surface.
+ *
+ * Same validation boundary as {@link parseListReposPagination}: only an omitted
+ * value (`undefined`) means "no filter"; any non-string is rejected. An empty
+ * string matches every name, so it is treated as no filter.
+ */
+export function parseListReposNameFilter(
+  params: { name_contains?: unknown } | null | undefined,
+): string | undefined {
+  const value = params?.name_contains;
+  if (value === undefined) return undefined;
+  if (typeof value !== 'string') {
+    throw new Error(
+      `list_repos: "name_contains" must be a string (received ${JSON.stringify(value)})`,
+    );
+  }
+  return value === '' ? undefined : value.toLowerCase();
+}
+
+/**
+ * Keep only repositories whose name contains `needle` (case-insensitive).
+ * `needle` must already be lower-cased by {@link parseListReposNameFilter}.
+ * Applied BEFORE pagination so `total`/`hasMore`/`nextOffset` describe the
+ * filtered set.
+ *
+ * @internal Exported for unit testing; not part of the public API surface.
+ */
+export function filterReposByName<T extends { name: string }>(
+  repos: T[],
+  needle: string | undefined,
+): T[] {
+  if (needle === undefined) return repos;
+  return repos.filter((repo) => repo.name.toLowerCase().includes(needle));
+}
