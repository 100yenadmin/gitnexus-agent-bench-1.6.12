+def _coerce_query_text(value: Any) -> str:
+    """Normalize a model-supplied query argument to stripped text.
+
+    Models sometimes send ``null`` (common right after compaction) or a bare
+    number. ``None`` becomes empty so callers report "No query provided";
+    other scalars such as ``0`` are searched as their text form.
+    """
+    if value is None:
+        return ""
+    if isinstance(value, bytes):
+        value = value.decode("utf-8", errors="replace")
+    return str(value).strip()
+
+
 def _parse_non_negative_int(value: Any, default: int) -> int:
     return max(0, _parse_int_value(value, default))
 
