+@pytest.mark.parametrize("mode", ["full_text", "semantic", "hybrid"])
+@pytest.mark.parametrize("query", [None, "", "   "], ids=["null", "empty", "blank"])
+def test_missing_or_null_query_returns_documented_error_in_every_mode(
+    semantic_engine, monkeypatch, mode, query
+):
+    provider = MockProvider()
+    monkeypatch.setattr(lcm_tools, "resolve_provider", lambda _config: provider)
+
+    for args in ({"query": query, "mode": mode}, {"mode": mode}):
+        payload = json.loads(lcm_tools.lcm_grep(args, engine=semantic_engine))
+        assert payload == {"error": "No query provided"}
+    assert provider.queries == []
+
+
+@pytest.mark.parametrize("mode", ["full_text", "semantic", "hybrid"])
+@pytest.mark.parametrize("query", [0, 0.0, 42], ids=["int-zero", "float-zero", "int"])
+def test_numeric_query_is_searched_as_text_in_every_mode(
+    semantic_engine, monkeypatch, mode, query
+):
+    semantic_engine._store.append(
+        "session-a",
+        {"role": "user", "content": f"ticket number {query} reported"},
+    )
+    provider = MockProvider()
+    monkeypatch.setattr(lcm_tools, "resolve_provider", lambda _config: provider)
+
+    payload = json.loads(
+        lcm_tools.lcm_grep({"query": query, "mode": mode}, engine=semantic_engine)
+    )
+
+    assert "error" not in payload, payload
+    assert payload["query"] == str(query)
+    if isinstance(query, int):
+        assert any(str(query) in json.dumps(hit) for hit in payload["results"])
+    if mode != "full_text":
+        assert provider.queries == [str(query)]
+
+
