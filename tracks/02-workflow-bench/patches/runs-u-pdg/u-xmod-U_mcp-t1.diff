+++ b/gitnexus/src/core/ingestion/workers/parse-retry.ts
@@ -0,0 +1,211 @@
+/**
+ * Bounded per-file retry for parse-worker failures.
+ *
+ * When a worker dies while a specific file is in flight, the pool used to
+ * quarantine that file on the first death. That is right for a deterministic
+ * failure (the same input reproduces the same throw on every attempt) but
+ * wrong for a transient one — a worker killed by the OS, a native crash under
+ * memory pressure, an `EMFILE`/`EAGAIN` from a shard write — where a second
+ * attempt on a fresh worker usually succeeds. This module decides which is
+ * which and how long to back off before the retry. It is pure (no timers, no
+ * pool state beyond the per-path counter) so the decision is unit-testable
+ * without spinning up workers.
+ */
+
+/** Retries granted to a file after its first transient failure. */
+export const DEFAULT_MAX_PARSE_RETRIES = 2;
+/** Backoff before the first retry; doubles per retry up to the cap. */
+export const DEFAULT_PARSE_RETRY_BASE_DELAY_MS = 250;
+export const DEFAULT_PARSE_RETRY_MAX_DELAY_MS = 5_000;
+
+/** Which pool death site observed the failure. */
+export type ParseFailureSource =
+  /** Worker caught its own throw and reported `{type:'error'}`. */
+  | 'worker-error-message'
+  /** Node `error` event — an uncaught worker throw. */
+  | 'uncaught-error'
+  /** Worker thread exited (native crash, OOM kill, external signal). */
+  | 'exit'
+  /** Receiver-side postMessage deserialization failure. */
+  | 'messageerror'
+  /** Worker sent a message without a `type` discriminant. */
+  | 'malformed-message';
+
+export interface ParseFailure {
+  source: ParseFailureSource;
+  /** Error message (or exit description) as observed by the pool. */
+  message?: string;
+  /** `err.code` when the failure carried one (e.g. `ERR_WORKER_OUT_OF_MEMORY`). */
+  code?: string;
+  /** Worker-side stack; its first line names the error type. */
+  stack?: string;
+}
+
+export type ParseFailureClass = 'transient' | 'deterministic';
+
+/**
+ * OS-level errno codes that describe resource contention rather than the
+ * input itself — a retry on a fresh worker can succeed.
+ */
+const TRANSIENT_ERRNO_CODES = [
+  'EAGAIN',
+  'EBUSY',
+  'EMFILE',
+  'ENFILE',
+  'ENOMEM',
+  'ETIMEDOUT',
+  'ECONNRESET',
+  'EPIPE',
+  'EINTR',
+];
+const TRANSIENT_ERRNO_RE = new RegExp(`\\b(?:${TRANSIENT_ERRNO_CODES.join('|')})\\b`);
+
+/**
+ * Failures that reproduce on the same input: JS error types thrown by the
+ * parser/extractors, and the worker hitting its own heap cap (the file is too
+ * large for the cap — retrying only burns another worker).
+ */
+const DETERMINISTIC_ERROR_NAME_RE =
+  /^(?:SyntaxError|TypeError|RangeError|ReferenceError|URIError|EvalError|ParseError)\b/;
+const DETERMINISTIC_MESSAGE_RE =
+  /ERR_WORKER_OUT_OF_MEMORY|Maximum call stack size exceeded|\bparse error\b|\bfailed to parse\b|\bunsupported language\b/i;
+
+/**
+ * Classify a worker failure as transient (worth retrying the in-flight file)
+ * or deterministic (retrying the same input would fail the same way).
+ *
+ * Order matters: an explicit transient errno wins over everything (an
+ * `EMFILE` surfaced as a thrown Error is still contention), then known
+ * deterministic signatures, then a per-source default.
+ */
+export function classifyParseFailure(failure: ParseFailure): ParseFailureClass {
+  const message = failure.message ?? '';
+  const firstStackLine = (failure.stack ?? '').split('\n', 1)[0] ?? '';
+
+  if (failure.code === 'ERR_WORKER_OUT_OF_MEMORY') return 'deterministic';
+  if (
+    (failure.code !== undefined && TRANSIENT_ERRNO_CODES.includes(failure.code)) ||
+    TRANSIENT_ERRNO_RE.test(message) ||
+    TRANSIENT_ERRNO_RE.test(firstStackLine)
+  ) {
+    return 'transient';
+  }
+  if (DETERMINISTIC_MESSAGE_RE.test(message) || DETERMINISTIC_MESSAGE_RE.test(firstStackLine)) {
+    return 'deterministic';
+  }
+  if (
+    DETERMINISTIC_ERROR_NAME_RE.test(firstStackLine) ||
+    DETERMINISTIC_ERROR_NAME_RE.test(message)
+  ) {
+    return 'deterministic';
+  }
+
+  switch (failure.source) {
+    // The worker survived long enough to catch and report its own throw:
+    // the parse code rejected this input, and will again.
+    case 'worker-error-message':
+    // A protocol bug or an unclonable payload is a property of the code /
+    // the produced result, not of the moment it ran.
+    case 'malformed-message':
+    case 'messageerror':
+      return 'deterministic';
+    // The thread vanished without a JS-level explanation (native crash,
+    // OOM-killer, external signal) or threw something unrecognized —
+    // give the file another chance on a fresh worker.
+    case 'exit':
+    case 'uncaught-error':
+      return 'transient';
+  }
+}
+
+export interface ParseRetryPolicy {
+  /** Retries after the first failure; 0 disables retry. */
+  maxRetries: number;
+  baseDelayMs: number;
+  maxDelayMs: number;
+}
+
+export const DEFAULT_PARSE_RETRY_POLICY: ParseRetryPolicy = {
+  maxRetries: DEFAULT_MAX_PARSE_RETRIES,
+  baseDelayMs: DEFAULT_PARSE_RETRY_BASE_DELAY_MS,
+  maxDelayMs: DEFAULT_PARSE_RETRY_MAX_DELAY_MS,
+};
+
+/**
+ * Exponential backoff for the `retryNumber`-th retry (1-based), capped at
+ * `maxDelayMs`. `random` (0..1) applies "equal jitter": the delay lands in
+ * `[d/2, d]` so concurrent retries from different slots don't line up, while
+ * never collapsing to zero.
+ */
+export function parseRetryBackoffMs(
+  retryNumber: number,
+  policy: Pick<ParseRetryPolicy, 'baseDelayMs' | 'maxDelayMs'> = DEFAULT_PARSE_RETRY_POLICY,
+  random: () => number = Math.random,
+): number {
+  if (policy.baseDelayMs <= 0) return 0;
+  const exponent = Math.max(0, retryNumber - 1);
+  const raw = Math.min(policy.maxDelayMs, policy.baseDelayMs * 2 ** exponent);
+  const half = raw / 2;
+  return Math.round(half + half * Math.min(1, Math.max(0, random())));
+}
+
+export type ParseRetryDecision =
+  | { retry: true; retryNumber: number; delayMs: number }
+  | { retry: false; reason: 'deterministic' | 'retries-exhausted' };
+
+/**
+ * Decide whether a file that just failed should be retried.
+ *
+ * @param priorRetries retries already spent on this file (0 on first failure).
+ */
+export function decideParseRetry(
+  failureClass: ParseFailureClass,
+  priorRetries: number,
+  policy: ParseRetryPolicy = DEFAULT_PARSE_RETRY_POLICY,
+  random: () => number = Math.random,
+): ParseRetryDecision {
+  if (failureClass === 'deterministic') return { retry: false, reason: 'deterministic' };
+  if (priorRetries >= policy.maxRetries) return { retry: false, reason: 'retries-exhausted' };
+  const retryNumber = priorRetries + 1;
+  return { retry: true, retryNumber, delayMs: parseRetryBackoffMs(retryNumber, policy, random) };
+}
+
+/**
+ * Session-scoped per-path retry counter. Like the quarantine, it lives for
+ * one `createWorkerPool` invocation, so a file's retry budget is spent at
+ * most once per pool.
+ */
+export interface ParseRetryTracker {
+  /**
+   * Record a failure of `path` and return the decision. A `retry: true`
+   * decision consumes one retry from the path's budget.
+   */
+  onFailure(path: string, failure: ParseFailure): ParseRetryDecision;
+  /** Retries already spent on `path`. */
+  retriesFor(path: string): number;
+  /** Total retries granted across all paths. */
+  readonly totalRetries: number;
+}
+
+export function createParseRetryTracker(
+  policy: ParseRetryPolicy = DEFAULT_PARSE_RETRY_POLICY,
+  random: () => number = Math.random,
+): ParseRetryTracker {
+  const retries = new Map<string, number>();
+  let total = 0;
+  return {
+    onFailure(path, failure) {
+      const prior = retries.get(path) ?? 0;
+      const decision = decideParseRetry(classifyParseFailure(failure), prior, policy, random);
+      if (decision.retry) {
+        retries.set(path, decision.retryNumber);
+        total++;
+      }
+      return decision;
+    },
+    retriesFor: (path) => retries.get(path) ?? 0,
+    get totalRetries() {
+      return total;
+    },
+  };
+}
