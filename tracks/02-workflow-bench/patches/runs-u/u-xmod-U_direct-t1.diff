diff --git a/gitnexus/test/unit/parse-retry.test.ts b/gitnexus/test/unit/parse-retry.test.ts
new file mode 100644
index 0000000..361faf5
--- /dev/null
+++ b/gitnexus/test/unit/parse-retry.test.ts
@@ -0,0 +1,210 @@
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { EventEmitter } from 'node:events';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { pathToFileURL } from 'node:url';
+import type { Worker } from 'node:worker_threads';
+import {
+  decideParseRetry,
+  isTransientParseFailure,
+  MAX_TRANSIENT_PARSE_RETRIES,
+  parseRetryBackoffMs,
+  type ParseWorkerFailureKind,
+} from '../../src/core/ingestion/workers/parse-retry.js';
+import { createWorkerPool } from '../../src/core/ingestion/workers/worker-pool.js';
+
+const TRANSIENT: ParseWorkerFailureKind[] = ['worker-exit', 'worker-oom'];
+const DETERMINISTIC: ParseWorkerFailureKind[] = [
+  'worker-reported-error',
+  'uncaught-error',
+  'message-error',
+  'malformed-message',
+];
+
+describe('isTransientParseFailure', () => {
+  it.each(TRANSIENT)('classifies %s as transient', (kind) => {
+    expect(isTransientParseFailure(kind)).toBe(true);
+  });
+
+  it.each(DETERMINISTIC)('classifies %s as deterministic', (kind) => {
+    expect(isTransientParseFailure(kind)).toBe(false);
+  });
+});
+
+describe('parseRetryBackoffMs', () => {
+  it('grows exponentially from the base delay', () => {
+    expect(parseRetryBackoffMs(1)).toBe(250);
+    expect(parseRetryBackoffMs(2)).toBe(500);
+    expect(parseRetryBackoffMs(3)).toBe(1000);
+  });
+
+  it('is capped', () => {
+    expect(parseRetryBackoffMs(10)).toBe(2000);
+  });
+});
+
+describe('decideParseRetry', () => {
+  it('allows two retries by default', () => {
+    expect(MAX_TRANSIENT_PARSE_RETRIES).toBe(2);
+  });
+
+  it.each(TRANSIENT)('retries a transient %s failure with backoff', (kind) => {
+    expect(decideParseRetry({ kind, priorRetries: 0, poolHasHeadroom: true })).toEqual({
+      action: 'retry',
+      retryNumber: 1,
+      delayMs: 250,
+    });
+    expect(decideParseRetry({ kind, priorRetries: 1, poolHasHeadroom: true })).toEqual({
+      action: 'retry',
+      retryNumber: 2,
+      delayMs: 500,
+    });
+  });
+
+  it('marks the file failed once two retries are spent', () => {
+    expect(
+      decideParseRetry({ kind: 'worker-exit', priorRetries: 2, poolHasHeadroom: true }),
+    ).toEqual({ action: 'fail', reason: 'retries-exhausted' });
+  });
+
+  it.each(DETERMINISTIC)('never retries a deterministic %s failure', (kind) => {
+    expect(decideParseRetry({ kind, priorRetries: 0, poolHasHeadroom: true })).toEqual({
+      action: 'fail',
+      reason: 'deterministic',
+    });
+  });
+
+  it('does not retry when the pool lacks headroom for another failure', () => {
+    expect(
+      decideParseRetry({ kind: 'worker-exit', priorRetries: 0, poolHasHeadroom: false }),
+    ).toEqual({ action: 'fail', reason: 'no-pool-headroom' });
+  });
+
+  it('honours a custom retry budget', () => {
+    expect(
+      decideParseRetry({
+        kind: 'worker-oom',
+        priorRetries: 0,
+        poolHasHeadroom: true,
+        maxRetries: 0,
+      }),
+    ).toEqual({ action: 'fail', reason: 'retries-exhausted' });
+  });
+});
+
+/**
+ * Pool wiring: a scripted worker double drives the real pool so the decision
+ * above is proven to gate quarantine end to end. Each scripted action runs on
+ * the next `sub-batch` the pool posts.
+ */
+type PoolAction = 'ok' | 'exit' | 'worker-error';
+
+const actions: PoolAction[] = [];
+let spawned = 0;
+
+class ScriptedWorker extends EventEmitter {
+  constructor() {
+    super();
+    spawned++;
+    queueMicrotask(() => {
+      this.emit('online');
+      this.emit('message', { type: 'ready' });
+    });
+  }
+
+  postMessage(msg: unknown): void {
+    const m = msg as { type?: string; files?: { path: string }[] };
+    if (m?.type !== 'sub-batch') return;
+    const action = actions.shift();
+    const files = m.files ?? [];
+    if (!action) return;
+    queueMicrotask(async () => {
+      if (action === 'ok') {
+        this.emit('message', { type: 'progress', filesProcessed: files.length });
+        this.emit('message', { type: 'sub-batch-done' });
+        await Promise.resolve();
+        this.emit('message', { type: 'result', data: files.map((f) => f.path) });
+        return;
+      }
+      this.emit('message', { type: 'starting-file', path: files[0].path });
+      if (action === 'exit') this.emit('exit', 134);
+      else this.emit('message', { type: 'error', error: 'Unexpected token at line 1' });
+    });
+  }
+
+  async terminate(): Promise<number> {
+    this.emit('exit', 0);
+    return 0;
+  }
+}
+
+describe('worker pool transient-failure retry', () => {
+  let tempDir: string;
+  let workerUrl: URL;
+
+  beforeEach(() => {
+    actions.length = 0;
+    spawned = 0;
+    tempDir = fs.mkdtempSync(path.join(os.tmpdir(), 'gitnexus-parse-retry-'));
+    const workerPath = path.join(tempDir, 'fake-worker.js');
+    fs.writeFileSync(workerPath, '// fake');
+    workerUrl = pathToFileURL(workerPath) as URL;
+  });
+
+  afterEach(() => {
+    fs.rmSync(tempDir, { recursive: true, force: true });
+  });
+
+  const makePool = () =>
+    createWorkerPool(workerUrl, 1, {
+      workerFactory: () => new ScriptedWorker() as unknown as Worker,
+      consecutiveFailureThreshold: 10,
+      maxRespawnsPerSlot: 10,
+    });
+
+  const items = [
+    { path: 'src/a.ts', content: '' },
+    { path: 'src/b.ts', content: '' },
+  ];
+
+  it('retries a file after a transient worker exit and does not quarantine it', async () => {
+    const pool = makePool();
+    actions.push('exit', 'ok');
+    try {
+      const results = await pool.dispatch<(typeof items)[number], string[]>(items);
+      expect(results).toEqual([['src/a.ts', 'src/b.ts']]);
+      expect(pool.getQuarantinedPaths()).toEqual([]);
+      expect(spawned).toBe(2);
+    } finally {
+      await pool.terminate();
+    }
+  });
+
+  it('quarantines the file after two transient retries are spent', async () => {
+    const pool = makePool();
+    actions.push('exit', 'exit', 'exit', 'ok');
+    try {
+      const results = await pool.dispatch<(typeof items)[number], string[]>(items);
+      expect(results).toEqual([['src/b.ts']]);
+      expect(pool.getQuarantinedPaths()).toEqual(['src/a.ts']);
+      // Initial worker + one respawn per death (3 deaths).
+      expect(spawned).toBe(4);
+    } finally {
+      await pool.terminate();
+    }
+  });
+
+  it('quarantines a deterministic worker-reported parse error without retrying', async () => {
+    const pool = makePool();
+    actions.push('worker-error', 'ok');
+    try {
+      const results = await pool.dispatch<(typeof items)[number], string[]>(items);
+      expect(results).toEqual([['src/b.ts']]);
+      expect(pool.getQuarantinedPaths()).toEqual(['src/a.ts']);
+      expect(spawned).toBe(2);
+    } finally {
+      await pool.terminate();
+    }
+  });
+});
