+def is_schema_current_without_writes(conn: sqlite3.Connection) -> bool:
+    """Check if database is already at the current schema version (read-only check).
+
+    Returns True only if the database is at SCHEMA_VERSION = 5, meaning all
+    startup migrations have been completed. This allows schema initialization
+    to skip writes when cloning under active WAL writer contention.
+
+    Uses read-only operations only: no DDL, no DML, no metadata updates.
+    The check relies on the invariant that once a database is upgraded to
+    the current schema version, all required tables and columns exist.
+    """
+    try:
+        current_version = read_existing_schema_version(conn)
+        return current_version == SCHEMA_VERSION
+    except Exception:
+        return False
+
+
 def run_versioned_migrations(conn: sqlite3.Connection) -> None:
     refuse_schema_version_too_new(conn)
 
