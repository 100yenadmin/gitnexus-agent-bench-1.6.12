--- /dev/null
+++ b/tests/test_tool_group_safe_end.py
@@ -0,0 +1,133 @@
+"""Leaf boundaries must not strand parallel tool results (#559)."""
+
+import pytest
+
+from hermes_lcm import fresh_tail
+from hermes_lcm.config import LCMConfig
+from hermes_lcm.engine import LCMEngine
+from hermes_lcm.tokens import count_messages_tokens
+
+
+def _user(content="old"):
+    return {"role": "user", "content": content}
+
+
+def _group():
+    return [
+        {
+            "role": "assistant",
+            "content": "calling tools",
+            "tool_calls": [
+                {"id": "a", "function": {"name": "a", "arguments": "{}"}},
+                {"id": "b", "function": {"name": "b", "arguments": "{}"}},
+            ],
+        },
+        {"role": "tool", "tool_call_id": "a", "content": "first result"},
+        {"role": "tool", "tool_call_id": "b", "content": "second result"},
+    ]
+
+
+@pytest.mark.parametrize("end", [2, 3])
+def test_safe_end_retreats_before_group(end):
+    messages = [_user(), *_group(), _user("new")]
+    assert fresh_tail.tool_group_safe_end(messages, end) == 1
+
+
+@pytest.mark.parametrize("end", [1, 2])
+def test_safe_end_extends_group_at_zero(end):
+    messages = [*_group(), _user("new")]
+    assert fresh_tail.tool_group_safe_end(messages, end) == 3
+
+
+@pytest.mark.parametrize("end", [0, 1, 4, 5])
+def test_safe_end_keeps_boundaries_outside_group(end):
+    messages = [_user(), *_group(), _user("new")]
+    assert fresh_tail.tool_group_safe_end(messages, end) == end
+
+
+@pytest.mark.parametrize("result_id", [None, "", "undeclared"])
+@pytest.mark.parametrize("end", [1, 2])
+def test_safe_end_keeps_ambiguous_results(result_id, end):
+    messages = _group()
+    messages[2]["tool_call_id"] = result_id
+    assert fresh_tail.tool_group_safe_end(messages, end) == end
+
+
+def test_safe_end_handles_reversed_results_and_separate_groups():
+    group = _group()
+    messages = [*group, _user(), group[0], group[2], group[1]]
+    assert fresh_tail.tool_group_safe_end(messages, 6) == 4
+    assert fresh_tail.tool_group_safe_end(messages, 3) == 3
+
+
+def test_safe_end_does_not_attach_orphan_to_completed_group():
+    messages = [*_group(), {"role": "tool", "tool_call_id": "orphan"}]
+    assert fresh_tail.tool_group_safe_end(messages, 3) == 3
+
+
+@pytest.fixture
+def engine(tmp_path):
+    instance = LCMEngine(
+        config=LCMConfig(
+            database_path=str(tmp_path / "leaf.db"),
+            fresh_tail_count=1,
+            leaf_chunk_tokens=1,
+            dynamic_leaf_chunk_enabled=True,
+            dynamic_leaf_chunk_max=1,
+        ),
+        hermes_home=str(tmp_path / "hermes"),
+    )
+    instance.on_session_start("leaf-session", context_length=200_000)
+    yield instance
+    instance.shutdown()
+
+
+@pytest.mark.parametrize("end", [2, 3])
+def test_selector_retreats_before_parallel_group(engine, end):
+    messages = [_user(), *_group(), _user("new")]
+    budget = count_messages_tokens(messages[:end])
+    assert engine._select_oldest_leaf_chunk(messages, budget) == messages[:1]
+
+
+@pytest.mark.parametrize("end", [1, 2])
+def test_selector_extends_parallel_group_at_zero(engine, end):
+    messages = [*_group(), _user("new")]
+    budget = count_messages_tokens(messages[:end])
+    assert engine._select_oldest_leaf_chunk(messages, budget) == messages[:3]
+
+
+def test_rescue_fallback_retreats_before_parallel_group(engine):
+    messages = [_user(), *_group()]
+    engine._config.leaf_chunk_tokens = count_messages_tokens(messages)
+    assert engine._next_leaf_rescue_chunk(messages, count_messages_tokens(messages)) == messages[:1]
+
+
+def test_rescue_cannot_shrink_indivisible_parallel_group(engine):
+    messages = _group()
+    assert engine._next_leaf_rescue_chunk(messages, count_messages_tokens(messages)) == []
+
+
+def test_selector_allows_later_compaction_with_contiguous_coverage(engine, monkeypatch):
+    import hermes_lcm.engine as engine_module
+
+    monkeypatch.setattr(
+        engine_module,
+        "summarize_with_escalation",
+        lambda **kwargs: ("Leaf summary. Expand for details about: tools", 1),
+    )
+    messages = [_user(), *_group(), _user("fresh")]
+    engine._config.leaf_chunk_tokens = count_messages_tokens(messages[:3])
+    engine._config.dynamic_leaf_chunk_max = engine._config.leaf_chunk_tokens
+
+    first = engine.compress(messages, force=True)
+    nodes = engine._dag.get_session_nodes("leaf-session")
+    assert len(nodes) == 1
+    assert len(nodes[0].source_ids) == 1
+    assert first[-4:] == messages[1:]
+
+    second = engine.compress(first, force=True)
+    nodes = engine._dag.get_session_nodes("leaf-session")
+    assert len(nodes) == 2
+    assert sorted(len(node.source_ids) for node in nodes) == [1, 3]
+    assert len(engine._store.get_session_messages("leaf-session")) == len(messages)
+    assert second[-1] == messages[-1]
