diff --git a/servers/engine/tests/test_stuck_cell.py b/servers/engine/tests/test_stuck_cell.py
new file mode 100644
index 0000000..4657058
--- /dev/null
+++ b/servers/engine/tests/test_stuck_cell.py
@@ -0,0 +1,184 @@
+"""#1511 stuck cell: a character standing on a NEWLY impassable cell (PR #1507 made crates,
+bedrolls, the fire and walls solid) must never be treated as trapped.
+
+Pinned here:
+  * combat_grid.reachable / shortest_path explicitly EXEMPT the start cell from the occupied and
+    impassable checks, and never return the start as a destination.
+  * rest_blocked_cells(exclude_id=mover) drops the mover's own cell even when it is TERRAIN
+    (not only occupancy), so a stander on a crate can walk_to an adjacent open cell.
+  * end_combat's write-back moves a survivor whose final combat cell is rest-blocked (wall/prop
+    in the rest scene grid, off-grid, or another stander's cell) to the nearest walkable cell.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+import server  # imported FIRST: resolves the models<->scene_grid import cycle in the right order
+import combat_grid
+from scene_grid import (
+    SceneGrid,
+    SceneGridSpec,
+    SceneCell,
+    SceneCellDefault,
+    SceneProp,
+)
+
+
+# ── combat_grid: the start cell is exempt ─────────────────────────────────────────────
+
+
+def test_reachable_exempts_start_from_impassable_and_occupied():
+    start = (1, 1)
+    for blocked_kw in ({"occupied": {start}}, {"occupied": set(), "impassable": {start}}):
+        occupied = blocked_kw.pop("occupied")
+        reach = combat_grid.reachable(start, 1, occupied, 3, 3, **blocked_kw)
+        assert start not in reach  # never a destination
+        assert len(reach) == 8      # every neighbour is enterable from the blocked start
+
+
+def test_shortest_path_steps_off_an_impassable_start():
+    start = (1, 1)
+    path = combat_grid.shortest_path(start, (2, 1), {start}, 3, 3, impassable={start})
+    assert path == [(2, 1)]  # one step; the start is never part of the route
+    # Routing back onto the start is "already there", not a move to the start.
+    assert combat_grid.shortest_path(start, start, set(), 3, 3, impassable={start}) == []
+
+
+def test_shortest_path_never_routes_back_through_start():
+    # A 3x1 corridor with the start in the middle: going right never revisits the start.
+    path = combat_grid.shortest_path((1, 0), (2, 0), set(), 3, 1, impassable={(1, 0)})
+    assert path == [(2, 0)]
+
+
+# ── fixtures ──────────────────────────────────────────────────────────────────────────
+
+
+def _crate_room(location_id: str = "loc") -> SceneGrid:
+    """5x3 scene: wall column x=2 at rows 1..2 (gap at (2,0)) and a crate prop at (4,2)."""
+    cells = [SceneCell(c=2, r=r, type="wall", walkable=False) for r in (1, 2)]
+    props = [SceneProp(id="crate", kind="crates", cells=[(4, 2)], anchor_cell=(4, 2))]
+    cells.append(SceneCell(c=4, r=2, type="prop", walkable=False, prop_ref="crate"))
+    return SceneGrid(
+        scene_id=f"w:{location_id}", location_id=location_id, kind="dungeon",
+        grid=SceneGridSpec(cols=5, rows=3, cell_size_ft=5),
+        cell_default=SceneCellDefault(type="floor", walkable=True, cost=1),
+        cells=cells, props=props,
+    )
+
+
+@pytest.fixture
+def room(tmp_path, monkeypatch):
+    """Hero standing ON the crate (4,2) — an old save from before #1507 made it solid — and an
+    Ally at (1,0). A Goblin foe with no stage_cell. Rest mode (no combat)."""
+    monkeypatch.setenv("WORLDOS_STATE_DIR", str(tmp_path))
+    cid = server.create_campaign("#1511 stuck cell")["id"]
+    loc_id = server.add_location(cid, "The Crate Room")["id"]
+    hero = server.create_character(cid, "Hero", kind="player", max_hp=30)["id"]
+    ally = server.create_character(cid, "Ally", kind="companion", max_hp=20)["id"]
+    goblin = server.create_character(cid, "Goblin", kind="monster", max_hp=7)["id"]
+    c = server._require(cid)
+    c.locations[loc_id].scene_grid = _crate_room(loc_id)
+    c.characters[hero].stage_cell = (4, 2)
+    c.characters[ally].stage_cell = (1, 0)
+    server.save_campaign(c)
+    return cid, hero, ally, goblin, loc_id
+
+
+# ── rest_blocked_cells + walk_to ──────────────────────────────────────────────────────
+
+
+def test_mover_on_terrain_is_not_in_its_own_blocked_set(room):
+    cid, hero, ally, _goblin, loc_id = room
+    c = server._require(cid)
+    loc = c.locations[loc_id]
+    _w, _h, blocked = server.rest_blocked_cells(c, loc, exclude_id=hero)
+    assert (4, 2) not in blocked  # own cell — even though it is a crate
+    assert (2, 1) in blocked and (2, 2) in blocked  # walls still block
+    assert (1, 0) in blocked  # the ally still blocks
+    # Without an exclude, the crate (and the hero standing on it) is blocked as before.
+    _w, _h, blocked_all = server.rest_blocked_cells(c, loc)
+    assert (4, 2) in blocked_all
+    # The ally's view: the crate blocks, the ally's own cell does not.
+    _w, _h, blocked_ally = server.rest_blocked_cells(c, loc, exclude_id=ally)
+    assert (4, 2) in blocked_ally and (1, 0) not in blocked_ally
+
+
+def test_stander_on_crate_can_walk_to_adjacent_open_cell(room):
+    cid, hero, _ally, _goblin, _loc = room
+    out = server.walk_to(cid, hero, 3, 2)
+    assert out["walked"] is True
+    assert out["path"] == [[4, 2], [3, 2]]
+    assert tuple(server._require(cid).characters[hero].stage_cell) == (3, 2)
+
+
+def test_stander_on_crate_still_cannot_walk_into_a_wall(room):
+    cid, hero, _ally, _goblin, _loc = room
+    out = server.walk_to(cid, hero, 2, 2)
+    assert out["walked"] is False
+    assert tuple(server._require(cid).characters[hero].stage_cell) == (4, 2)
+
+
+# ── end_combat write-back ─────────────────────────────────────────────────────────────
+
+
+def _place(cid: str, cells: dict[str, tuple[int, int]]) -> None:
+    c = server._require(cid)
+    for cb in c.combat.order:
+        if cb.character_id in cells:
+            cb.x, cb.y = cells[cb.character_id]
+    server.save_campaign(c)
+
+
+def _rest_free(cid: str, loc_id: str, char_id: str, cell) -> bool:
+    c = server._require(cid)
+    w, h, terrain, occupied = server._rest_grid_parts(c, c.locations[loc_id], exclude_id=char_id)
+    x, y = cell
+    return 0 <= x < w and 0 <= y < h and (x, y) not in terrain and (x, y) not in occupied
+
+
+def test_end_combat_moves_survivor_off_a_rest_prop(room):
+    cid, hero, ally, goblin, loc_id = room
+    server.start_combat(cid, [hero, ally, goblin])
+    _place(cid, {hero: (4, 2), ally: (1, 0)})  # the fight's grid allowed the crate cell
+    server.end_combat(cid, resolution="the goblin fled")
+    c = server._require(cid)
+    hero_cell = tuple(c.characters[hero].stage_cell)
+    # Nearest walkable rest cell, with a stable (y, x) tiebreak among the distance-1 ring.
+    assert hero_cell == (3, 1)
+    assert _rest_free(cid, loc_id, hero, hero_cell)
+    assert tuple(c.characters[ally].stage_cell) == (1, 0)  # a legal cell is left untouched
+
+
+def test_end_combat_moves_survivors_off_walls_without_stacking(room):
+    cid, hero, ally, goblin, loc_id = room
+    server.start_combat(cid, [hero, ally, goblin])
+    _place(cid, {hero: (2, 1), ally: (2, 2)})  # both end inside the rest scene's wall column
+    server.end_combat(cid, resolution="the goblin fled")
+    c = server._require(cid)
+    hero_cell = tuple(c.characters[hero].stage_cell)
+    ally_cell = tuple(c.characters[ally].stage_cell)
+    assert hero_cell != ally_cell
+    for cid_, cell, origin in ((hero, hero_cell, (2, 1)), (ally, ally_cell, (2, 2))):
+        assert _rest_free(cid, loc_id, cid_, cell)
+        assert combat_grid.chebyshev_cells(cell, origin) == 1
+
+
+def test_end_combat_clamps_off_grid_survivor_onto_rest_grid(room):
+    cid, hero, ally, goblin, loc_id = room
+    server.start_combat(cid, [hero, ally, goblin])
+    _place(cid, {hero: (9, 0), ally: (1, 0)})  # the fight grid was larger than the rest scene
+    server.end_combat(cid, resolution="the goblin fled")
+    hero_cell = tuple(server._require(cid).characters[hero].stage_cell)
+    assert hero_cell == (4, 0)
+    assert _rest_free(cid, loc_id, hero, hero_cell)
+
+
+def test_end_combat_legal_cells_unchanged(room):
+    cid, hero, ally, goblin, _loc = room
+    server.start_combat(cid, [hero, ally, goblin])
+    _place(cid, {hero: (3, 2), ally: (0, 1)})
+    server.end_combat(cid, resolution="the goblin fled")
+    c = server._require(cid)
+    assert tuple(c.characters[hero].stage_cell) == (3, 2)
+    assert tuple(c.characters[ally].stage_cell) == (0, 1)
