+def test_over_budget_move_surfaces_advisory(grid_fight):
+    cid, hero, _ = grid_fight
+    out = combat_loop.resolve_player_turn(cid, hero, Intent(kind="move", to_cell=(7, 0)))
+
+    assert out["ok"] is True, out
+    result = out["resolved"]["result"]
+    assert result["to_cell"] == (7, 0)
+    assert result["to_zone"] == ""
+    assert result["movement_illegal"]["budget_cells"] == 6
+    assert result["movement_illegal"]["cost_cells"] == 7
+    assert result["movement_illegal"]["reason"]
+    assert "move_blocked" not in result
+    assert _cell(cid, hero) == (7, 0)  # over-budget movement remains advisory-only
+    assert out["turn_open"] is True
+
+
+def test_blocked_move_surfaces_advisory(grid_fight):
+    cid, hero, _ = grid_fight
+    server.set_grid(cid, 20, 20, obstacles=[[3, 0]])
+    out = combat_loop.resolve_player_turn(cid, hero, Intent(kind="move", to_cell=(3, 0)))
+
+    assert out["ok"] is True, out
+    result = out["resolved"]["result"]
+    assert result["to_cell"] == (3, 0)
+    assert result["to_zone"] == ""
+    assert result["move_blocked"]["target"] == [3, 0]
+    assert result["move_blocked"]["reason"]
+    assert "movement_illegal" not in result
+    assert _cell(cid, hero) == (0, 0)
+    assert out["turn_open"] is True
+
+
 def test_move_then_end_turn_advances(grid_fight):
     """A move followed by end_turn=True ends the move-only turn (the arbiter declares the skip),
