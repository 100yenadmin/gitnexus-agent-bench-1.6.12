+def delete_host_uid_bindings(conn: sqlite3.Connection, rows_sql: str, args: tuple = ()) -> None:
+    """#836: the ``host_uid_bindings`` of rows about to be deleted (``rows_sql`` selects their store_ids)
+    go with them, on the caller's connection and transaction: a store_id reused after the delete must
+    never inherit a stale binding. A store without the side table is left without it."""
