+describe('C system includes never resolve into the repository (cScopeResolver)', () => {
+  const files = new Set(['src/main.c', 'src/stdio.h', 'include/sys/types.h']);
+
+  it('recognizes only the angle-bracket spelling as a system include', () => {
+    expect(isCSystemIncludeSpelling('<stdio.h>')).toBe(true);
+    expect(isCSystemIncludeSpelling('<sys/types.h>')).toBe(true);
+    expect(isCSystemIncludeSpelling('stdio.h')).toBe(false);
+    expect(isCSystemIncludeSpelling('<')).toBe(false);
+    expect(isCSystemIncludeSpelling('')).toBe(false);
+  });
+
+  it('refuses <stdio.h> even with a same-named sibling header', () => {
+    expect(cScopeResolver.resolveImportTarget('<stdio.h>', 'src/main.c', files)).toBeNull();
+  });
+
+  it('refuses a nested system include with a same-suffixed in-repo header', () => {
+    expect(cScopeResolver.resolveImportTarget('<sys/types.h>', 'src/main.c', files)).toBeNull();
+  });
+
+  it('refuses system includes on the header-augmented path too', () => {
+    const headers = new Set(['src/stdio.h', 'include/sys/types.h']);
+    const cFiles = new Set(['src/main.c']);
+    expect(
+      cScopeResolver.resolveImportTarget('<stdio.h>', 'src/main.c', cFiles, headers),
+    ).toBeNull();
+    expect(cScopeResolver.resolveImportTarget('stdio.h', 'src/main.c', cFiles, headers)).toBe(
+      'src/stdio.h',
+    );
+  });
+
+  it('still resolves the quoted spelling of the same headers', () => {
+    expect(cScopeResolver.resolveImportTarget('stdio.h', 'src/main.c', files)).toBe('src/stdio.h');
+    expect(cScopeResolver.resolveImportTarget('sys/types.h', 'src/main.c', files)).toBe(
+      'include/sys/types.h',
+    );
+  });
+});
