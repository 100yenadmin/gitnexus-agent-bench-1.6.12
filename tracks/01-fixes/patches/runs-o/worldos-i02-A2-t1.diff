+def _settle_survivors_on_rest_grid(c: "Campaign", survivors: list["Character"]) -> list[str]:
+    """#1511: after ``end_combat`` writes each survivor's final COMBAT cell into ``stage_cell``,
+    move any survivor whose cell is rest-blocked — off the rest scene grid, on a wall/prop in that
+    grid (the fight's own grid may have allowed it), or on another stander's cell — to the nearest
+    walkable rest cell. Runs AFTER the whole write-back so a survivor's pre-fight rest cell never
+    counts against an earlier survivor. Survivors are settled in combat order, each seeing the
+    already-settled ones as occupancy (no stacking). No scene grid / a survivor anchored elsewhere
+    ⇒ untouched (additive). Returns the ids moved."""
+    loc = c.locations.get(c.current_location_id) if c.current_location_id else None
+    if loc is None or getattr(loc, "scene_grid", None) is None:
+        return []
+    moved: list[str] = []
+    for ch in survivors:
+        if ch.location_id and ch.location_id != loc.id:
+            continue
+        cell = ch.stage_cell
+        if cell is None:
+            continue
+        width, height, terrain, occupied = _rest_grid_parts(c, loc, exclude_id=ch.id)
+        if width <= 0 or height <= 0:
+            return moved
+        cell = (int(cell[0]), int(cell[1]))
+        in_bounds = 0 <= cell[0] < width and 0 <= cell[1] < height
+        blocked = terrain | occupied
+        if in_bounds and cell not in blocked:
+            continue
+        ch.stage_cell = _nearest_free_rest_cell(cell, width, height, blocked)
+        moved.append(ch.id)
+    return moved
 
 
