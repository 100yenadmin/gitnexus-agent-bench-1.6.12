diff --git a/gitnexus/test/unit/parse-retry.test.ts b/gitnexus/test/unit/parse-retry.test.ts
new file mode 100644
index 0000000..e5d33b9
--- /dev/null
+++ b/gitnexus/test/unit/parse-retry.test.ts
@@ -0,0 +1,303 @@
+/**
+ * Retry/no-retry decision for parse-worker failures (parse-retry.ts).
+ *
+ * A transient failure attributed to a file is retried up to
+ * MAX_PARSE_RETRIES (2) times with capped exponential backoff before the
+ * file is marked failed; a deterministic parse error is never retried.
+ */
+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import { EventEmitter } from 'node:events';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { pathToFileURL } from 'node:url';
+import type { Worker } from 'node:worker_threads';
+import {
+  createWorkerPool,
+  type WorkerPoolOptions,
+} from '../../src/core/ingestion/workers/worker-pool.js';
+import {
+  MAX_PARSE_RETRIES,
+  PARSE_RETRY_BACKOFF_BASE_MS,
+  PARSE_RETRY_BACKOFF_CAP_MS,
+  classifyParseFailure,
+  createParseRetryTracker,
+  parseRetryBackoffMs,
+  shouldRetryParseFailure,
+} from '../../src/core/ingestion/workers/parse-retry.js';
+
+describe('classifyParseFailure', () => {
+  it('treats a worker exit mid-job as transient', () => {
+    expect(classifyParseFailure({ source: 'exit', code: 1 })).toBe('transient');
+    expect(classifyParseFailure({ source: 'exit', code: 134 })).toBe('transient');
+  });
+
+  it('treats worker heap OOM as transient (fresh worker gets a clean heap)', () => {
+    expect(classifyParseFailure({ source: 'error-event', code: 'ERR_WORKER_OUT_OF_MEMORY' })).toBe(
+      'transient',
+    );
+    expect(
+      classifyParseFailure({
+        source: 'error-event',
+        message: 'Worker terminated due to reaching memory limit: JS heap out of memory',
+      }),
+    ).toBe('transient');
+  });
+
+  it('treats host resource exhaustion as transient on any channel', () => {
+    for (const message of [
+      'spawn EAGAIN',
+      'EMFILE: too many open files, open shard.bin',
+      'ENOMEM: not enough memory',
+      'Resource temporarily unavailable',
+    ]) {
+      expect(classifyParseFailure({ source: 'error-message', message })).toBe('transient');
+    }
+    expect(classifyParseFailure({ source: 'error-event', code: 'EBUSY' })).toBe('transient');
+  });
+
+  it('treats JS throws on the file content as deterministic', () => {
+    for (const message of [
+      "Cannot read properties of undefined (reading 'text')",
+      'Failed to parse file src/bad.ts: Invalid argument',
+      'Maximum call stack size exceeded',
+      'Query error of type NodeType at position 12',
+    ]) {
+      expect(classifyParseFailure({ source: 'error-message', message })).toBe('deterministic');
+      expect(classifyParseFailure({ source: 'error-event', message })).toBe('deterministic');
+    }
+  });
+
+  it('treats malformed and undeserializable results as deterministic', () => {
+    expect(classifyParseFailure({ source: 'malformed-message' })).toBe('deterministic');
+    expect(
+      classifyParseFailure({
+        source: 'messageerror',
+        message: 'Unable to deserialize cloned data',
+      }),
+    ).toBe('deterministic');
+  });
+
+  it('does not match transient codes inside unrelated words', () => {
+    expect(
+      classifyParseFailure({ source: 'error-message', message: 'unexpected token XEAGAINX' }),
+    ).toBe('deterministic');
+  });
+});
+
+describe('shouldRetryParseFailure', () => {
+  it('retries transient failures until the budget is spent', () => {
+    expect(MAX_PARSE_RETRIES).toBe(2);
+    expect(shouldRetryParseFailure('transient', 0)).toBe(true);
+    expect(shouldRetryParseFailure('transient', 1)).toBe(true);
+    expect(shouldRetryParseFailure('transient', 2)).toBe(false);
+  });
+
+  it('never retries deterministic failures', () => {
+    expect(shouldRetryParseFailure('deterministic', 0)).toBe(false);
+    expect(shouldRetryParseFailure('deterministic', 1)).toBe(false);
+  });
+
+  it('honours a custom budget', () => {
+    expect(shouldRetryParseFailure('transient', 0, 0)).toBe(false);
+  });
+});
+
+describe('parseRetryBackoffMs', () => {
+  it('grows exponentially and is capped', () => {
+    const max = () => 0.999999;
+    expect(parseRetryBackoffMs(1, max)).toBe(PARSE_RETRY_BACKOFF_BASE_MS);
+    expect(parseRetryBackoffMs(2, max)).toBe(PARSE_RETRY_BACKOFF_BASE_MS * 2);
+    expect(parseRetryBackoffMs(20, max)).toBe(PARSE_RETRY_BACKOFF_CAP_MS);
+  });
+
+  it('always waits at least half the ceiling (equal jitter)', () => {
+    const min = () => 0;
+    expect(parseRetryBackoffMs(1, min)).toBe(PARSE_RETRY_BACKOFF_BASE_MS / 2);
+    expect(parseRetryBackoffMs(2, min)).toBe(PARSE_RETRY_BACKOFF_BASE_MS);
+    expect(parseRetryBackoffMs(20, min)).toBe(PARSE_RETRY_BACKOFF_CAP_MS / 2);
+  });
+});
+
+describe('createParseRetryTracker', () => {
+  const crash = { source: 'exit', code: 1 } as const;
+  const parseError = { source: 'error-message', message: 'Invalid node type' } as const;
+
+  it('retries a transient failure twice, then marks the file failed', () => {
+    const tracker = createParseRetryTracker(undefined, () => 0);
+    const first = tracker.recordFailure('src/a.ts', crash);
+    const second = tracker.recordFailure('src/a.ts', crash);
+    const third = tracker.recordFailure('src/a.ts', crash);
+
+    expect(first).toEqual({ action: 'retry', kind: 'transient', retry: 1, delayMs: 125 });
+    expect(second).toEqual({ action: 'retry', kind: 'transient', retry: 2, delayMs: 250 });
+    expect(third).toEqual({ action: 'fail', kind: 'transient', retries: 2 });
+    expect(tracker.retriesFor('src/a.ts')).toBe(2);
+  });
+
+  it('marks a deterministic parse error failed without retrying', () => {
+    const tracker = createParseRetryTracker();
+    expect(tracker.recordFailure('src/bad.ts', parseError)).toEqual({
+      action: 'fail',
+      kind: 'deterministic',
+      retries: 0,
+    });
+    expect(tracker.retriesFor('src/bad.ts')).toBe(0);
+  });
+
+  it('fails a deterministic error that follows a transient retry', () => {
+    const tracker = createParseRetryTracker();
+    expect(tracker.recordFailure('src/a.ts', crash).action).toBe('retry');
+    expect(tracker.recordFailure('src/a.ts', parseError)).toEqual({
+      action: 'fail',
+      kind: 'deterministic',
+      retries: 1,
+    });
+  });
+
+  it('keeps an independent budget per file', () => {
+    const tracker = createParseRetryTracker();
+    tracker.recordFailure('src/a.ts', crash);
+    tracker.recordFailure('src/a.ts', crash);
+    expect(tracker.recordFailure('src/a.ts', crash).action).toBe('fail');
+    expect(tracker.recordFailure('src/b.ts', crash).action).toBe('retry');
+  });
+
+  it('honours a zero budget', () => {
+    const tracker = createParseRetryTracker(0);
+    expect(tracker.recordFailure('src/a.ts', crash)).toEqual({
+      action: 'fail',
+      kind: 'transient',
+      retries: 0,
+    });
+  });
+});
+
+/**
+ * Pool-level wiring: a fake Worker scripted per dispatched sub-batch proves
+ * that transient deaths re-dispatch the file and deterministic ones
+ * quarantine it on the first death.
+ */
+type Action = { kind: 'ok' } | { kind: 'exit'; code: number } | { kind: 'throw'; message: string };
+
+const actions: Action[] = [];
+let subBatches = 0;
+
+class FakeWorker extends EventEmitter {
+  constructor() {
+    super();
+    queueMicrotask(() => this.emit('message', { type: 'ready' }));
+  }
+
+  postMessage(msg: { type?: string; files?: { path: string }[] }): void {
+    if (msg?.type !== 'sub-batch') return;
+    subBatches++;
+    const files = msg.files ?? [];
+    const action = actions.shift() ?? { kind: 'ok' };
+    queueMicrotask(async () => {
+      for (const file of files) this.emit('message', { type: 'starting-file', path: file.path });
+      if (action.kind === 'exit') {
+        this.emit('exit', action.code);
+        return;
+      }
+      if (action.kind === 'throw') {
+        this.emit('message', { type: 'error', error: action.message });
+        return;
+      }
+      this.emit('message', { type: 'progress', filesProcessed: files.length });
+      this.emit('message', { type: 'sub-batch-done' });
+      await Promise.resolve();
+      this.emit('message', { type: 'result', data: { paths: files.map((f) => f.path) } });
+    });
+  }
+
+  async terminate(): Promise<number> {
+    this.emit('exit', 0);
+    return 0;
+  }
+}
+
+describe('worker pool transient-failure retry', () => {
+  let tempDir: string;
+  let workerUrl: URL;
+
+  beforeEach(() => {
+    actions.length = 0;
+    subBatches = 0;
+    tempDir = fs.mkdtempSync(path.join(os.tmpdir(), 'gitnexus-parse-retry-'));
+    const workerPath = path.join(tempDir, 'fake-worker.js');
+    fs.writeFileSync(workerPath, '// fake');
+    workerUrl = pathToFileURL(workerPath) as URL;
+  });
+
+  afterEach(() => {
+    fs.rmSync(tempDir, { recursive: true, force: true });
+  });
+
+  const makePool = (opts: Partial<WorkerPoolOptions> = {}) =>
+    createWorkerPool(workerUrl, 1, {
+      workerFactory: () => new FakeWorker() as unknown as Worker,
+      ...opts,
+    });
+  const items = [{ path: 'src/flaky.ts', content: 'x' }];
+
+  it('retries a file after a transient worker exit and keeps its result', async () => {
+    const pool = makePool();
+    try {
