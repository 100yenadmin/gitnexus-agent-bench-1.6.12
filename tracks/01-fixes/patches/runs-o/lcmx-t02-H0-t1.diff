+"""Tests for safe query coercion in lcm_grep, lcm_recall, and lcm_expand_query.
+
+Verifies that None, numeric, and empty query values are handled safely without
+AttributeError crashes and that numeric queries are properly converted to strings.
+"""
+from __future__ import annotations
+
+import json
+from types import SimpleNamespace
+
+import pytest
+
+import hermes_lcm.tools as lcm_tools
+from hermes_lcm.config import LCMConfig
+from hermes_lcm.dag import SummaryDAG
+from hermes_lcm.store import MessageStore
+
+
+@pytest.fixture
+def engine(tmp_path):
+    config = LCMConfig(
+        database_path=str(tmp_path / "test.db"),
+        embeddings_enabled=False,
+        embedding_query_timeout_s=2.0,
+    )
+    store = MessageStore(config.database_path, ingest_protection_config=config)
+    dag = SummaryDAG(config.database_path)
+    eng = SimpleNamespace(
+        _config=config,
+        _store=store,
+        _dag=dag,
+        current_session_id="session-test",
+    )
+    try:
+        yield eng
+    finally:
+        dag.close()
+        store.close()
+
+
+class TestLcmGrepQueryCoercion:
+    """Test lcm_grep handles null/numeric/empty queries safely."""
+
+    def test_lcm_grep_null_query_returns_error(self, engine):
+        """Null query should return error, not crash."""
+        result = json.loads(
+            lcm_tools.lcm_grep(
+                {"query": None, "mode": "full_text"},
+                engine=engine,
+            )
+        )
+        assert "error" in result
+        assert result["error"] == "No query provided"
+
+    def test_lcm_grep_numeric_zero_query_searches_as_string(self, engine):
+        """Numeric 0 should be converted to string '0' and searched."""
+        # Add a message with "0" in it
+        store = engine._store
+        store.append(
+            session_id="session-test",
+            msg={"role": "user", "content": "The number is 0"},
+        )
+
+        result = json.loads(
+            lcm_tools.lcm_grep(
+                {"query": 0, "mode": "full_text"},
+                engine=engine,
+            )
+        )
+        # Should not crash and should return results
+        assert "results" in result
+
+    def test_lcm_grep_numeric_float_query_searches_as_string(self, engine):
+        """Numeric 0.0 should be converted to string '0.0' and searched."""
+        result = json.loads(
+            lcm_tools.lcm_grep(
+                {"query": 0.0, "mode": "full_text"},
+                engine=engine,
+            )
+        )
+        # Should not crash with AttributeError
+        assert isinstance(result, dict)
+
+    def test_lcm_grep_empty_string_query_returns_error(self, engine):
+        """Empty string query should return error."""
+        result = json.loads(
+            lcm_tools.lcm_grep(
+                {"query": "", "mode": "full_text"},
+                engine=engine,
+            )
+        )
+        assert "error" in result
+        assert result["error"] == "No query provided"
+
+    def test_lcm_grep_whitespace_only_query_returns_error(self, engine):
+        """Whitespace-only query should return error."""
+        result = json.loads(
+            lcm_tools.lcm_grep(
+                {"query": "   \t\n  ", "mode": "full_text"},
+                engine=engine,
+            )
+        )
+        assert "error" in result
+        assert result["error"] == "No query provided"
+
+    def test_lcm_grep_semantic_null_query_returns_error(self, engine):
+        """Null query in semantic mode should return error, not crash."""
+        result = json.loads(
+            lcm_tools.lcm_grep(
+                {"query": None, "mode": "semantic"},
+                engine=engine,
+            )
+        )
+        # Either error from our check or from embedding provider check
+        assert isinstance(result, dict)
+
+    def test_lcm_grep_semantic_numeric_query_searches(self, engine):
+        """Numeric query in semantic mode should convert to string."""
+        result = json.loads(
+            lcm_tools.lcm_grep(
+                {"query": 42, "mode": "semantic"},
+                engine=engine,
+            )
+        )
+        # Should not crash with AttributeError, may error for other reasons
+        assert isinstance(result, dict)
+
+    def test_lcm_grep_hybrid_null_query_returns_error(self, engine):
+        """Null query in hybrid mode should return error."""
+        result = json.loads(
+            lcm_tools.lcm_grep(
+                {"query": None, "mode": "hybrid"},
+                engine=engine,
+            )
+        )
+        assert isinstance(result, dict)
+
+
+class TestLcmRecallQueryCoercion:
+    """Test lcm_recall handles null/numeric/empty queries safely."""
+
+    def test_lcm_recall_null_query_returns_error(self, engine):
+        """Null query should return error, not crash."""
+        result = json.loads(
+            lcm_tools.lcm_recall(
+                {"query": None},
+                engine=engine,
+            )
+        )
+        assert "error" in result
+        assert result["error"] == "No query provided"
+
+    def test_lcm_recall_numeric_zero_query_searches_as_string(self, engine):
+        """Numeric 0 should be converted to string '0' and searched."""
+        result = json.loads(
+            lcm_tools.lcm_recall(
+                {"query": 0},
+                engine=engine,
+            )
+        )
+        # Should not crash, may have zero results
+        assert isinstance(result, dict)
+
+    def test_lcm_recall_numeric_float_query_searches(self, engine):
+        """Numeric float should be converted to string."""
+        result = json.loads(
+            lcm_tools.lcm_recall(
+                {"query": 3.14},
+                engine=engine,
+            )
+        )
+        assert isinstance(result, dict)
+
+    def test_lcm_recall_empty_string_query_returns_error(self, engine):
+        """Empty string query should return error."""
+        result = json.loads(
+            lcm_tools.lcm_recall(
+                {"query": ""},
+                engine=engine,
+            )
+        )
+        assert "error" in result
+        assert result["error"] == "No query provided"
+
+    def test_lcm_recall_whitespace_only_query_returns_error(self, engine):
+        """Whitespace-only query should return error."""
+        result = json.loads(
+            lcm_tools.lcm_recall(
+                {"query": "  \n\t  "},
+                engine=engine,
+            )
+        )
+        assert "error" in result
+        assert result["error"] == "No query provided"
+
+
+class TestLcmExpandQueryCoercion:
+    """Test lcm_expand_query handles numeric queries safely."""
+
+    def test_lcm_expand_query_numeric_zero_with_node_ids(self, engine):
+        """Numeric query with node_ids should not crash."""
+        # Since we don't have real node_ids, this should return an error about no matches
+        result = json.loads(
+            lcm_tools.lcm_expand_query(
+                {
+                    "prompt": "Test prompt",
+                    "query": 0,
+                    "node_ids": [],
+                },
+                engine=engine,
+            )
+        )
+        # Should not crash with AttributeError
+        assert isinstance(result, dict)
+
+    def test_lcm_expand_query_numeric_float(self, engine):
+        """Numeric float query should convert to string."""
+        result = json.loads(
+            lcm_tools.lcm_expand_query(
+                {
+                    "prompt": "Test prompt",
+                    "query": 2.71,
+                    "node_ids": [],
+                },
+                engine=engine,
+            )
+        )
+        assert isinstance(result, dict)
+
+    def test_lcm_expand_query_null_with_node_ids_should_not_error_on_query(self, engine):
+        """Null query with node_ids should only error if node_ids invalid."""
+        result = json.loads(
+            lcm_tools.lcm_expand_query(
+                {
+                    "prompt": "Test prompt",
+                    "query": None,
+                    "node_ids": [],
+                },
+                engine=engine,
+            )
+        )
+        # Should error about needing query or node_ids, not about query being None
+        assert isinstance(result, dict)
