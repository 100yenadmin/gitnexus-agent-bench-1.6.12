+def test_mover_on_terrain_blocked_cell_not_in_blocked_set(room):
+    """A character standing on an impassable terrain cell (wall/crate) is NOT trapped —
+    rest_blocked_cells excludes the mover's cell from the blocked set even when the cell
+    itself is terrain-blocked. This lets walk_to path the character away from that cell."""
+    cid, hero, _ally, loc_id = room
+    c = server._require(cid)
+    loc = c.locations[loc_id]
+    # Manually place Hero on a wall cell (2,1) — simulating what end_combat could do
+    # when writing a survivor's final combat-grid cell back to stage_cell.
+    c.characters[hero].stage_cell = (2, 1)
+    server.save_campaign(c)
+    # When rest_blocked_cells is called with exclude_id=hero, the (2,1) wall cell
+    # should NOT be in the blocked set — the hero is standing on it, so it's not
+    # blocking them from walking away.
+    _w, _h, blocked = server.rest_blocked_cells(c, loc, exclude_id=hero)
+    assert (2, 1) not in blocked, "mover's own cell must not be in blocked set"
+
+
+def test_mover_on_terrain_can_walk_away(room):
+    """A character standing on an impassable cell can walk to an adjacent open cell."""
+    cid, hero, _ally, loc_id = room
+    c = server._require(cid)
+    loc = c.locations[loc_id]
+    # Place Hero on a wall cell (2,1)
+    c.characters[hero].stage_cell = (2, 1)
+    server.save_campaign(c)
+    # Hero should be able to walk to an adjacent open cell
+    out = server.walk_to(cid, hero, 1, 1)
+    assert out["walked"] is True, "should be able to walk away from terrain-blocked cell"
+    assert out["to"] == [1, 1]
