diff --git a/hermes_cli/plugins_cmd.py b/hermes_cli/plugins_cmd.py
index 56260193..49a04aa2 100644
--- a/hermes_cli/plugins_cmd.py
+++ b/hermes_cli/plugins_cmd.py
@@ -738,15 +738,17 @@ def _is_portable_plugin_dir(dir_path) -> bool:
 _BUNDLED_DEFAULT_ON_KINDS = frozenset({"backend", "platform", "model-provider"})
 
 
-def _bundled_default_on(dir_path) -> bool:
-    """True when a bundled plugin is active without a ``plugins.enabled`` entry (portable
+def _plugin_default_on(dir_path, *, source: str) -> bool:
+    """True when a plugin is active without a ``plugins.enabled`` entry (portable
     ``plugin.json`` packages have no kind, so never)."""
     manifest_file = _native_manifest_file(Path(dir_path))
     if manifest_file is None:
         return False
     try:
         kind = str(_load_yaml_manifest(manifest_file).get("kind", "standalone")).strip().lower()
-        return kind in _BUNDLED_DEFAULT_ON_KINDS
+        return kind == "model-provider" or (
+            source == "bundled" and kind in _BUNDLED_DEFAULT_ON_KINDS
+        )
     except Exception:
         return False
 
@@ -810,14 +812,14 @@ def _plugin_status(name: str, enabled: set, disabled: set, key: str = "", *, sou
                    dir_path=None, active: "frozenset | set" = frozenset()) -> str:
     """User-facing activation state for a plugin name or key. Mirrors ``gate_manifest``: an explicit
     disable wins, then the allow-list, then the activations that need no list entry — bundled
-    backends/platforms/model providers (*source* + *dir_path*) and category-selected providers
-    (*active*, see :func:`_category_active_names`)."""
+    backends/platforms and model providers from any source (*source* + *dir_path*), plus
+    category-selected providers (*active*, see :func:`_category_active_names`)."""
     names = {name, key}
     if names & disabled:
         return "disabled"
     if names & enabled or names & active:
         return "enabled"
-    if source == "bundled" and dir_path is not None and _bundled_default_on(dir_path):
+    if dir_path is not None and _plugin_default_on(dir_path, source=source):
         return "enabled"
     return "not enabled"
 
diff --git a/tests/hermes_cli/test_plugins_cmd_activation_keys.py b/tests/hermes_cli/test_plugins_cmd_activation_keys.py
index efadcf2d..9a817c1d 100644
--- a/tests/hermes_cli/test_plugins_cmd_activation_keys.py
+++ b/tests/hermes_cli/test_plugins_cmd_activation_keys.py
@@ -104,3 +104,45 @@ def test_status_reports_bundled_defaults_and_the_live_memory_provider(home):
     # An explicit disable still wins over both defaults.
     assert plugins_cmd._plugin_status("fakemem", enabled, {"fakemem"}, key="fakemem", source="user",
                                       active=active) == "disabled"
+
+
+@pytest.mark.parametrize("kind, expected", [
+    ("model-provider", "enabled"),
+    (None, "not enabled"),
+    ("backend", "not enabled"),
+    ("platform", "not enabled"),
+])
+@pytest.mark.parametrize("git_install", [False, True])
+def test_user_plugin_status_defaults_match_kind(home, kind, expected, git_install):
+    directory = _write_plugin(home / "plugins", "providers/fakeprov", "fake-provider",
+                              f"kind: {kind}\n" if kind else "")
+    if git_install:
+        (directory / ".git").mkdir()
+    entry = next(e for e in plugins_cmd._discover_all_plugins() if e[4] == directory)
+    name, _version, _description, source, dir_path, key = entry
+    assert source == ("git" if git_install else "user")
+    assert plugins_cmd._plugin_status(name, set(), set(), key=key, source=source,
+                                      dir_path=dir_path) == expected
+    # Both accepted disable identifiers override default activation and explicit enablement.
+    for disabled_name in (name, key):
+        assert plugins_cmd._plugin_status(name, {name, key}, {disabled_name}, key=key,
+                                          source=source, dir_path=dir_path) == "disabled"
+
+
+@pytest.mark.parametrize("kind, expected", [
+    ("model-provider", "enabled"),
+    ("backend", "enabled"),
+    ("platform", "enabled"),
+    ("exclusive", "not enabled"),
+    (None, "not enabled"),
+])
+def test_bundled_plugin_status_defaults(home, tmp_path, monkeypatch, kind, expected):
+    bundled = tmp_path / "bundled"
+    directory = _write_plugin(bundled, "fakeprov", "fake-provider",
+                              f"kind: {kind}\n" if kind else "")
+    monkeypatch.setattr("hermes_cli.plugins.get_bundled_plugins_dir", lambda: bundled)
+    entry = next(e for e in plugins_cmd._discover_all_plugins() if e[4] == directory)
+    name, _version, _description, source, dir_path, key = entry
+    assert source == "bundled"
+    assert plugins_cmd._plugin_status(name, set(), set(), key=key, source=source,
+                                      dir_path=dir_path) == expected
