diff --git a/hermes_cli/plugins_loader.py b/hermes_cli/plugins_loader.py
index a0d4422f..425e8d0f 100644
--- a/hermes_cli/plugins_loader.py
+++ b/hermes_cli/plugins_loader.py
@@ -265,6 +265,20 @@ class PluginLoaderMixin:
             return
         self._register_deferred_platform_tools(manifest, loaded)
 
+    def rearm_failed_platform(self, platform_name: str) -> bool:
+        """Re-publish a failed platform's loader without importing it until the next lookup."""
+        with self._discovery_lock, _plugin_home_scope(self.home_path):
+            for lookup_key, loaded in self._plugins.items():
+                manifest = loaded.manifest
+                if (manifest.kind != "platform" or not loaded.error or loaded.deferred
+                        or self._platform_name_from_manifest(manifest) != platform_name):
+                    continue
+                if not self._lease_deferred_platform(manifest, lookup_key):
+                    return False
+                loaded.deferred = True
+                return True
+        return False
+
     @_serialized_replacement
     def _lease_deferred_platform(self, manifest: PluginManifest, lookup_key: str) -> bool:
         """Publish the deferred loader as a ledger-owned lease; False when the registry refused it."""
