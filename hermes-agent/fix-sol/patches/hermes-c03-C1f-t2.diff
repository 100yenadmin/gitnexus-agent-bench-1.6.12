+@pytest.mark.asyncio
+async def test_failed_plugin_is_rearmed_then_installed_on_next_tick(monkeypatch, tmp_path):
+    from gateway.platform_registry import platform_registry
+    from hermes_cli import plugins
+
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    platform = Platform("irc")
+    config = PlatformConfig(enabled=True, token="***")
+    healthy = _HealthyAdapter()
+    healthy.platform = platform
+    manager = plugins.PluginManager()
+    manifest = plugins.PluginManifest(
+        name="irc-platform", key="irc-platform", kind="platform",
+        source="bundled", path=str(tmp_path / "irc"),
+    )
+    attempts = []
+
+    def register(ctx):
+        attempts.append(ctx)
+        if len(attempts) == 1:
+            raise TimeoutError("startup contention")
+        ctx.register_platform(
+            name=platform.value, label="Retry", adapter_factory=lambda config: healthy,
+            check_fn=lambda: True,
+        )
+
+    module = types.ModuleType("retryplat")
+    module.register = register
+    monkeypatch.setattr(manager, "_load_directory_module", lambda *args, **kwargs: module)
+    manager._register_deferred_platform(manifest)
+    runner = GatewayRunner(GatewayConfig(
+        platforms={platform: config}, sessions_dir=tmp_path / "sessions",
+    ))
+    runner._failed_platforms[platform] = runner._startup_retry_entry(platform, None, config)
+    try:
+        assert platform_registry.get(platform.value) is None
+        # Resolve this module attribute at tick time, rather than caching the startup manager.
+        get_manager = Mock(return_value=manager)
+        monkeypatch.setattr(plugins, "get_plugin_manager", get_manager)
+        rearm = Mock(wraps=manager.rearm_failed_platform)
+        monkeypatch.setattr(manager, "rearm_failed_platform", rearm)
+        await runner._reconnect_failed_platform(platform, time.monotonic() + 60)
+        get_manager.assert_called_once_with()
+        rearm.assert_called_once_with(platform.value)
+        assert len(attempts) == 1
+        assert platform in runner._failed_platforms
+        assert platform not in runner.adapters
+
+        await runner._reconnect_failed_platform(platform, time.monotonic() + 3600)
+        assert len(attempts) == 2
+        assert runner.adapters[platform] is healthy
+        assert platform not in runner._failed_platforms
+        rearm.assert_called_once_with(platform.value)
+    finally:
+        await runner.stop()
+        manager.unload(manifest)
+
+
