+/**
+ * Resolve a C `#include` target as the C scope resolver receives it, honouring
+ * the include's delimiters when the spelling still carries them.
+ *
+ *   - `<stdio.h>` is a system include: the compiler searches the system and
+ *     `-I` directories, never the including file's directory, so the repo's
+ *     file set says nothing about which header it names. A same-named in-repo
+ *     file (`src/stdio.h`) is a decoy, not an answer, so this returns `null` —
+ *     the same verdict `interpretCImport` reaches by dropping system includes
+ *     before they become imports.
+ *   - `"util.h"` is a quoted include: the quotes are stripped and the path is
+ *     resolved normally (same-directory sibling, exact, then suffix).
+ *   - A bare path (what `interpretCImport` emits for a quoted include) is
+ *     resolved unchanged.
+ */
+export function resolveCIncludeTarget(
+  targetRaw: string,
+  fromFile: string,
+  allFilePaths: ReadonlySet<string>,
+): string | null {
+  const spelling = targetRaw.trim();
+  if (spelling.startsWith('<') && spelling.endsWith('>')) return null;
+  if (spelling.length >= 2 && spelling.startsWith('"') && spelling.endsWith('"')) {
+    return resolveCImportTarget(spelling.slice(1, -1), fromFile, allFilePaths);
+  }
+  return resolveCImportTarget(targetRaw, fromFile, allFilePaths);
+}
