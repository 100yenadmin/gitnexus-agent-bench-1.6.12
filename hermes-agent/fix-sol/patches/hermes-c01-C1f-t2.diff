+def find_claude_code_cli(command: str) -> Optional[str]:
+    """Find a bare Claude Code command, preferring PATH over known install prefixes."""
+    if command not in _CLAUDE_CODE_NAMES:
+        return None
+    hit = shutil.which(command)
+    if hit:
+        return hit
+    return next((path for path in _claude_code_candidates() if os.access(path, os.X_OK)), None)
+
