+def _settle_stage_cell_on_rest_grid(c: "Campaign", ch: "Character") -> None:
+    """#1511: if ``ch.stage_cell`` is REST-blocked in its room — off the rest grid, on a wall /
+    prop the rest scene marks impassable, or on another stander's cell — move it to the nearest
+    walkable rest cell. Used by ``end_combat``'s write-back: the fight's grid may have allowed a
+    cell the room's rest scene grid forbids. Prefers cells reachable from where the survivor
+    stands (the start is exempt from the blocked checks), ranked nearest-first with a stable
+    (y, x) tiebreak; falls back to the nearest free cell anywhere on the grid; clears the cell
+    (unplaced) when the room has no free cell at all. No-op without a scene grid."""
+    sc = getattr(ch, "stage_cell", None)
+    if sc is None:
+        return
+    loc_id = ch.location_id or c.current_location_id
+    loc = c.locations.get(loc_id) if loc_id else None
+    grid = getattr(loc, "scene_grid", None) if loc is not None else None
+    if grid is None:
+        return
+    width, height, blocked = rest_blocked_cells(c, loc, exclude_id=ch.id)
+    if width <= 0 or height <= 0:
+        return
+    cell = (int(sc[0]), int(sc[1]))
+    # rest_blocked_cells drops the mover's own cell, so re-check its terrain explicitly.
+    terrain = {(x, y) for x, y in scene_grid_mod.impassable_cells(grid, width, height)}
+    in_bounds = 0 <= cell[0] < width and 0 <= cell[1] < height
+    if in_bounds and cell not in blocked and cell not in terrain:
+        return
+    blocked = blocked | terrain
+
+    def _rank(cand: tuple[int, int]) -> tuple[int, int, int]:
+        return (combat_grid.chebyshev_cells(cand, cell), cand[1], cand[0])
+
+    candidates: set[tuple[int, int]] = set()
+    if in_bounds:
+        candidates = combat_grid.reachable(cell, width * height, set(), width, height, impassable=blocked)
+    if not candidates:
+        candidates = {
+            (x, y) for x in range(width) for y in range(height) if (x, y) not in blocked
+        }
+    ch.stage_cell = min(candidates, key=_rank) if candidates else None
 
 
