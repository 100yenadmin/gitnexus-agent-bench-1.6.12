+def _nearest_walkable_cell(
+    from_cell: tuple[int, int],
+    blocked: set[tuple[int, int]],
+    width: int,
+    height: int,
+) -> "tuple[int, int] | None":
+    """Find the nearest walkable cell from ``from_cell`` using BFS over the 8-neighbourhood.
+    This is used when end_combat writes a survivor's final cell to stage_cell and that cell
+    is impassable terrain — we need to relocate them to the nearest walkable cell. Returns
+    None if no walkable cell exists reachable from from_cell."""
+    import heapq
+
+    if from_cell not in blocked:
+        return from_cell  # already walkable
+
+    # BFS to find nearest walkable cell; start with distance 0 so immediate neighbours
+    # might be reachable even if from_cell itself is blocked.
+    dist: dict[tuple[int, int], int] = {}
+    pq: list[tuple[int, tuple[int, int]]] = []
+
+    # Try all 8 neighbours first (distance 1)
+    for dx in (-1, 0, 1):
+        for dy in (-1, 0, 1):
+            if dx == 0 and dy == 0:
+                continue
+            nx, ny = from_cell[0] + dx, from_cell[1] + dy
+            if not (0 <= nx < width and 0 <= ny < height):
+                continue
+            cell = (nx, ny)
+            if cell not in blocked:
+                return cell  # immediate neighbour is walkable
+            dist[cell] = 1
+            heapq.heappush(pq, (1, cell))
+
+    # BFS from blocked neighbours to find further walkable cells
+    while pq:
+        d, (cx, cy) = heapq.heappop(pq)
+        if d > dist.get((cx, cy), d):
+            continue
+        for dx in (-1, 0, 1):
+            for dy in (-1, 0, 1):
+                if dx == 0 and dy == 0:
+                    continue
+                nx, ny = cx + dx, cy + dy
+                if not (0 <= nx < width and 0 <= ny < height):
+                    continue
+                cell = (nx, ny)
+                if cell not in blocked:
+                    return cell  # found a walkable cell
+                nd = d + 1
+                if nd < dist.get(cell, nd + 1):
+                    dist[cell] = nd
+                    heapq.heappush(pq, (nd, cell))
+
+    return None
+
+
