+
+
+# ── MOVEMENT ADVISORIES: movement_illegal + move_blocked are captured in the result ────
+
+
+def test_movement_illegal_over_budget_captured_in_result(grid_fight):
+    """When a move exceeds the mover's speed budget, move_to_coords returns movement_illegal.
+    This advisory should be captured in resolved['result']."""
+    cid, hero, gob = grid_fight
+    # Hero has speed 30 (6-cell budget at cell size 5). Move 7 cells (over budget).
+    out = combat_loop.resolve_player_turn(
+        cid, hero, Intent(kind="move", to_cell=(7, 0)), advance=False
+    )
+    assert out["ok"] is True, out
+    # The move still happened (advisory-not-block).
+    assert _cell(cid, hero) == (7, 0)
+    # The advisory should be in the result.
+    assert "movement_illegal" in out["resolved"]["result"]
+    assert out["resolved"]["result"]["movement_illegal"]["budget_cells"] == 6
+    assert out["resolved"]["result"]["movement_illegal"]["used_cells"] == 0
+    assert out["resolved"]["result"]["movement_illegal"]["cost_cells"] == 7
+
+
+def test_move_blocked_captured_in_result(grid_fight):
+    """When a move targets a blocked/impassable cell, move_to_coords returns move_blocked.
+    This advisory should be captured in resolved['result']."""
+    cid, hero, gob = grid_fight
+    # Add an impassable wall at (3, 0).
+    c = server._require(cid)
+    c.combat.grid_impassable = [[3, 0]]
+    save_campaign(c)
+    # Try to move to the blocked cell.
+    out = combat_loop.resolve_player_turn(
+        cid, hero, Intent(kind="move", to_cell=(3, 0)), advance=False
+    )
+    assert out["ok"] is True, out
+    # The hero should not have moved (it was blocked).
+    assert _cell(cid, hero) == (0, 0)
+    # The move_blocked advisory should be in the result.
+    assert "move_blocked" in out["resolved"]["result"]
+    assert out["resolved"]["result"]["move_blocked"]["target"] == [3, 0]
+
+
+def test_legal_move_has_no_advisories(grid_fight):
+    """A legal, in-budget move should have no extra advisory keys in the result."""
+    cid, hero, gob = grid_fight
+    # Move 2 cells (well within the 6-cell budget).
+    out = combat_loop.resolve_player_turn(
+        cid, hero, Intent(kind="move", to_cell=(2, 0)), advance=False
+    )
+    assert out["ok"] is True, out
+    assert _cell(cid, hero) == (2, 0)
+    # The result should only contain to_cell and to_zone, no advisories.
+    result = out["resolved"]["result"]
+    assert set(result.keys()) == {"to_cell", "to_zone"}
+    assert "movement_illegal" not in result
+    assert "move_blocked" not in result
