+def _leaf_engine(tmp_path):
+    config = LCMConfig(database_path=str(tmp_path / "leaf-cut.db"), fresh_tail_count=1)
+    return LCMEngine(config=config, hermes_home=str(tmp_path / "hermes"))
+
+
+def test_oldest_leaf_chunk_never_ends_inside_tool_group(tmp_path):
+    engine = _leaf_engine(tmp_path)
+    messages = [
+        _user("old " * 20),
+        *_tool_group(payload_a="a " * 20, payload_b="b " * 200),
+        _user("new"),
+    ]
+    # Budget fits the user row, the assistant and the first result only.
+    budget = sum(count_message_tokens(message) for message in messages[:3])
+    try:
+        chunk = engine._select_oldest_leaf_chunk(messages, budget)
+    finally:
+        engine.shutdown()
+
+    assert chunk == messages[:1]
+
+
+def test_oldest_leaf_chunk_takes_whole_group_when_it_opens_the_backlog(tmp_path):
+    engine = _leaf_engine(tmp_path)
+    messages = [*_tool_group(payload_a="a " * 200, payload_b="b " * 200), _user("new")]
+    try:
+        chunk = engine._select_oldest_leaf_chunk(messages, 1)
+    finally:
+        engine.shutdown()
+
+    assert chunk == messages[:3]
