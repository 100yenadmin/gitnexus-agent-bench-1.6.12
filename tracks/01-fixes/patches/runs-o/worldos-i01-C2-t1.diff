 from __future__ import annotations
 
 import combat_ai
+import combat_grid
+import pytest
+from types import SimpleNamespace
 from combat_ai import (
     AoeSpellOption,
     AttackOption,
@@ -66,6 +69,74 @@ def _greedy(view) -> Intent:
     return combat_ai.pick_action(actor=object(), combat_state=view, policy="greedy-v1")
 
 
+# Greedy movement must use the same terrain rules as the engine (#1269).
+@pytest.mark.parametrize("policy", ["greedy-v1", "unknown-policy"])
+@pytest.mark.parametrize("wall_rows", [range(1, 12), range(12), range(4, 7)])
+def test_greedy_approach_stays_reachable_with_wall(policy, wall_rows):
+    wall = {(5, y) for y in wall_rows}
+    v = _view([AttackOption(name="Claw", to_hit=5, damage_expr="1d6")],
+              [_foe("t", cell=(8, 5))], actor_cell=(2, 5), blocking=wall)
+    intent = combat_ai.pick_action(object(), v, policy=policy)
+    assert intent.kind == "move"
+    route = combat_grid.shortest_path((2, 5), intent.to_cell, {(8, 5)}, 12, 12,
+                                     impassable=wall)
+    assert route is not None
+    assert not wall.intersection(route)
+    assert combat_grid.path_cost_cells((2, 5), intent.to_cell, route) <= 6
+    if len(wall) > 3:
+        assert intent.to_cell[0] < 5
+    else:
+        assert intent.to_cell[0] > 5  # a short wall can be routed around this turn
+
+
+def test_greedy_approach_prefers_cheaper_equal_distance_cell():
+    v = _view([AttackOption(name="Claw", to_hit=5, damage_expr="1d6")],
+              [_foe("t", cell=(5, 0))], actor_cell=(0, 0),
+              difficult=[(4, 0)])
+    # (4, 0) is also within budget, but costs 5 cells rather than 4.
+    assert _greedy(v).to_cell == (4, 1)
+
+
+def test_greedy_approach_dodges_when_enclosed():
+    wall = {(x, y) for x in range(1, 4) for y in range(4, 7)} - {(2, 5)}
+    v = _view([AttackOption(name="Claw", to_hit=5, damage_expr="1d6")],
+              [_foe("t", cell=(8, 5))], actor_cell=(2, 5), blocking=wall)
+    assert _greedy(v).kind == "dodge"
+
+
+def test_greedy_retreat_stays_reachable_with_wall(monkeypatch):
+    monkeypatch.setattr(combat_ai, "RETREAT_FRACTION", 0.5)
+    wall = {(5, y) for y in range(12)}
+    v = _view([], [_foe("t", cell=(0, 5))], actor_cell=(2, 5), blocking=wall)
+    intent = combat_ai.pick_action(SimpleNamespace(max_hp=20, current_hp=1), v)
+    assert intent.kind == "disengage"
+    route = combat_grid.shortest_path((2, 5), intent.to_cell, {(0, 5)}, 12, 12,
+                                     impassable=wall)
+    assert route is not None
+    assert not wall.intersection(route)
+    assert combat_grid.path_cost_cells((2, 5), intent.to_cell, route) <= 6
+    assert intent.to_cell[0] < 5
+
+
+def test_greedy_retreat_prefers_cheaper_equal_distance_cell(monkeypatch):
+    monkeypatch.setattr(combat_ai, "RETREAT_FRACTION", 0.5)
+    v = _view([], [_foe("t", cell=(0, 0))], actor_cell=(1, 0), speed=15,
+              w=4, h=3, difficult=[(3, 2)])
+    intent = combat_ai.pick_action(SimpleNamespace(max_hp=20, current_hp=1), v)
+    assert intent.kind == "disengage"
+    # (3, 2) is also within budget, but costs 3 cells rather than 2.
+    assert intent.to_cell == (3, 1)
+
+
+def test_greedy_open_floor_picks_preserved(monkeypatch):
+    v = _view([AttackOption(name="Claw", to_hit=5, damage_expr="1d6")],
+              [_foe("t", cell=(8, 5))], actor_cell=(2, 5))
+    assert _greedy(v).to_cell == (7, 4)
+    monkeypatch.setattr(combat_ai, "RETREAT_FRACTION", 0.5)
+    intent = combat_ai.pick_action(SimpleNamespace(max_hp=20, current_hp=1), v)
+    assert intent.to_cell == (0, 11)
+
