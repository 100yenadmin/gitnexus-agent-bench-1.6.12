+# -- #836: home-scoped keys and deletion hygiene -----------------------------------------------
+
+def test_lineage_keys_isolate_equal_roots_in_shared_store_and_resolve_symlinks(tmp_path):
+    one, two = tmp_path / "one", tmp_path / "two"
+    one.mkdir()
+    two.mkdir()
+    alias = tmp_path / "alias"
+    alias.symlink_to(one, target_is_directory=True)
+    for home in (one, two):
+        _state_db(home, [("S", None, None)])
+    engine = LCMEngine(config=LCMConfig(database_path=str(tmp_path / "lcm.db")), hermes_home=str(one))
+    engine.on_session_start("S", platform="cli", context_length=200_000)
+    try:
+        key_one = engine._host_uid_lineage_key()
+        assert key_one == (_lineage(one), None)
+        engine._hermes_home = str(two)
+        key_two = engine._host_uid_lineage_key()
+        assert key_two == (_lineage(two), None)
+        assert key_one != key_two
+        ids = [engine._store.append("S", _m("user", text)) for text in ("one", "two")]
+        for key, store_id in zip((key_one[0], key_two[0]), ids):
+            engine._store.add_host_uid_bindings(key, [(store_id, "same-uid", "canonical", "stored_new")])
+        assert engine._store.host_uid_bindings_for(key_one[0], ["same-uid"])["same-uid"] == [(ids[0], "canonical")]
+        assert engine._store.host_uid_bindings_for(key_two[0], ["same-uid"])["same-uid"] == [(ids[1], "canonical")]
+        engine._hermes_home = str(alias)
+        assert engine._host_uid_lineage_key() == key_one
+    finally:
+        engine.shutdown()
+
+
+def _delete_shadow_session(engine, path):
+    if path == "store":
+        assert engine._store.delete_session_messages("cron-delete") == 1
+    else:
+        result = handle_lcm_command("doctor clean apply", engine)
+        assert "status: ok" in result, result
+        assert "messages_deleted: 1" in result, result
+
+
+@pytest.mark.parametrize("path", ["store", "doctor"])
+@pytest.mark.parametrize("bindings", [False, True])
+def test_delete_removes_only_deleted_ids_bindings_without_creating_table(tmp_path, path, bindings):
+    # Model legacy stores whose plain INTEGER PRIMARY KEY can reuse a deleted id.
+    conn = sqlite3.connect(tmp_path / "lcm.db")
+    conn.execute("CREATE TABLE messages (store_id INTEGER PRIMARY KEY, session_id TEXT NOT NULL, "
+                 "role TEXT NOT NULL, content TEXT, tool_call_id TEXT, tool_calls TEXT, tool_name TEXT, "
+                 "token_estimate INTEGER DEFAULT 0, timestamp REAL NOT NULL, pinned INTEGER DEFAULT 0)")
+    conn.close()
+    engine = LCMEngine(config=LCMConfig(database_path=str(tmp_path / "lcm.db"),
+                                      doctor_clean_apply_enabled=True, ignore_session_patterns=["cron*"]))
+    engine.on_session_start("live", platform="cli", context_length=200_000)
+    try:
+        kept = engine._store.append("live", _m("user", "keep"))
+        deleted = engine._store.append("cron-delete", _m("user", "delete"))
+        if bindings:
+            engine._store.add_host_uid_bindings("home:root", [
+                (kept, "keep", "canonical", "stored_new"),
+                (deleted, "delete", "canonical", "stored_new"),
+                (deleted, "delete", "version", "version_new"),
+                (deleted, "alias", "alias_candidate", "unknown"),
+            ])
+        _delete_shadow_session(engine, path)
+        assert engine._store.get_session_messages("cron-delete") == []
+        assert len(engine._store.get_session_messages("live")) == 1
+        assert _has_table(engine) is bindings
+        assert [b[:2] for b in _bindings(engine)] == ([(kept, "keep")] if bindings else [])
+        reused = engine._store.append("new", _m("user", "new row"))
+        assert reused == deleted
+        assert all(b[0] != reused for b in _bindings(engine))
+    finally:
+        engine.shutdown()
+
+
+@pytest.mark.parametrize("path", ["store", "doctor"])
+def test_delete_failure_rolls_back_shadow_bindings_and_messages(tmp_path, path):
+    engine = LCMEngine(config=LCMConfig(database_path=str(tmp_path / "lcm.db"),
+                                      doctor_clean_apply_enabled=True, ignore_session_patterns=["cron*"]))
+    engine.on_session_start("live", platform="cli", context_length=200_000)
+    try:
+        deleted = engine._store.append("cron-delete", _m("user", "delete"))
+        engine._store.add_host_uid_bindings("home:root", [(deleted, "delete", "canonical", "stored_new")])
+        before = _bindings(engine)
+        conn = engine._store.connection
+        conn.execute("CREATE TRIGGER fail_message_delete BEFORE DELETE ON messages "
+                     "BEGIN SELECT RAISE(ABORT, 'delete failed'); END")
+        conn.commit()
+        if path == "store":
+            with pytest.raises(sqlite3.IntegrityError, match="delete failed"):
+                engine._store.delete_session_messages("cron-delete")
+        else:
+            result = handle_lcm_command("doctor clean apply", engine)
+            assert "cleanup apply rolled back" in result
+        assert not conn.in_transaction
+        assert _bindings(engine) == before
+        assert len(engine._store.get_session_messages("cron-delete")) == 1
+    finally:
+        engine.shutdown()
