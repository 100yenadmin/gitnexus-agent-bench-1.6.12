+    @staticmethod
+    def _join_background_integrity_scans() -> None:
+        from hermes_lcm import db_bootstrap
+
+        while True:
+            with db_bootstrap._integrity_scan_lock:
+                threads = list(db_bootstrap._integrity_scan_threads.values())
+            if not threads:
+                return
+            for thread in threads:
+                thread.join(10)
+
+    @staticmethod
+    def _hold_wal_write_slot(db_path: Path) -> sqlite3.Connection:
+        writer = sqlite3.connect(str(db_path), timeout=0.01, isolation_level=None)
+        writer.execute("PRAGMA busy_timeout=1")
+        writer.execute("PRAGMA journal_mode=WAL")
+        writer.execute("BEGIN IMMEDIATE")
+        return writer
+
+    def test_deepcopy_on_current_schema_db_succeeds_under_active_writer(self, tmp_path):
+        """#363: current-schema startup must not need the SQLite write slot."""
+        from hermes_lcm.engine import LCMEngine
+
+        def host_selects_context_engine(candidate):
+            try:
+                return copy.deepcopy(candidate)
+            except Exception:
+                return "built-in-compressor-fallback"
+
+        db_path = tmp_path / "lcm-current-schema.db"
+        config = LCMConfig(database_path=str(db_path))
+        prototype = LCMEngine(config=config, hermes_home=str(tmp_path / "hermes"))
+        prototype._store.append("seed-session", {"role": "user", "content": "hello"})
+        self._join_background_integrity_scans()
+        clone = None
+        writer = self._hold_wal_write_slot(db_path)
+        try:
+            clone = host_selects_context_engine(prototype)
+
+            assert clone != "built-in-compressor-fallback"
+            assert isinstance(clone, LCMEngine)
+            assert clone._store is not prototype._store
+        finally:
+            writer.execute("ROLLBACK")
+            writer.close()
+            prototype.shutdown()
+            shutdown = getattr(clone, "shutdown", None)
+            if callable(shutdown):
+                shutdown()
+
+    def test_outdated_schema_stamp_still_migrates_and_fails_closed_under_writer(self, tmp_path, monkeypatch):
+        db_path = tmp_path / "lcm-stale-stamp.db"
+        MessageStore(db_path).close()
+        self._join_background_integrity_scans()
+        conn = sqlite3.connect(str(db_path))
+        conn.execute("UPDATE metadata SET value = '4' WHERE key = 'schema_version'")
+        conn.commit()
+        conn.close()
+
+        from hermes_lcm import db_bootstrap
+
+        monkeypatch.setattr(db_bootstrap, "SQLITE_BUSY_TIMEOUT_MS", 50)
+        writer = self._hold_wal_write_slot(db_path)
+        try:
+            with pytest.raises(sqlite3.OperationalError, match="locked"):
+                MessageStore(db_path)
+        finally:
+            writer.execute("ROLLBACK")
+            writer.close()
+
+        MessageStore(db_path).close()
+        conn = sqlite3.connect(str(db_path))
+        try:
+            row = conn.execute(
+                "SELECT value FROM metadata WHERE key = 'schema_version'"
+            ).fetchone()
+            assert row[0] == str(SCHEMA_VERSION)
+        finally:
+            conn.close()
+
+    def test_legacy_ingested_at_rows_still_repair_and_fail_closed_under_writer(self, tmp_path, monkeypatch):
+        db_path = tmp_path / "lcm-legacy-rows.db"
+        store = MessageStore(db_path)
+        store_id = store.append("legacy-session", {"role": "user", "content": "old"})
+        store.close()
+        self._join_background_integrity_scans()
+        conn = sqlite3.connect(str(db_path))
+        conn.execute("UPDATE messages SET ingested_at = NULL WHERE store_id = ?", (store_id,))
+        conn.commit()
+        conn.close()
+
+        from hermes_lcm import db_bootstrap
+
+        monkeypatch.setattr(db_bootstrap, "SQLITE_BUSY_TIMEOUT_MS", 50)
+        writer = self._hold_wal_write_slot(db_path)
+        try:
+            with pytest.raises(sqlite3.OperationalError, match="locked"):
+                MessageStore(db_path)
+        finally:
+            writer.execute("ROLLBACK")
+            writer.close()
+
+        MessageStore(db_path).close()
+        conn = sqlite3.connect(str(db_path))
+        try:
+            row = conn.execute(
+                "SELECT ingested_at, timestamp FROM messages WHERE store_id = ?",
+                (store_id,),
+            ).fetchone()
+            assert row[0] is not None
+            assert row[0] == row[1]
+        finally:
+            conn.close()
+
 
