     assert all(ch.stage_cell is None for ch in restored.characters.values())
+
+
+# ── #1511: a stander on a since-impassable cell is never trapped ──────────────────────
+
+
+def test_movers_own_impassable_cell_is_not_in_its_blocked_set(room):
+    """#1511: rest_blocked_cells promises a mover never blocks itself — that must hold for
+    TERRAIN too. A Hero left standing on the crate prop (4,2) (an old save, or a combat
+    write-back) is excluded from its OWN blocked set; everyone else still sees the cell blocked."""
+    cid, hero, ally, loc_id = room
+    c = server._require(cid)
+    c.characters[hero].stage_cell = (4, 2)  # the crate cell
+    loc = c.locations[loc_id]
+    _w, _h, mine = server.rest_blocked_cells(c, loc, exclude_id=hero)
+    assert (4, 2) not in mine
+    assert (2, 1) in mine and (2, 2) in mine  # real walls stay blocked for the mover
+    _w, _h, theirs = server.rest_blocked_cells(c, loc, exclude_id=ally)
+    assert (4, 2) in theirs  # the Hero still occupies it for anyone else
+
+
+def test_movers_own_occupied_cell_is_not_blocked_even_when_stacked(room):
+    """Occupancy half of the same promise: even if another stander shares the mover's cell, the
+    mover's own cell is never in its blocked set (it must be able to step off)."""
+    cid, hero, ally, loc_id = room
+    c = server._require(cid)
+    c.characters[ally].stage_cell = (0, 0)  # stacked on the Hero
+    _w, _h, mine = server.rest_blocked_cells(c, c.locations[loc_id], exclude_id=hero)
+    assert (0, 0) not in mine
+
+
+def test_stander_on_crate_cell_can_walk_to_adjacent_open_cell(room):
+    cid, hero, _ally, _loc = room
+    c = server._require(cid)
+    c.characters[hero].stage_cell = (4, 2)
+    server.save_campaign(c)
+    out = server.walk_to(cid, hero, 4, 1)
+    assert out["walked"] is True
+    assert out["path"] == [[4, 2], [4, 1]]
+    assert tuple(server._require(cid).characters[hero].stage_cell) == (4, 1)
+
+
+def test_stander_on_crate_cell_is_already_adjacent_for_approach(room):
+    """_nearest_walkable_adjacent treats the mover's own (now unblocked) crate cell as a legal
+    "already adjacent" spot instead of reporting no reachable approach."""
+    cid, hero, _ally, loc_id = room
+    c = server._require(cid)
+    c.characters[hero].stage_cell = (4, 2)
