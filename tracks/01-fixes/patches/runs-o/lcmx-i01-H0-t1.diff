+    def get_session_depths(self, session_id: str) -> List[int]:
+        """Return all distinct depths for a session, with no row cap.
+
+        Returns an empty list for an unknown session. This is used by context
+        assembly to ensure all depths are visible regardless of the number of
+        leaf nodes.
+        """
+        with self._db_lock:
+            rows = self._conn.execute(
+                """SELECT DISTINCT depth FROM summary_nodes
+                   WHERE session_id = ?
+                   ORDER BY depth""",
+                (session_id,),
+            ).fetchall()
+        return [int(row[0]) for row in rows]
+
