+/** Route handlers, named (variant for the engine check: same flows as the inline-callback version). */
+export function handleBlame(req: express.Request, res: express.Response): void {
+  const file = req.query.file as string;
+  res.json(blameSummary(file));
+}
+
+export function handleSnippet(req: express.Request, res: express.Response): void {
+  const rel = req.query.path as string;
+  res.type('text/plain').send(readSnippet(rel));
+}
+
+export function handleCommitSubject(req: express.Request, res: express.Response): void {
+  const ref = req.query.ref as string;
+  try {
+    res.json({ subject: commitSubject(ref) });
+  } catch {
+    res.status(400).json({ error: 'invalid ref' });
+  }
+}
+
+export function makeFilterHandler(listRows: () => Promise<Record<string, unknown>[]>) {
+  return async function handleFilter(req: express.Request, res: express.Response): Promise<void> {
+    const expr = req.body.filter as string;
+    res.json(filterRows(await listRows(), expr));
+  };
+}
+
+export function handleLicense(_req: express.Request, res: express.Response): void {
+  res.type('text/plain').send(licenseText());
+}
+
+/** Inline-callback flow with the sink in the callback itself (intra-procedural control). */
+export function handleBlameInline(req: express.Request, res: express.Response): void {
+  res.type('text/plain').send(execSync('git log -1 --format=%an -- ' + (req.query.file as string), { cwd: SNIPPET_ROOT, encoding: 'utf8' }));
+}
