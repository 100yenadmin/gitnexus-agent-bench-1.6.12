diff --git a/servers/engine/tests/test_stuck_cell.py b/servers/engine/tests/test_stuck_cell.py
new file mode 100644
index 0000000..3168e62
--- /dev/null
+++ b/servers/engine/tests/test_stuck_cell.py
@@ -0,0 +1,155 @@
+"""#1511: a character standing on a NEWLY impassable cell (a crate/bedroll/fire/wall made solid
+by #1507, reached via an old save or an end-of-combat write-back) must not be treated as trapped.
+
+INVARIANTS pinned here:
+  * rest_blocked_cells never puts the mover's own cell in its blocked set — terrain OR occupancy.
+  * walk_to lets a stander on a crate cell step to an adjacent open cell.
+  * combat_grid.shortest_path / reachable exempt the start cell from occupied/impassable checks
+    and never return the start as a destination.
+  * end_combat moves a survivor whose final combat cell is rest-blocked to the nearest walkable
+    rest cell.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+import server  # imported FIRST: resolves the models<->scene_grid import cycle in the right order
+import combat_grid
+from scene_grid import SceneCell, SceneCellDefault, SceneGrid, SceneGridSpec, SceneProp
+
+
+def _crate_room(location_id: str = "loc") -> SceneGrid:
+    """A 5x3 room: a crate at (4,2), a wall at (2,1)/(2,2) (gap at (2,0))."""
+    cells = [SceneCell(c=2, r=r, type="wall", walkable=False) for r in (1, 2)]
+    props = [SceneProp(id="crate", kind="crates", cells=[(4, 2)], anchor_cell=(4, 2))]
+    cells.append(SceneCell(c=4, r=2, type="prop", walkable=False, prop_ref="crate"))
+    return SceneGrid(
+        scene_id=f"w:{location_id}", location_id=location_id, kind="dungeon",
+        grid=SceneGridSpec(cols=5, rows=3, cell_size_ft=5),
+        cell_default=SceneCellDefault(type="floor", walkable=True, cost=1),
+        cells=cells, props=props,
+    )
+
+
+@pytest.fixture
+def room(tmp_path, monkeypatch):
+    """Hero stands ON the crate cell (4,2) — an old save from before the crate was solid."""
+    monkeypatch.setenv("WORLDOS_STATE_DIR", str(tmp_path))
+    cid = server.create_campaign("#1511 stuck cell")["id"]
+    loc_id = server.add_location(cid, "The Camp")["id"]
+    hero = server.create_character(cid, "Hero", kind="player", max_hp=30)["id"]
+    ally = server.create_character(cid, "Ally", kind="companion", max_hp=20)["id"]
+    goblin = server.create_character(cid, "Goblin", kind="monster", max_hp=7)["id"]
+    c = server._require(cid)
+    c.locations[loc_id].scene_grid = _crate_room(loc_id)
+    c.characters[hero].stage_cell = (4, 2)
+    c.characters[ally].stage_cell = (0, 0)
+    server.save_campaign(c)
+    return cid, hero, ally, goblin, loc_id
+
+
+# ── combat_grid: start-cell exemption ─────────────────────────────────────────────────
+
+
+def test_shortest_path_leaves_impassable_start():
+    path = combat_grid.shortest_path((1, 1), (2, 1), set(), 3, 3, impassable={(1, 1)})
+    assert path == [(2, 1)]
+
+
+def test_shortest_path_leaves_occupied_start():
+    path = combat_grid.shortest_path((1, 1), (2, 1), {(1, 1)}, 3, 3)
+    assert path == [(2, 1)]
+
+
+def test_shortest_path_never_steps_back_onto_start():
+    path = combat_grid.shortest_path((0, 0), (2, 0), set(), 3, 1, impassable={(0, 0)})
+    assert path == [(1, 0), (2, 0)]
+    assert (0, 0) not in path
+
+
+def test_reachable_from_impassable_start_excludes_start():
+    reach = combat_grid.reachable((1, 1), 1, {(1, 1)}, 3, 3, impassable={(1, 1)})
+    assert (1, 1) not in reach
+    assert len(reach) == 8  # every neighbour is reachable off the blocked start
+
+
+# ── rest_blocked_cells: own cell never blocked ────────────────────────────────────────
+
+
+def test_rest_blocked_cells_excludes_movers_own_impassable_cell(room):
+    cid, hero, ally, _goblin, loc_id = room
+    c = server._require(cid)
+    loc = c.locations[loc_id]
+    _w, _h, blocked = server.rest_blocked_cells(c, loc, exclude_id=hero)
+    assert (4, 2) not in blocked  # hero's own crate cell — not a trap
+    assert (2, 1) in blocked and (0, 0) in blocked  # walls + other standers still block
+    # For any OTHER mover the hero's crate cell still blocks (occupied).
+    _w, _h, blocked_ally = server.rest_blocked_cells(c, loc, exclude_id=ally)
+    assert (4, 2) in blocked_ally
+
+
+def test_rest_blocked_cells_excludes_own_npc_spawn_on_prop(room):
+    cid, hero, _ally, _goblin, loc_id = room
+    c = server._require(cid)
+    loc = c.locations[loc_id]
+    c.locations[loc_id].scene_grid.spawns = {"npc:barkeep": [(4, 2)]}
+    c.characters[hero].stage_cell = (3, 0)
+    _w, _h, blocked = server.rest_blocked_cells(c, loc, exclude_id="barkeep")
+    assert (4, 2) not in blocked
+
+
+# ── walk_to off a crate cell ──────────────────────────────────────────────────────────
+
+
+def test_walk_to_off_crate_cell_to_adjacent_open_cell(room):
+    cid, hero, _ally, _goblin, _loc = room
+    out = server.walk_to(cid, hero, 3, 2)
+    assert out["walked"] is True, out
+    assert out["path"] == [[4, 2], [3, 2]]
+    c = server._require(cid)
+    assert tuple(c.characters[hero].stage_cell) == (3, 2)
+
+
+def test_walk_to_cannot_reenter_crate_cell(room):
+    cid, hero, _ally, _goblin, _loc = room
+    server.walk_to(cid, hero, 3, 2)
+    out = server.walk_to(cid, hero, 4, 2)
+    assert out["walked"] is False
+
+
+# ── end_combat write-back relocation ──────────────────────────────────────────────────
+
+
+def _end_fight_with_hero_at(cid, hero, ally, goblin, cell):
+    server.start_combat(cid, [hero, ally, goblin], seed_from_stage=True)
+    c = server._require(cid)
+    cb = next(cb for cb in c.combat.order if cb.character_id == hero)
+    cb.x, cb.y = cell  # the fight's own grid allowed this cell
+    server.save_campaign(c)
+    server.end_combat(cid, resolution="the goblin fled")
+    return server._require(cid)
+
+
+def test_end_combat_moves_survivor_off_rest_blocked_prop(room):
+    cid, hero, ally, goblin, _loc = room
+    c = _end_fight_with_hero_at(cid, hero, ally, goblin, (4, 2))
+    sc = tuple(c.characters[hero].stage_cell)
+    assert sc != (4, 2)
+    assert combat_grid.chebyshev_cells(sc, (4, 2)) == 1  # nearest walkable neighbour
+    assert sc not in {(2, 1), (2, 2)}
+    assert tuple(c.characters[ally].stage_cell) == (0, 0)  # fine cell untouched
+
+
+def test_end_combat_moves_survivor_off_wall(room):
+    cid, hero, ally, goblin, _loc = room
+    c = _end_fight_with_hero_at(cid, hero, ally, goblin, (2, 2))
+    sc = tuple(c.characters[hero].stage_cell)
+    assert sc not in {(2, 1), (2, 2), (4, 2), (0, 0)}
+    assert combat_grid.chebyshev_cells(sc, (2, 2)) == 1
+
+
+def test_end_combat_keeps_open_floor_cell(room):
+    cid, hero, ally, goblin, _loc = room
+    c = _end_fight_with_hero_at(cid, hero, ally, goblin, (1, 1))
+    assert tuple(c.characters[hero].stage_cell) == (1, 1)  # open floor: kept exactly
