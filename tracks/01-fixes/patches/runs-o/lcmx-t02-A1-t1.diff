@@ -192,6 +192,21 @@ def _parse_int_value(value: Any, default: int) -> int:
         return default
 
 
+def _coerce_query_arg(value: Any) -> str:
+    """Normalize a tool ``query`` argument to stripped text.
+
+    Models sometimes send ``null`` (notably right after compaction) or a bare
+    number. ``None`` and non-scalar values become ``""`` so callers return the
+    documented "No query provided" error; numbers are searched as their text
+    form (``0`` -> ``"0"``).
+    """
+    if isinstance(value, str):
+        return value.strip()
+    if isinstance(value, (int, float)) and not isinstance(value, bool):
+        return str(value).strip()
+    return ""
+
+
 def _parse_non_negative_int(value: Any, default: int) -> int:
     return max(0, _parse_int_value(value, default))
 
