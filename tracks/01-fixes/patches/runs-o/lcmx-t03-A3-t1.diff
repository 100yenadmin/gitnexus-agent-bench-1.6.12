diff --git a/tests/test_embedding_backfill.py b/tests/test_embedding_backfill.py
index 673dbdd..dca2f72 100644
--- a/tests/test_embedding_backfill.py
+++ b/tests/test_embedding_backfill.py
@@ -200,6 +200,65 @@ def test_dry_run_reports_counts_tokens_and_cost_without_calls_or_writes(
     assert provider.calls == []
 
 
+_BLANK_SUMMARIES = ("", "   ", "\v\f", "　\n\t")
+
+
+def _blank_leaf_summaries(engine, node_ids: list[int]) -> None:
+    conn = sqlite3.connect(engine._store.db_path)
+    try:
+        conn.executemany(
+            "UPDATE summary_nodes SET summary = ? WHERE node_id = ?",
+            zip(_BLANK_SUMMARIES, node_ids),
+        )
+        conn.commit()
+    finally:
+        conn.close()
+
+
+def test_blank_leaf_summaries_are_never_counted_or_sent(monkeypatch, tmp_path):
+    engine = _engine(tmp_path)
+    node_ids = _seed(engine, 6)
+    blank_ids = node_ids[1:5]
+    _blank_leaf_summaries(engine, blank_ids)
+    provider = FakeProvider()
+    monkeypatch.setattr(command_mod, "resolve_provider", lambda _config, **_kw: provider)
+
+    preview = handle_lcm_command("embed backfill", engine)
+
+    assert "pending: 2" in preview
+    assert "selected: 2" in preview
+    assert provider.calls == []
+
+    applied = handle_lcm_command("embed backfill --apply", engine)
+
+    assert "status: complete" in applied
+    assert "embedded: 2" in applied
+    assert "remaining: 0" in applied
+    assert provider.calls == [["summary-5", "summary-0"]]
+    assert _meta_ids(engine) == [str(node_ids[0]), str(node_ids[5])]
+
+
+def test_retry_uncertain_skips_blank_summary_and_keeps_its_marker(
+    monkeypatch, tmp_path
+):
+    engine = _engine(tmp_path)
+    node_ids = _seed(engine, 2)
+    _blank_leaf_summaries(engine, [node_ids[0]])
+    _mark_uncertain(engine, node_ids)
+    provider = FakeProvider()
+    monkeypatch.setattr(command_mod, "resolve_provider", lambda _config, **_kw: provider)
+
+    result = handle_lcm_command(
+        "embed backfill --apply --retry-uncertain --limit 5", engine
+    )
+
+    assert "selected: 1" in result
+    assert "embedded: 1" in result
+    assert provider.calls == [["summary-1"]]
+    assert _meta_ids(engine) == [str(node_ids[1])]
+    assert _inflight_rows(engine) == [(str(node_ids[0]), "uncertain")]
+
+
