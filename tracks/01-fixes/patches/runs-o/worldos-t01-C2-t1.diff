+@pytest.mark.parametrize("target_x, blocked", [(3, False), (7, False), (3, True)])
+def test_move_result_preserves_advisories(grid_fight, target_x, blocked):
+    cid, hero, _ = grid_fight
+    if blocked:
+        c = server._require(cid)
+        c.combat.grid_impassable = [[target_x, 0]]
+        server.save_campaign(c)
+
+    out = combat_loop.resolve_player_turn(cid, hero, Intent(kind="move", to_cell=(target_x, 0)))
+
+    assert out["ok"] is True, out
+    assert out["turn_open"] is True
+    result = out["resolved"]["result"]
+    expected = {"to_cell": (target_x, 0), "to_zone": ""}
+    if blocked:
+        note = result["move_blocked"]
+        assert note["target"] == [target_x, 0]
+        assert "impassable" in note["reason"]
+        expected["move_blocked"] = note
+        assert _cell(cid, hero) == (0, 0)
+        assert server._require(cid).combat.order[0].moved_cells_this_turn == 0
+    else:
+        assert _cell(cid, hero) == (target_x, 0)
+        if target_x > 6:
+            note = result["movement_illegal"]
+            assert note["budget_cells"] == 6
+            assert note["cost_cells"] == target_x
+            assert note["used_cells"] == 0
+            assert "Moved anyway" in note["reason"]
+            expected["movement_illegal"] = note
+    assert result == expected
+
+
