+def test_dry_run_skips_blank_summaries(tmp_path):
+    """Blank summaries are not counted as pending or selected."""
+    engine = _engine(tmp_path)
+    dag = SummaryDAG(engine._store.db_path)
+    try:
+        # Create 3 valid summaries and 2 blank ones
+        valid_ids = [
+            dag.add_node(SummaryNode(
+                session_id="session-a",
+                depth=0,
+                summary=f"valid-{i}",
+                source_token_count=100 + i,
+                created_at=float(i + 1),
+                latest_at=float(i + 1),
+            ))
+            for i in range(3)
+        ]
+        # Add blank summaries: empty string and whitespace-only
+        blank_ids = [
+            dag.add_node(SummaryNode(
+                session_id="session-a",
+                depth=0,
+                summary="",  # empty
+                source_token_count=100,
+                created_at=10.0,
+                latest_at=10.0,
+            )),
+            dag.add_node(SummaryNode(
+                session_id="session-a",
+                depth=0,
+                summary="  \v\f\t  ",  # Unicode whitespace
+                source_token_count=100,
+                created_at=12.0,
+                latest_at=12.0,
+            )),
+        ]
+        dag.add_node(SummaryNode(
+            session_id="session-a",
+            depth=1,
+            summary="not a leaf",
+            created_at=20.0,
+        ))
+    finally:
+        dag.close()
+
+    store = VectorStore(engine._store.db_path, config=engine._config)
+    try:
+        store.register_profile("model-a", "ollama", 2)
+    finally:
+        store.close()
+
+    result = handle_lcm_command("embed backfill", engine)
+
+    # Only the 3 valid summaries should be counted as pending
+    assert "pending: 3" in result
+    assert "selected: 3" in result
+    assert "status: dry-run" in result
+    # No provider calls in dry-run
+
+
+def test_apply_skips_blank_summaries(monkeypatch, tmp_path):
+    """Blank summaries are not sent to the provider."""
+    engine = _engine(tmp_path)
+    dag = SummaryDAG(engine._store.db_path)
+    try:
+        # Create 3 valid summaries and 2 blank ones
+        valid_ids = [
+            dag.add_node(SummaryNode(
+                session_id="session-a",
+                depth=0,
+                summary=f"valid-{i}",
+                source_token_count=100 + i,
+                created_at=float(i + 1),
+                latest_at=float(i + 1),
+            ))
+            for i in range(3)
+        ]
+        dag.add_node(SummaryNode(
+            session_id="session-a",
+            depth=0,
+            summary="",  # empty
+            source_token_count=100,
+            created_at=10.0,
+            latest_at=10.0,
+        ))
+        dag.add_node(SummaryNode(
+            session_id="session-a",
+            depth=0,
+            summary="  \t  ",  # whitespace-only
+            source_token_count=100,
+            created_at=11.0,
+            latest_at=11.0,
+        ))
+    finally:
+        dag.close()
+
+    store = VectorStore(engine._store.db_path, config=engine._config)
+    try:
+        store.register_profile("model-a", "ollama", 2)
+    finally:
+        store.close()
+
+    provider = FakeProvider()
+    monkeypatch.setattr(command_mod, "resolve_provider", lambda _config, **_kw: provider)
+
+    result = handle_lcm_command("embed backfill --apply", engine)
+
+    # Only 3 valid summaries should be embedded
+    assert "embedded: 3" in result
+    assert "remaining: 0" in result
+    # Provider should receive only valid summaries
+    assert len(provider.calls) == 1  # one batch
+    assert len(provider.calls[0]) == 3  # three documents
+    assert all("valid-" in str(text) for text in provider.calls[0])
+
