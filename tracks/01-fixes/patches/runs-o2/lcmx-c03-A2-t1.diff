+# -- #836: bindings go with their rows; the lineage key names the Hermes home ----------------------------
+
+def _delete_session(engine: LCMEngine, path: str, session_id: str) -> None:
+    import hermes_lcm.command as command_mod
+
+    if path == "delete_session_messages":
+        engine._store.delete_session_messages(session_id)
+    else:
+        engine.on_session_start("other", platform="cli", context_length=200_000, conversation_id="conv2")
+        command_mod._delete_clean_candidates_atomically(engine, {session_id})
+    assert not engine._store.get_session_messages(session_id)
+
+
+@pytest.mark.parametrize("path", ["delete_session_messages", "doctor_clean"])
+def test_836_deleting_a_sessions_rows_deletes_their_bindings_only(tmp_path, path):
+    _state_db(tmp_path, [("S", None, None)])
+    engine = _engine(tmp_path)
+    try:
+        engine.ingest(_UID_LIST)
+        kept = engine._store.append("O", {"role": "user", "content": "other session" + PAD})
+        engine._store.add_host_uid_bindings(_key(tmp_path, "O"), [(kept, "u-other", "canonical", "seed")])
+        assert {b[1] for b in _bindings(engine)} > {"u-other"}
+        _delete_session(engine, path, "S")
+        assert _bindings(engine) == [(kept, "u-other", "O", "canonical", 1, "seed")]
+    finally:
+        engine.shutdown()
+
+
+@pytest.mark.parametrize("path", ["delete_session_messages", "doctor_clean"])
+def test_836_a_store_without_the_table_deletes_as_before_and_does_not_create_it(tmp_path, path):
+    engine = _engine(tmp_path)  # no state.db: nothing is ever bound
+    try:
+        engine.ingest(_UID_LIST)
+        assert not _has_table(engine)
+        _delete_session(engine, path, "S")
+        assert not _has_table(engine)
+    finally:
+        engine.shutdown()
+
+
+def test_836_a_reused_store_id_inherits_no_binding(tmp_path):
+    _state_db(tmp_path, [("S", None, None)])
+    engine = _engine(tmp_path)
+    try:
+        engine.ingest(_UID_LIST)
+        bound = {b[0] for b in _bindings(engine)}
+        engine._store.delete_session_messages("S")
+        conn = engine._store._conn
+        for store_id in bound:  # what a plain INTEGER PRIMARY KEY may hand out again
+            conn.execute("INSERT INTO messages(store_id, session_id, role, content, timestamp) "
+                         "VALUES (?, 'S2', 'user', 'reused', 1.0)", (store_id,))
+        conn.commit()
+        assert engine._store.host_uid_uids_of_stores(_key(tmp_path, "S"), bound) == {}
+    finally:
+        engine.shutdown()
+
+
+def test_836_two_homes_with_the_same_root_keep_separate_bindings(tmp_path):
+    for name in ("one", "two"):
+        (tmp_path / name).mkdir()
+        _state_db(tmp_path / name, [("S", None, None)])
+    engine = LCMEngine(config=LCMConfig(database_path=str(tmp_path / "lcm.db")), hermes_home=str(tmp_path / "one"))
+    engine.on_session_start("S", platform="cli", context_length=200_000)
+    try:
+        one = engine._host_uid_lineage_key()[0]
+        engine._hermes_home = str(tmp_path / "two")
+        two = engine._host_uid_lineage_key()[0]
+        assert one == _key(tmp_path / "one", "S") and two == _key(tmp_path / "two", "S") and one != two
+        assert re.fullmatch(r"[0-9a-f]{16}:S", one)
+        stored = engine._store.append("S", {"role": "user", "content": "x" + PAD})
+        engine._store.add_host_uid_bindings(one, [(stored, "u-1", "canonical", "seed")])
+        assert engine._store.host_uid_bindings_for(two, {"u-1"}) == {}
+        assert engine._store.host_uid_bindings_for(one, {"u-1"}) == {"u-1": [(stored, "canonical")]}
+    finally:
+        engine.shutdown()
+
+
+def test_836_a_symlinked_home_gives_the_same_tag(tmp_path):
+    real = tmp_path / "real"
+    real.mkdir()
+    _state_db(real, [("S", None, None)])
+    (tmp_path / "link").symlink_to(real, target_is_directory=True)
+    engine = LCMEngine(config=LCMConfig(database_path=str(tmp_path / "lcm.db")), hermes_home=str(tmp_path / "link"))
+    engine.on_session_start("S", platform="cli", context_length=200_000)
+    try:
+        assert engine._host_uid_lineage_key() == (_key(real, "S"), None)
+    finally:
+        engine.shutdown()
