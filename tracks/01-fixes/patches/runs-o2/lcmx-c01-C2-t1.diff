+def tool_group_safe_end(messages: Sequence[Dict[str, Any]], end: int) -> int:
+    """Keep an oldest-prefix cut outside a declared assistant/tool group.
+
+    Retreat to the opening assistant, or include its results when retreating
+    would leave no prefix. Ambiguous result ownership leaves the cut unchanged.
+    """
+    if end <= 0 or end >= len(messages) or messages[end].get("role") != "tool":
+        return end
+
+    start = end - 1
+    while start >= 0 and messages[start].get("role") == "tool":
+        start -= 1
+    if start < 0 or messages[start].get("role") != "assistant":
+        return end
+    call_ids = {
+        call_id
+        for call in (messages[start].get("tool_calls") or [])
+        if (call_id := _tool_call_id(call))
+    }
+    if not call_ids:
+        return end
+
+    pending = set(call_ids)
+    group_end = start + 1
+    while group_end < len(messages) and messages[group_end].get("role") == "tool":
+        result_id = str(messages[group_end].get("tool_call_id") or "").strip()
+        if not result_id or result_id not in call_ids:
+            return end
+        pending.discard(result_id)
+        group_end += 1
+        if not pending:
+            break
+
+    if end >= group_end:
+        return end
+    return start if start > 0 else group_end
+
+
