diff --git a/servers/engine/tests/test_combat_greedy_terrain.py b/servers/engine/tests/test_combat_greedy_terrain.py
new file mode 100644
index 0000000..6dc88f7
--- /dev/null
+++ b/servers/engine/tests/test_combat_greedy_terrain.py
@@ -0,0 +1,180 @@
+"""Greedy-v1 terrain-aware movement (#1269).
+
+The default `greedy-v1` policy (also the fallback for an unknown policy) must route its
+move-to-reach and retreat-if-low moves AROUND the fight's `blocking` cells (walls/props) and
+prefer cheaper ground over `difficult` terrain — the same Dijkstra the engine uses to legalise a
+move. On OPEN floor (no blocking, no difficult) the picks are byte-identical to the legacy
+open-floor step, which the parity tests pin against an inline reference of the old algorithm.
+
+Pure + LLM-free: build a CombatView, assert the Intent.
+"""
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import pytest
+
+import combat_ai
+import combat_grid
+from combat_ai import AttackOption, CombatantView, CombatView, Intent
+
+
+def _view(foes, *, actor_cell, speed=30, w=12, h=12, blocking=(), difficult=(), attacks=None):
+    return CombatView(
+        actor_id="A",
+        actor_cell=actor_cell,
+        actor_zone="",
+        actor_side="enemy",
+        speed=speed,
+        dashed=False,
+        grid_enabled=True,
+        grid_width=w,
+        grid_height=h,
+        cell_size=5,
+        foes=tuple(foes),
+        allies=(),
+        attacks=tuple(attacks if attacks is not None else
+                      [AttackOption(name="Claw", to_hit=5, damage_expr="1d8+3", reach_ft=5)]),
+        spells=(),
+        blocking=tuple(blocking),
+        difficult=tuple(difficult),
+    )
+
+
+def _foe(fid, cell, hp=20):
+    return CombatantView(id=fid, name=fid, side="party", current_hp=hp, max_hp=hp,
+                         armor_class=12, cell=cell)
+
+
+def _greedy(view, actor=None) -> Intent:
+    return combat_ai.pick_action(actor=actor or object(), combat_state=view, policy="greedy-v1")
+
+
+def _routed_cost(view, cell):
+    """The engine-legal move cost to `cell` (None when no route exists)."""
+    occupied = {f.cell for f in view.foes if f.cell is not None} - {view.actor_cell}
+    blocking, difficult = set(view.blocking), set(view.difficult)
+    route = combat_grid.shortest_path(view.actor_cell, cell, occupied, view.grid_width,
+                                      view.grid_height, impassable=blocking, difficult=difficult)
+    if route is None:
+        return None
+    return combat_grid.path_cost_cells(view.actor_cell, cell, route, difficult=difficult)
+
+
+def _budget(view):
+    return combat_grid.movement_budget_cells(view.speed, view.cell_size, view.dashed)
+
+
+# ── Approach (step 4: move-to-reach) ─────────────────────────────────────────────────
+
+def test_issue_repro_out_of_reach_melee_routes_around_wall_gap():
+    """#1269 repro: 12x12, monster (2,5), foe (8,5), wall x=5 for y=1..11 (gap at (5,0)). The move
+    cell must be reachable this turn by routing through the gap — never straight across the wall."""
+    wall = [(5, y) for y in range(1, 12)]
+    v = _view([_foe("hero", (8, 5))], actor_cell=(2, 5), blocking=wall)
+    intent = _greedy(v)
+    assert intent.kind == "move"
+    cell = tuple(intent.to_cell)
+    assert cell not in wall
+    cost = _routed_cost(v, cell)
+    assert cost is not None and cost <= _budget(v)
+    # And it still makes progress toward the foe.
+    assert combat_grid.distance_ft(cell, (8, 5), 5) < combat_grid.distance_ft((2, 5), (8, 5), 5)
+
+
+def test_solid_wall_keeps_the_move_on_the_actor_side():
+    """A wall spanning the whole grid: no route exists to the foe's side, so the move stays on the
+    actor's side (never a cell behind the wall)."""
+    wall = [(5, y) for y in range(12)]
+    v = _view([_foe("hero", (8, 5))], actor_cell=(2, 5), blocking=wall)
+    intent = _greedy(v)
+    if intent.kind == "move":
+        assert intent.to_cell[0] < 5
+        cost = _routed_cost(v, tuple(intent.to_cell))
+        assert cost is not None and cost <= _budget(v)
+
+
+def test_difficult_band_move_is_affordable_this_turn():
+    """Difficult terrain along row 0 toward a distant foe: the open-floor pick (6,0) would cost 7
+    cells through the band (budget 6). Greedy must pick a cell whose ROUTED cost fits the budget."""
+    difficult = [(x, 0) for x in range(1, 7)]
+    v = _view([_foe("hero", (11, 0))], actor_cell=(0, 0), difficult=difficult)
+    intent = _greedy(v)
+    assert intent.kind == "move"
+    cost = _routed_cost(v, tuple(intent.to_cell))
+    assert cost is not None and cost <= _budget(v)
+
+
+def test_same_distance_prefers_clear_ground_over_difficult():
+    """Two cells equally close to the foe: (2,0) is difficult (routed cost 3), (2,1) is clear (cost 2).
+    Greedy prefers the cheaper ground."""
+    v = _view([_foe("hero", (3, 0))], actor_cell=(0, 0), difficult=[(2, 0)])
+    intent = _greedy(v)
+    assert intent.kind == "move"
+    assert tuple(intent.to_cell) == (2, 1)
+
+
+# ── Retreat-if-low (step 1, morale on) ───────────────────────────────────────────────
+
+def test_retreat_flee_cell_does_not_cross_a_wall(monkeypatch):
+    """Morale on + low HP: the flee cell must be reachable this turn — not past a solid wall."""
+    monkeypatch.setattr(combat_ai, "RETREAT_FRACTION", 0.5)
+    wall = [(7, y) for y in range(12)]
+    v = _view([_foe("hero", (4, 5))], actor_cell=(5, 5), blocking=wall)
+    actor = SimpleNamespace(max_hp=20, current_hp=3)
+    intent = _greedy(v, actor)
+    assert intent.kind == "disengage"
+    cell = tuple(intent.to_cell)
+    assert cell[0] < 7
+    cost = _routed_cost(v, cell)
+    assert cost is not None and cost <= _budget(v)
+
+
+def test_retreat_flee_cell_affordable_through_difficult(monkeypatch):
+    """A difficult band the actor would have to cross to reach the farthest open-floor flee cell: the
+    chosen flee cell must still be affordable this turn by the routed cost."""
+    monkeypatch.setattr(combat_ai, "RETREAT_FRACTION", 0.5)
+    difficult = [(x, y) for x in range(7, 12) for y in range(12)]
+    v = _view([_foe("hero", (2, 5))], actor_cell=(4, 5), difficult=difficult)
+    actor = SimpleNamespace(max_hp=20, current_hp=3)
+    intent = _greedy(v, actor)
+    assert intent.kind == "disengage"
+    cost = _routed_cost(v, tuple(intent.to_cell))
+    assert cost is not None and cost <= _budget(v)
+
+
+# ── Open-floor parity: byte-identical to the legacy picks ────────────────────────────
+
+def _legacy_step(view, target_cell):
+    budget = _budget(view)
+    occupied = {f.cell for f in view.foes if f.cell is not None} - {view.actor_cell}
+    reach = combat_grid.reachable(view.actor_cell, budget, occupied, view.grid_width, view.grid_height)
+    best = min(reach, key=lambda c: (combat_grid.distance_ft(c, target_cell, 5), c))
+    cur = combat_grid.distance_ft(view.actor_cell, target_cell, 5)
+    return best if combat_grid.distance_ft(best, target_cell, 5) < cur else None
+
+
+def _legacy_flee(view, threat_cell):
+    budget = _budget(view)
+    occupied = {f.cell for f in view.foes if f.cell is not None} - {view.actor_cell}
+    reach = combat_grid.reachable(view.actor_cell, budget, occupied, view.grid_width, view.grid_height)
+    return max(reach, key=lambda c: (combat_grid.distance_ft(c, threat_cell, 5), c))
+
+
+@pytest.mark.parametrize("actor_cell,foe_cell", [
+    ((2, 5), (8, 5)), ((0, 0), (11, 11)), ((11, 0), (0, 11)), ((5, 5), (5, 11)), ((3, 9), (10, 2)),
+])
+def test_open_floor_move_is_unchanged(actor_cell, foe_cell):
+    v = _view([_foe("hero", foe_cell)], actor_cell=actor_cell)
+    intent = _greedy(v)
+    assert intent.kind == "move"
+    assert tuple(intent.to_cell) == _legacy_step(v, foe_cell)
+
+
+@pytest.mark.parametrize("actor_cell,foe_cell", [((5, 5), (4, 5)), ((0, 0), (1, 1)), ((6, 6), (6, 7))])
+def test_open_floor_retreat_is_unchanged(monkeypatch, actor_cell, foe_cell):
+    monkeypatch.setattr(combat_ai, "RETREAT_FRACTION", 0.5)
+    v = _view([_foe("hero", foe_cell)], actor_cell=actor_cell)
+    intent = _greedy(v, SimpleNamespace(max_hp=20, current_hp=3))
+    assert intent.kind == "disengage"
+    assert tuple(intent.to_cell) == _legacy_flee(v, foe_cell)
