--- a/hermes_cli/plugins_loader.py
+++ b/hermes_cli/plugins_loader.py
@@ -265,6 +265,31 @@ class PluginLoaderMixin:
             return
         self._register_deferred_platform_tools(manifest, loaded)
 
+    def rearm_failed_platform(self, platform_name: str) -> bool:
+        """Re-publish a failed platform's loader; its next registry lookup retries the load.
+
+        Ordinary lookups remain one-shot. The reconnect watcher explicitly re-arms failures at
+        its backoff cadence, using this manager's immutable profile scope and ownership ledger.
+        """
+        from gateway.platform_registry import platform_registry
+
+        with self._discovery_lock, replacement_coordinator.transaction():
+            for plugin_key, loaded in self._plugins.items():
+                manifest = loaded.manifest
+                if (manifest.kind != "platform" or loaded.error is None or loaded.deferred
+                        or self._platform_name_from_manifest(manifest) != platform_name):
+                    continue
+                # Never displace another registration or re-arm an already pending loader.
+                if platform_registry.snapshot_registration(platform_name, scope=self.scope_key) != (None, None):
+                    return False
+                if not self._lease_deferred_platform(manifest, plugin_key):
+                    return False
+                loaded.error = None
+                loaded.enabled = True
+                loaded.deferred = True
+                return True
+        return False
+
     @_serialized_replacement
     def _lease_deferred_platform(self, manifest: PluginManifest, lookup_key: str) -> bool:
         """Publish the deferred loader as a ledger-owned lease; False when the registry refused it."""
