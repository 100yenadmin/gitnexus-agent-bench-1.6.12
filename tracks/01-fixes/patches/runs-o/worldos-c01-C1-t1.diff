+    }})
+    return cid, ids, cur
 
 
 def test_second_action_same_turn_is_flagged(combat):
@@ -46,3 +52,135 @@ def test_next_turn_refreshes_the_budget(combat):
     server.next_turn(cid)
     new_cur = server.get_state(cid)["current_turn"]
     assert server.use_action(cid, new_cur, "action")["ok"] is True  # fresh turn
+
+
+def _attack(combat):
+    cid, ids, cur = combat
+    target = next(i for i in ids if i != cur)
+    return server.attack(cid, cur, target, attack_bonus=0, damage_dice="1")
+
+
+@pytest.mark.parametrize("first", ["cast", "attack", "action", "skip"])
+def test_action_cast_shares_the_action_budget(combat, first):
+    cid, _ids, cur = combat
+    if first == "cast":
+        server.cast_spell(cid, cur, "Fire Bolt")
+    elif first == "attack":
+        _attack(combat)
+    else:
+        assert server.use_action(cid, cur, first)["ok"]
+    before = server.get_character(cid, cur)
+    with pytest.raises(ValueError, match="already used its action"):
+        server.cast_spell(cid, cur, "Fireball")
+    assert server.get_character(cid, cur) == before
+
+
+@pytest.mark.parametrize("first,reason", [("cast", "already cast a spell"), ("skip", "skipped this turn")])
+def test_attack_refuses_cast_or_skip(combat, first, reason):
+    cid, _ids, cur = combat
+    if first == "cast":
+        server.cast_spell(cid, cur, "Fire Bolt")
+    else:
+        server.use_action(cid, cur, "skip")
+    with pytest.raises(ValueError, match=reason):
+        _attack(combat)
+
+
+@pytest.mark.parametrize("srd_only", [False, True])
+@pytest.mark.parametrize("following", ["action", "cast", "attack"])
+def test_bonus_cast_leaves_action_available(combat, monkeypatch, srd_only, following):
+    cid, _ids, cur = combat
+    if srd_only:
+        original = spells.spell_data
+
+        def srd_healing_word(name):
+            if name == "Healing Word":
+                raise ValueError("use SRD record")
+            return original(name)
+
+        monkeypatch.setattr(spells, "spell_data", srd_healing_word)
+    server.cast_spell(cid, cur, "Healing Word")
+    assert not server.use_action(cid, cur, "bonus")["ok"]
+    with pytest.raises(ValueError, match="already used its bonus action"):
+        server.cast_spell(cid, cur, "Healing Word")
+    if following == "action":
+        assert server.use_action(cid, cur, "action")["ok"]
+    elif following == "cast":
+        server.cast_spell(cid, cur, "Fireball")
+    else:
+        _attack(combat)
+
+
+def test_bonus_cast_after_action_cast(combat):
+    cid, _ids, cur = combat
+    server.cast_spell(cid, cur, "Fire Bolt")
+    server.cast_spell(cid, cur, "Healing Word")
+    assert not server.use_action(cid, cur, "action")["ok"]
+
+
+@pytest.mark.parametrize("spell", ["Identify", "Resurrection"])
+def test_long_casts_refused_in_active_combat(combat, spell):
+    cid, _ids, cur = combat
+    before = server.get_character(cid, cur)
+    with pytest.raises(ValueError, match="casting time"):
+        server.cast_spell(cid, cur, spell)
+    assert server.get_character(cid, cur) == before
+    assert server.use_action(cid, cur, "action")["ok"]
+
+
+@pytest.mark.parametrize("first", ["cast", "attack", "action", "skip"])
+@pytest.mark.parametrize("following", ["cast", "attack", "action"])
+def test_action_surge_reopens_one_action(combat, first, following):
+    cid, _ids, cur = combat
+    server.set_class_resource(cid, cur, "action_surge", max=1, recharge="short")
+    server.update_character(cid, cur, {"extra_attacks": 1})
+    if first == "cast":
+        server.cast_spell(cid, cur, "Fire Bolt")
+    elif first == "attack":
+        _attack(combat)  # only half of the first Attack action
+    else:
+        server.use_action(cid, cur, first)
+    server.use_resource(cid, cur, "action_surge")
+    if following == "cast":
+        server.cast_spell(cid, cur, "Fire Bolt")
+        with pytest.raises(ValueError, match="already cast a spell"):
+            _attack(combat)
+    elif following == "action":
+        assert server.use_action(cid, cur, "action")["ok"]
+    else:
+        for _ in range(3 if first == "attack" else 2):
+            _attack(combat)
+        with pytest.raises(ValueError, match="no attacks left"):
+            _attack(combat)
+    with pytest.raises(ValueError, match="already used its action"):
+        server.cast_spell(cid, cur, "Fire Bolt")
+
+
+def test_declared_attack_action_and_extra_attack_still_work(combat):
+    cid, _ids, cur = combat
+    server.update_character(cid, cur, {"extra_attacks": 1})
+    assert server.use_action(cid, cur, "action")["ok"]
+    _attack(combat)
+    _attack(combat)
+    with pytest.raises(ValueError, match="no attacks left"):
+        _attack(combat)
+
+
+@pytest.mark.parametrize("purpose", ["cast", "skip"])
+def test_next_turn_resets_action_purpose(combat, purpose):
+    cid, _ids, cur = combat
+    if purpose == "cast":
+        server.cast_spell(cid, cur, "Fire Bolt")
+    else:
+        server.use_action(cid, cur, "skip")
+    assert server._require(cid).combat.action_purpose == purpose
+    server.next_turn(cid)
+    assert server._require(cid).combat.action_purpose == ""
+    new_cur = server.get_state(cid)["current_turn"]
+    server.cast_spell(cid, new_cur, "Fire Bolt")
+
+
+def test_old_combat_snapshots_default_action_purpose():
+    snapshot = Combat(action_used=True).model_dump()
+    snapshot.pop("action_purpose")
+    assert Combat.model_validate(snapshot).action_purpose == ""
