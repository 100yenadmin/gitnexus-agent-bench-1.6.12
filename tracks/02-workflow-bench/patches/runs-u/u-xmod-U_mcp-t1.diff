diff --git a/gitnexus/test/unit/parse-retry.test.ts b/gitnexus/test/unit/parse-retry.test.ts
new file mode 100644
index 0000000..95535d4
--- /dev/null
+++ b/gitnexus/test/unit/parse-retry.test.ts
@@ -0,0 +1,115 @@
+import { describe, it, expect } from 'vitest';
+import {
+  classifyParseFailure,
+  createParseRetryTracker,
+  parseRetryBackoffMs,
+  DEFAULT_PARSE_MAX_RETRIES,
+} from '../../src/core/ingestion/workers/parse-retry.js';
+
+describe('classifyParseFailure', () => {
+  it.each([
+    'Worker 0 error: EMFILE: too many open files, open /repo/a.ts',
+    'Worker 1 error: spawn EAGAIN',
+    'Worker 2 error: ENOMEM: not enough memory, read',
+    'Worker 0 error: read ETIMEDOUT',
+    'Worker 3 error: Resource temporarily unavailable',
+  ])('classifies %j as transient', (reason) => {
+    expect(classifyParseFailure(reason)).toBe('transient');
+  });
+
+  it.each([
+    'Worker 0 error: Unexpected token\nSyntaxError: Unexpected token at parse-worker.js:10',
+    "Worker 0 error: Cannot read properties of undefined (reading 'type')\nTypeError: ...",
+    'Worker 0 error: Maximum call stack size exceeded\nRangeError: ...',
+    'Worker 0 error: parse error in src/foo.py',
+    'Worker 0 exited with code 139. Likely OOM or native addon failure (in-flight: a.c).',
+    'Worker 0 error: ERR_WORKER_OUT_OF_MEMORY (worker hit its 2048MB heap cap)',
+    'Worker 0 messageerror (postMessage deserialization failure): boom',
+    '',
+  ])('classifies %j as deterministic', (reason) => {
+    expect(classifyParseFailure(reason)).toBe('deterministic');
+  });
+
+  it('lets a deterministic marker override a transient signature', () => {
+    expect(classifyParseFailure('Worker 0 error: EAGAIN\nTypeError: x is not a function')).toBe(
+      'deterministic',
+    );
+  });
+});
+
+describe('parseRetryBackoffMs', () => {
+  it('grows exponentially and is capped', () => {
+    const max = () => 0.999999;
+    expect(parseRetryBackoffMs(1, 200, 2000, max)).toBe(200);
+    expect(parseRetryBackoffMs(2, 200, 2000, max)).toBe(400);
+    expect(parseRetryBackoffMs(3, 200, 2000, max)).toBe(800);
+    expect(parseRetryBackoffMs(10, 200, 2000, max)).toBe(2000);
+  });
+
+  it('never drops below half the ceiling (no immediate retry)', () => {
+    expect(parseRetryBackoffMs(1, 200, 2000, () => 0)).toBe(100);
+    expect(parseRetryBackoffMs(2, 200, 2000, () => 0)).toBe(200);
+  });
+});
+
+describe('createParseRetryTracker', () => {
+  const transient = 'Worker 0 error: EMFILE: too many open files';
+  const deterministic = 'Worker 0 error: boom\nSyntaxError: Unexpected token';
+
+  it('retries a transient failure up to 2 times, then marks the file failed', () => {
+    expect(DEFAULT_PARSE_MAX_RETRIES).toBe(2);
+    const tracker = createParseRetryTracker({ random: () => 0 });
+
+    const first = tracker.recordFailure('a.ts', transient);
+    expect(first).toMatchObject({ action: 'retry', kind: 'transient', retry: 1 });
+
+    const second = tracker.recordFailure('a.ts', transient);
+    expect(second).toMatchObject({ action: 'retry', kind: 'transient', retry: 2 });
+    if (first.action === 'retry' && second.action === 'retry') {
+      expect(second.delayMs).toBeGreaterThan(first.delayMs);
+    }
+
+    expect(tracker.recordFailure('a.ts', transient)).toEqual({
+      action: 'fail',
+      kind: 'transient',
+      failures: 3,
+    });
+    expect(tracker.retriesFor('a.ts')).toBe(2);
+  });
+
+  it('never retries a deterministic parse error', () => {
+    const tracker = createParseRetryTracker();
+    expect(tracker.recordFailure('b.py', deterministic)).toEqual({
+      action: 'fail',
+      kind: 'deterministic',
+      failures: 1,
+    });
+    expect(tracker.retriesFor('b.py')).toBe(0);
+  });
+
+  it('fails a file immediately when a deterministic error follows a transient retry', () => {
+    const tracker = createParseRetryTracker();
+    expect(tracker.recordFailure('c.go', transient).action).toBe('retry');
+    expect(tracker.recordFailure('c.go', deterministic)).toEqual({
+      action: 'fail',
+      kind: 'deterministic',
+      failures: 2,
+    });
+  });
+
+  it('tracks retry budgets independently per file', () => {
+    const tracker = createParseRetryTracker();
+    tracker.recordFailure('x.ts', transient);
+    tracker.recordFailure('x.ts', transient);
+    expect(tracker.recordFailure('x.ts', transient).action).toBe('fail');
+    expect(tracker.recordFailure('y.ts', transient)).toMatchObject({ action: 'retry', retry: 1 });
+  });
+
+  it('honours a custom retry budget', () => {
+    const tracker = createParseRetryTracker({ maxRetries: 0 });
+    expect(tracker.recordFailure('z.ts', transient)).toMatchObject({
+      action: 'fail',
+      failures: 1,
+    });
+  });
+});
