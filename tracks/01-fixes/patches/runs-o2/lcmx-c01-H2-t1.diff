diff --git a/fresh_tail.py b/fresh_tail.py
index f9ae35c..9b1730e 100644
--- a/fresh_tail.py
+++ b/fresh_tail.py
@@ -14,6 +14,108 @@ from .message_analysis import _tool_call_id
 from .tokens import count_message_tokens, count_messages_tokens
 
 
+def tool_group_safe_end(messages: Sequence[Dict[str, Any]], end: int) -> int:
+    """Ensure a chunk boundary doesn't split a tool-call group.
+
+    When cutting a leaf chunk at position `end`, verify the boundary doesn't
+    orphan tool result messages by splitting an assistant/tool group.
+
+    Returns:
+    - If `end` is outside any group: unchanged
+    - If `end` is inside a group and there's a prefix: the group's assistant index
+    - If `end` is inside a group at the start: extend through the group's results
+    - If an assistant has tool_calls but we'd cut before results: retreat to before assistant
+    - If a result's tool_call_id is missing or unmatched: return `end` unchanged
+    """
+    if end <= 0 or end > len(messages):
+        return end
+
+    # Check if we're ending right at or after an assistant with tool_calls
+    if end > 0 and messages[end - 1].get("role") == "assistant":
+        assistant_call_ids = {
+            _tool_call_id(tool_call)
+            for tool_call in (messages[end - 1].get("tool_calls") or [])
+        }
+        if assistant_call_ids:
+            # Assistant has declared tool_calls; check if we'd orphan them
+            # Look ahead to see if there are matching results after our cut
+            has_declared_results = any(
+                end < len(messages)
+                and messages[i].get("role") == "tool"
+                and str(messages[i].get("tool_call_id") or "").strip() in assistant_call_ids
+                for i in range(end, len(messages))
+            )
+            if has_declared_results:
+                # We'd be cutting between the assistant and its tool results
+                # Either extend to include all or retreat to exclude the assistant
+                if end - 1 == 0:
+                    # Assistant is at start of chunk; extend to include all results
+                    group_end = end
+                    while group_end < len(messages) and messages[group_end].get("role") == "tool":
+                        result_id = str(messages[group_end].get("tool_call_id") or "").strip()
+                        if not result_id or result_id not in assistant_call_ids:
+                            break
+                        group_end += 1
+                    return group_end
+                else:
+                    # There's content before; retreat to exclude the assistant
+                    return end - 1
+
+    # Check if we're ending inside a tool-result group
+    # Scan backwards from end-1 to find any tool results
+    scan_pos = end - 1
+    while scan_pos >= 0 and messages[scan_pos].get("role") == "tool":
+        scan_pos -= 1
+
+    # Check if there are any tool results from scan_pos+1 to end
+    has_tool_results = any(
+        messages[i].get("role") == "tool"
+        for i in range(max(0, scan_pos + 1), end)
+    )
+
+    if not has_tool_results:
+        return end  # Outside a group (or no results yet)
+
+    # Verify all messages from scan_pos+1 to end are tool results
+    if not all(
+        messages[i].get("role") == "tool"
+        for i in range(max(0, scan_pos + 1), end)
+    ):
+        return end  # Mixed message types; not inside a clean group
+
+    # Now check if scan_pos is an assistant with tool_calls
+    if scan_pos < 0 or messages[scan_pos].get("role") != "assistant":
+        return end  # No opening assistant found
+
+    # Verify all tool results have matching call IDs
+    assistant_call_ids = {
+        _tool_call_id(tool_call)
+        for tool_call in (messages[scan_pos].get("tool_calls") or [])
+    }
+
+    for i in range(scan_pos + 1, end):
+        result_id = str(messages[i].get("tool_call_id") or "").strip()
+        if not result_id or result_id not in assistant_call_ids:
+            # Orphaned or mismatched result; return end unchanged
+            return end
+
+    # We're inside a complete tool-call group
+    group_start = scan_pos
+
+    if group_start == 0:
+        # Group starts at beginning of chunk; extend through all results
+        group_end = group_start + 1
+        while group_end < len(messages) and messages[group_end].get("role") == "tool":
+            result_id = str(messages[group_end].get("tool_call_id") or "").strip()
+            if not result_id or result_id not in assistant_call_ids:
+                break
+            group_end += 1
+        return group_end
+    else:
+        # There's content before the group; retreat to the group start
+        return group_start
+
+
 @dataclass(frozen=True)
 class FreshTailBoundary:
     """Resolved protected-tail metadata for one ordered message sequence."""
