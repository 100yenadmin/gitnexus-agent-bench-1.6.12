diff --git a/gitnexus/test/unit/status-json-alias.test.ts b/gitnexus/test/unit/status-json-alias.test.ts
new file mode 100644
index 0000000..6870bbe
--- /dev/null
+++ b/gitnexus/test/unit/status-json-alias.test.ts
@@ -0,0 +1,53 @@
+import { spawnSync } from 'node:child_process';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { CLI_SPAWN_PREFIX } from '../helpers/cli-entry.js';
+
+let tmpDir: string;
+
+function runStatus(args: string[]) {
+  return spawnSync(process.execPath, [...CLI_SPAWN_PREFIX, 'status', ...args], {
+    cwd: tmpDir,
+    encoding: 'utf8',
+    env: { ...process.env, GITNEXUS_HOME: tmpDir, GITNEXUS_LANG: 'en' },
+  });
+}
+
+function jsonLine(stdout: string): unknown {
+  const line = stdout
+    .split('\n')
+    .map((l) => l.trim())
+    .find((l) => l.startsWith('{'));
+  expect(line, stdout).toBeDefined();
+  return JSON.parse(line!);
+}
+
+describe('gitnexus status -j alias', () => {
+  beforeEach(() => {
+    tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'gitnexus-status-json-alias-'));
+  });
+
+  afterEach(() => {
+    fs.rmSync(tmpDir, { recursive: true, force: true });
+  });
+
+  it('documents -j as the short form of --json in help', () => {
+    const result = runStatus(['--help']);
+
+    expect(result.status).toBe(0);
+    expect(result.stdout).toContain('-j, --json');
+  });
+
+  it('-j emits the same machine-readable output as --json', () => {
+    const long = runStatus(['--json']);
+    const short = runStatus(['-j']);
+
+    expect(long.status, long.stderr).toBe(0);
+    expect(short.status, short.stderr).toBe(0);
+    expect(short.stderr).not.toContain('unknown option');
+    expect(jsonLine(short.stdout)).toEqual(jsonLine(long.stdout));
+    expect(jsonLine(short.stdout)).toMatchObject({ schemaVersion: 1 });
+  });
+});
