+        {"role": "user", "content": f"release {query} shipped"},
+    )
+    # No provider forces semantic/hybrid through their full-text fallback, which
+    # previously re-raised the AttributeError inside "full-text fallback failed".
+    monkeypatch.setattr(lcm_tools, "resolve_provider", lambda _config: None)
+
+    payload = json.loads(
+        lcm_tools.lcm_grep({"query": query, "mode": mode}, engine=semantic_engine)
+    )
+
+    assert "error" not in payload, payload
+    # Snippet highlighting splits "0.0" into ">>>0<<<.>>>0<<<", so assert on hits.
+    assert [hit["store_id"] for hit in payload["results"]] == [1]
