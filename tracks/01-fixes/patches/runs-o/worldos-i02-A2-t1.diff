+def _nearest_free_rest_cell(
+    start: tuple[int, int], width: int, height: int, blocked: set[tuple[int, int]]
+) -> tuple[int, int] | None:
+    """The nearest walkable rest cell to ``start`` (which may itself be blocked — a survivor on a
+    crate). Prefers cells REACHABLE from ``start`` (``reachable`` exempts the start, so a stander on
+    a prop can step off it) so nobody lands in a walled-off pocket; falls back to any free in-bounds
+    cell when ``start`` is fully enclosed. Ranked by Chebyshev distance, then a stable (y, x)
+    tiebreak. None when the grid has no free cell at all."""
+    sx = min(max(int(start[0]), 0), width - 1)
+    sy = min(max(int(start[1]), 0), height - 1)
+    origin = (sx, sy)
+    pool = combat_grid.reachable(origin, width + height, set(), width, height, impassable=blocked)
+    if origin not in blocked:
+        pool.add(origin)  # an off-grid start clamped onto a free edge cell lands right there
+    if not pool:
+        pool = {
+            (x, y) for x in range(width) for y in range(height) if (x, y) not in blocked
+        }
+    if not pool:
+        return None
+    return min(pool, key=lambda cell: (combat_grid.chebyshev_cells(cell, start), cell[1], cell[0]))
+
