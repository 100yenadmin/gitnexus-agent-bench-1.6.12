+/**
+ * Validate the optional `list_repos` `name_contains` filter.
+ *
+ * @internal Exported for unit testing; not part of the public API surface.
+ *
+ * Same validation boundary as {@link parseListReposPagination}: an omitted
+ * value (only `undefined`) means "no filter"; a non-string is REJECTED rather
+ * than coerced. An empty string is a valid needle that matches every name.
+ */
+export function parseListReposNameFilter(
+  params: { name_contains?: unknown } | null | undefined,
+): string | undefined {
+  const value = params?.name_contains;
+  if (value === undefined) return undefined;
+  if (typeof value !== 'string') {
+    throw new Error(
+      `list_repos: "name_contains" must be a string (received ${JSON.stringify(value)})`,
+    );
+  }
+  return value;
+}
+
+/**
+ * Keep only repositories whose name contains `needle`, case-insensitively.
+ * Applied BEFORE pagination so `total` / `hasMore` / `nextOffset` describe the
+ * filtered set. `undefined` returns the input unchanged.
+ *
+ * @internal Exported for unit testing; not part of the public API surface.
+ */
+export function filterReposByName<T extends { name: string }>(
+  repos: T[],
+  needle: string | undefined,
+): T[] {
+  if (needle === undefined) return repos;
+  const lowered = needle.toLowerCase();
+  return repos.filter((repo) => repo.name.toLowerCase().includes(lowered));
+}
