diff --git a/fresh_tail.py b/fresh_tail.py
index f9ae35c..8dd5905 100644
--- a/fresh_tail.py
+++ b/fresh_tail.py
@@ -50,6 +50,56 @@ def _assistant_group_start(messages: Sequence[Dict[str, Any]], start: int) -> in
     return start
 
 
+def tool_group_safe_end(messages: Sequence[Dict[str, Any]], end: int) -> int:
+    """Move a prefix cut ``messages[:end]`` off any assistant/tool-result group.
+
+    When the cut falls after an assistant row with ``tool_calls`` or between
+    its sibling results, return the index of that assistant so the whole group
+    stays on the far side.  When the group starts at index 0 (retreating would
+    empty the prefix), extend the cut through the group's declared results
+    instead.  A result without a ``tool_call_id``, or with an id the assistant
+    did not declare, is not treated as part of a group and leaves ``end``
+    unchanged, as does a cut outside any group.
+    """
+    if end <= 0 or end >= len(messages):
+        return end
+    if messages[end].get("role") != "tool":
+        return end
+
+    # Walk back over the results already inside the prefix to the opener.
+    result_ids: list[str] = []
+    index = end
+    while index >= 0 and messages[index].get("role") == "tool":
+        result_id = str(messages[index].get("tool_call_id") or "").strip()
+        if not result_id:
+            return end
+        result_ids.append(result_id)
+        index -= 1
+    if index < 0:
+        return end
+    opener = messages[index]
+    if opener.get("role") != "assistant":
+        return end
+    declared = {
+        call_id
+        for call_id in (_tool_call_id(tool_call) for tool_call in (opener.get("tool_calls") or []))
+        if call_id
+    }
+    if not declared or any(result_id not in declared for result_id in result_ids):
+        return end
+    if index > 0:
+        return index
+
+    # The group opens the sequence: keep it whole by extending forward.
+    extended = end
+    while extended < len(messages) and messages[extended].get("role") == "tool":
+        result_id = str(messages[extended].get("tool_call_id") or "").strip()
+        if not result_id or result_id not in declared:
+            return end
+        extended += 1
+    return extended
+
+
 def resolve_fresh_tail_boundary(
     messages: Sequence[Dict[str, Any]],
     *,
