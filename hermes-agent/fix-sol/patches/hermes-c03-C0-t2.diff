diff --git a/tests/hermes_cli/test_failed_platform_rearm.py b/tests/hermes_cli/test_failed_platform_rearm.py
new file mode 100644
index 00000000..b7f5010a
--- /dev/null
+++ b/tests/hermes_cli/test_failed_platform_rearm.py
@@ -0,0 +1,47 @@
+"""Failed deferred platforms retry only after their manager explicitly rearms them."""
+
+from hermes_cli.plugins import PluginManager, PluginManifest
+
+
+def test_failed_platform_rearm_retries_import_and_owns_the_new_lease(tmp_path, monkeypatch):
+    from gateway.platform_registry import PlatformRegistry
+
+    registry = PlatformRegistry()
+    monkeypatch.setattr("gateway.platform_registry.platform_registry", registry)
+    plugin_dir = tmp_path / "retry_platform"
+    plugin_dir.mkdir()
+    marker = plugin_dir / "attempted"
+    (plugin_dir / "__init__.py").write_text(
+        "from pathlib import Path\n"
+        "def register(ctx):\n"
+        "    marker = Path(__file__).with_name('attempted')\n"
+        "    if not marker.exists():\n"
+        "        marker.touch()\n"
+        "        raise TimeoutError('transient startup contention')\n"
+        "    ctx.register_platform(name='retry_platform', label='Recovered',\n"
+        "        adapter_factory=lambda config: object(), check_fn=lambda: True)\n"
+    )
+    manifest = PluginManifest(
+        name="retry_platform-platform", kind="platform", source="bundled", path=str(plugin_dir),
+    )
+    manager = PluginManager()
+    try:
+        manager._register_deferred_platform(manifest)
+        assert manager.rearm_failed_platform("retry_platform") is False
+        assert registry.get("retry_platform") is None
+        assert marker.exists()
+        assert registry.get("retry_platform") is None  # lookup alone must never retry
+        assert manager.rearm_failed_platform("missing") is False
+        other = PluginManager(scope_key=str(tmp_path / "other"))
+        assert other.rearm_failed_platform("retry_platform") is False
+
+        assert manager.rearm_failed_platform("retry_platform") is True
+        assert manager.rearm_failed_platform("retry_platform") is False  # already pending
+        entry = registry.get("retry_platform")
+        assert entry is not None and entry.label == "Recovered"
+        assert manager.rearm_failed_platform("retry_platform") is False
+        assert manager.unload(manifest) is True
+        assert registry.get("retry_platform") is None  # retry lease remains manager-owned
+        assert manager.rearm_failed_platform("retry_platform") is False
+    finally:
+        manager.unload(manifest)
