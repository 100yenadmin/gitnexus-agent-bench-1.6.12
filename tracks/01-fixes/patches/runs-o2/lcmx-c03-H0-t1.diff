+def _home_tag_from_state_db(path: Path) -> str:
+    """First 16 hex chars of sha256 of the resolved state.db path, so symlinked homes give the same tag."""
+    resolved = str(path.resolve())
+    digest = hashlib.sha256(resolved.encode()).hexdigest()
+    return digest[:16]
