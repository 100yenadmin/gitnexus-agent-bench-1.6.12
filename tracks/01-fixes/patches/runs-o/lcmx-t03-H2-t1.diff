+def test_dry_run_skips_blank_summaries_in_selected_but_counts_in_pending(
+    monkeypatch, tmp_path
+):
+    engine = _engine(tmp_path)
+    dag = SummaryDAG(engine._store.db_path)
+    try:
+        node_ids = [
+            dag.add_node(SummaryNode(
+                session_id="session-a",
+                depth=0,
+                summary="real-summary-0",
+                source_token_count=100,
+                created_at=1.0,
+                latest_at=1.0,
+            )),
+            dag.add_node(SummaryNode(
+                session_id="session-a",
+                depth=0,
+                summary="",
+                source_token_count=100,
+                created_at=2.0,
+                latest_at=2.0,
+            )),
+            dag.add_node(SummaryNode(
+                session_id="session-a",
+                depth=0,
+                summary="   ",
+                source_token_count=100,
+                created_at=4.0,
+                latest_at=4.0,
+            )),
+            dag.add_node(SummaryNode(
+                session_id="session-a",
+                depth=0,
+                summary="\t\n\v\f",
+                source_token_count=100,
+                created_at=5.0,
+                latest_at=5.0,
+            )),
+            dag.add_node(SummaryNode(
+                session_id="session-a",
+                depth=0,
+                summary="real-summary-5",
+                source_token_count=100,
+                created_at=6.0,
+                latest_at=6.0,
+            )),
+        ]
+    finally:
+        dag.close()
+
+    store = VectorStore(engine._store.db_path, config=engine._config)
+    try:
+        store.register_profile("model-a", "ollama", 2)
+    finally:
+        store.close()
+
+    provider = FakeProvider()
+    monkeypatch.setattr(command_mod, "resolve_provider", lambda _config, **_kw: provider)
+
+    result = handle_lcm_command("embed backfill", engine)
+
+    assert "status: dry-run" in result
+    assert "pending: 5" in result
+    assert "selected: 2" in result
+    assert provider.calls == []
+    assert _meta_ids(engine) == []
+
