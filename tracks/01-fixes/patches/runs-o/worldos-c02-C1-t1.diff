diff --git a/servers/engine/tests/test_pending_spell_attack.py b/servers/engine/tests/test_pending_spell_attack.py
new file mode 100644
index 0000000..ba9b811
--- /dev/null
+++ b/servers/engine/tests/test_pending_spell_attack.py
@@ -0,0 +1,160 @@
+"""#1270: a spell's attack roll finishes its cast, rather than taking another action."""
+import pytest
+
+import server
+import store
+from dice import DiceRoll
+from models import Combat
+
+
+@pytest.fixture
+def fight(tmp_path, monkeypatch):
+    monkeypatch.setenv("WORLDOS_STATE_DIR", str(tmp_path))
+    cid = server.create_campaign("Spell attack")["id"]
+    caster = server.create_character(
+        cid, "Maren", kind="player", class_name="Cleric", apply_srd_defaults=True,
+    )["id"]
+    server.update_character(cid, caster, patch={
+        "initiative_bonus": 100, "extra_attacks": 2,
+        "spell_slots": {"1": {"maximum": 4, "used": 0}},
+    })
+    foes = [server.create_character(
+        cid, name, kind="monster", max_hp=100, armor_class=12,
+    )["id"] for name in ("Goblin", "Orc")]
+    server.learn_spells(cid, caster, ["Guiding Bolt", "Magic Missile", "Fire Bolt"])
+    server.prepare_spells(cid, caster, ["Guiding Bolt", "Magic Missile"])
+    server.start_combat(cid, [caster, *foes])
+    assert server.get_state(cid)["current_turn"] == caster
+    return cid, caster, foes
+
+
+def cast(fight, **kw):
+    cid, caster, foes = fight
+    return server.cast_spell(cid, caster, "Guiding Bolt", **(kw or {"target_id": foes[0]}))
+
+
+def strike(fight, target=None):
+    cid, caster, foes = fight
+    return server.attack(cid, caster, target or foes[0], attack_bonus=5,
+                         damage_dice="4d6", damage_type="radiant", is_ranged=True)
+
+
+def pending(fight):
+    return store.load_campaign(fight[0]).combat.pending_spell_attack
+
+
+def test_old_combat_snapshot_has_no_pending_spell_attack():
+    snapshot = Combat().model_dump(mode="json")
+    snapshot.pop("pending_spell_attack")
+    assert Combat.model_validate(snapshot).pending_spell_attack is None
+
+
+@pytest.mark.parametrize("hit", [True, False])
+def test_spell_attack_finishes_cast_once_without_extra_attack_budget(fight, monkeypatch, hit):
+    cid, caster, foes = fight
+    result = cast(fight)
+    assert result["automated"] is False and result["attack_roll"] is True
+    p = pending(fight)
+    assert (p.source_id, p.target_ids, p.spell, p.round) == (
+        caster, [foes[0]], "Guiding Bolt", store.load_campaign(cid).combat.round,
+    )
+    assert server.get_character(cid, caster)["spell_slots"]["1"]["used"] == 1
+
+    def roll(expr, **kwargs):
+        if expr.startswith("1d20"):
+            natural = 15 if hit else 2
+            return DiceRoll(expression=expr, total=natural + 5, rolls=[natural],
+                            natural=natural, is_d20=True)
+        return DiceRoll(expression=expr, total=14, rolls=[3, 3, 4, 4])
+
+    monkeypatch.setattr(server.dice_mod, "roll", roll)
+    out = strike(fight)
+    assert out["hit"] is hit
+    assert server.get_character(cid, foes[0])["current_hp"] == (86 if hit else 100)
+    assert pending(fight) is None
+    assert server.get_character(cid, caster)["pending_on_hit_riders"] == []
+    effects = server.get_character(cid, foes[0])["active_effects"]
+    assert bool(effects) is hit
+    economy = store.load_campaign(cid).combat
+    assert economy.action_purpose == "cast" and economy.action_used
+    assert economy.action_attacks_made == 0
+    with pytest.raises(ValueError, match="already cast a spell"):
+        strike(fight)
+    with pytest.raises(ValueError, match="already used its action"):
+        cast(fight)
+
+
+def test_other_target_and_double_cast_refused_without_spending_or_clearing(fight):
+    cid, caster, foes = fight
+    cast(fight)
+    before = store.load_campaign(cid).model_dump()
+    with pytest.raises(ValueError, match="already cast a spell"):
+        strike(fight, foes[1])
+    with pytest.raises(ValueError, match="already used its action"):
+        cast(fight)
+    assert store.load_campaign(cid).model_dump() == before
+
+
+@pytest.mark.parametrize("spell", ["Magic Missile", "Fire Bolt"])
+def test_automated_spell_does_not_allow_followup_attack(fight, spell):
+    cid, caster, foes = fight
+    assert server.cast_spell(cid, caster, spell, target_id=foes[0])["automated"] is True
+    assert pending(fight) is None
+    with pytest.raises(ValueError, match="already cast a spell"):
+        strike(fight)
+
+
+def test_next_turn_discards_unresolved_cast_and_rider(fight):
+    cid, caster, _ = fight
+    cast(fight)
+    server.next_turn(cid)
+    assert pending(fight) is None
+    assert server.get_character(cid, caster)["pending_on_hit_riders"] == []
+
+
+@pytest.mark.parametrize("cleanup", ["damage", "set_hp", "remove"])
+def test_target_death_or_removal_discards_pending_spell_and_riders(fight, cleanup):
+    cid, caster, foes = fight
+    cast(fight)
+    if cleanup == "damage":
+        server.apply_damage(cid, foes[0], 200)
+    elif cleanup == "set_hp":
+        server.set_hp(cid, foes[0], 0)
+    else:
+        server.remove_combatant(cid, foes[0])
+    assert pending(fight) is None
+    assert server.get_character(cid, caster)["pending_on_hit_riders"] == []
+
+
+def test_target_list_grants_only_one_continuation(fight, monkeypatch):
+    cast(fight, target_ids=fight[2])
+    assert pending(fight).target_ids == fight[2]
+    monkeypatch.setattr(server.dice_mod, "roll", lambda expr, **kw: DiceRoll(
+        expression=expr, total=2, rolls=[2], natural=2, is_d20=True,
+    ))
+    strike(fight, fight[2][1])
+    assert pending(fight) is None
+    with pytest.raises(ValueError, match="already cast a spell"):
+        strike(fight, fight[2][0])
+
+
+def test_stale_round_cannot_bypass_cast_gate(fight):
+    cast(fight)
+    campaign = store.load_campaign(fight[0])
+    campaign.combat.pending_spell_attack.round -= 1
+    store.save_campaign(campaign)
+    with pytest.raises(ValueError, match="already cast a spell"):
+        strike(fight)
+
+
+def test_killing_spell_attack_leaves_no_pending_or_materialized_rider(fight, monkeypatch):
+    cid, caster, foes = fight
+    cast(fight)
+    monkeypatch.setattr(server.dice_mod, "roll", lambda expr, **kw: DiceRoll(
+        expression=expr, total=200, rolls=[15], natural=15, is_d20=expr.startswith("1d20"),
+    ))
+    assert strike(fight)["hit"] is True
+    assert server.get_character(cid, foes[0])["dead"] is True
+    assert server.get_character(cid, foes[0])["active_effects"] == []
+    assert server.get_character(cid, caster)["pending_on_hit_riders"] == []
+    assert pending(fight) is None
