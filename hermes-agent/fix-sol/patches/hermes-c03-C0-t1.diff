diff --git a/hermes_cli/plugins_loader.py b/hermes_cli/plugins_loader.py
index a0d4422f..5365e3db 100644
--- a/hermes_cli/plugins_loader.py
+++ b/hermes_cli/plugins_loader.py
@@ -265,6 +265,28 @@ class PluginLoaderMixin:
             return
         self._register_deferred_platform_tools(manifest, loaded)
 
+    def rearm_failed_platform(self, platform_name: str) -> bool:
+        """Restore a failed platform's deferred loader for the next registry lookup.
+
+        Retrying is explicit so ordinary registry reads cannot repeatedly import a broken plugin.
+        """
+        from gateway.platform_registry import platform_registry
+
+        with self._discovery_lock, _plugin_home_scope(self.home_path):
+            for loaded in self._plugins.values():
+                manifest = loaded.manifest
+                if (not loaded.error or manifest.kind != "platform"
+                        or self._platform_name_from_manifest(manifest) != platform_name):
+                    continue
+                entry, loader = platform_registry.snapshot_registration(
+                    platform_name, scope=self.scope_key,
+                )
+                if entry is not None or loader is not None:
+                    return False
+                self._register_deferred_platform(manifest)
+                return self._plugins[manifest_key(manifest)].deferred
+        return False
+
     @_serialized_replacement
     def _lease_deferred_platform(self, manifest: PluginManifest, lookup_key: str) -> bool:
         """Publish the deferred loader as a ledger-owned lease; False when the registry refused it."""
