+@pytest.mark.parametrize("final_cell", [(4, 2), (2, 1), (8, 2)])
+def test_end_combat_relocates_to_nearest_free_rest_cell(staged, final_cell):
+    cid, hero, ally, _goblin, loc_id = staged
+    # An old save may already have the mover on the same newly blocked cell.
+    c = server._require(cid)
+    c.characters[hero].stage_cell = final_cell
+    server.save_campaign(c)
+    server.start_combat(cid, [hero, ally])
+    server.set_grid(cid, 10, 3, obstacles=[])
+    server.place_combatant_at_coords(cid, hero, *final_cell)
+    server.place_combatant_at_coords(cid, ally, 3, 1)
+    server.end_combat(cid)
+    c = server._require(cid)
+    loc = c.locations[loc_id]
+    terrain = {tuple(cell) for cell in server.scene_grid_mod.impassable_cells(loc.scene_grid, 5, 3)}
+    available = {(x, y) for x in range(5) for y in range(3)} - terrain - {(3, 1)}
+    expected = min(available, key=lambda cell: (server.combat_grid.chebyshev_cells(cell, final_cell), cell[1], cell[0]))
+    assert tuple(c.characters[hero].stage_cell) == expected
+    assert tuple(c.characters[ally].stage_cell) == (3, 1)
+    # The survivor is actionable again through the ordinary rest movement verb.
+    destination = min(available - {expected})
+    assert server.walk_to(cid, hero, *destination)["walked"] is True
+
+
+def test_end_combat_relocations_do_not_stack_survivors(staged):
+    cid, hero, ally, _goblin, loc_id = staged
+    server.start_combat(cid, [hero, ally])
+    server.set_grid(cid, 5, 3, obstacles=[])
+    server.place_combatant_at_coords(cid, hero, 4, 2)
+    server.place_combatant_at_coords(cid, ally, 4, 2)
+    server.end_combat(cid)
+    c = server._require(cid)
+    cells = {tuple(c.characters[char_id].stage_cell) for char_id in (hero, ally)}
+    terrain = {tuple(cell) for cell in server.scene_grid_mod.impassable_cells(c.locations[loc_id].scene_grid, 5, 3)}
+    assert len(cells) == 2
+    assert not cells & terrain
+
+
+def test_end_combat_keeps_final_cell_without_rest_grid(staged):
+    cid, hero, _ally, _goblin, loc_id = staged
+    server.start_combat(cid, [hero])
+    server.set_grid(cid, 5, 3, obstacles=[])
+    server.place_combatant_at_coords(cid, hero, 4, 2)
+    c = server._require(cid)
+    c.locations[loc_id].scene_grid = None
+    server.save_campaign(c)
+    server.end_combat(cid)
+    assert tuple(server._require(cid).characters[hero].stage_cell) == (4, 2)
+
+
+def test_end_combat_leaves_survivor_unplaced_if_rest_grid_is_solid(staged):
+    cid, hero, _ally, _goblin, loc_id = staged
+    server.start_combat(cid, [hero])
+    server.set_grid(cid, 5, 3, obstacles=[])
+    server.place_combatant_at_coords(cid, hero, 4, 2)
+    c = server._require(cid)
+    grid = c.locations[loc_id].scene_grid
+    grid.cells = []
+    grid.cell_default.walkable = False
+    server.save_campaign(c)
+    server.end_combat(cid)
+    assert server._require(cid).characters[hero].stage_cell is None
+
