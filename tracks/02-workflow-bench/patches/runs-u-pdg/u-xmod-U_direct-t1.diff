diff --git a/gitnexus/test/unit/parse-retry.test.ts b/gitnexus/test/unit/parse-retry.test.ts
new file mode 100644
index 0000000..85659ba
--- /dev/null
+++ b/gitnexus/test/unit/parse-retry.test.ts
@@ -0,0 +1,231 @@
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { EventEmitter } from 'node:events';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { pathToFileURL } from 'node:url';
+import type { Worker } from 'node:worker_threads';
+import {
+  classifyParseWorkerFailure,
+  createParseRetryTracker,
+  DEFAULT_MAX_TRANSIENT_RETRIES,
+  parseRetryDelayMs,
+  type ParseWorkerFailureKind,
+} from '../../src/core/ingestion/workers/parse-retry.js';
+import { createWorkerPool } from '../../src/core/ingestion/workers/worker-pool.js';
+
+describe('classifyParseWorkerFailure', () => {
+  it.each<ParseWorkerFailureKind>(['exit', 'messageerror'])('%s is transient', (kind) => {
+    expect(classifyParseWorkerFailure(kind)).toBe('transient');
+  });
+
+  it.each<ParseWorkerFailureKind>([
+    'worker-error-message',
+    'uncaught-error',
+    'heap-oom',
+    'malformed-message',
+  ])('%s is deterministic', (kind) => {
+    expect(classifyParseWorkerFailure(kind)).toBe('deterministic');
+  });
+});
+
+describe('parseRetryDelayMs', () => {
+  it('backs off exponentially from the base delay', () => {
+    expect(parseRetryDelayMs(1, 100, 10_000)).toBe(100);
+    expect(parseRetryDelayMs(2, 100, 10_000)).toBe(200);
+    expect(parseRetryDelayMs(3, 100, 10_000)).toBe(400);
+  });
+
+  it('caps at the max delay', () => {
+    expect(parseRetryDelayMs(10, 100, 1_000)).toBe(1_000);
+  });
+
+  it('is zero for a non-positive base or retry index', () => {
+    expect(parseRetryDelayMs(1, 0, 1_000)).toBe(0);
+    expect(parseRetryDelayMs(0, 100, 1_000)).toBe(0);
+  });
+});
+
+describe('createParseRetryTracker', () => {
+  it('defaults to 2 retries', () => {
+    expect(DEFAULT_MAX_TRANSIENT_RETRIES).toBe(2);
+  });
+
+  it('retries a transient failure twice with backoff, then fails the file', () => {
+    const tracker = createParseRetryTracker({ baseDelayMs: 50, maxDelayMs: 1_000 });
+    expect(tracker.recordFailure('a.ts', 'exit')).toEqual({
+      action: 'retry',
+      retry: 1,
+      delayMs: 50,
+    });
+    expect(tracker.recordFailure('a.ts', 'messageerror')).toEqual({
+      action: 'retry',
+      retry: 2,
+      delayMs: 100,
+    });
+    expect(tracker.recordFailure('a.ts', 'exit')).toEqual({
+      action: 'fail',
+      failureClass: 'transient',
+      retries: 2,
+    });
+    expect(tracker.retriesFor('a.ts')).toBe(2);
+  });
+
+  it('never retries a deterministic parse error', () => {
+    const tracker = createParseRetryTracker();
+    expect(tracker.recordFailure('bad.ts', 'worker-error-message')).toEqual({
+      action: 'fail',
+      failureClass: 'deterministic',
+      retries: 0,
+    });
+    expect(tracker.recordFailure('huge.ts', 'heap-oom')).toMatchObject({ action: 'fail' });
+    expect(tracker.recordFailure('throws.ts', 'uncaught-error')).toMatchObject({ action: 'fail' });
+    expect(tracker.recordFailure('proto.ts', 'malformed-message')).toMatchObject({
+      action: 'fail',
+    });
+    expect(tracker.retriesFor('bad.ts')).toBe(0);
+  });
+
+  it('fails immediately on a deterministic error even with retry budget left', () => {
+    const tracker = createParseRetryTracker();
+    expect(tracker.recordFailure('a.ts', 'exit')).toMatchObject({ action: 'retry', retry: 1 });
+    expect(tracker.recordFailure('a.ts', 'worker-error-message')).toEqual({
+      action: 'fail',
+      failureClass: 'deterministic',
+      retries: 1,
+    });
+  });
+
+  it('keeps retry budgets independent per file', () => {
+    const tracker = createParseRetryTracker();
+    tracker.recordFailure('a.ts', 'exit');
+    tracker.recordFailure('a.ts', 'exit');
+    expect(tracker.recordFailure('a.ts', 'exit')).toMatchObject({ action: 'fail' });
+    expect(tracker.recordFailure('b.ts', 'exit')).toMatchObject({ action: 'retry', retry: 1 });
+  });
+
+  it('maxRetries: 0 disables retry', () => {
+    const tracker = createParseRetryTracker({ maxRetries: 0 });
+    expect(tracker.recordFailure('a.ts', 'exit')).toEqual({
+      action: 'fail',
+      failureClass: 'transient',
+      retries: 0,
+    });
+  });
+});
+
+/**
+ * Pool-level wiring: a scripted Worker double fails or succeeds on each
+ * dispatched sub-batch, so the tests observe whether the pool retried the
+ * file or quarantined it.
+ */
+type Action = 'ok' | 'exit' | 'messageerror' | 'error-message' | 'uncaught-error';
+
+const actions: Action[] = [];
+let spawned = 0;
+
+class ScriptedWorker extends EventEmitter {
+  constructor() {
+    super();
+    spawned++;
+    queueMicrotask(() => this.emit('message', { type: 'ready' }));
+  }
+
+  postMessage(msg: { type?: string; files?: { path: string }[] }): void {
+    if (msg?.type !== 'sub-batch') return;
+    const files = msg.files ?? [];
+    const action = actions.shift();
+    if (!action) return;
+    queueMicrotask(async () => {
+      this.emit('message', { type: 'starting-file', path: files[0].path });
+      switch (action) {
+        case 'ok':
+          this.emit('message', { type: 'progress', filesProcessed: files.length });
+          this.emit('message', { type: 'sub-batch-done' });
+          await Promise.resolve();
+          this.emit('message', { type: 'result', data: { fileCount: files.length } });
+          return;
+        case 'exit':
+          this.emit('exit', 134);
+          return;
+        case 'messageerror':
+          this.emit('messageerror', new Error('could not deserialize'));
+          return;
+        case 'error-message':
+          this.emit('message', { type: 'error', error: 'SyntaxError: unexpected token' });
+          return;
+        case 'uncaught-error':
+          this.emit('error', new Error('boom'));
+          return;
+      }
+    });
+  }
+
+  async terminate(): Promise<number> {
+    this.emit('exit', 0);
+    return 0;
+  }
+}
+
+describe('worker pool transient parse retry', () => {
+  let tempDir: string;
+  let workerUrl: URL;
+
+  beforeEach(() => {
+    actions.length = 0;
+    spawned = 0;
+    tempDir = fs.mkdtempSync(path.join(os.tmpdir(), 'gitnexus-parse-retry-'));
+    const workerPath = path.join(tempDir, 'fake-worker.js');
+    fs.writeFileSync(workerPath, '// fake');
+    workerUrl = pathToFileURL(workerPath) as URL;
+  });
+
+  afterEach(() => {
+    fs.rmSync(tempDir, { recursive: true, force: true });
+  });
+
+  const makePool = () =>
+    createWorkerPool(workerUrl, 1, {
+      workerFactory: () => new ScriptedWorker() as unknown as Worker,
+      transientParseRetryBaseDelayMs: 1,
+    });
+
+  const dispatchOne = (pool: ReturnType<typeof makePool>) =>
+    pool.dispatch<{ path: string; content: string }, unknown>([{ path: 'a.ts', content: '' }]);
+
+  it.each<Action>(['exit', 'messageerror'])(
+    'retries a file after a transient %s and keeps it out of quarantine',
+    async (failure) => {
+      const pool = makePool();
+      actions.push(failure, failure, 'ok');
+      await expect(dispatchOne(pool)).resolves.toEqual([{ fileCount: 1 }]);
+      expect(pool.getQuarantinedPaths()).toEqual([]);
+      expect(spawned).toBe(3);
+      await pool.terminate();
+    },
+  );
+
+  it('marks the file failed after 2 transient retries are exhausted', async () => {
+    const pool = makePool();
+    actions.push('exit', 'exit', 'exit');
+    await expect(dispatchOne(pool)).resolves.toEqual([]);
+    expect(pool.getQuarantinedPaths()).toEqual(['a.ts']);
+    // Original worker + one respawn per death.
+    expect(spawned).toBe(4);
+    expect(actions).toEqual([]);
+    await pool.terminate();
+  });
+
+  it.each<Action>(['error-message', 'uncaught-error'])(
+    'does not retry a deterministic %s failure',
+    async (failure) => {
+      const pool = makePool();
+      // A second action that would succeed proves no retry was dispatched.
+      actions.push(failure, 'ok');
+      await expect(dispatchOne(pool)).resolves.toEqual([]);
+      expect(pool.getQuarantinedPaths()).toEqual(['a.ts']);
+      expect(actions).toEqual(['ok']);
+      await pool.terminate();
+    },
+  );
+});
