diff --git a/gitnexus/test/unit/status-json-alias.test.ts b/gitnexus/test/unit/status-json-alias.test.ts
new file mode 100644
index 0000000..d2f0c8d
--- /dev/null
+++ b/gitnexus/test/unit/status-json-alias.test.ts
@@ -0,0 +1,41 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+const statusCommand = vi.fn();
+
+vi.mock('../../src/cli/status.js', () => ({ statusCommand }));
+vi.mock('../../src/cli/command-banner.js', () => ({ writeCommandBanner: vi.fn() }));
+vi.mock('../../src/cli/update-notice.js', () => ({ runProcessCliUpdateNotice: vi.fn() }));
+
+async function runCli(args: string[]): Promise<void> {
+  process.argv = ['node', 'gitnexus', ...args];
+  await import('../../src/cli/index.js');
+  await vi.waitFor(() => expect(statusCommand).toHaveBeenCalledTimes(1));
+}
+
+describe('gitnexus status -j', () => {
+  const originalArgv = process.argv;
+
+  beforeEach(() => {
+    vi.resetModules();
+    statusCommand.mockReset();
+  });
+
+  afterEach(() => {
+    process.argv = originalArgv;
+  });
+
+  it('treats -j as an alias for --json', async () => {
+    await runCli(['status', '-j']);
+    expect(statusCommand.mock.calls[0][0]).toMatchObject({ json: true });
+  });
+
+  it('still accepts --json', async () => {
+    await runCli(['status', '--json']);
+    expect(statusCommand.mock.calls[0][0]).toMatchObject({ json: true });
+  });
+
+  it('leaves json unset without the flag', async () => {
+    await runCli(['status']);
+    expect(statusCommand.mock.calls[0][0].json).toBeUndefined();
+  });
+});
