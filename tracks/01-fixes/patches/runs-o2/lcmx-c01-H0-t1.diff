+def tool_group_safe_end(messages: Sequence[Dict[str, Any]], end: int) -> int:
+    """Ensure an end index doesn't cut a message inside a tool-call group.
+
+    A tool-call group is an assistant message with tool_calls followed by its
+    tool result messages. Splitting a group leaves orphan rows that break compaction.
+
+    Args:
+        messages: The message sequence.
+        end: The proposed end index (exclusive).
+
+    Returns:
+        A safe end index that doesn't split a tool-call group:
+        - If messages[:end] stops inside a group, returns the group's assistant index
+        - If that would empty the prefix, extends end through the group's declared results
+        - If a result has no tool_call_id or id not in assistant, returns end unchanged
+        - If end is outside any group, returns end unchanged
+    """
+    if end <= 0 or end > len(messages):
+        return end
+
+    # Check if we're in the middle of a tool-call group by looking back from end-1
+    message_at_end_minus_1 = messages[end - 1]
+    if message_at_end_minus_1.get("role") != "tool":
+        # Not a tool result, so we're not in the middle of a group
+        return end
+
+    tool_result_id = str(message_at_end_minus_1.get("tool_call_id") or "").strip()
+    if not tool_result_id:
+        # Tool result without an id, not part of a group
+        return end
+
+    # Find the opening assistant message that declared this tool_call_id
+    group_start = None
+    for index in range(end - 2, -1, -1):
+        message = messages[index]
+        role = str(message.get("role") or "")
+
+        if role in {"user", "system"}:
+            # Reached a boundary without finding the assistant
+            return end
+
+        if role != "assistant":
+            continue
+
+        # Found an assistant, check if it has this tool_call_id
+        call_ids = {
+            _tool_call_id(tool_call)
+            for tool_call in (message.get("tool_calls") or [])
+        }
+
+        if tool_result_id in call_ids:
+            # This is the opening assistant of the group
+            group_start = index
+            break
+
+    if group_start is None:
+        # No opening assistant found, return unchanged
+        return end
+
+    # We found the group starts at group_start
+    # Check if we have all the declared results
+    assistant_msg = messages[group_start]
+    declared_ids = {
+        _tool_call_id(tc)
+        for tc in assistant_msg.get("tool_calls") or []
+    }
+
+    # Collect all tool result ids in the range [group_start+1, end)
+    result_ids_in_range = set()
+    for i in range(group_start + 1, end):
+        msg = messages[i]
+        if msg.get("role") == "tool":
+            result_id = str(msg.get("tool_call_id") or "").strip()
+            if result_id:
+                result_ids_in_range.add(result_id)
+        elif msg.get("role") != "assistant" or not msg.get("tool_calls"):
+            # Hit a non-assistant, non-tool message
+            break
+
+    # If we have all declared results in the range, we're complete - return end unchanged
+    if result_ids_in_range == declared_ids:
+        return end
+
+    # We're in the middle of the group
+    # If group_start == 0, we can't remove the group, so extend through results
+    if group_start == 0:
+        # Extend end through all declared tool results
+        extended_end = 1
+        for i in range(1, len(messages)):
+            msg = messages[i]
+            if msg.get("role") == "tool":
+                result_id = str(msg.get("tool_call_id") or "").strip()
+                if result_id and result_id in declared_ids:
+                    extended_end = i + 1
+                else:
+                    break
+            else:
+                break
+        return extended_end
+    else:
+        # Return the group_start to exclude the group
+        return group_start
+
+
