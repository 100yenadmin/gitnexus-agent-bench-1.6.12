--- a/fresh_tail.py
+++ b/fresh_tail.py
@@ -50,6 +50,40 @@ def _assistant_group_start(messages: Sequence[Dict[str, Any]], start: int) -> in
     return start
 
 
+def tool_group_safe_end(messages: Sequence[Dict[str, Any]], end: int) -> int:
+    """Keep a prefix cut outside a declared assistant/tool-result group.
+
+    Retreat to the opening assistant, or include its declared results when
+    retreating would leave no rows. Ambiguous results leave the cut unchanged.
+    """
+    if end <= 0 or end >= len(messages):
+        return end
+    group_start = _assistant_group_start(messages, end)
+    if group_start == end:
+        return end
+
+    call_ids = {
+        call_id
+        for call in (messages[group_start].get("tool_calls") or [])
+        if (call_id := _tool_call_id(call))
+    }
+    pending = set(call_ids)
+    group_end = group_start + 1
+    while group_end < len(messages) and pending:
+        result = messages[group_end]
+        if result.get("role") != "tool":
+            break
+        result_id = str(result.get("tool_call_id") or "").strip()
+        if not result_id or result_id not in call_ids:
+            return end
+        pending.discard(result_id)
+        group_end += 1
+
+    if end >= group_end:
+        return end
+    return group_start if group_start > 0 else group_end
+
+
