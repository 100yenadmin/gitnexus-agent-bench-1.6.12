+describe('C: system includes stay outside the repository, local includes resolve', () => {
+  const testCase = CASES.get(SupportedLanguages.C)!;
+  const resolve = (targetRaw: string) =>
+    filesOf(resolveWith(SupportedLanguages.C, testCase, targetRaw));
+
+  it.each(['<stdio.h>', '<util.h>', '< stdio.h >'])(
+    '%s resolves to nothing even with a same-named in-repo header',
+    (spelling) => {
+      expect(resolve(spelling)).toEqual([]);
+    },
+  );
+
+  it.each([
+    // Quoted: the includer's directory is searched first.
+    ['"stdio.h"', 'src/stdio.h'],
+    // The bare path `interpretCImport` emits for `#include "stdio.h"`.
+    ['stdio.h', 'src/stdio.h'],
+    // Quoted, not a sibling: falls through to the workspace suffix match.
+    ['"util.h"', 'include/util.h'],
+    ['util.h', 'include/util.h'],
+  ])('%s resolves to %s', (spelling, expected) => {
+    expect(resolve(spelling)).toEqual([expected]);
+  });
+});
