                 clone.shutdown()
 
+    @pytest.mark.parametrize("startup_work", ["none", "migration", "legacy_row"])
+    def test_deepcopy_under_wal_writer_only_requires_lock_for_real_work(
+        self, tmp_path, monkeypatch, startup_work
+    ):
+        from hermes_lcm import db_bootstrap, store, dag, lifecycle_state
+        from hermes_lcm.engine import LCMEngine
+
+        config = LCMConfig(database_path=str(tmp_path / "lcm-writer-copy.db"))
+        prototype = LCMEngine(config=config, hermes_home=str(tmp_path / "hermes"))
+        clone = None
+        writer = sqlite3.connect(config.database_path, timeout=0.01)
+        statements = []
+        configure = db_bootstrap.configure_connection
+
+        def configure_with_short_timeout(conn):
+            configure(conn)
+            conn.execute("PRAGMA busy_timeout=10")
+            conn.set_trace_callback(statements.append)
+
+        try:
+            # Complete first-open scans before holding the write slot. Reopening
+            # a healthy, recently checked DB should need neither scan nor repair.
+            db_bootstrap.join_background_integrity_scans(timeout=30)
+            store_id = prototype._store.append(
+                "copy-session", {"role": "user", "content": "retained context"}
+            )
+            if startup_work == "migration":
+                writer.execute("UPDATE metadata SET value='4' WHERE key='schema_version'")
+            elif startup_work == "legacy_row":
+                writer.execute(
+                    "UPDATE messages SET ingested_at=NULL WHERE store_id=?", (store_id,)
+                )
+            writer.commit()
+            assert writer.execute("PRAGMA journal_mode=WAL").fetchone()[0] == "wal"
+            for module in (store, dag, lifecycle_state):
+                monkeypatch.setattr(module, "configure_connection", configure_with_short_timeout)
+            writer.execute("BEGIN IMMEDIATE")
+
+            if startup_work == "none":
+                clone = copy.deepcopy(prototype)
+                assert isinstance(clone, LCMEngine)
+                assert clone.name == "lcm"
+                assert clone._store is not prototype._store
+                assert clone._store.connection.total_changes == 0
+                assert clone._dag.connection.total_changes == 0
+                assert clone._lifecycle.connection.total_changes == 0
+                assert not any(
+                    sql.lstrip().upper().startswith(("INSERT", "UPDATE", "DELETE", "REPLACE"))
+                    for sql in statements
+                )
+                assert writer.in_transaction
+            else:
+                with pytest.raises(sqlite3.OperationalError, match="database is locked"):
+                    copy.deepcopy(prototype)
+                # Contention must not mark a migration complete or silently
+                # skip a real backfill. Once released, normal startup repairs it.
+                if startup_work == "migration":
+                    assert db_bootstrap.get_schema_version(writer) == 4
+                else:
+                    assert writer.execute(
+                        "SELECT ingested_at FROM messages WHERE store_id=?", (store_id,)
+                    ).fetchone()[0] is None
+                writer.rollback()
+                clone = copy.deepcopy(prototype)
+                assert db_bootstrap.get_schema_version(writer) == SCHEMA_VERSION
+                assert writer.execute(
+                    "SELECT content, ingested_at, timestamp FROM messages WHERE store_id=?",
+                    (store_id,),
+                ).fetchone() == (
+                    "retained context",
+                    prototype._store.get_session_messages("copy-session")[0]["timestamp"],
+                    prototype._store.get_session_messages("copy-session")[0]["timestamp"],
+                )
+        finally:
+            writer.rollback()
+            writer.close()
+            if clone is not None:
+                clone.shutdown()
+            prototype.shutdown()
+
     def test_deepcopy_matches_hermes_host_copy_contract_without_fallback(self, tmp_path):
         from hermes_lcm.engine import LCMEngine
 
