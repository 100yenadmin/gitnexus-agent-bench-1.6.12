--- /dev/null
+++ b/tests/test_issue_750_session_depths.py
@@ -0,0 +1,104 @@
+"""Large sessions must not hide their deepest summaries (#750)."""
+
+import pytest
+
+from hermes_lcm.config import LCMConfig
+from hermes_lcm.dag import SummaryNode
+from hermes_lcm.engine import LCMEngine
+
+
+@pytest.fixture
+def engine(tmp_path):
+    instance = LCMEngine(
+        config=LCMConfig(database_path=str(tmp_path / "lcm.db")),
+        hermes_home=str(tmp_path / "hermes"),
+    )
+    instance._session_id = "large-session"
+    try:
+        yield instance
+    finally:
+        instance.shutdown()
+
+
+def _add_node(dag, session_id, depth, source_ids=()):
+    return dag.add_node(SummaryNode(
+        session_id=session_id,
+        depth=depth,
+        summary=f"History at depth {depth}",
+        token_count=10,
+        source_token_count=40,
+        source_ids=list(source_ids),
+        source_type="nodes" if depth else "messages",
+    ))
+
+
+def _build_tree(engine, leaf_count):
+    """Keep all source nodes while condensing complete groups up to depth 3."""
+    dag, session_id = engine._dag, engine._session_id
+    levels = {0: [_add_node(dag, session_id, 0) for _ in range(leaf_count)]}
+    for depth in range(1, 4):
+        children = levels[depth - 1]
+        levels[depth] = [
+            _add_node(dag, session_id, depth, children[start:start + 4])
+            for start in range(0, len(children) - 3, 4)
+        ]
+    return levels
+
+
+def test_session_depths_are_uncapped_sorted_distinct_and_session_scoped(engine):
+    dag = engine._dag
+    for _ in range(1024):
+        _add_node(dag, engine._session_id, 0)
+    for depth in (11, 3, 1, 3):
+        _add_node(dag, engine._session_id, depth)
+    _add_node(dag, "other-session", 42)
+
+    assert dag.get_session_depths(engine._session_id) == [0, 1, 3, 11]
+    assert dag.get_session_depths("other-session") == [42]
+    assert dag.get_session_depths("unknown-session") == []
+    # Existing readers retain their bounded behavior.
+    assert len(dag.get_session_nodes(engine._session_id)) == 1000
+    assert len(dag.get_session_nodes(engine._session_id, limit=7)) == 7
+    assert len(dag.get_session_nodes(engine._session_id, depth=3)) == 2
+
+
+@pytest.mark.parametrize("leaf_count", [760, 768, 800, 1000, 1024])
+def test_assembly_renders_deepest_summaries_in_large_sessions(engine, leaf_count):
+    levels = _build_tree(engine, leaf_count)
+    tail = [{"role": "user", "content": "Fresh question"}]
+    result = engine._assemble_context({"role": "system", "content": "System"}, tail)
+    content = "\n".join(message.get("content", "") for message in result)
+
+    for node_id in levels[3]:
+        assert f"[Depth-3 Summary (d3, node {node_id})]" in content
+    # Only the uncondensed frontier is rendered; sources remain retrievable.
+    for node_id in levels[2][:4]:
+        assert f"Summary (d2, node {node_id})]" not in content
+        assert engine._dag.get_node(node_id) is not None
+    assert result[-1] == tail[0]
+
+
+def test_unlimited_condensation_reaches_deepest_level_after_1024_leaves(engine, monkeypatch):
+    levels = _build_tree(engine, 1024)
+    engine._config.incremental_max_depth = -1
+    monkeypatch.setattr(
+        "hermes_lcm.engine.summarize_with_escalation",
+        lambda **kwargs: ("Condensed history.\nExpand for details about: history", 1),
+    )
+
+    assert engine._maybe_condense() == 1
+    parents = engine._dag.get_session_nodes(engine._session_id, depth=4)
+    assert len(parents) == 1
+    assert parents[0].source_ids == levels[3][:4]
+    assert all(engine._dag.get_node(node_id) is not None for node_id in levels[3])
+
+
+def test_configured_max_depth_still_limits_condensation(engine, monkeypatch):
+    _build_tree(engine, 1024)
+
+    def unexpected_summary(**kwargs):
+        pytest.fail("No condensation is allowed beyond the configured depth 3")
+
+    monkeypatch.setattr("hermes_lcm.engine.summarize_with_escalation", unexpected_summary)
+    assert engine._maybe_condense() == 0
+    assert engine._dag.get_session_nodes(engine._session_id, depth=4) == []
