+# ── Action economy (#778): spell casting, skip, and attack ordering ──────────────────
+
+def test_action_economy_double_cast_rejected(tmp_path, monkeypatch):
+    """#778: casting twice in one turn is forbidden by 5e RAW. A second action-cast after an
+    action-cast is rejected with 'already cast a spell this turn'."""
+    import pytest
+    monkeypatch.setenv("WORLDOS_STATE_DIR", str(tmp_path))
+    import server
+    dice_mod.reseed_process_rng(7)
+    cid, cleric, fighter, mons = _seed_healer_fight(server, store)
+
+    # Pin the cleric's turn with a fresh action economy.
+    c = server._require(cid)
+    idx = next(i for i, cb in enumerate(c.combat.order) if cb.character_id == cleric)
+    c.combat.turn_index = idx
+    c.combat.action_used = False
+    c.combat.action_purpose = ""
+    c.combat.bonus_action_used = False
+    store.save_campaign(c)
+
+    # First cast succeeds (Cure Wounds is action-level).
+    res1 = server.cast_spell(cid, cleric, "Cure Wounds", target_id=fighter)
+    assert res1.get("ok") or "ok" not in res1, "first cast should succeed"
+
+    # Second action-cast on the same turn is rejected.
+    c = server._require(cid)
+    with pytest.raises(ValueError, match="already cast a spell this turn"):
+        server.cast_spell(cid, cleric, "Sacred Flame", target_id=fighter)
+
+
+def test_action_economy_cast_after_skip_rejected(tmp_path, monkeypatch):
+    """#778: casting after skip is forbidden. A skip sets action_purpose='skip', so any
+    following action-level cast is rejected."""
+    import pytest
+    monkeypatch.setenv("WORLDOS_STATE_DIR", str(tmp_path))
+    import server
+    dice_mod.reseed_process_rng(7)
+    cid, cleric, fighter, mons = _seed_healer_fight(server, store)
+
+    # Pin the cleric's turn with a fresh action economy.
+    c = server._require(cid)
+    idx = next(i for i, cb in enumerate(c.combat.order) if cb.character_id == cleric)
+    c.combat.turn_index = idx
+    c.combat.action_used = False
+    c.combat.action_purpose = ""
+    c.combat.bonus_action_used = False
+    store.save_campaign(c)
+
+    # Skip the action.
+    skip_res = server.use_action(cid, cleric, "skip")
+    assert skip_res["ok"], "skip should succeed"
+
+    # Following cast is rejected.
+    c = server._require(cid)
+    with pytest.raises(ValueError, match="skipped.*cannot cast"):
+        server.cast_spell(cid, cleric, "Sacred Flame", target_id=fighter)
+
+
+def test_action_economy_attack_after_cast_rejected(tmp_path, monkeypatch):
+    """#778: attacking after a cast is forbidden. If action_purpose='cast', an attack is
+    rejected with 'already cast a spell this turn'."""
+    import pytest
+    monkeypatch.setenv("WORLDOS_STATE_DIR", str(tmp_path))
+    import server
+    dice_mod.reseed_process_rng(7)
+    cid, cleric, fighter, mons = _seed_healer_fight(server, store)
+
+    # Pin the cleric's turn and cast a spell.
+    c = server._require(cid)
+    idx = next(i for i, cb in enumerate(c.combat.order) if cb.character_id == cleric)
+    c.combat.turn_index = idx
+    c.combat.action_used = False
+    c.combat.action_purpose = ""
+    c.combat.bonus_action_used = False
+    store.save_campaign(c)
+
+    # Cast a spell.
+    server.cast_spell(cid, cleric, "Sacred Flame", target_id=fighter)
+
+    # Attack after cast is rejected.
+    c = server._require(cid)
+    with pytest.raises(ValueError, match="already cast a spell.*cannot attack"):
+        server.attack(cid, cleric, fighter, attack_bonus=3, damage_dice="1d8")
+
