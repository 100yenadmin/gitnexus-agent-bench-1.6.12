+def test_action_economy_bonus_action_spell_does_not_consume_action(tmp_path, monkeypatch):
+    """#778: bonus-action spells consume only the bonus_action, not the action. After a
+    bonus-action cast, action_purpose should be '' (not set to 'cast'), so an attack or
+    action-cast is still legal."""
+    monkeypatch.setenv("WORLDOS_STATE_DIR", str(tmp_path))
+    import server
+    dice_mod.reseed_process_rng(7)
+    cid, cleric, fighter, mons = _seed_healer_fight(server, store)
+
+    # Pin the cleric's turn with a fresh action economy.
+    c = server._require(cid)
+    idx = next(i for i, cb in enumerate(c.combat.order) if cb.character_id == cleric)
+    c.combat.turn_index = idx
+    c.combat.action_used = False
+    c.combat.action_purpose = ""
+    c.combat.bonus_action_used = False
+    store.save_campaign(c)
+
+    # Cast Healing Word (bonus action spell).
+    server.cast_spell(cid, cleric, "Healing Word", target_id=fighter)
+
+    # After bonus-action spell, action should still be available (attack should succeed).
+    c = server._require(cid)
+    assert c.combat.action_used is False, "action should not be consumed by bonus-action spell"
+    assert c.combat.bonus_action_used is True, "bonus_action should be consumed"
+    assert c.combat.action_purpose == "", "action_purpose should be empty after bonus-action cast"
+
+    # An action-level attack after a bonus-action spell succeeds.
+    res = server.attack(cid, cleric, fighter, attack_bonus=3, damage_dice="1d8")
+    assert "ok" not in res or res.get("ok"), "attack after bonus-action spell should succeed"
