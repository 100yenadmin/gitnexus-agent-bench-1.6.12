index 0000000..e9f268b
--- /dev/null
+++ b/tests/test_issue_750_session_depths.py
@@ -0,0 +1,92 @@
+"""#750: depth discovery must not depend on a capped node listing."""
+
+import pytest
+
+import hermes_lcm.engine as engine_module
+from hermes_lcm.config import LCMConfig
+from hermes_lcm.dag import SummaryDAG, SummaryNode
+from hermes_lcm.engine import LCMEngine
+
+
+def _node(dag, session, depth, sources=()):
+    return dag.add_node(SummaryNode(
+        session_id=session, depth=depth, summary=f"history at depth {depth}",
+        token_count=10, source_token_count=40, source_ids=list(sources),
+        source_type="nodes" if depth else "messages",
+    ))
+
+
+def _hierarchy(dag, leaves):
+    ids = [_node(dag, "S", 0) for _ in range(leaves)]
+    for depth in range(1, 4):
+        ids = [_node(dag, "S", depth, ids[i:i + 4])
+               for i in range(0, len(ids), 4)]
+    return ids
+
+
+@pytest.fixture
+def engine(tmp_path):
+    instance = LCMEngine(config=LCMConfig(
+        database_path=str(tmp_path / "lcm.db"), condensation_fanin=4,
+        incremental_max_depth=3, max_assembly_tokens=100_000,
+        threshold_full_sweep_enabled=False,
+    ))
+    instance.on_session_start("S", context_length=200_000)
+    try:
+        yield instance
+    finally:
+        instance.shutdown()
+
+
+def test_session_depths_are_distinct_sorted_uncapped_and_scoped(tmp_path):
+    dag = SummaryDAG(tmp_path / "dag.db")
+    try:
+        assert dag.get_session_depths("missing") == []
+        for depth in reversed(range(1005)):
+            _node(dag, "S", depth)
+        _node(dag, "S", 3)
+        _node(dag, "other", 2000)
+        assert dag.get_session_depths("S") == list(range(1005))
+        assert dag.get_session_depths("other") == [2000]
+        assert dag.get_session_depths("missing") == []
+        # Existing row readers retain their cap and explicit-limit behavior.
+        assert len(dag.get_session_nodes("S")) == 1000
+        assert len(dag.get_session_nodes("S", limit=2000)) == 1006
+        assert len(dag.get_session_nodes("S", depth=3)) == 2
+    finally:
+        dag.close()
+
+
+@pytest.mark.parametrize("leaves", [760, 800, 1000, 1024])
+def test_assembly_keeps_deepest_history_in_long_sessions(engine, leaves):
+    top_ids = _hierarchy(engine._dag, leaves)
+    system = {"role": "system", "content": "system prompt"}
+    tail = [{"role": "user", "content": "fresh question"}]
+    result = engine._assemble_context(system, tail, include_lcm_note=False)
+    content = "\n".join(row["content"] for row in result)
+    for node_id in top_ids:
+        assert f"(d3, node {node_id})" in content
+    assert result[0] == system
+    assert result[-1] == tail[0]
+    assert engine._dag.get_session_node_count("S") == sum(
+        (leaves + 4 ** depth - 1) // 4 ** depth for depth in range(4)
+    )
+
+
+def test_unlimited_condensation_reaches_top_depth_after_1000_leaves(engine, monkeypatch):
+    top_ids = _hierarchy(engine._dag, 1024)
+    engine._config.incremental_max_depth = -1
+    calls = []
+
+    def summarize(**kwargs):
+        calls.append(kwargs["depth"])
+        return "condensed history", 1
+
+    monkeypatch.setattr(engine_module, "summarize_with_escalation", summarize)
+    before = engine._dag.get_session_node_count("S")
+    assert engine._maybe_condense() == 1
+    parent, = engine._dag.get_session_nodes("S", depth=4)
+    assert parent.source_ids == top_ids[:4]
+    assert calls == [4]
+    assert engine._dag.get_session_node_count("S") == before + 1
+    assert all(engine._dag.get_node(node_id) is not None for node_id in top_ids)
