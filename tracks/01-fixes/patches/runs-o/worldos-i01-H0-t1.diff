+def test_pick_action_routes_around_walls():
+    # Grid with a wall: monster at (2, 5), foe at (8, 5), wall at x=5 for y=1..11.
+    # The monster should not pick a move cell across the wall (straight line).
+    # Instead, it should route around it.
+    import combat_grid
+    atks = [AttackOption(name="Bite", to_hit=4, damage_expr="1d8", reach_ft=5)]
+    # Wall spans x=5, y in [1, 4] (vertical wall blocking the direct path)
+    wall = [(5, y) for y in range(1, 5)]
+    view = _mk_view(
+        atks,
+        [_foe("t", cell=(8, 5))],
+        grid=True,
+        actor_cell=(2, 5),
+        blocking=wall,
+        w=12,
+        h=12,
+    )
+    intent = combat_ai.pick_action(actor=object(), combat_state=view)
+    assert intent.kind == "move"
+    assert intent.to_cell is not None
+    # The move cell should not be on the wall
+    for x, y in wall:
+        assert intent.to_cell != (x, y), f"move picked a wall cell {intent.to_cell}"
+    # The move should get closer to the foe
+    assert combat_grid.distance_ft(intent.to_cell, (8, 5), 5) < combat_grid.distance_ft((2, 5), (8, 5), 5)
+
+
+def test_pick_action_prefers_clear_path_over_difficult_terrain():
+    # Grid with difficult terrain: monster should prefer a clear path over difficult terrain
+    # when both reach the same distance.
+    import combat_grid
+    atks = [AttackOption(name="Bite", to_hit=4, damage_expr="1d8", reach_ft=5)]
+    # Difficult terrain at (2, 2), (2, 3), (2, 4) — a narrow strip
+    difficult = [(2, 2), (2, 3), (2, 4)]
+    view = _mk_view(
+        atks,
+        [_foe("t", cell=(2, 8))],
+        grid=True,
+        actor_cell=(2, 0),
+        difficult=difficult,
+        w=5,
+        h=9,
+    )
+    intent = combat_ai.pick_action(actor=object(), combat_state=view)
+    assert intent.kind == "move"
+    assert intent.to_cell is not None
+    # The move should avoid difficult terrain when possible (prefer same distance clear path)
+    # When moving straight up (2,0)->(2,8), the direct path (2,1), (2,2 if clear else bypass)
+    # The easiest path avoids difficult terrain, so we just check it's still closing.
+    assert combat_grid.distance_ft(intent.to_cell, (2, 8), 5) < combat_grid.distance_ft((2, 0), (2, 8), 5)
+
+
+def test_pick_action_greedy_v1_issue_1269_walled_grid():
+    """Repro from issue #1269: on a 12x12 grid, monster at (2,5), foe at (8,5),
+    wall at x=5 for y=1..11. Greedy-v1 must NOT pick a move cell beyond the wall."""
+    import combat_grid
+    atks = [AttackOption(name="Claw", to_hit=5, damage_expr="1d6+3", reach_ft=5)]
+    # Wall at x=5 for y in [1, 11] — vertical barrier
+    wall = [(5, y) for y in range(1, 12)]
+    view = _mk_view(
+        atks,
+        [_foe("foe", cell=(8, 5))],
+        grid=True,
+        actor_cell=(2, 5),
+        blocking=wall,
+        w=12,
+        h=12,
+    )
+    intent = combat_ai.pick_action(actor=object(), combat_state=view)
+    # The monster should move toward the foe, but NOT across the wall.
+    # It should route around it (either north through y=0 or south through y=11).
+    assert intent.kind == "move"
+    assert intent.to_cell is not None
+    # Verify the chosen cell is not on the wall
+    assert intent.to_cell not in wall, f"Move picked a wall cell {intent.to_cell}"
+    # Verify it's getting closer (not at x=5 yet, since that's blocked)
+    assert combat_grid.distance_ft(intent.to_cell, (8, 5), 5) < combat_grid.distance_ft((2, 5), (8, 5), 5)
+
