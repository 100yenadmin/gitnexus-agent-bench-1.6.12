+@pytest.mark.parametrize("tool", ["memory", "todo_list", "skill_manage", "session_search"])
+@pytest.mark.parametrize("follow_up, footer, reused", [
+    ("", "", True),
+    ("Here is the answer.", "", False),
+    ("", "\n\nChanged files: example.txt", False),
+])
+def test_housekeeping_response_reuse_tracks_provenance_and_final_text(
+    agent, monkeypatch, tool, follow_up, footer, reused,
+):
+    agent.max_iterations = 3
+    agent.iteration_budget.max_total = 3
+    agent.valid_tool_names = {tool}
+    first = _response("Here is the answer.")
+    first.choices[0].finish_reason = "tool_calls"
+    first.choices[0].message.tool_calls = [SimpleNamespace(
+        id="housekeeping", type="function",
+        function=SimpleNamespace(name=tool, arguments="{}"),
+    )]
+    answers = iter([first, _response(follow_up)])
+
+    def model_call(_kwargs):
+        response = next(answers)
+        agent._current_streamed_assistant_text = response.choices[0].message.content
+        return response
+
+    agent._interruptible_api_call = model_call
+    agent._execute_tool_calls = lambda *_args, **_kwargs: [{
