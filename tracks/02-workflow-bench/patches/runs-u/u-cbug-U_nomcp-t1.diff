+/**
+ * C beyond the one-case table above: the property must hold for every shape a
+ * system include takes, and refusing `<…>` must not cost a quoted include any
+ * of the lookups it is entitled to.
+ */
+describe('C: system includes never resolve into the repository', () => {
+  const files = new Set([
+    'src/stdio.h',
+    'src/main.c',
+    'include/util.h',
+    'include/sys/types.h',
+    'lib/net/socket.c',
+  ]);
+  const resolve = (targetRaw: string, fromFile: string, resolutionConfig?: unknown) =>
+    SCOPE_RESOLVERS.get(SupportedLanguages.C)!.resolveImportTarget(
+      targetRaw,
+      fromFile,
+      files,
+      resolutionConfig,
+      { parsedFiles: [] },
+    );
+  // What `loadResolutionConfig` hands the resolver: the scanned header set.
+  const headers: ReadonlySet<string> = new Set(['src/stdio.h', 'include/util.h']);
+
+  it.each([
+    ['a same-directory sibling', '<stdio.h>', 'src/main.c'],
+    ['a same-named header elsewhere', '<stdio.h>', 'lib/net/socket.c'],
+    ['a nested path suffix', '<sys/types.h>', 'src/main.c'],
+    ['an exact workspace path', '<include/util.h>', 'src/main.c'],
+    ['a header-scan config', '<stdio.h>', 'lib/net/socket.c', headers],
+  ])('refuses %s', (_shape, targetRaw, fromFile, config?: unknown) => {
+    expect(resolve(targetRaw, fromFile, config)).toBeNull();
+  });
+
+  it('is fed the bracketed spelling by the C interpreter, not the bare name', () => {
+    // The table case above is only meaningful if `<stdio.h>` is what the
+    // pipeline actually hands the resolver. Stripping the brackets here would
+    // make a system include indistinguishable from `"stdio.h"` again.
+    const include = (source: string, system: boolean) =>
+      interpretCImport({
+        '@import.source': syntheticCapture('@import.source', source),
+        ...(system ? { '@import.system': syntheticCapture('@import.system', 'true') } : {}),
+      })!.targetRaw!;
+    expect(resolve(include('stdio.h', true), 'src/main.c')).toBeNull();
+    expect(resolve(include('stdio.h', false), 'src/main.c')).toBe('src/stdio.h');
+  });
+
+  it.each([
+    ['a same-directory sibling', 'stdio.h', 'src/main.c', 'src/stdio.h'],
+    ['a same-named header elsewhere', 'stdio.h', 'lib/net/socket.c', 'src/stdio.h'],
+    ['a nested path suffix', 'sys/types.h', 'src/main.c', 'include/sys/types.h'],
+    ['a relative path', '../include/util.h', 'src/main.c', 'include/util.h'],
+    ['an exact workspace path', 'include/util.h', 'lib/net/socket.c', 'include/util.h'],
+  ])('still resolves a quoted include through %s', (_shape, targetRaw, fromFile, expected) => {
+    expect(resolve(targetRaw, fromFile)).toBe(expected);
+  });
