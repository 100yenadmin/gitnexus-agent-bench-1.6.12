+# -- #836 stale bindings and home tag collision detection -----------------------------------------------
+
+def test_836_host_uid_bindings_are_deleted_with_session_messages(tmp_path):
+    """#836: delete_session_messages removes stale host_uid_bindings so store_id reuse doesn't inherit them."""
+    _state_db(tmp_path, [("S", None, None)])
+    engine = _engine(tmp_path)
+    try:
+        engine.ingest([_m("user", "hello" + PAD, 10.0, "u-1"), _m("assistant", "hi", 11.0, "u-2")])
+        initial_bindings = _bindings(engine)
+        assert len(initial_bindings) == 2
+        store_id_1 = initial_bindings[0][0]
+        # Delete the session
+        deleted = engine._store.delete_session_messages("S")
+        assert deleted == 2
+        # Bindings for deleted store_ids should be gone
+        remaining_bindings = _bindings(engine)
+        assert len(remaining_bindings) == 0
+        # Ingest again; new messages might reuse store_id 1 (SQLite reuse)
+        engine.ingest([_m("user", "goodbye" + PAD, 20.0, "u-3")])
+        new_bindings = _bindings(engine)
+        # The new row should bind to a fresh uid, not inherit stale bindings
+        assert len(new_bindings) == 1
+        new_store_id = new_bindings[0][0]
+        new_uid = new_bindings[0][1]
+        assert new_uid == "u-3"
+        # If the store_id was reused, it should NOT have the old bindings
+        if new_store_id == store_id_1:
+            assert (store_id_1, "u-1", "S", "canonical", 1, "stored_new") not in new_bindings
+    finally:
+        engine.shutdown()
+
+
+def test_836_different_hermes_homes_have_different_lineage_keys(tmp_path):
+    """#836: lineage_key includes home_tag to prevent collisions across Hermes homes."""
+    home1 = tmp_path / "home1"
+    home2 = tmp_path / "home2"
+    home1.mkdir()
+    home2.mkdir()
+    # Create identical session structure in two homes
+    _state_db(home1, [("S", None, None)])
+    _state_db(home2, [("S", None, None)])
+    # Create engines in different homes with the same session id
+    engine1 = LCMEngine(config=LCMConfig(database_path=str(tmp_path / "lcm1.db")), hermes_home=str(home1))
+    engine1.on_session_start("S", platform="cli", context_length=200_000)
+    engine2 = LCMEngine(config=LCMConfig(database_path=str(tmp_path / "lcm2.db")), hermes_home=str(home2))
+    engine2.on_session_start("S", platform="cli", context_length=200_000)
+    try:
+        key1, err1 = engine1._host_uid_lineage_key()
+        key2, err2 = engine2._host_uid_lineage_key()
+        assert err1 is None and err2 is None
+        # Extract just the root part for comparison
+        root1 = key1.split(":", 1)[1] if ":" in key1 else key1
+        root2 = key2.split(":", 1)[1] if ":" in key2 else key2
+        assert root1 == "S" and root2 == "S"  # Same root session
+        assert key1 != key2  # But different full keys due to different home_tags
+        assert key1.startswith(key1.split(":")[0]) and key2.startswith(key2.split(":")[0])  # Different home_tag prefixes
+    finally:
+        engine1.shutdown()
+        engine2.shutdown()
