+
+  it('a deterministic failure after a transient retry stops retrying', () => {
+    const t = createParseRetryTracker(undefined, noJitter);
+    expect(t.onFailure('a.ts', crash).retry).toBe(true);
+    expect(t.onFailure('a.ts', syntax)).toEqual({ retry: false, reason: 'deterministic' });
+  });
+
+  it('backs off exponentially across retries of the same file', () => {
