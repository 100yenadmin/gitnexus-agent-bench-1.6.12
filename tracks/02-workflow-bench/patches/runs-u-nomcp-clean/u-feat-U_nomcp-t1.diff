+/**
+ * Validate and normalise the optional `list_repos` `name_contains` filter.
+ *
+ * @internal Exported for unit testing; not part of the public API surface.
+ *
+ * Returns the lower-cased, trimmed needle, or `undefined` when no filter
+ * applies (omitted, `null`, or empty/whitespace-only). A non-string value is
+ * REJECTED for the same reason as {@link parseListReposPagination}: the backend
+ * is the real validation boundary.
+ */
+export function parseListReposNameFilter(
+  params: { name_contains?: unknown } | null | undefined,
+): string | undefined {
+  const value = params?.name_contains;
+  if (value === undefined || value === null) return undefined;
+  if (typeof value !== 'string') {
+    throw new Error(
+      `list_repos: "name_contains" must be a string (received ${JSON.stringify(value)})`,
+    );
+  }
+  const needle = value.trim().toLowerCase();
+  return needle.length > 0 ? needle : undefined;
+}
+
+/**
+ * Keep only repositories whose name contains `needle` (case-insensitive).
+ * `needle` must already be normalised by {@link parseListReposNameFilter};
+ * `undefined` returns the input unchanged.
+ *
+ * @internal Exported for unit testing and the MCP repository policy.
+ */
+export function filterReposByName<T extends { name: string }>(
+  repos: T[],
+  needle: string | undefined,
+): T[] {
+  if (needle === undefined) return repos;
+  return repos.filter((repo) => repo.name.toLowerCase().includes(needle));
+}
