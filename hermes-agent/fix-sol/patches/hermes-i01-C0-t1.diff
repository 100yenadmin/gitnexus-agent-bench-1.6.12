+    [{"type": "redacted_thinking", "data": "opaque-test-data"}],
+    [{"type": "claude-subscription-directsdk-experimental.native_assistant", "messages": [
+        {"role": "assistant", "content": [
+            {"type": "thinking", "thinking": "I considered the factors.", "signature": "sig-abc"},
+        ]},
+    ]}],
+])
+def test_chat_completion_native_thinking_carrier_continues_to_answer(loop_agent, details):
+    from tests.agent.test_run_agent import _mock_response
+
+    answer = "391 = 17 x 23."
+    result = _run(loop_agent, [
