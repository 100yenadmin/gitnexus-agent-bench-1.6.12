     return out
 
 
+def _unresolved_spell_attacks(evs: list[tuple]) -> list[str]:
+    """Advisory trace check: a deferred spell roll must precede turn advancement."""
+    pending: list[tuple[str, list[str], str]] = []
+    unresolved: list[str] = []
+    for name, inp, obj, is_error, _text in evs:
+        if is_error:
+            continue
+        if name == "cast_spell" and isinstance(obj, dict):
+            if obj.get("automated") is False and obj.get("attack_roll") is True:
+                source = inp.get("character_id") or ""
+                targets = list(inp.get("target_ids") or [])
+                target = inp.get("target_id") or inp.get("npc_id") or inp.get("id")
+                if target:
+                    targets.append(target)
+                pending.append((source, targets, obj.get("spell") or inp.get("spell_name") or inp.get("spell") or "spell"))
+        elif name == "attack" and isinstance(obj, dict) and "hit" in obj:
+            if inp.get("is_reaction"):
+                continue
+            source = inp.get("attacker_id") or inp.get("character_id")
+            target = inp.get("target_id") or inp.get("npc_id") or inp.get("id")
+            match = next((p for p in pending if p[0] == source and target in p[1]), None)
+            if match is not None:
+                pending.remove(match)  # a miss resolves the roll too
+        elif name == "remove_combatant":
+            removed = inp.get("character_id")
+            pending = [p for p in pending if removed != p[0] and removed not in p[1]]
+        elif name == "next_turn":
+            unresolved.extend(p[2] for p in pending)
+            pending.clear()
+    unresolved.extend(p[2] for p in pending)
+    return unresolved
+
+
