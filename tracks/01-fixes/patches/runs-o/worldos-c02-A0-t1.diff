diff --git a/servers/engine/tests/test_spell_attack_leg.py b/servers/engine/tests/test_spell_attack_leg.py
new file mode 100644
index 0000000..6f27bb4
--- /dev/null
+++ b/servers/engine/tests/test_spell_attack_leg.py
@@ -0,0 +1,138 @@
+"""#1270: the attack-roll leg of a cast spell is part of the SAME casting action.
+
+A non-auto-resolved attack-roll spell (Guiding Bolt) spends its slot + action in cast_spell
+and returns automated:false / attack_roll:true, leaving the hit to attack(). The #778
+cast→attack gate used to refuse that attack, so the bolt dealt 0 and its pending on-hit
+rider lingered on the caster. `Combat.pending_spell_attack` lets exactly one same-turn
+attack() by the caster on a listed target through."""
+
+import pytest
+
+import server
+from models import Combat
+
+
+@pytest.fixture
+def cleric(tmp_path, monkeypatch):
+    monkeypatch.setenv("WORLDOS_STATE_DIR", str(tmp_path))
+    cid = server.create_campaign("GB1270")["id"]
+    maren = server.create_character(
+        cid, "Maren", kind="player", class_name="Cleric", apply_srd_defaults=True
+    )["id"]
+    server.update_character(cid, maren, patch={"initiative_bonus": 100})
+    server.learn_spells(cid, maren, ["Guiding Bolt", "Fire Bolt", "Inflict Wounds"])
+    server.prepare_spells(cid, maren, ["Guiding Bolt", "Inflict Wounds"])
+    server.update_character(
+        cid, maren, patch={"spell_slots": {"1": {"maximum": 4, "used": 0}}}
+    )
+    gob = server.create_character(cid, "Goblin", kind="monster", max_hp=200, armor_class=1)["id"]
+    orc = server.create_character(cid, "Orc", kind="monster", max_hp=200, armor_class=1)["id"]
+    server.start_combat(cid, [maren, gob, orc])
+    assert server.get_state(cid)["current_turn"] == maren
+    return cid, maren, gob, orc
+
+
+def _psa(cid):
+    return server._require(cid).combat.pending_spell_attack
+
+
+def _bolt(cid, maren, target):
+    out = server.cast_spell(cid, maren, "Guiding Bolt", target_id=target)
+    assert out["automated"] is False and out["attack_roll"] is True
+    return out
+
+
+def test_guiding_bolt_attack_leg_resolves(cleric):
+    cid, maren, gob, _orc = cleric
+    _bolt(cid, maren, gob)
+    psa = _psa(cid)
+    assert psa is not None and psa.source_id == maren and psa.target_ids == [gob]
+    assert psa.spell == "Guiding Bolt"
+    res = server.attack(cid, maren, gob, attack_bonus=50, damage_dice="4d6", damage_type="radiant")
+    assert res["hit"] is True and res["spell_attack_leg"] == "Guiding Bolt"
+    assert _psa(cid) is None
+    c = server._require(cid)
+    assert c.characters[gob].current_hp < 200  # the bolt dealt damage
+    assert c.characters[maren].pending_on_hit_riders == []  # rider consumed by the leg
+    assert c.combat.action_attacks_made == 0  # no Attack-action budget spent
+
+
+def test_second_attack_after_leg_refused(cleric):
+    cid, maren, gob, _orc = cleric
+    _bolt(cid, maren, gob)
+    server.attack(cid, maren, gob, attack_bonus=50, damage_dice="1d4")
+    with pytest.raises(ValueError, match="already cast a spell"):
+        server.attack(cid, maren, gob, attack_bonus=50, damage_dice="1d4")
+
+
+def test_attack_on_other_target_refused(cleric):
+    cid, maren, gob, orc = cleric
+    _bolt(cid, maren, gob)
+    with pytest.raises(ValueError, match="already cast a spell"):
+        server.attack(cid, maren, orc, attack_bonus=50, damage_dice="1d4")
+    assert _psa(cid) is not None  # a refused attack changes nothing
+
+
+def test_other_attacker_does_not_consume_record(cleric):
+    cid, maren, gob, orc = cleric
+    _bolt(cid, maren, gob)
+    # The goblin striking off-turn is a reaction, not the bolt's leg.
+    server.attack(cid, gob, maren, attack_bonus=0, damage_dice="1d1")
+    assert _psa(cid) is not None
+
+
+def test_double_cast_still_refused(cleric):
+    cid, maren, gob, _orc = cleric
+    _bolt(cid, maren, gob)
+    with pytest.raises(ValueError, match="already used its action"):
+        server.cast_spell(cid, maren, "Guiding Bolt", target_id=gob)
+
+
+def test_auto_resolved_spell_sets_no_record_and_attack_refused(cleric):
+    cid, maren, gob, _orc = cleric
+    out = server.cast_spell(cid, maren, "Fire Bolt", target_id=gob)
+    assert out["automated"] is True
+    assert _psa(cid) is None
+    with pytest.raises(ValueError, match="already cast a spell"):
+        server.attack(cid, maren, gob, attack_bonus=50, damage_dice="1d10")
+
+
+def test_non_attack_spell_sets_no_record(cleric):
+    cid, maren, gob, _orc = cleric
+    server.cast_spell(cid, maren, "Inflict Wounds", target_id=gob)
+    assert _psa(cid) is None
+    with pytest.raises(ValueError, match="already cast a spell"):
+        server.attack(cid, maren, gob, attack_bonus=50, damage_dice="1d10")
+
+
+def test_next_turn_clears_record(cleric):
+    cid, maren, gob, _orc = cleric
+    _bolt(cid, maren, gob)
+    server.next_turn(cid)
+    assert _psa(cid) is None
+
+
+def test_target_death_clears_riders_and_record(cleric):
+    cid, maren, gob, _orc = cleric
+    _bolt(cid, maren, gob)
+    assert server._require(cid).characters[maren].pending_on_hit_riders
+    server.apply_damage(cid, gob, 500)
+    c = server._require(cid)
+    assert c.characters[gob].dead
+    assert c.characters[maren].pending_on_hit_riders == []
+    assert c.combat.pending_spell_attack is None
