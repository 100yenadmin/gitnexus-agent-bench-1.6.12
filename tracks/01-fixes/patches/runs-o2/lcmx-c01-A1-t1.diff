+
+# -- tool_group_safe_end (#559) ---------------------------------------------
+
+
+def _leaf_engine(tmp_path, **overrides):
+    config = LCMConfig(
+        fresh_tail_count=2,
+        leaf_chunk_tokens=1,
+        database_path=str(tmp_path / "lcm_tool_group_safe_end.db"),
+        **overrides,
+    )
+    return LCMEngine(config=config)
+
+
+def test_tool_group_safe_end_leaves_cut_outside_group_unchanged():
+    messages = [_user("u0"), *_tool_group(), _user("u1")]
+
+    assert tool_group_safe_end(messages, 1) == 1  # before the assistant
+    assert tool_group_safe_end(messages, 4) == 4  # after the last result
+    assert tool_group_safe_end(messages, 5) == 5  # whole sequence
+    assert tool_group_safe_end(messages, 0) == 0
+
+
+def test_tool_group_safe_end_retreats_to_assistant_row():
+    messages = [_user("u0"), *_tool_group(), _user("u1")]
+
+    # Right after the assistant row and between sibling results.
+    assert tool_group_safe_end(messages, 2) == 1
+    assert tool_group_safe_end(messages, 3) == 1
+
+
+def test_tool_group_safe_end_extends_when_group_starts_at_zero():
+    messages = [*_tool_group(), _user("u1"), _user("u2")]
+
+    assert tool_group_safe_end(messages, 1) == 3
+    assert tool_group_safe_end(messages, 2) == 3
+
+
+def test_tool_group_safe_end_extension_stops_at_declared_results():
+    messages = [*_tool_group(), *_tool_group(payload_a="x", payload_b="y")]
+    messages[3] = {**messages[3], "tool_calls": [
+        {"id": "call-c", "function": {"name": "c", "arguments": "{}"}},
+        {"id": "call-d", "function": {"name": "d", "arguments": "{}"}},
+    ]}
+    messages[4] = {**messages[4], "tool_call_id": "call-c"}
+    messages[5] = {**messages[5], "tool_call_id": "call-d"}
+
+    assert tool_group_safe_end(messages, 1) == 3
+    assert tool_group_safe_end(messages, 5) == 3
+
+
+def test_tool_group_safe_end_unattributable_results_return_end_unchanged():
+    missing_id = [_user("u0"), *_tool_group(), _user("u1")]
+    missing_id[3] = {"role": "tool", "content": "no id"}
+    assert tool_group_safe_end(missing_id, 2) == 2
+    assert tool_group_safe_end(missing_id, 3) == 3
+
+    undeclared = [_user("u0"), *_tool_group(), _user("u1")]
+    undeclared[3] = {**undeclared[3], "tool_call_id": "call-zzz"}
+    assert tool_group_safe_end(undeclared, 2) == 2
+    assert tool_group_safe_end(undeclared, 3) == 3
+
+    no_assistant = [_user("u0"), {"role": "tool", "tool_call_id": "call-a", "content": "x"},
+                    {"role": "tool", "tool_call_id": "call-b", "content": "y"}]
+    assert tool_group_safe_end(no_assistant, 2) == 2
+
+
+def test_select_oldest_leaf_chunk_never_ends_inside_tool_group(tmp_path):
+    engine = _leaf_engine(tmp_path)
+    candidate_raw = [_user("u0 " * 20), *_tool_group(payload_a="a " * 20, payload_b="b " * 20), _user("u1")]
+    budget = count_message_tokens(candidate_raw[0]) + count_message_tokens(candidate_raw[1])
+
+    chunk = engine._select_oldest_leaf_chunk(candidate_raw, budget)
+
+    assert chunk == candidate_raw[:1]
+
+
+def test_select_oldest_leaf_chunk_extends_group_at_start(tmp_path):
+    engine = _leaf_engine(tmp_path)
+    candidate_raw = [*_tool_group(payload_a="a " * 20, payload_b="b " * 20), _user("u1")]
+
+    chunk = engine._select_oldest_leaf_chunk(candidate_raw, 1)
+
+    assert chunk == candidate_raw[:3]
+
+
+def test_leaf_rescue_last_row_fallback_respects_tool_group(tmp_path):
+    engine = _leaf_engine(tmp_path)
+    chunk = [_user("u0"), *_tool_group()]
+
+    smaller = engine._next_leaf_rescue_chunk(chunk, 1)
+
+    assert smaller == chunk[:1]
+
+    whole_group = _tool_group()
+    assert engine._next_leaf_rescue_chunk(whole_group, 1) == whole_group
