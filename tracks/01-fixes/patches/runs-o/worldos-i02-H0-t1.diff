+def test_end_combat_moves_survivor_from_impassable_cell(staged):
+    """#1511: if a survivor's final combat cell is impassable in the rest scene (e.g., on a
+    crate or wall), end_combat moves them to the nearest walkable cell so they're not trapped."""
+    cid, hero, ally, goblin, _loc = staged
+    server.start_combat(cid, [hero, ally, goblin], seed_from_stage=True)
+    c = server._require(cid)
+    # Directly set the hero's combat cell to (4, 2), which is impassable in rest mode.
+    # This simulates end-of-combat state where they ended up on a prop.
+    hero_cb = next(cb for cb in c.combat.order if cb.character_id == hero)
+    hero_cb.x = 4
+    hero_cb.y = 2
+    server.save_campaign(c)
+
+    server.end_combat(cid, resolution="the goblin fled")
+    c = server._require(cid)
+    # The hero should NOT be on (4, 2) since it's impassable in rest.
+    # Instead, it's moved to the nearest walkable cell.
+    hero_final = tuple(c.characters[hero].stage_cell)
+    # The nearest walkable cells to (4, 2) are (3, 2), (4, 1), or (4, 0).
+    # The function picks the one reachable from the hero's previous rest position (0, 0).
+    # Verify it's NOT the crate cell and IS walkable.
+    assert hero_final != (4, 2), f"hero should not remain on impassable crate cell, got {hero_final}"
+    # Verify it's in-bounds and not a blocked cell.
+    assert 0 <= hero_final[0] < 5 and 0 <= hero_final[1] < 3, f"hero cell out of bounds: {hero_final}"
+
+
