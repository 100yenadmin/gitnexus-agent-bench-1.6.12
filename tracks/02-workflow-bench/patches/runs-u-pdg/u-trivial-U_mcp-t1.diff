diff --git a/gitnexus/test/unit/status-json-alias.test.ts b/gitnexus/test/unit/status-json-alias.test.ts
new file mode 100644
index 0000000..47c1e20
--- /dev/null
+++ b/gitnexus/test/unit/status-json-alias.test.ts
@@ -0,0 +1,43 @@
+import { spawnSync } from 'node:child_process';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+import { CLI_SPAWN_PREFIX } from '../helpers/cli-entry.js';
+
+// `gitnexus status -j` must behave exactly like `gitnexus status --json`.
+describe('status -j alias for --json', () => {
+  let cwd: string;
+
+  beforeAll(() => {
+    // A non-git directory gives a deterministic JSON payload without an index.
+    cwd = fs.mkdtempSync(path.join(os.tmpdir(), 'gitnexus-status-j-'));
+  });
+
+  afterAll(() => {
+    fs.rmSync(cwd, { recursive: true, force: true });
+  });
+
+  const runStatus = (...args: string[]) =>
+    spawnSync(process.execPath, [...CLI_SPAWN_PREFIX, 'status', ...args], {
+      cwd,
+      encoding: 'utf8',
+      env: { ...process.env, GIT_CEILING_DIRECTORIES: path.dirname(cwd) },
+    });
+
+  it('lists -j in status help', () => {
+    const result = runStatus('--help');
+    expect(result.status).toBe(0);
+    expect(result.stdout).toMatch(/-j, --json/);
+  });
+
+  it('emits the same machine-readable output for -j and --json', () => {
+    const short = runStatus('-j');
+    const long = runStatus('--json');
+    expect(short.status).toBe(0);
+    expect(long.status).toBe(0);
+    const shortPayload = JSON.parse(short.stdout.trim());
+    expect(shortPayload).toEqual({ schemaVersion: 1, error: 'not-git-repository' });
+    expect(shortPayload).toEqual(JSON.parse(long.stdout.trim()));
+  });
+});
