+@pytest.mark.parametrize(
+    ("previewed", "append_footer", "reused"),
+    [(False, False, False), (True, False, True), (True, True, False)],
+)
+def test_budget_fallback_marks_only_previewed_candidate_reused(
+    agent, monkeypatch, previewed, append_footer, reused,
+):
+    def model_call(_kwargs):
+        if previewed:
+            agent._current_streamed_assistant_text = "composed report"
+        return _response()
+
+    agent._interruptible_api_call = model_call
+    agent._handle_max_iterations = MagicMock(return_value="replacement summary")
+    monkeypatch.setenv("HERMES_VERIFY_ON_STOP", "1")
