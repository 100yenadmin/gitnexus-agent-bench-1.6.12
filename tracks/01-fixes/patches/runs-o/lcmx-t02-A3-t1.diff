index 766445e..016078a 100644
--- a/tools.py
+++ b/tools.py
@@ -192,6 +192,18 @@ def _parse_int_value(value: Any, default: int) -> int:
         return default
 
 
+def _coerce_query_arg(value: Any) -> str:
+    """Normalize a model-supplied ``query`` argument to stripped text.
+
+    Models sometimes send ``null`` (notably right after compaction) or a bare
+    number. ``None`` maps to ``""`` so callers return the documented
+    "No query provided" error; numbers like ``0`` are searched as their text.
+    """
+    if value is None:
+        return ""
+    return str(value).strip()
+
+
 def _parse_non_negative_int(value: Any, default: int) -> int:
     return max(0, _parse_int_value(value, default))
 
