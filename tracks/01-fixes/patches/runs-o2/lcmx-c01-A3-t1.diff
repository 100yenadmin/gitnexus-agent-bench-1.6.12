index f9ae35c..bbcb770 100644
--- a/fresh_tail.py
+++ b/fresh_tail.py
@@ -50,6 +50,70 @@ def _assistant_group_start(messages: Sequence[Dict[str, Any]], start: int) -> in
     return start
 
 
+def _tool_result_id(message: Dict[str, Any]) -> str:
+    return str(message.get("tool_call_id") or "").strip()
+
+
+def tool_group_safe_end(messages: Sequence[Dict[str, Any]], end: int) -> int:
+    """Move a prefix cut so ``messages[:end]`` never ends inside a tool group.
+
+    A tool group is an assistant row with ``tool_calls`` followed by the tool
+    results it declared.  When the cut falls right after that assistant or
+    between its sibling results, the cut retreats to the assistant row.  If
+    that would empty the prefix (the group opens at index 0), the cut extends
+    through the group's declared results instead.  A cut outside any group,
+    or one next to a result whose id is missing or undeclared, is returned
+    unchanged.
+    """
+    message_count = len(messages)
+    end = max(0, min(int(end), message_count))
+    if end == 0:
+        return end
+
+    opener = end - 1
+    while opener >= 0 and messages[opener].get("role") == "tool":
+        opener -= 1
+    if opener < 0 or messages[opener].get("role") != "assistant":
+        return end
+    declared = {
+        _tool_call_id(tool_call)
+        for tool_call in (messages[opener].get("tool_calls") or [])
+    }
+    declared.discard("")
+    if not declared:
+        return end
+
+    seen: set[str] = set()
+    for message in messages[opener + 1:end]:
+        result_id = _tool_result_id(message)
+        if not result_id or result_id not in declared:
+            return end
+        seen.add(result_id)
+
+    if end < message_count and messages[end].get("role") == "tool":
+        result_id = _tool_result_id(messages[end])
+        if not result_id or result_id not in declared:
+            return end
+    elif opener != end - 1:
+        return end
+
+    if opener > 0:
+        return opener
+
+    extended = end
+    while (
+        extended < message_count
+        and seen != declared
+        and messages[extended].get("role") == "tool"
+    ):
+        result_id = _tool_result_id(messages[extended])
+        if not result_id or result_id not in declared:
+            return end
+        seen.add(result_id)
+        extended += 1
+    return extended
+
+
 def resolve_fresh_tail_boundary(
     messages: Sequence[Dict[str, Any]],
     *,
