+def _register_embedding_summary_filter(conn: sqlite3.Connection) -> None:
+    # SQLite TRIM only removes ASCII spaces by default. Use Python's full
+    # whitespace definition in SQL so counts and LIMIT share the same filter.
+    conn.create_function(
+        "lcm_summary_has_text", 1,
+        lambda text: text is not None and bool(text.strip()),
+        deterministic=True,
+    )
+
