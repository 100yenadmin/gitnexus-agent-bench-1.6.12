diff --git a/command.py b/command.py
index a012a1c..d8f0702 100644
--- a/command.py
+++ b/command.py
@@ -2849,6 +2849,32 @@ def _embedding_current_profile(conn: sqlite3.Connection) -> sqlite3.Row | None:
         raise
 
 
+_SUMMARY_TEXT_PRESENT_SQL_FUNCTION = "lcm_summary_text_present"
+
+
+def _summary_text_present(value: object) -> int:
+    """True when a summary has embeddable text under Python's ``str.strip()``.
+
+    SQLite's ``TRIM`` only strips ASCII spaces, so Unicode/control whitespace
+    such as ``"\\v\\f"`` would otherwise survive and be sent to the provider,
+    which rejects the whole mixed batch.
+    """
+    if value is None:
+        return 0
+    if isinstance(value, bytes):
+        value = value.decode("utf-8", errors="replace")
+    return 1 if str(value).strip() else 0
+
+
+def _register_summary_text_present(conn: sqlite3.Connection) -> None:
+    conn.create_function(
+        _SUMMARY_TEXT_PRESENT_SQL_FUNCTION,
+        1,
+        _summary_text_present,
+        deterministic=True,
+    )
+
+
