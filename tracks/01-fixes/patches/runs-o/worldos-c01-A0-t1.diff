diff --git a/servers/engine/tests/test_action_economy_shared.py b/servers/engine/tests/test_action_economy_shared.py
new file mode 100644
index 0000000..2861e56
--- /dev/null
+++ b/servers/engine/tests/test_action_economy_shared.py
@@ -0,0 +1,229 @@
+"""#778: the action is ONE shared resource per turn across cast_spell, attack and use_action,
+decided by the spell's casting time (curated "1 bonus action" and SRD "bonus-action" both count).
+
+Too permissive before: cast+cast, cast+attack, attack+cast, skip+attack all resolved in one turn.
+Too restrictive before: a bonus-action spell (Healing Word) consumed the ACTION, so a following
+use_action("action") or an action spell (Fireball) was refused.
+"""
+from __future__ import annotations
+
+import pytest
+
+import spells
+import store
+from models import Combat
+
+
+def _fight(server, *, extra_attacks: int = 0):
+    """A level-5 caster vs a sturdy monster, with the caster pinned as the current combatant
+    and a fresh economy. Returns (cid, caster_id, foe_id)."""
+    cid = server.create_campaign("economy-778")["id"]
+    caster = server.create_character(
+        cid, "Ilsa", kind="player", class_name="wizard", level=5,
+        abilities={"strength": 10, "dexterity": 14, "constitution": 14,
+                   "intelligence": 18, "wisdom": 12, "charisma": 10},
+        apply_srd_defaults=True,
+    )["id"]
+    foe = server.create_character(cid, "Ogre", kind="monster", max_hp=500, armor_class=5)["id"]
+    known = ["Fire Bolt", "Fireball", "Healing Word", "Misty Step", "Identify", "Glyph of Warding"]
+    server.learn_spells(cid, caster, known)
+    server.prepare_spells(cid, caster, known)
+    if extra_attacks:
+        server.update_character(cid, caster, {"extra_attacks": extra_attacks})
+    server.start_combat(cid, [caster, foe])
+    c = server._require(cid)
+    c.combat.turn_index = next(i for i, cb in enumerate(c.combat.order) if cb.character_id == caster)
+    c.combat.action_used = False
+    store.save_campaign(c)
+    return cid, caster, foe
+
+
+def _swing(server, cid, who, target):
+    return server.attack(cid, who, target, attack_bonus=5, damage_dice="1d4")
+
+
+@pytest.fixture
+def server(tmp_path, monkeypatch):
+    monkeypatch.setenv("WORLDOS_STATE_DIR", str(tmp_path))
+    import server as server_mod
+    return server_mod
+
+
+# ── casting-time classification ─────────────────────────────────────────────────────
+
+@pytest.mark.parametrize("ct,kind", [
+    ("1 bonus action", "bonus"), ("bonus-action", "bonus"), ("1 action", "action"),
+    ("action", "action"), ("1 reaction", "reaction"), ("reaction", "reaction"),
+    ("1 minute", "long"), ("minute", "long"), ("10 minutes", "long"), ("hour", "long"),
+    ("8 hours", "long"), ("", "action"), (None, "action"),
+])
+def test_casting_time_kind(ct, kind):
+    assert spells.casting_time_kind(ct) == kind
+
+
+# ── too restrictive: a bonus-action cast spends only the bonus action ────────────────
+
+def test_bonus_cast_leaves_the_action_for_use_action(server):
+    cid, me, _foe = _fight(server)
+    server.cast_spell(cid, me, "Healing Word", target_id=me)  # curated "1 bonus action"
+    c = server._require(cid)
+    assert c.combat.bonus_action_used is True and c.combat.action_used is False
+    assert server.use_action(cid, me, "action")["ok"] is True
+
+
+def test_bonus_cast_then_action_spell_is_allowed(server):
+    cid, me, foe = _fight(server)
+    server.cast_spell(cid, me, "Healing Word", target_id=me)
+    out = server.cast_spell(cid, me, "Fireball", target_id=foe)
+    assert out["spell"] == "Fireball"
+    assert server._require(cid).combat.action_purpose == "cast"
+
+
+def test_srd_spelled_bonus_action_spell_spends_only_the_bonus(server):
+    cid, me, foe = _fight(server)
+    assert spells.srd_spell("Misty Step")["casting_time"] == "bonus-action"
+    server.cast_spell(cid, me, "Misty Step")
+    c = server._require(cid)
+    assert c.combat.bonus_action_used is True and c.combat.action_used is False
+    _swing(server, cid, me, foe)  # the action is still free for an attack
+
+
+def test_second_bonus_cast_is_refused(server):
+    cid, me, _foe = _fight(server)
+    server.cast_spell(cid, me, "Healing Word", target_id=me)
+    with pytest.raises(ValueError, match="already used its bonus action"):
+        server.cast_spell(cid, me, "Misty Step")
+
+
+# ── too permissive: one action per turn, shared ──────────────────────────────────────
+
+def test_cast_then_cast_is_refused_without_spending_a_slot(server):
+    cid, me, foe = _fight(server)
+    server.cast_spell(cid, me, "Fire Bolt", target_id=foe)
+    slots_before = server.get_character(cid, me)["spell_slots"]
+    with pytest.raises(ValueError, match="already used its action"):
+        server.cast_spell(cid, me, "Fireball", target_id=foe)
+    assert server.get_character(cid, me)["spell_slots"] == slots_before
+
+
+def test_cast_then_attack_is_refused(server):
+    cid, me, foe = _fight(server)
+    server.cast_spell(cid, me, "Fire Bolt", target_id=foe)
+    with pytest.raises(ValueError, match="already cast a spell"):
+        _swing(server, cid, me, foe)
+
+
+def test_attack_then_cast_is_refused(server):
+    cid, me, foe = _fight(server)
+    _swing(server, cid, me, foe)
+    with pytest.raises(ValueError, match="already used its action"):
+        server.cast_spell(cid, me, "Fire Bolt", target_id=foe)
+
+
+def test_skip_then_attack_is_refused(server):
+    cid, me, foe = _fight(server)
+    assert server.use_action(cid, me, "skip")["ok"] is True
+    with pytest.raises(ValueError, match="skipped this turn"):
+        _swing(server, cid, me, foe)
+    with pytest.raises(ValueError, match="already used its action"):
+        server.cast_spell(cid, me, "Fire Bolt", target_id=foe)
+
+
+def test_use_action_then_cast_is_refused(server):
+    cid, me, foe = _fight(server)
+    assert server.use_action(cid, me, "action")["ok"] is True
+    with pytest.raises(ValueError, match="already used its action"):
+        server.cast_spell(cid, me, "Fire Bolt", target_id=foe)
+
+
+def test_cast_then_use_action_is_refused(server):
+    cid, me, foe = _fight(server)
+    server.cast_spell(cid, me, "Fire Bolt", target_id=foe)
+    assert server.use_action(cid, me, "action")["ok"] is False
+
+
+def test_minute_and_hour_casts_refused_in_combat(server):
+    cid, me, _foe = _fight(server)
+    for name in ("Identify", "Glyph of Warding"):
+        rec = spells.srd_spell(name)
+        assert spells.casting_time_kind(rec["casting_time"]) == "long"
+    slots_before = server.get_character(cid, me)["spell_slots"]
+    with pytest.raises(ValueError, match="casting time"):
+        server.cast_spell(cid, me, "Identify")
+    with pytest.raises(ValueError, match="casting time"):
+        server.cast_spell(cid, me, "Glyph of Warding")
+    assert server.get_character(cid, me)["spell_slots"] == slots_before
+    # Nothing was spent: the action is still free.
+    assert server._require(cid).combat.action_used is False
+
+
+# ── Action Surge grants one more action ──────────────────────────────────────────────
+
+def test_action_surge_allows_cast_after_cast(server):
+    cid, me, foe = _fight(server)
+    server.set_class_resource(cid, me, "action_surge", max=1, recharge="short")
+    server.cast_spell(cid, me, "Fire Bolt", target_id=foe)
+    server.use_resource(cid, me, "action_surge")
+    server.cast_spell(cid, me, "Fire Bolt", target_id=foe)
+    with pytest.raises(ValueError, match="already used its action"):
+        server.cast_spell(cid, me, "Fire Bolt", target_id=foe)
+
+
+def test_action_surge_allows_attack_after_cast_and_cast_after_attack(server):
+    cid, me, foe = _fight(server)
+    server.set_class_resource(cid, me, "action_surge", max=1, recharge="short")
+    server.cast_spell(cid, me, "Fire Bolt", target_id=foe)
+    server.use_resource(cid, me, "action_surge")
+    _swing(server, cid, me, foe)  # the surged action
+    with pytest.raises(ValueError):
+        _swing(server, cid, me, foe)  # only one more action, one attack in it
+    with pytest.raises(ValueError, match="already used its action"):
+        server.cast_spell(cid, me, "Fire Bolt", target_id=foe)
+
+
+def test_surge_first_then_cast_keeps_one_attack_action(server):
+    cid, me, foe = _fight(server, extra_attacks=1)
+    server.set_class_resource(cid, me, "action_surge", max=1, recharge="short")
+    server.use_resource(cid, me, "action_surge")
+    server.cast_spell(cid, me, "Fire Bolt", target_id=foe)
+    _swing(server, cid, me, foe)
+    _swing(server, cid, me, foe)  # Extra Attack under the remaining action
+    with pytest.raises(ValueError):
+        _swing(server, cid, me, foe)
+
+
+# ── unchanged: generic use_action + attacks, Extra Attack ────────────────────────────
+
+def test_generic_use_action_then_attacks_still_work(server):
+    cid, me, foe = _fight(server, extra_attacks=1)
+    assert server.use_action(cid, me, "action")["ok"] is True
+    _swing(server, cid, me, foe)
+    out = _swing(server, cid, me, foe)
+    assert out["attacks_made_this_turn"] == 2
+    with pytest.raises(ValueError, match="no attacks left"):
+        _swing(server, cid, me, foe)
+
+
+def test_extra_attack_then_bonus_cast(server):
+    cid, me, foe = _fight(server, extra_attacks=1)
+    _swing(server, cid, me, foe)
+    _swing(server, cid, me, foe)
+    server.cast_spell(cid, me, "Healing Word", target_id=me)  # bonus action still free
+
+
+# ── per-turn reset + snapshot compatibility ──────────────────────────────────────────
+
+def test_next_turn_resets_action_purpose(server):
+    cid, me, foe = _fight(server)
+    server.cast_spell(cid, me, "Fire Bolt", target_id=foe)
+    assert server._require(cid).combat.action_purpose == "cast"
+    server.next_turn(cid)
+    c = server._require(cid)
+    assert c.combat.action_purpose == ""
+    assert c.combat.action_used is False
+
+
+def test_old_snapshot_loads_action_purpose_default():
+    legacy = Combat().model_dump(mode="json")
+    legacy.pop("action_purpose")
+    assert Combat.model_validate(legacy).action_purpose == ""
