+def test_apply_skips_blank_summaries_without_sending_to_provider(
+    monkeypatch, tmp_path
+):
+    engine = _engine(tmp_path)
+    dag = SummaryDAG(engine._store.db_path)
+    try:
+        node_0 = dag.add_node(SummaryNode(
+            session_id="session-a",
+            depth=0,
+            summary="real-summary-0",
+            source_token_count=100,
+            created_at=1.0,
+            latest_at=1.0,
+        ))
+        node_1 = dag.add_node(SummaryNode(
+            session_id="session-a",
+            depth=0,
+            summary="",
+            source_token_count=100,
+            created_at=2.0,
+            latest_at=2.0,
+        ))
+        node_2 = dag.add_node(SummaryNode(
+            session_id="session-a",
+            depth=0,
+            summary="real-summary-2",
+            source_token_count=100,
+            created_at=3.0,
+            latest_at=3.0,
+        ))
+    finally:
+        dag.close()
+
+    store = VectorStore(engine._store.db_path, config=engine._config)
+    try:
+        store.register_profile("model-a", "ollama", 2)
+    finally:
+        store.close()
+
+    provider = FakeProvider()
+    monkeypatch.setattr(command_mod, "resolve_provider", lambda _config, **_kw: provider)
+
+    result = handle_lcm_command("embed backfill --apply", engine)
+
+    assert "status: complete" in result
+    assert "embedded: 2" in result
+    assert "remaining: 1" in result
+    assert provider.calls == [["real-summary-2", "real-summary-0"]]
+    assert _meta_ids(engine) == [str(node_0), str(node_2)]
+
+
