+
+# -- tool_group_safe_end (#559) ---------------------------------------------
+
+
+def test_safe_end_outside_group_is_unchanged():
+    messages = [_user("u0"), *_tool_group(), _user("u4")]
+    assert tool_group_safe_end(messages, 1) == 1
+    assert tool_group_safe_end(messages, 4) == 4
+    assert tool_group_safe_end(messages, 0) == 0
+    assert tool_group_safe_end(messages, len(messages)) == len(messages)
+
+
+def test_safe_end_after_assistant_retreats_to_assistant():
+    messages = [_user("u0"), *_tool_group(), _user("u4")]
+    assert tool_group_safe_end(messages, 2) == 1
+
+
+def test_safe_end_between_sibling_results_retreats_to_assistant():
+    messages = [_user("u0"), *_tool_group(), _user("u4")]
+    assert tool_group_safe_end(messages, 3) == 1
+
+
+def test_safe_end_extends_through_group_starting_at_zero():
+    messages = [*_tool_group(), _user("u3")]
+    assert tool_group_safe_end(messages, 1) == 3
+    assert tool_group_safe_end(messages, 2) == 3
+
+
+def test_safe_end_result_without_id_is_unchanged():
+    messages = [_user("u0"), *_tool_group(), _user("u4")]
+    messages[3] = {"role": "tool", "content": "no id"}
+    assert tool_group_safe_end(messages, 3) == 3
+
+
+def test_safe_end_undeclared_result_id_is_unchanged():
+    messages = [_user("u0"), *_tool_group(), _user("u4")]
+    messages[2] = {"role": "tool", "tool_call_id": "call-x", "content": "stray"}
+    assert tool_group_safe_end(messages, 2) == 2
+    assert tool_group_safe_end(messages, 3) == 3
+
+    leading = [*_tool_group(), _user("u3")]
+    leading[2] = {"role": "tool", "tool_call_id": "call-x", "content": "stray"}
+    assert tool_group_safe_end(leading, 1) == 1
+
+
+def test_safe_end_orphan_result_without_assistant_is_unchanged():
+    messages = [_user("u0"), {"role": "tool", "tool_call_id": "call-a", "content": "x"}, _user("u2")]
+    assert tool_group_safe_end(messages, 1) == 1
+
+
+def _leaf_engine(tmp_path, **config_kwargs):
+    config = LCMConfig(
+        fresh_tail_count=2,
+        database_path=str(tmp_path / "lcm_leaf_group.db"),
+        **config_kwargs,
+    )
+    return LCMEngine(config=config)
+
+
+def test_select_oldest_leaf_chunk_never_ends_inside_tool_group(tmp_path):
+    engine = _leaf_engine(tmp_path)
+    candidate = [_user("u0"), *_tool_group(payload_a="x" * 400, payload_b="y" * 400), _user("u4")]
+    # Budget fits the user + assistant rows but stops before the first result.
+    budget = count_message_tokens(candidate[0]) + count_message_tokens(candidate[1])
+    chunk = engine._select_oldest_leaf_chunk(candidate, budget)
+    assert chunk == candidate[:1]
+
+    # Budget that would stop between sibling results also retreats.
+    budget += count_message_tokens(candidate[2])
+    chunk = engine._select_oldest_leaf_chunk(candidate, budget)
+    assert chunk == candidate[:1]
+
+
+def test_select_oldest_leaf_chunk_extends_leading_group(tmp_path):
+    engine = _leaf_engine(tmp_path)
+    candidate = [*_tool_group(payload_a="x" * 400, payload_b="y" * 400), _user("u3")]
+    chunk = engine._select_oldest_leaf_chunk(candidate, 1)
+    assert chunk == candidate[:3]
+
+
+def test_leaf_rescue_last_row_fallback_does_not_split_group(tmp_path):
+    engine = _leaf_engine(tmp_path, leaf_chunk_tokens=10_000_000)
+    chunk = [_user("u0"), *_tool_group()]
+    tokens = sum(count_message_tokens(message) for message in chunk)
+    assert engine._next_leaf_rescue_chunk(chunk, tokens) == chunk[:1]
+
+    leading = _tool_group()
+    tokens = sum(count_message_tokens(message) for message in leading)
+    assert engine._next_leaf_rescue_chunk(leading, tokens) == []
