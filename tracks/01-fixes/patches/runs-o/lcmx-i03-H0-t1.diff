index 4dd801e..929371a 100644
--- a/tests/test_lcm_engine.py
+++ b/tests/test_lcm_engine.py
@@ -29214,3 +29214,38 @@ class TestExtractionDuringCompress:
         result = eng.compress(messages)
         assert result[0]["role"] == "system"
         assert len(eng._dag.get_session_nodes("extract-fail")) > 0
+
+
+def test_deepcopy_engine_under_wal_contention(tmp_path):
+    """Test that deepcopy of LCMEngine works with active WAL writer lock."""
+    import copy
+
+    db_path = tmp_path / "lcm_deepcopy_test.db"
+    config = LCMConfig(database_path=str(db_path))
+
+    prototype = LCMEngine(config=config)
+    prototype._session_id = "test-session"
+    prototype.context_length = 200000
+    prototype.threshold_tokens = int(200000 * config.context_threshold)
+
+    try:
+        prototype.on_session_start("test-session", platform="test", conversation_id="test-conv")
+        prototype.ingest([{"role": "user", "content": "test message"}])
+
+        conn_writer = sqlite3.connect(str(db_path), timeout=0.1, check_same_thread=False)
+        try:
+            conn_writer.execute("BEGIN IMMEDIATE")
+
+            cloned = copy.deepcopy(prototype)
+            assert cloned is not None
+            assert cloned._store is not None
+            assert cloned._dag is not None
+            assert cloned._lifecycle is not None
+            assert cloned.context_length == prototype.context_length
+            cloned.shutdown()
+
+        finally:
+            conn_writer.rollback()
+            conn_writer.close()
+    finally:
+        prototype.shutdown()
