diff --git a/servers/engine/tests/test_spell_attack_gate.py b/servers/engine/tests/test_spell_attack_gate.py
new file mode 100644
index 0000000..2677425
--- /dev/null
+++ b/servers/engine/tests/test_spell_attack_gate.py
@@ -0,0 +1,190 @@
+"""#1270 — the attack-roll leg of a cast spell is part of the casting action.
+
+Guiding Bolt is an SRD (non-curated) attack-roll spell: `cast_spell` spends the slot + the
+turn's action and returns `automated: false, attack_roll: true`, leaving the hit to a follow-up
+`attack()`. The #778 cast→attack gate used to refuse that attack ("already cast a spell this
+turn and cannot also attack"), so the bolt dealt 0 and its pending on-hit rider leaked.
+
+`Combat.pending_spell_attack` licenses exactly ONE same-turn attack() by the caster on a listed
+target; independent attacks, other targets, double casts and auto-resolved spells stay refused.
+"""
+
+import json
+
+import pytest
+
+import server
+import store
+from models import Campaign
+from dice import DiceRoll
+
+
+@pytest.fixture(autouse=True)
+def isolated(tmp_path, monkeypatch):
+    monkeypatch.setenv("WORLDOS_STATE_DIR", str(tmp_path))
+    yield
+
+
+def _d20_roll(natural: int):
+    def _roll(expression: str, advantage: bool = False, disadvantage: bool = False,
+              seed=None, crit_min: int = 20) -> DiceRoll:
+        if expression.startswith("1d20"):
+            mod = int(expression.split("+", 1)[1]) if "+" in expression else 0
+            return DiceRoll(
+                expression=expression, total=natural + mod, rolls=[natural], modifier=mod,
+                detail=f"{expression}[{natural}]", is_d20=True, natural=natural,
+                crit=(natural == 20), fumble=(natural == 1),
+            )
+        return DiceRoll(expression=expression, total=6, rolls=[3], detail=f"{expression}[3] = 6")
+    return _roll
+
+
+def _caster(cid, spells=("Guiding Bolt",), levels=0):
+    c = server.create_character(
+        cid, "Maren", kind="player", class_name="Cleric",
+        apply_srd_defaults=True, abilities={"wisdom": 16, "constitution": 12},
+    )["id"]
+    for _ in range(levels):
+        server.level_up(cid, c, "Cleric")
+    server.learn_spells(cid, c, list(spells))
+    server.prepare_spells(cid, c, list(spells))
+    return c
+
+
+def _foe(cid, name="Goblin", hp=30, ac=10):
+    return server.create_character(cid, name, kind="monster", max_hp=hp, armor_class=ac)["id"]
+
+
+def _advance_to(cid, who):
+    for _ in range(12):
+        cur = server.get_state(cid).get("current_turn")
+        if cur == who:
+            return
+        ch = server.get_character(cid, cur)
+        if ch.get("kind") in ("player", "companion") and ch.get("current_hp", 1) > 0:
+            server.use_action(cid, cur, "skip")
+        server.next_turn(cid)
+    raise AssertionError(f"never reached {who}'s turn")
+
+
+def _psa(cid):
+    return store.load_campaign(cid).combat.pending_spell_attack
+
+
+def _fight(cid, *foes, caster_spells=("Guiding Bolt",), levels=0):
+    caster = _caster(cid, caster_spells, levels)
+    server.start_combat(cid, [caster, *foes])
+    _advance_to(cid, caster)
+    return caster
+
+
+def _bolt_attack(cid, caster, target):
+    return server.attack(cid, caster, target, attack_bonus=5, damage_dice="4d6",
+                         damage_type="radiant", is_ranged=True)
+
+
+def test_guiding_bolt_attack_leg_resolves_and_deals_damage(monkeypatch):
+    """THE BUG: cast(Guiding Bolt) → attack() must resolve (not be refused) and deal damage."""
+    cid = server.create_campaign("S")["id"]
+    foe = _foe(cid)
+    maren = _fight(cid, foe)
+    out = server.cast_spell(cid, maren, "Guiding Bolt", target_id=foe)
+    assert out["automated"] is False and out["attack_roll"] is True
+    psa = _psa(cid)
+    assert psa is not None and psa.source_id == maren and psa.target_ids == [foe]
+    assert psa.spell == "Guiding Bolt" and psa.round == store.load_campaign(cid).combat.round
+    monkeypatch.setattr(server.dice_mod, "roll", _d20_roll(15))
+    res = _bolt_attack(cid, maren, foe)
+    assert res["hit"] is True and res["spell_attack"] == "Guiding Bolt"
+    assert server.get_character(cid, foe)["current_hp"] == 24  # 30 - 6
+    assert res.get("on_hit_effect_applied") == ["Guiding Bolt"]
+    assert server.get_character(cid, maren)["pending_on_hit_riders"] == []
+    assert _psa(cid) is None  # one use — the record is consumed
+
+
+def test_second_independent_attack_after_spell_leg_is_refused(monkeypatch):
+    cid = server.create_campaign("S")["id"]
+    foe = _foe(cid)
+    maren = _fight(cid, foe)
+    server.cast_spell(cid, maren, "Guiding Bolt", target_id=foe)
+    monkeypatch.setattr(server.dice_mod, "roll", _d20_roll(15))
+    _bolt_attack(cid, maren, foe)
+    cb = store.load_campaign(cid).combat
+    assert cb.action_attacks_made == 0 and cb.action_purpose == "cast"  # no Attack budget spent
+    with pytest.raises(ValueError, match="already cast a spell this turn"):
+        server.attack(cid, maren, foe, attack_bonus=4, damage_dice="1d6")
+
+
+def test_attack_on_unlisted_target_is_refused_and_record_kept():
+    cid = server.create_campaign("S")["id"]
+    foe, other = _foe(cid), _foe(cid, "Orc")
+    maren = _fight(cid, foe, other)
+    server.cast_spell(cid, maren, "Guiding Bolt", target_id=foe)
+    with pytest.raises(ValueError, match="already cast a spell this turn"):
+        _bolt_attack(cid, maren, other)
+    assert _psa(cid) is not None  # a refused attack changes nothing
+
+
+def test_double_cast_stays_refused():
+    cid = server.create_campaign("S")["id"]
+    foe = _foe(cid)
+    maren = _fight(cid, foe, levels=2)  # two 1st-level slots
+    server.cast_spell(cid, maren, "Guiding Bolt", target_id=foe)
+    with pytest.raises(ValueError):
+        server.cast_spell(cid, maren, "Guiding Bolt", target_id=foe)
+
+
+def test_auto_resolved_attack_spell_sets_no_record_and_attack_stays_refused():
+    cid = server.create_campaign("S")["id"]
+    foe = _foe(cid)
+    wiz = server.create_character(
+        cid, "Gale", kind="player", class_name="Wizard",
+        apply_srd_defaults=True, abilities={"intelligence": 16},
+    )["id"]
+    server.learn_spells(cid, wiz, ["Fire Bolt"])
+    server.start_combat(cid, [wiz, foe])
+    _advance_to(cid, wiz)
+    out = server.cast_spell(cid, wiz, "Fire Bolt", target_id=foe)
+    assert out["automated"] is True
+    assert _psa(cid) is None
+    with pytest.raises(ValueError, match="already cast a spell this turn"):
+        server.attack(cid, wiz, foe, attack_bonus=5, damage_dice="1d10", is_ranged=True)
+
+
+def test_next_turn_clears_unresolved_record():
+    cid = server.create_campaign("S")["id"]
+    foe = _foe(cid)
+    maren = _fight(cid, foe)
+    server.cast_spell(cid, maren, "Guiding Bolt", target_id=foe)
+    assert _psa(cid) is not None
+    server.next_turn(cid)
+    assert _psa(cid) is None
+
+
+def test_target_death_clears_riders_and_record():
+    cid = server.create_campaign("S")["id"]
+    foe, other = _foe(cid), _foe(cid, "Orc")
+    maren = _fight(cid, foe, other)
+    server.cast_spell(cid, maren, "Guiding Bolt", target_id=foe)
