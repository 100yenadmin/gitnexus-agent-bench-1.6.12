+def _embedding_text_is_blank(value: object) -> int:
+    # SQLite's TRIM only strips ASCII spaces; blank-ness must match Python's
+    # str.strip() so Unicode whitespace (e.g. "\v\f") is also never embedded.
+    if value is None:
+        return 1
+    if isinstance(value, bytes):
+        value = value.decode("utf-8", errors="replace")
+    return 0 if str(value).strip() else 1
+
+
+def _register_embedding_text_functions(conn: sqlite3.Connection) -> None:
+    conn.create_function(
+        "lcm_text_is_blank", 1, _embedding_text_is_blank, deterministic=True
+    )
+
