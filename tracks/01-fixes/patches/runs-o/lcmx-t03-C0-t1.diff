+def _register_embedding_summary_filter(conn: sqlite3.Connection) -> None:
+    # SQLite TRIM does not share Python's Unicode whitespace definition.
+    # Filter in SQL so counts and LIMIT apply only to embeddable summaries.
+    conn.create_function(
+        "lcm_summary_has_text", 1,
+        lambda text: text is not None and bool(text.strip()),
+        deterministic=True,
+    )
+
+
 def _embedding_pending_rows(
     conn: sqlite3.Connection,
     identity_hash: str,
     limit: int,
 ) -> tuple[int, list[sqlite3.Row]]:
+    _register_embedding_summary_filter(conn)
     # Discovery excludes both recorded rows and every durable in-flight state.
     # A dispatched/uncertain row may already have been accepted remotely, so it
     # must never be silently resent; only explicit --retry-uncertain operator
@@ -2875,6 +2886,7 @@ def _embedding_pending_rows(
     )
     where = """
         n.depth = 0
+        AND lcm_summary_has_text(n.summary)
         AND NOT EXISTS (
             SELECT 1
             FROM lcm_embedding_meta AS m
@@ -2909,10 +2921,12 @@ def _embedding_authorized_uncertain_rows(
     limit: int,
 ) -> tuple[int, list[sqlite3.Row]]:
