diff --git a/gitnexus/test/unit/list-repos-name-filter.test.ts b/gitnexus/test/unit/list-repos-name-filter.test.ts
new file mode 100644
index 0000000..e27d2f6
--- /dev/null
+++ b/gitnexus/test/unit/list-repos-name-filter.test.ts
@@ -0,0 +1,189 @@
+/**
+ * `list_repos` `name_contains` filter: case-insensitive substring match on the
+ * repo name, applied BEFORE pagination so `total` / `hasMore` / `nextOffset`
+ * describe the filtered set. Covers the pure helpers, the LocalBackend tool
+ * surface, the allowlist policy surface, and the advertised schema.
+ */
+import { describe, expect, it, vi } from 'vitest';
+import {
+  LocalBackend,
+  filterReposByName,
+  parseListReposNameFilter,
+  type RepoListing,
+} from '../../src/mcp/local/local-backend.js';
+import { createMcpRepositoryPolicy } from '../../src/mcp/repository-policy.js';
+import { GITNEXUS_TOOLS } from '../../src/mcp/tools.js';
+
+const repo = (name: string, path = `/repos/${name.toLowerCase()}`): RepoListing => ({
+  name,
+  path,
+  indexedAt: '2026-01-01',
+  lastCommit: 'a'.repeat(40),
+});
+
+// Sorted order (lower-cased name, then path): api-gateway, Billing-API,
+// frontend, gitnexus, GitNexus-web, payments-api.
+const REPOS: RepoListing[] = [
+  repo('frontend'),
+  repo('payments-api'),
+  repo('GitNexus-web'),
+  repo('api-gateway'),
+  repo('gitnexus'),
+  repo('Billing-API'),
+];
+
+type Page = Awaited<ReturnType<LocalBackend['listReposPage']>>;
+
+function backendWith(repos: RepoListing[]): LocalBackend {
+  const backend = new LocalBackend();
+  vi.spyOn(backend, 'listRepos').mockImplementation(async () => repos.map((r) => ({ ...r })));
+  return backend;
+}
+
+describe('parseListReposNameFilter', () => {
+  it('returns undefined when the filter is omitted', () => {
+    expect(parseListReposNameFilter(undefined)).toBeUndefined();
+    expect(parseListReposNameFilter(null)).toBeUndefined();
+    expect(parseListReposNameFilter({})).toBeUndefined();
+  });
+
+  it('returns the string verbatim', () => {
+    expect(parseListReposNameFilter({ name_contains: 'Nexus' })).toBe('Nexus');
+    expect(parseListReposNameFilter({ name_contains: '' })).toBe('');
+  });
+
+  it('rejects non-string values instead of coercing them', () => {
+    for (const bad of [null, 5, true, {}, ['api']]) {
+      expect(() => parseListReposNameFilter({ name_contains: bad })).toThrow(/name_contains/);
+    }
+  });
+});
+
+describe('filterReposByName', () => {
+  it('matches case-insensitively as a substring', () => {
+    expect(filterReposByName(REPOS, 'API').map((r) => r.name)).toEqual([
+      'payments-api',
+      'api-gateway',
+      'Billing-API',
+    ]);
+    expect(filterReposByName(REPOS, 'nexus').map((r) => r.name)).toEqual([
+      'GitNexus-web',
+      'gitnexus',
+    ]);
+  });
+
+  it('returns the input unchanged without a filter and everything for an empty needle', () => {
+    expect(filterReposByName(REPOS, undefined)).toBe(REPOS);
+    expect(filterReposByName(REPOS, '')).toHaveLength(REPOS.length);
+  });
+
+  it('returns an empty list when nothing matches', () => {
+    expect(filterReposByName(REPOS, 'zzz')).toEqual([]);
+  });
+});
+
+describe('LocalBackend list_repos name_contains', () => {
+  it('filters before paginating; total/hasMore/nextOffset reflect the filtered set', async () => {
+    const backend = backendWith(REPOS);
+
+    const first = (await backend.callTool('list_repos', {
+      name_contains: 'api',
+      limit: 2,
+    })) as Page;
+    expect(first.repositories.map((r) => r.name)).toEqual(['api-gateway', 'Billing-API']);
+    expect(first.pagination).toEqual({
+      total: 3,
+      limit: 2,
+      offset: 0,
+      returned: 2,
+      hasMore: true,
+      nextOffset: 2,
+    });
+
+    const second = (await backend.callTool('list_repos', {
+      name_contains: 'api',
+      limit: 2,
+      offset: first.pagination.nextOffset,
+    })) as Page;
+    expect(second.repositories.map((r) => r.name)).toEqual(['payments-api']);
+    expect(second.pagination).toEqual({
+      total: 3,
+      limit: 2,
+      offset: 2,
+      returned: 1,
+      hasMore: false,
+    });
+  });
+
+  it('reports total 0 and no continuation when nothing matches', async () => {
+    const page = (await backendWith(REPOS).callTool('list_repos', {
+      name_contains: 'does-not-exist',
+    })) as Page;
+    expect(page.repositories).toEqual([]);
+    expect(page.pagination).toEqual({
+      total: 0,
+      limit: 50,
+      offset: 0,
+      returned: 0,
+      hasMore: false,
+    });
+  });
+
+  it('leaves the unfiltered listing unchanged when the filter is omitted', async () => {
+    const page = (await backendWith(REPOS).callTool('list_repos', {})) as Page;
+    expect(page.pagination.total).toBe(REPOS.length);
+    expect(page.repositories.map((r) => r.name)).toEqual([
+      'api-gateway',
+      'Billing-API',
+      'frontend',
+      'gitnexus',
+      'GitNexus-web',
+      'payments-api',
+    ]);
+  });
+
+  it('rejects a non-string name_contains', async () => {
+    await expect(backendWith(REPOS).callTool('list_repos', { name_contains: 42 })).rejects.toThrow(
+      /name_contains/,
+    );
+  });
+});
+
+describe('repository policy list_repos name_contains', () => {
+  it('applies the name filter after the allowlist and before pagination', async () => {
+    const backend = {
+      listRepos: vi.fn().mockResolvedValue(REPOS.map((r) => ({ ...r }))),
+      countRepos: vi.fn().mockResolvedValue(REPOS.length),
+      cachedRepoCount: vi.fn().mockReturnValue(REPOS.length),
+      callTool: vi.fn(),
+      resolveRepo: vi.fn().mockImplementation(async (r?: string) => ({
+        name: REPOS.find((entry) => entry.path === r || entry.name === r)?.name ?? r,
+        repoPath: REPOS.find((entry) => entry.path === r || entry.name === r)?.path ?? r,
+        lastCommit: 'a'.repeat(40),
+      })),
+    } as unknown as LocalBackend;
+    const policy = await createMcpRepositoryPolicy(backend, {
+      GITNEXUS_MCP_ALLOWED_REPOS: '/repos/payments-api,/repos/billing-api,/repos/frontend',
+    });
+    const scoped = policy.scopeBackend(backend);
+
+    const page = (await scoped.callTool('list_repos', { name_contains: 'API', limit: 1 })) as Page;
+    expect(page.repositories.map((r) => r.name)).toEqual(['Billing-API']);
+    expect(page.pagination).toMatchObject({
+      total: 2,
+      returned: 1,
+      hasMore: true,
+      nextOffset: 1,
+    });
+    expect(backend.callTool).not.toHaveBeenCalled();
+  });
+});
+
+describe('list_repos tool schema', () => {
+  it('advertises an optional string name_contains parameter', () => {
+    const tool = GITNEXUS_TOOLS.find((t) => t.name === 'list_repos');
+    const props = tool?.inputSchema.properties as Record<string, { type: string }>;
+    expect(props.name_contains?.type).toBe('string');
+    expect(tool?.inputSchema.required ?? []).not.toContain('name_contains');
+  });
+});
