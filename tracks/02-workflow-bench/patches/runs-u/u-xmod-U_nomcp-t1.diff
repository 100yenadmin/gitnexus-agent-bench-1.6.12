diff --git a/gitnexus/test/unit/parse-retry.test.ts b/gitnexus/test/unit/parse-retry.test.ts
new file mode 100644
index 0000000..e7b0042
--- /dev/null
+++ b/gitnexus/test/unit/parse-retry.test.ts
@@ -0,0 +1,118 @@
+import { describe, expect, it } from 'vitest';
+import {
+  DEFAULT_PARSE_RETRY_POLICY,
+  classifyParseFailure,
+  decideParseRetry,
+  parseRetryDelayMs,
+  type ParseFailureSignal,
+} from '../../src/core/ingestion/workers/parse-retry.js';
+import { resolveWorkerPoolOptions } from '../../src/core/ingestion/workers/worker-pool.js';
+
+const exit: ParseFailureSignal = { source: 'worker-exit' };
+const parseThrow: ParseFailureSignal = {
+  source: 'worker-reported-error',
+  message: "Cannot read properties of undefined (reading 'childCount')",
+  stack:
+    "TypeError: Cannot read properties of undefined (reading 'childCount')\n    at walk (/x/parse-worker.js:1:1)",
+};
+
+describe('classifyParseFailure', () => {
+  it('treats a worker thread exit as transient', () => {
+    expect(classifyParseFailure(exit)).toBe('transient');
+  });
+
+  it('treats a parser throw reported by the worker as deterministic', () => {
+    expect(classifyParseFailure(parseThrow)).toBe('deterministic');
+    expect(classifyParseFailure({ source: 'worker-uncaught-error', message: 'segfault' })).toBe(
+      'deterministic',
+    );
+    expect(
+      classifyParseFailure({
+        source: 'worker-uncaught-error',
+        message: 'Maximum call stack size exceeded',
+        stack: 'RangeError: Maximum call stack size exceeded',
+      }),
+    ).toBe('deterministic');
+  });
+
+  it('treats resource-exhaustion errors as transient', () => {
+    expect(
+      classifyParseFailure({ source: 'worker-uncaught-error', code: 'ERR_WORKER_OUT_OF_MEMORY' }),
+    ).toBe('transient');
+    expect(
+      classifyParseFailure({
+        source: 'worker-uncaught-error',
+        message: 'Worker terminated due to reaching memory limit: JS heap out of memory',
+      }),
+    ).toBe('transient');
+    expect(
+      classifyParseFailure({
+        source: 'worker-reported-error',
+        message: "EMFILE: too many open files, open '/repo/a.ts'",
+      }),
+    ).toBe('transient');
+    expect(
+      classifyParseFailure({ source: 'worker-reported-error', stack: 'Error: EAGAIN\n    at x' }),
+    ).toBe('transient');
+  });
+
+  it('only reads the stack headline, not frame paths', () => {
+    expect(
+      classifyParseFailure({
+        source: 'worker-reported-error',
+        message: 'bad node',
+        stack: 'Error: bad node\n    at /repo/src/ENOMEM-handler.ts:1:1',
+      }),
+    ).toBe('deterministic');
+  });
+
+  it('treats (de)serialization and protocol failures as deterministic', () => {
+    expect(classifyParseFailure({ source: 'message-deserialization', message: 'x' })).toBe(
+      'deterministic',
+    );
+    expect(classifyParseFailure({ source: 'malformed-message' })).toBe('deterministic');
+  });
+});
+
+describe('decideParseRetry', () => {
+  it('retries a transient failure twice, then marks the file failed', () => {
+    expect(decideParseRetry(exit, 0)).toEqual({ retry: true, attempt: 1, delayMs: 250 });
+    expect(decideParseRetry(exit, 1)).toEqual({ retry: true, attempt: 2, delayMs: 500 });
+    expect(decideParseRetry(exit, 2)).toEqual({ retry: false, reason: 'exhausted' });
+  });
+
+  it('never retries a deterministic parse error, even with budget left', () => {
+    expect(decideParseRetry(parseThrow, 0)).toEqual({ retry: false, reason: 'deterministic' });
+  });
+
+  it('honours a zero-retry policy', () => {
+    expect(decideParseRetry(exit, 0, { ...DEFAULT_PARSE_RETRY_POLICY, maxRetries: 0 })).toEqual({
+      retry: false,
+      reason: 'exhausted',
+    });
+  });
+});
+
+describe('parseRetryDelayMs', () => {
+  it('backs off exponentially and caps at maxDelayMs', () => {
+    const policy = { maxRetries: 5, baseDelayMs: 100, maxDelayMs: 350 };
+    expect([1, 2, 3, 4].map((a) => parseRetryDelayMs(a, policy))).toEqual([100, 200, 350, 350]);
+  });
+});
+
+describe('worker pool transient-retry options', () => {
+  it('defaults to 2 retries with a 250ms base delay', () => {
+    expect(resolveWorkerPoolOptions({}, 1).transientRetry).toEqual({
+      maxRetries: 2,
+      baseDelayMs: 250,
+      maxDelayMs: 2000,
+    });
+  });
+
+  it('accepts explicit overrides, including 0 retries', () => {
+    expect(
+      resolveWorkerPoolOptions({ maxTransientRetries: 0, transientRetryBaseDelayMs: 10 }, 1)
+        .transientRetry,
+    ).toEqual({ maxRetries: 0, baseDelayMs: 10, maxDelayMs: 80 });
+  });
+});
