# Copy to harness/config.env (or point BENCH_CONFIG at your copy) and fill in. Plain KEY=VALUE lines; a value may use
# ${OTHER}. A variable already set in the environment wins. Read by common/benchenv.py (Python) and
# isolation/_config.sh (shell). Keys ending in _API_KEY are read by the shell launchers only.

# --- where things live ----------------------------------------------------------------------------------------------
# State root (large: base checkouts with deps and indexes, per-run APFS clones, GitNexus homes). Discarded run clones
# are renamed into clones.noindex/.trash and need deleting by hand.
BENCH_ROOT=/path/to/bench-state
# Data dirs of the three studies (the bundle's data folders, or your own run output).
BENCH_ARTIFACTS=/path/to/claims-bench-data
HERMES_ARTIFACTS=/path/to/hermes-impact-data
AB_ARTIFACTS=/path/to/ab-ripgrep-data
# Parent directory of the A/B task repositories (task 'cwd' values use $AB_REPOS_ROOT).
AB_REPOS_ROOT=/path/to/repos
# Mining checkouts (optional overrides; default <data dir>/mining).
# MINING_DIR=${BENCH_ARTIFACTS}/mining
# HERMES_MINING_DIR=${HERMES_ARTIFACTS}/mining
# A full clone of abhigyanpatwari/GitNexus (bases are git-archived from it at c4ecf398 and the five review SHAs;
# review cases and hidden labels are read from its eval/workflow_bench at c4ecf398).
GITNEXUS_SRC=/path/to/GitNexus
# A clone of NousResearch/hermes-agent (blobless is fine) used by hermes/mining/mkcheckout.sh.
# HERMES_SRC=${BENCH_ROOT}/src/hermes-agent

# --- tools ------------------------------------------------------------------------------------------------------------
# Node 22+ used to run GitNexus, the hook and the TypeScript ground-truth scripts.
NODE_BIN=/path/to/node
# NODE_BIN_DIR=  (default: dirname of NODE_BIN; task path_prefix entries use $NODE_BIN_DIR)
# The gitnexus npm package at 1.6.12 (npm install gitnexus@1.6.12 -> <dir>/node_modules/gitnexus).
GITNEXUS_PKG=/path/to/node_modules/gitnexus
# Agent CLIs (default: found on PATH).
CLAUDE_BIN=claude
CODEX_BIN=codex
# uv for the hermes-agent tests (hermes/mining/bin/uv forwards to it).
UV_BIN=uv
# pyright 1.1.414 for the hermes impact ground truth (npm install pyright@1.1.414 in this dir).
# PYRIGHT_DIR=${BENCH_ROOT}/tools/pyright-1.1.414
# Extra PATH entries appended after the per-run shims and before /usr/bin:/bin:/usr/sbin:/sbin in agent and grader
# environments. Ours held the dirs of the claude, codex and uv launchers and of other command-line tools.
EXTRA_PATH=
# hermes_pytest.sh's own extra PATH entry (a dir of general command-line tools; never the agent CLIs' dir).
HERMES_PYTEST_EXTRA_PATH=

# --- GitNexus embeddings ----------------------------------------------------------------------------------------------
# Voyage key for query embeddings (voyage-code-4, 1024 dims) and for re-analysis of embedded indexes. Read only by the
# shell launchers and bench-refresh.sh (the original read it from the macOS keychain). Agents can read this file:
# keep it outside the run directories and use a key you can rotate.
VOYAGE_API_KEY=

# --- seed indexes (setup/ only) ---------------------------------------------------------------------------------------
# Bases start from a copy of an existing index and are re-analyzed at the task commit by isolation/bench-refresh.sh.
# Ours were our everyday indexes of these repos; build your own with `gitnexus analyze --embeddings` on a checkout.
# SEED_INDEX_GITNEXUS = an index storage dir (.gitnexus) of GitNexus; the others are checkout dirs holding .gitnexus/.
SEED_INDEX_GITNEXUS=/path/to/GitNexus/.gitnexus
SEED_INDEX_LCMX=/path/to/lcm-x-checkout
SEED_INDEX_WORLDOS=/path/to/WorldOS-checkout
SEED_INDEX_HERMES=/path/to/hermes-agent/.gitnexus
# One file per seed (gitnexus, lcm-x, worldos, hermes-agent) holding its embedding identity, e.g.
# "voyage-code-4/1024/<EMBEDDING_TEXT_VERSION>"; bench-refresh.sh refuses to mix vector spaces without it.
SEED_EMBED_STAMP_DIR=/path/to/embed-stamps

# --- withheld private inputs (see README "Withheld") ------------------------------------------------------------------
# Our global agent instruction file, appended as a system prompt in the sys="owner*" arms (A0-A3, H0, H2, A1f, A1m)
# and the A/B aug* arms. Default: runner/owner-instructions.PLACEHOLDER.md.
# OWNER_INSTRUCTIONS_FILE=/path/to/your/instructions.md
# Directory with gitnexus-* skill dirs, copied into the run for skills="owner" arms (A1, A1f, A1m). No default.
# OWNER_SKILLS_DIR=/path/to/skills
# Codex home for the Codex arms (C*, CR*, cx*). Our runs used our global Codex home (its AGENTS.md, skills, memories).
# CODEX_HOME_FOR_RUNS=/path/to/codex-home
# A/B only: the GitNexus launcher for the MCP arms (default isolation/launcher-ro.sh) and the home for augH2/augHk.
# AB_GNX_LAUNCHER=
# AB_AUG_GN_HOME=
# Contamination audit (grading/scan_gnx.py): extra regex of path fragments that only your everyday index estate prints.
# LIVE_INDEX_MARKERS=
