+def _unresolved_spell_attacks(evs: list[tuple]) -> int:
+    """Count casts whose promised attack never resolved before the turn ended."""
+    pending: list[tuple[str, set[str]]] = []
+    unresolved = 0
+    for name, inp, result, error, _ in evs:
+        if error or not isinstance(result, dict) or result.get("error"):
+            continue
+        if name == "cast_spell" and result.get("automated") is False and result.get("attack_roll"):
+            source = inp.get("character_id") or ""
+            targets = set(inp.get("target_ids") or [])
+            target = inp.get("target_id") or inp.get("npc_id") or inp.get("id")
+            if target:
+                targets.add(target)
+            pending.append((source, targets))
+        elif name == "attack" and isinstance(result.get("hit"), bool):
+            source = inp.get("attacker_id") or inp.get("character_id") or ""
+            target = inp.get("target_id") or inp.get("npc_id") or inp.get("id")
+            if not inp.get("is_reaction"):
+                for i, (caster, targets) in enumerate(pending):
+                    if source == caster and target in targets:
+                        pending.pop(i)
+                        break
+        elif name == "next_turn":
+            unresolved += len(pending)
+            pending.clear()
+    return unresolved + len(pending)
+
+
