+        patch("agent.verification_stop.build_verify_on_stop_nudge", return_value="verify it"),
+        patch("hermes_cli.plugins.invoke_hook", return_value=[]),
+        patch("agent.turn_finalizer._append_file_mutation_footer",
+              side_effect=lambda _agent, text, _logger: text + " Extra." if append_footer else text),
+    ):
+        result = agent.run_conversation("verify the task")
+
+    assert result["final_response"] == ("composed report Extra." if append_footer else "composed report")
+    agent._handle_max_iterations.assert_not_called()
+    assert result["response_reused"] is reused
