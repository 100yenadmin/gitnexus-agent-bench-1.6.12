@@ -0,0 +1,65 @@
+"""Consent must never open the classic-CLI panel when nobody can answer."""
+
+from unittest.mock import Mock
+
+import pytest
+
+from gateway.session_context import clear_session_vars, set_session_vars
+from tools import approval_prompt, terminal_tool
+
+
+@pytest.fixture
+def panel_callback(monkeypatch):
+    monkeypatch.setenv("HERMES_INTERACTIVE", "1")
+    monkeypatch.delenv("HERMES_SINGLE_QUERY_SESSION", raising=False)
+    monkeypatch.delenv("HERMES_GATEWAY_SESSION", raising=False)
+    callback = Mock(return_value="once")
+    previous = terminal_tool._get_approval_callback()
+    terminal_tool.set_approval_callback(callback)
+    try:
+        yield callback
+    finally:
+        terminal_tool.set_approval_callback(previous)
+
+
+@pytest.mark.parametrize("platform,cron,single_query", [
+    pytest.param("", "", True, id="single-query-cli"),
+    pytest.param("telegram", "", True, id="single-query-gateway"),
+    pytest.param("api_server", "", True, id="single-query-api"),
+    pytest.param("", "1", False, id="cron-cli"),
+    pytest.param("telegram", "1", False, id="cron-gateway"),
+    pytest.param("api_server", "1", False, id="cron-api"),
+    pytest.param("webhook", "", False, id="webhook"),
+    pytest.param("msgraph_webhook", "", False, id="msgraph-webhook"),
+    pytest.param("api_server", "", False, id="api-without-listener"),
+])
+def test_no_user_consent_skips_panel(
+    monkeypatch, panel_callback, platform, cron, single_query
+):
+    if single_query:
+        monkeypatch.setenv("HERMES_SINGLE_QUERY_SESSION", "1")
+    # Spy on the real prompt: a callback returning "once" exposes the regression
+    # without waiting for the panel's approval timeout.
+    prompt = Mock(wraps=approval_prompt.prompt_dangerous_approval)
+    monkeypatch.setattr(approval_prompt, "prompt_dangerous_approval", prompt)
+    tokens = set_session_vars(platform=platform, cron_session=cron)
+    try:
+        assert approval_prompt.request_elicitation_consent(
+            "write", "Approve once or deny."
+        ) == "decline"
+    finally:
+        clear_session_vars(tokens)
+    prompt.assert_not_called()
+    panel_callback.assert_not_called()
+
+
+def test_interactive_cli_consent_uses_panel(panel_callback):
+    tokens = set_session_vars(cron_session="")
+    try:
+        assert approval_prompt.request_elicitation_consent(
+            "write", "Approve once or deny."
+        ) == "accept"
+    finally:
+        clear_session_vars(tokens)
+    panel_callback.assert_called_once()
+    assert panel_callback.call_args.kwargs["allow_permanent"] is False
