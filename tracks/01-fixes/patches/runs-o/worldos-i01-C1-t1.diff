diff --git a/servers/engine/tests/test_combat_tactical.py b/servers/engine/tests/test_combat_tactical.py
index d52b4ba..84ee305 100644
--- a/servers/engine/tests/test_combat_tactical.py
+++ b/servers/engine/tests/test_combat_tactical.py
@@ -10,7 +10,11 @@ Pure + LLM-free: build a CombatView, assert the Intent. No campaign, no lock, no
 """
 from __future__ import annotations
 
+from types import SimpleNamespace
+
 import combat_ai
+import combat_grid
+import pytest
 from combat_ai import (
     AoeSpellOption,
     AttackOption,
@@ -248,3 +252,94 @@ def test_tactical_is_deterministic():
     foes = [_foe("g1", cell=(5, 5)), _foe("g2", cell=(5, 6))]
     v = _view(atks, foes, actor_cell=(2, 5), aoe_spells=[fireball], spell_save_dc=15, caster_level=5)
     assert _tv2(v) == _tv2(v)
+
+
+# Greedy-v1 terrain regressions (#1269), including default/unknown-policy fallback.
+
+def _assert_legal_move(view, intent):
+    occupied = {c.cell for c in view.foes + view.allies if c.cell is not None}
+    occupied.discard(view.actor_cell)
+    route = combat_grid.shortest_path(
+        view.actor_cell, intent.to_cell, occupied, view.grid_width, view.grid_height,
+        impassable=set(view.blocking), difficult=set(view.difficult),
+    )
+    assert route is not None
+    assert not (set(route) & (occupied | set(view.blocking)))
+    assert combat_grid.path_cost_cells(
+        view.actor_cell, intent.to_cell, route, difficult=set(view.difficult),
+    ) <= combat_grid.movement_budget_cells(view.speed, view.cell_size, view.dashed)
+
+
+@pytest.mark.parametrize("policy", [None, "greedy-v1", "unknown", "tactical-v2"])
+@pytest.mark.parametrize("wall_start", [0, 1])
+def test_greedy_approach_wall_destination_has_legal_route(policy, wall_start):
+    atks = [AttackOption(name="Claw", to_hit=5, damage_expr="1d6", reach_ft=5)]
+    view = _view(atks, [_foe("t", cell=(8, 5))], actor_cell=(2, 5),
+                 blocking=[(5, y) for y in range(wall_start, 12)])
+    kwargs = {} if policy is None else {"policy": policy}
+    intent = combat_ai.pick_action(actor=object(), combat_state=view, **kwargs)
+    assert intent.kind == "move"
+    assert intent.to_cell[0] < 5  # crossing via the gap costs more than this turn's budget
+    _assert_legal_move(view, intent)
+
+
+def test_greedy_approach_routes_around_short_wall():
+    view = _view([AttackOption(name="Claw", to_hit=5, damage_expr="1d6")],
+                 [_foe("t", cell=(8, 5))], actor_cell=(2, 5), blocking=[(5, 5)])
+    intent = _greedy(view)
+    assert intent.kind == "move"
+    assert intent.to_cell[0] > 5
+    _assert_legal_move(view, intent)
+
+
+def test_greedy_enclosed_actor_dodges():
+    walls = [(x, y) for x in range(1, 4) for y in range(4, 7) if (x, y) != (2, 5)]
+    view = _view([AttackOption(name="Claw", to_hit=5, damage_expr="1d6")],
+                 [_foe("t", cell=(8, 5))], actor_cell=(2, 5), blocking=walls)
+    assert _greedy(view).kind == "dodge"
+
+
+@pytest.mark.parametrize("speed, difficult, expected", [
+    (10, (2, 0), (2, 1)),  # difficult destination exceeds the movement budget
+    (30, (4, 0), (4, 1)),  # both reachable, but clear ground costs less
+])
+def test_greedy_approach_prefers_cheaper_ground(speed, difficult, expected):
+    view = _view([AttackOption(name="Claw", to_hit=5, damage_expr="1d6")],
+                 [_foe("t", cell=(5, 0))], actor_cell=(0, 0), speed=speed,
+                 difficult=[difficult])
+    intent = _greedy(view)
+    assert intent.kind == "move"
+    assert intent.to_cell == expected
+    _assert_legal_move(view, intent)
+
+
+@pytest.mark.parametrize("wall_start", [0, 1])
+def test_greedy_retreat_wall_destination_has_legal_route(monkeypatch, wall_start):
+    monkeypatch.setattr(combat_ai, "RETREAT_FRACTION", 0.5)
+    view = _view([], [_foe("t", cell=(0, 5))], actor_cell=(2, 5), speed=25,
+                 blocking=[(5, y) for y in range(wall_start, 12)])
+    intent = combat_ai.pick_action(SimpleNamespace(max_hp=20, current_hp=1), view)
+    assert intent.kind == "disengage"
+    # With a gap, the gap itself is legal at five steps; the far side needs six.
+    assert intent.to_cell[0] <= (5 if wall_start else 4)
+    _assert_legal_move(view, intent)
+
+
+def test_greedy_retreat_prefers_cheaper_ground(monkeypatch):
+    monkeypatch.setattr(combat_ai, "RETREAT_FRACTION", 0.5)
+    view = _view([], [_foe("t", cell=(1, 2))], actor_cell=(2, 2), speed=10,
+                 difficult=[(4, 4)])
+    intent = combat_ai.pick_action(SimpleNamespace(max_hp=20, current_hp=1), view)
+    assert intent.kind == "disengage"
+    assert intent.to_cell == (4, 3)
+    _assert_legal_move(view, intent)
+
+
+def test_greedy_open_floor_preserves_approach_and_retreat_cells(monkeypatch):
+    view = _view([AttackOption(name="Claw", to_hit=5, damage_expr="1d6")],
+                 [_foe("t", cell=(8, 5))], actor_cell=(2, 5))
+    assert _greedy(view).to_cell == (7, 4)
+    monkeypatch.setattr(combat_ai, "RETREAT_FRACTION", 0.5)
+    intent = combat_ai.pick_action(SimpleNamespace(max_hp=20, current_hp=1), view)
+    assert intent.kind == "disengage"
+    assert intent.to_cell == (0, 11)
