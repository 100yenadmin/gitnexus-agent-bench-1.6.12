diff --git a/tests/hermes_cli/test_failed_platform_rearm.py b/tests/hermes_cli/test_failed_platform_rearm.py
new file mode 100644
index 00000000..69a2b600
--- /dev/null
+++ b/tests/hermes_cli/test_failed_platform_rearm.py
@@ -0,0 +1,45 @@
+"""Failed platform imports retry only after an explicit manager rearm."""
+
+import sys
+import types
+
+from gateway.platform_registry import platform_registry
+from hermes_cli.plugins import PluginManager, PluginManifest
+
+
+def test_failed_platform_rearms_without_importing_until_lookup(tmp_path, monkeypatch):
+    probe = types.ModuleType("_platform_retry_probe")
+    probe.attempts = 0
+    monkeypatch.setitem(sys.modules, probe.__name__, probe)
+    plugin_dir = tmp_path / "retryplat"
+    plugin_dir.mkdir()
+    (plugin_dir / "__init__.py").write_text(
+        "import _platform_retry_probe as probe\n"
+        "def register(ctx):\n"
+        "    probe.attempts += 1\n"
+        "    if probe.attempts == 1:\n"
+        "        raise TimeoutError()\n"
+        "    ctx.register_platform(name='retryplat', label='Retry',\n"
+        "        adapter_factory=lambda config: object(), check_fn=lambda: True)\n"
+    )
+    manifest = PluginManifest(
+        name="retryplat-platform", key="retryplat-platform", kind="platform",
+        source="bundled", path=str(plugin_dir),
+    )
+    manager = PluginManager()
+    try:
+        assert manager.rearm_failed_platform("retryplat") is False
+        manager._register_deferred_platform(manifest)
+        assert manager.rearm_failed_platform("retryplat") is False
+        assert platform_registry.get("retryplat") is None
+        assert platform_registry.get("retryplat") is None
+        assert probe.attempts == 1
+        assert manager.rearm_failed_platform("unknown") is False
+        assert manager.rearm_failed_platform("retryplat") is True
+        assert probe.attempts == 1
+        assert manager.rearm_failed_platform("retryplat") is False
+        assert platform_registry.get("retryplat").label == "Retry"
+        assert probe.attempts == 2
+        assert manager.rearm_failed_platform("retryplat") is False
+    finally:
+        manager.unload(manifest)
