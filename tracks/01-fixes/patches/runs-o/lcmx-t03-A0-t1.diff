+_BLANK_SUMMARIES = ("", "   ", "\n\t ", "\v\f", "  　")
+
+
+def _blank_out(engine, node_ids: list[int], texts=_BLANK_SUMMARIES) -> None:
+    conn = sqlite3.connect(engine._store.db_path)
+    try:
+        conn.executemany(
+            "UPDATE summary_nodes SET summary = ? WHERE node_id = ?",
+            list(zip(texts, node_ids)),
+        )
+        conn.commit()
+    finally:
+        conn.close()
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        (None, 0),
+        ("", 0),
+        ("  \t\n", 0),
+        ("\v\f", 0),
+        ("  　 ", 0),
+        (b" \x0b\x0c", 0),
+        ("x", 1),
+        ("  real summary \v", 1),
+        (b"real", 1),
+    ],
+)
+def test_summary_embeddable_predicate_uses_python_whitespace(value, expected):
+    assert command_mod._summary_text_is_embeddable(value) == expected
+
+
+def test_blank_leaf_summaries_are_excluded_from_preview_and_apply(
+    monkeypatch, tmp_path
+):
+    engine = _engine(tmp_path)
+    node_ids = _seed(engine, 8)
+    blank_ids = node_ids[:len(_BLANK_SUMMARIES)]
+    real_ids = node_ids[len(_BLANK_SUMMARIES):]
+    _blank_out(engine, blank_ids)
+    provider = FakeProvider()
+    monkeypatch.setattr(command_mod, "resolve_provider", lambda _config, **_kw: provider)
+
+    preview = handle_lcm_command("embed backfill", engine)
+
+    assert f"pending: {len(real_ids)}" in preview
+    assert f"selected: {len(real_ids)}" in preview
+    assert provider.calls == []
+
+    applied = handle_lcm_command("embed backfill --apply", engine)
+
+    assert "status: complete" in applied
+    assert f"embedded: {len(real_ids)}" in applied
+    assert "remaining: 0" in applied
+    sent = [text for batch in provider.calls for text in batch]
+    assert sorted(sent) == sorted(f"summary-{index}" for index in range(5, 8))
+    assert all(text.strip() for text in sent)
+    assert _meta_ids(engine) == [str(node_id) for node_id in real_ids]
+    assert _inflight_rows(engine) == []
+
+
+def test_retry_uncertain_never_resends_blank_summary_and_keeps_its_marker(
+    monkeypatch, tmp_path
+):
+    engine = _engine(tmp_path)
+    node_ids = _seed(engine, 2)
+    _blank_out(engine, [node_ids[0]], ["\v\f"])
+    _mark_uncertain(engine, node_ids)
+    provider = FakeProvider()
+    monkeypatch.setattr(command_mod, "resolve_provider", lambda _config, **_kw: provider)
+
+    result = handle_lcm_command(
+        "embed backfill --apply --retry-uncertain", engine
+    )
+
+    assert "selected: 1" in result
+    assert "embedded: 1" in result
+    assert provider.calls == [["summary-1"]]
+    assert _meta_ids(engine) == [str(node_ids[1])]
+    assert _inflight_rows(engine) == [(str(node_ids[0]), "uncertain")]
+
+    again = handle_lcm_command("embed backfill --apply --retry-uncertain", engine)
+
+    assert "selected: 0" in again
+    assert provider.calls == [["summary-1"]]
+    assert _inflight_rows(engine) == [(str(node_ids[0]), "uncertain")]
+
