+    expect(t.retriesFor('b.ts')).toBe(1);
+  });
+
+  it('marks a deterministic failure failed immediately without spending budget', () => {
+    const t = createParseRetryTracker(undefined, noJitter);
+    expect(t.onFailure('a.ts', syntax)).toEqual({ retry: false, reason: 'deterministic' });
+    expect(t.retriesFor('a.ts')).toBe(0);
+    expect(t.totalRetries).toBe(0);
