 import sys
 from pathlib import Path
 
+import pytest
+
 ROOT = Path(__file__).resolve().parents[3]
 GATE = ROOT / "qa" / "assert_behavioral.py"
 PLAYER_IN_PARTY = {"characters": {"pc1": {"kind": "player", "name": "Kield"}}, "party": ["pc1"]}
@@ -29,6 +31,50 @@ PARTY_WITH_COMPANION = {
 }
 
 
+@pytest.mark.parametrize("resolution,warn", [
+    ("none", True), ("hit", False), ("miss", False),
+    ("rejected", True), ("wrong_target", True), ("wrong_caster", True),
+    ("late", True), ("automated", False), ("save", False),
+])
+def test_unresolved_spell_attack_is_warning_only(tmp_path, resolution, warn):
+    rows = []
+
+    def tool(name, inp, result, error=False):
+        tid = str(len(rows))
+        rows.extend([
+            {"type": "assistant", "message": {"content": [{
+                "type": "tool_use", "id": tid,
+                "name": f"mcp__worldos-engine__{name}", "input": inp,
+            }]}},
+            {"type": "user", "message": {"content": [{
+                "type": "tool_result", "tool_use_id": tid,
+                "content": json.dumps(result), "is_error": error,
+            }]}},
+        ])
+
+    tool("roll", {}, {"total": 10})
+    tool("cast_spell", {"character_id": "pc1", "target_id": "foe"}, {
+        "automated": resolution == "automated", "attack_roll": resolution != "save",
+    })
+    if resolution == "late":
+        tool("next_turn", {}, {"current_turn": "foe"})
+    if resolution not in ("none", "automated", "save"):
+        tool("attack", {
+            "attacker_id": "other" if resolution == "wrong_caster" else "pc1",
+            "target_id": "other" if resolution == "wrong_target" else "foe",
+        }, {"hit": resolution != "miss"}, error=resolution == "rejected")
+    tool("next_turn", {}, {"current_turn": "foe"})
+    run = tmp_path / "run.jsonl"
+    _write(run, rows)
+    state = tmp_path / "state.json"
+    state.write_text(json.dumps(PLAYER_IN_PARTY), encoding="utf-8")
+    result = subprocess.run([sys.executable, str(GATE), str(run), str(state)],
+                            capture_output=True, text=True)
+    assert result.returncode == 0, result.stdout + result.stderr
+    tag = "WARN" if warn else "PASS"
+    assert f"[{tag}] unresolved_spell_attack" in result.stdout
+
+
 def _write(p: Path, rows: list[dict]) -> None:
     p.write_text("".join(json.dumps(r) + "\n" for r in rows), encoding="utf-8")
 
