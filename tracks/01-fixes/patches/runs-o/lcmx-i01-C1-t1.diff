index 0000000..ff8f7ab
--- /dev/null
+++ b/tests/test_issue_750_session_depths.py
@@ -0,0 +1,98 @@
+"""#750: depth discovery must not depend on the capped session-node reader."""
+
+import pytest
+
+import hermes_lcm.engine as lcm_engine
+from hermes_lcm.config import LCMConfig
+from hermes_lcm.dag import SummaryNode
+from hermes_lcm.engine import LCMEngine
+
+
+@pytest.fixture
+def engine(tmp_path):
+    instance = LCMEngine(config=LCMConfig(
+        database_path=str(tmp_path / "lcm.db"), max_assembly_tokens=100_000,
+    ))
+    instance.on_session_start("S", context_length=200_000)
+    try:
+        yield instance
+    finally:
+        instance.shutdown()
+
+
+def add_node(dag, depth, index, *, session_id="S", sources=()):
+    node = SummaryNode(
+        session_id=session_id, depth=depth, summary=f"Summary d{depth} #{index}",
+        token_count=10, source_token_count=40, source_ids=list(sources),
+        source_type="nodes" if depth else "messages", created_at=float(index + 1),
+    )
+    dag.add_node(node)
+    return node
+
+
+def build_hierarchy(dag, leaves):
+    """Real fan-in-four edges leave only the uncondensed frontier visible."""
+    nodes = [add_node(dag, 0, i) for i in range(leaves)]
+    for depth in range(1, 4):
+        nodes = [add_node(dag, depth, i // 4,
+                          sources=[n.node_id for n in nodes[i:i + 4]])
+                 for i in range(0, len(nodes) - 3, 4)]
+    return nodes
+
+
+def test_session_depths_are_sorted_distinct_scoped_and_uncapped(engine):
+    dag = engine._dag
+    for i in range(1024):
+        add_node(dag, 0, i)
+    for depth in (12, 2, 12):
+        add_node(dag, depth, depth)
+    add_node(dag, 99, 0, session_id="other")
+
+    assert dag.get_session_depths("S") == [0, 2, 12]
+    assert dag.get_session_depths("other") == [99]
+    assert dag.get_session_depths("unknown") == []
+    # Existing readers retain their default cap and optional depth/limit filters.
+    assert len(dag.get_session_nodes("S")) == 1000
+    assert len(dag.get_session_nodes("S", depth=12)) == 2
+    assert len(dag.get_session_nodes("S", limit=2000)) == 1027
+    assert len(dag.get_session_nodes("S", limit=2)) == 2
+
+
+def test_session_depths_have_no_distinct_depth_cap(engine):
+    for depth in reversed(range(1005)):
+        add_node(engine._dag, depth, depth)
+    assert engine._dag.get_session_depths("S") == list(range(1005))
+
+
+@pytest.mark.parametrize("leaves", [760, 800, 1000, 1024])
+def test_assembly_keeps_deep_summaries_in_large_sessions(engine, leaves):
+    dag = engine._dag
+    top = build_hierarchy(dag, leaves)
+    system = {"role": "system", "content": "system prompt"}
+    tail = [{"role": "user", "content": "fresh turn"}]
+    assembled = engine._assemble_context(system, tail, include_lcm_note=False)
+    text = "\n".join(msg.get("content", "") for msg in assembled)
+
+    for depth in range(4):
+        for node in dag.get_uncondensed_at_depth("S", depth):
+            assert f"(d{depth}, node {node.node_id})" in text
+            assert node.summary in text
+    assert top and all(f"(d3, node {node.node_id})" in text for node in top)
+    assert assembled[0] == system and assembled[-1] == tail[0]
+
+
+def test_unlimited_condensation_reaches_deep_nodes_after_1024_leaves(engine, monkeypatch):
+    top = build_hierarchy(engine._dag, 1024)
+    engine._config.incremental_max_depth = -1
+    calls = []
+
+    def summarize(**kwargs):
+        calls.append(kwargs["depth"])
+        return "Condensed history", 1
+
+    monkeypatch.setattr(lcm_engine, "summarize_with_escalation", summarize)
+    assert engine._maybe_condense() == 1
+    assert calls == [4]
+    parent, = engine._dag.get_session_nodes("S", depth=4)
+    assert parent.source_ids == [node.node_id for node in top[:4]]
+    assert all(engine._dag.get_node(node.node_id) is not None for node in top)
