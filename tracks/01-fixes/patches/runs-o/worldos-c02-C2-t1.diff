diff --git a/servers/engine/tests/test_action_economy.py b/servers/engine/tests/test_action_economy.py
index a038766..c295806 100644
--- a/servers/engine/tests/test_action_economy.py
+++ b/servers/engine/tests/test_action_economy.py
@@ -244,3 +244,101 @@ def test_old_snapshot_without_action_purpose_defaults_empty():
     # Round-trips: the field serializes back and reloads to the same value.
     reloaded = Combat.model_validate(loaded.model_dump(mode="json"))
     assert reloaded.action_purpose == ""
+
+
+# #1270: the attack roll belongs to the casting action, not a second Attack action.
+def _guiding_bolt(caster, **kw):
+    cid, wiz, gob = caster
+    server.learn_spells(cid, wiz, ["Guiding Bolt"])
+    server.prepare_spells(cid, wiz, ["Guiding Bolt"])
+    return server.cast_spell(cid, wiz, "Guiding Bolt", **(kw or {"target_id": gob}))
+
+
+@pytest.mark.parametrize("hit", [True, False])
+def test_pending_spell_attack_resolves_once(caster, monkeypatch, hit):
+    from dice import DiceRoll
+
+    cid, wiz, gob = caster
+    # Even Extra Attack must not turn the spell roll into a new Attack action.
+    server.update_character(cid, wiz, patch={"extra_attacks": 2})
+    cast = _guiding_bolt(caster)
+    assert cast["automated"] is False and cast["attack_roll"] is True
+    pending = server._require(cid).combat.pending_spell_attack
+    assert pending.source_id == wiz and pending.target_ids == [gob]
+    assert pending.spell == "Guiding Bolt" and pending.round == server._require(cid).combat.round
+    assert server.get_character(cid, wiz)["spell_slots"]["1"]["used"] == 1
+    monkeypatch.setattr(server.dice_mod, "roll", lambda expr, **kw: DiceRoll(
+        expression=expr, total=15 if hit else 1, rolls=[15 if hit else 1],
+        natural=15 if hit else 1, fumble=not hit, detail="fixed"))
+    before = server.get_character(cid, gob)["current_hp"]
+    result = server.attack(cid, wiz, gob, attack_bonus=5, damage_dice="4d6",
+                           damage_type="radiant", is_ranged=True)
+    assert result["hit"] is hit
+    assert server.get_character(cid, gob)["current_hp"] == (before - 15 if hit else before)
+    assert server._require(cid).combat.pending_spell_attack is None
+    assert server._require(cid).combat.action_attacks_made == 0
+    assert server.get_character(cid, wiz)["pending_on_hit_riders"] == []
+    effects = server.get_character(cid, gob)["active_effects"]
+    assert any(e["name"] == "Guiding Bolt" for e in effects) is hit
+    with pytest.raises(ValueError, match="already cast a spell"):
+        server.attack(cid, wiz, gob, damage_dice="1d6")
+    with pytest.raises(ValueError, match="already used its action"):
+        _guiding_bolt(caster)
+
+
+def test_pending_spell_attack_wrong_target_and_double_cast_refused(caster):
+    cid, wiz, gob = caster
+    other = server.create_character(cid, "Other", kind="monster", max_hp=20)["id"]
+    _guiding_bolt(caster)
+    with pytest.raises(ValueError, match="already cast a spell"):
+        server.attack(cid, wiz, other, damage_dice="1d6")
+    with pytest.raises(ValueError, match="already used its action"):
+        _guiding_bolt(caster)
+    assert server._require(cid).combat.pending_spell_attack.target_ids == [gob]
+    assert server.get_character(cid, wiz)["spell_slots"]["1"]["used"] == 1
+
+
+def test_pending_spell_attack_target_list(caster):
+    cid, wiz, gob = caster
+    _guiding_bolt(caster, target_ids=[gob, gob])
+    assert server._require(cid).combat.pending_spell_attack.target_ids == [gob]
+    server.attack(cid, wiz, gob, damage_dice="1d6")
+    assert server._require(cid).combat.pending_spell_attack is None
+
+
+@pytest.mark.parametrize("spell", ["Magic Missile", "Fire Bolt"])
+def test_automated_spell_has_no_pending_attack(caster, spell):
+    cid, wiz, gob = caster
+    server.prepare_spells(cid, wiz, [spell])
+    assert _cast(cid, wiz, spell, target_id=gob)["automated"] is True
+    assert server._require(cid).combat.pending_spell_attack is None
+    with pytest.raises(ValueError, match="already cast a spell"):
+        server.attack(cid, wiz, gob, damage_dice="1d6")
+
+
+def test_next_turn_clears_pending_spell_attack(caster):
+    cid, wiz, gob = caster
+    _guiding_bolt(caster)
+    server.next_turn(cid)
+    assert server._require(cid).combat.pending_spell_attack is None
+
+
+@pytest.mark.parametrize("cleanup", ["death", "remove"])
+def test_target_cleanup_clears_pending_spell_and_riders(caster, cleanup):
+    cid, wiz, gob = caster
+    _guiding_bolt(caster)
+    assert server.get_character(cid, wiz)["pending_on_hit_riders"]
+    if cleanup == "death":
+        server.set_hp(cid, gob, current_hp=0)
+    else:
+        server.remove_combatant(cid, gob)
+    assert server._require(cid).combat.pending_spell_attack is None
+    assert server.get_character(cid, wiz)["pending_on_hit_riders"] == []
+
