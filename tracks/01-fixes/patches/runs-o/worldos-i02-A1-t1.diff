@@ -126,6 +126,41 @@ def test_end_combat_writes_survivors_final_cells_back_to_stage(staged):
     assert tuple(c.characters[ally].stage_cell) == (1, 0)   # never moved → unchanged
 
 
+def _force_combat_cell(cid, char_id, cell):
+    c = server._require(cid)
+    cb = next(cb for cb in c.combat.order if cb.character_id == char_id)
+    cb.x, cb.y = cell
+    server.save_campaign(c)
+
+
+def test_end_combat_moves_survivor_off_rest_blocked_prop(staged):
+    """#1511: the fight's grid allowed a cell the REST scene forbids (the crate at (4,2)) — the
+    write-back settles the survivor on the nearest walkable rest cell instead of trapping it."""
+    cid, hero, ally, goblin, _loc = staged
+    server.start_combat(cid, [hero, ally, goblin], seed_from_stage=True)
+    _force_combat_cell(cid, hero, (4, 2))
+    server.end_combat(cid, resolution="cleared")
+    c = server._require(cid)
+    # Nearest walkable neighbour of (4,2), ranked (chebyshev, y, x) → (3,1).
+    assert tuple(c.characters[hero].stage_cell) == (3, 1)
+    assert tuple(c.characters[ally].stage_cell) == (1, 0)  # a legal cell is left alone
+
+
+def test_end_combat_moves_survivor_off_wall_and_off_grid(staged):
+    cid, hero, ally, goblin, _loc = staged
+    server.start_combat(cid, [hero, ally, goblin], seed_from_stage=True)
+    _force_combat_cell(cid, hero, (2, 2))   # a wall cell in the rest scene
+    _force_combat_cell(cid, ally, (9, 9))   # off the 5x3 rest grid
+    server.end_combat(cid, resolution="cleared")
+    c = server._require(cid)
+    hero_cell = tuple(c.characters[hero].stage_cell)
+    ally_cell = tuple(c.characters[ally].stage_cell)
+    assert hero_cell == (1, 1)  # nearest reachable walkable neighbour of (2,2)
+    assert ally_cell == (3, 2)  # nearest free in-grid cell to (9,9)
+    terrain = {(2, 1), (2, 2), (4, 2)}
+    assert hero_cell not in terrain and ally_cell not in terrain and hero_cell != ally_cell
+
+
 def test_end_combat_skips_the_dead(staged):
     """A downed combatant has no rest position — its cell is NOT written back to stage_cell."""
     cid, hero, ally, goblin, _loc = staged
