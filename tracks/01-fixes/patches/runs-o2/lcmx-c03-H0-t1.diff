+# -- v0.26.0 A: stale bindings and lineage key collisions --------------------------------------------------
+
+def test_v0260a_bindings_are_deleted_when_messages_are_deleted(tmp_path):
+    """Bindings of deleted store_ids should be removed to prevent stale binding reuse on store_id recycling."""
+    _state_db(tmp_path, [("S", None, None)])
+    engine = _engine(tmp_path)
+    try:
+        engine.ingest([_m("user", "hello" + PAD, 10.0, "u-1"), _m("assistant", "hi", 11.0, "u-2")])
+        first_bindings = _bindings(engine)
+        assert len(first_bindings) == 2
+        deleted_store_ids = {b[0] for b in first_bindings}
+
+        # Delete the session's messages
+        deleted = engine._store.delete_session_messages("S")
+        assert deleted == 2
+
+        # Bindings should be gone (for the deleted store_ids)
+        remaining_bindings = _bindings(engine)
+        assert len(remaining_bindings) == 0
+
+        # Verify the host_uid_bindings table no longer has bindings for deleted store_ids
+        bindings_table_rows = engine._store._conn.execute(
+            "SELECT store_id FROM host_uid_bindings WHERE store_id IN (SELECT * FROM (VALUES {}))".format(
+                ",".join(f"({sid})" for sid in deleted_store_ids)
+            )
+        ).fetchall() if engine._store._host_uid_table_exists() else []
+        assert len(bindings_table_rows) == 0
+    finally:
+        engine.shutdown()
+
+
+def test_v0260a_lineage_key_includes_home_tag_to_prevent_collisions(tmp_path):
+    """Lineage keys should include home_tag to prevent collisions when sharing a database across homes."""
+    (tmp_path / "home1").mkdir()
+    (tmp_path / "home2").mkdir()
+    # Both homes have the same session id S
+    _state_db(tmp_path / "home1", [("S", None, None)])
+    _state_db(tmp_path / "home2", [("S", None, None)])
+
+    # Ingest messages in home1
+    engine1 = LCMEngine(config=LCMConfig(database_path=str(tmp_path / "lcm.db")), hermes_home=str(tmp_path / "home1"))
+    engine1.on_session_start("S", platform="cli", context_length=200_000)
+    try:
+        engine1.ingest([_m("user", "message_from_home1" + PAD, 10.0, "u-home1")])
+        # Get the actual lineage_key from the database (not the helper which extracts root)
+        raw_bindings1 = engine1._store._conn.execute(
+            "SELECT lineage_key FROM host_uid_bindings"
+        ).fetchall()
+        assert len(raw_bindings1) == 1
+        lineage1 = raw_bindings1[0][0]
+        assert lineage1.endswith(":S")  # has home_tag prefix
+    finally:
+        engine1.shutdown()
+
+    # Ingest messages in home2 (same session id but different home)
+    engine2 = LCMEngine(config=LCMConfig(database_path=str(tmp_path / "lcm.db")), hermes_home=str(tmp_path / "home2"))
+    engine2.on_session_start("S", platform="cli", context_length=200_000)
+    try:
+        engine2.ingest([_m("user", "message_from_home2" + PAD, 10.0, "u-home2")])
+        # Get the actual lineage keys from the database
+        raw_bindings2 = engine2._store._conn.execute(
+            "SELECT DISTINCT lineage_key FROM host_uid_bindings ORDER BY lineage_key"
+        ).fetchall()
+        assert len(raw_bindings2) == 2  # Two different lineage keys for the two homes
+        lineage_keys = [row[0] for row in raw_bindings2]
+        assert all(key.endswith(":S") for key in lineage_keys)  # Both have root S
+        assert lineage_keys[0] != lineage_keys[1]  # Different home_tags
+    finally:
+        engine2.shutdown()
