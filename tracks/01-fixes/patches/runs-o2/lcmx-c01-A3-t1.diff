+# -- tool_group_safe_end (#559) ---------------------------------------------
+
+
+def test_safe_end_outside_any_group_is_unchanged():
+    messages = [_user("a"), *_tool_group(), _user("b")]
+
+    assert tool_group_safe_end(messages, 0) == 0
+    assert tool_group_safe_end(messages, 1) == 1
+    assert tool_group_safe_end(messages, 4) == 4
+    assert tool_group_safe_end(messages, 5) == 5
+
+
+def test_safe_end_after_assistant_with_tool_calls_retreats_to_assistant():
+    messages = [_user("a"), *_tool_group(), _user("b")]
+
+    assert tool_group_safe_end(messages, 2) == 1
+
+
+def test_safe_end_between_sibling_results_retreats_to_assistant():
+    messages = [_user("a"), *_tool_group(), _user("b")]
+
+    assert tool_group_safe_end(messages, 3) == 1
+
+
+def test_safe_end_extends_through_results_when_group_opens_at_zero():
+    messages = [*_tool_group(), _user("b")]
+
+    assert tool_group_safe_end(messages, 1) == 3
+    assert tool_group_safe_end(messages, 2) == 3
+
+
+def test_safe_end_with_result_missing_id_is_unchanged():
+    messages = [
+        _user("a"),
+        *_tool_group()[:2],
+        {"role": "tool", "content": "no id"},
+        _user("b"),
+    ]
+
+    assert tool_group_safe_end(messages, 3) == 3
+    assert tool_group_safe_end(messages, 4) == 4
+
+
+def test_safe_end_with_undeclared_result_id_is_unchanged():
+    messages = [
+        _user("a"),
+        *_tool_group()[:2],
+        {"role": "tool", "tool_call_id": "call-zzz", "content": "stray"},
+        _user("b"),
+    ]
+
+    assert tool_group_safe_end(messages, 3) == 3
+    assert tool_group_safe_end(messages, 4) == 4
+
+
+def test_safe_end_extension_stops_on_undeclared_result():
+    messages = [
+        *_tool_group()[:2],
+        {"role": "tool", "tool_call_id": "call-zzz", "content": "stray"},
+    ]
+
+    assert tool_group_safe_end(messages, 1) == 1
+
