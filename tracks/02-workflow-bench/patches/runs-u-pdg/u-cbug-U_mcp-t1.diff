 /**
  * Resolve a C #include path to a file in the workspace.
  *
+ * A system include keeps its angle brackets in `targetRaw` (`<stdio.h>`, the
+ * same spelling the Objective-C resolver reads) and resolves to nothing:
+ * `#include <…>` searches the system/`-I` paths, never the including file's
+ * directory, and nothing here knows those paths — so the suffix fallback below
+ * could only land on an unrelated in-repo header that happens to share the
+ * name (#2953). Quoted includes arrive without delimiters and take the chain.
+ *
  * Strategy:
  * 1. Check for a same-directory sibling relative to the including file
  *    (matches C compiler `#include "…"` relative-lookup semantics).
@@ -63,6 +70,7 @@ export function resolveCImportTarget(
   allFilePaths: ReadonlySet<string>,
 ): string | null {
   if (!targetRaw) return null;
+  if (isSystemIncludeSpelling(targetRaw)) return null;
 
   const normalizedTarget = targetRaw.replace(/\\/g, '/');
 
@@ -116,3 +124,9 @@ export function resolveCImportTarget(
 
   return bestMatch;
 }
+
+/** `<stdio.h>` — an angle-bracket (system) include spelling. */
+function isSystemIncludeSpelling(targetRaw: string): boolean {
+  const trimmed = targetRaw.trim();
+  return trimmed.startsWith('<') && trimmed.endsWith('>');
+}
