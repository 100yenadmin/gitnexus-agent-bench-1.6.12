@@ -0,0 +1,141 @@
+/**
+ * Bounded per-file retry policy for parse-worker failures.
+ *
+ * When a worker dies while a file is in flight, the pool used to quarantine
+ * that file on the first death. Some deaths are transient — the worker hit its
+ * heap cap after accumulating state across earlier jobs, or a syscall failed
+ * under resource pressure (EMFILE / EAGAIN / ENOMEM) — and a fresh worker would
+ * parse the same file fine. This module decides whether a failure on a file is
+ * worth retrying (up to {@link MAX_TRANSIENT_FILE_RETRIES} times, with capped
+ * exponential backoff) before the file is marked failed (quarantined).
+ *
+ * Deterministic failures are never retried: a parse/JS-logic error thrown by
+ * the parser code, a native abort/segfault on the input, a postMessage
+ * deserialization failure, or a malformed message will recur on the same
+ * input, so retrying only burns respawn budget. Classification is
+ * conservative: a failure is transient only on a POSITIVE transient signal;
+ * anything unrecognized keeps the prior quarantine-on-first-death behavior.
+ *
+ * Pure functions only — the pool owns the retry counters and timers.
+ */
+
+/** Retries beyond the first attempt before a file is marked failed. */
+export const MAX_TRANSIENT_FILE_RETRIES = 2;
+export const FILE_RETRY_BACKOFF_BASE_MS = 250;
+export const FILE_RETRY_BACKOFF_CAP_MS = 2_000;
+
+/** Which pool death site observed the failure. */
+export type WorkerFailureSource =
+  /** Worker caught an exception and reported `{type:'error'}`. */
+  | 'worker-error'
+  /** Node `error` event: an uncaught throw / resource-limit termination. */
+  | 'uncaught-error'
+  /** Node `exit` event with no preceding error. */
+  | 'exit'
+  /** Receiver-side postMessage deserialization failure. */
+  | 'messageerror'
+  /** Worker sent a message without a `type` discriminant. */
+  | 'malformed-message';
+
+export interface WorkerFailure {
+  source: WorkerFailureSource;
+  message?: string;
+  stack?: string;
+  /** `err.code` when the failure carried one (e.g. `ERR_WORKER_OUT_OF_MEMORY`). */
+  code?: string;
+  exitCode?: number;
+}
+
+export type FailureClass = 'transient' | 'deterministic';
+
+/**
+ * Error codes that indicate a resource/environment condition rather than a
+ * property of the file being parsed.
+ */
+const TRANSIENT_CODES = [
+  'ERR_WORKER_OUT_OF_MEMORY',
+  'EAGAIN',
+  'EMFILE',
+  'ENFILE',
+  'ENOMEM',
+  'EBUSY',
+  'ETIMEDOUT',
+] as const;
+
+const TRANSIENT_CODE_RE = new RegExp(`\\b(${TRANSIENT_CODES.join('|')})\\b`);
+
+/**
+ * JS error classes thrown by parser/extraction logic. They are a property of
+ * the code path the input drives, so the same file reproduces them.
+ */
+const DETERMINISTIC_ERROR_NAME_RE =
+  /^\s*(TypeError|RangeError|SyntaxError|ReferenceError|EvalError|URIError)\b/;
+
+/**
+ * Message text of a parse failure. Matched against the error MESSAGE only —
+ * never the stack, whose frames name `parse-worker.js` on every failure.
+ */
+const DETERMINISTIC_MESSAGE_RE =
+  /\b(parse error|syntax error|failed to parse|unexpected token|maximum call stack size exceeded)\b/i;
+
+/**
+ * Classify a worker failure. Precedence: deterministic parse/JS-logic signals
+ * win over transient markers (a TypeError whose text happens to mention EBUSY
+ * is still a TypeError), then a transient code makes it retryable, otherwise
+ * it is deterministic.
+ */
+export function classifyWorkerFailure(failure: WorkerFailure): FailureClass {
+  if (failure.source === 'messageerror' || failure.source === 'malformed-message') {
+    return 'deterministic';
+  }
+  const message = failure.message ?? '';
+  const firstStackLine = failure.stack?.split('\n', 1)[0] ?? '';
+  if (
+    DETERMINISTIC_ERROR_NAME_RE.test(firstStackLine) ||
+    DETERMINISTIC_ERROR_NAME_RE.test(message) ||
+    DETERMINISTIC_MESSAGE_RE.test(message)
+  ) {
+    return 'deterministic';
+  }
+  if (failure.code !== undefined && (TRANSIENT_CODES as readonly string[]).includes(failure.code)) {
+    return 'transient';
+  }
+  if (TRANSIENT_CODE_RE.test(message)) return 'transient';
+  return 'deterministic';
+}
+
+/**
+ * Capped exponential backoff with equal jitter: half the window is fixed so a
+ * retry always waits, the other half is random so workers that failed
+ * together don't retry in lockstep. `retryIndex` is 0 for the first retry.
+ */
+export function fileRetryBackoffMs(retryIndex: number, random: () => number = Math.random): number {
+  const ceil = Math.min(FILE_RETRY_BACKOFF_CAP_MS, FILE_RETRY_BACKOFF_BASE_MS * 2 ** retryIndex);
+  const half = Math.floor(ceil / 2);
+  return half + Math.floor(random() * (ceil - half + 1));
+}
+
+export type FileRetryDecision =
+  | { action: 'retry'; retryIndex: number; delayMs: number }
+  | { action: 'fail'; reason: 'deterministic' | 'retries-exhausted' };
+
+/**
+ * Decide whether to retry `failure` on a file that has already been retried
+ * `priorRetries` times.
+ */
+export function decideFileRetry(
+  failure: WorkerFailure,
+  priorRetries: number,
+  maxRetries: number = MAX_TRANSIENT_FILE_RETRIES,
+  random: () => number = Math.random,
+): FileRetryDecision {
+  if (classifyWorkerFailure(failure) === 'deterministic') {
+    return { action: 'fail', reason: 'deterministic' };
+  }
+  if (priorRetries >= maxRetries) return { action: 'fail', reason: 'retries-exhausted' };
+  return {
+    action: 'retry',
+    retryIndex: priorRetries,
+    delayMs: fileRetryBackoffMs(priorRetries, random),
+  };
+}
