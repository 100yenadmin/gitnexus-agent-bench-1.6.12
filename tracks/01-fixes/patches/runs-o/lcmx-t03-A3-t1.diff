         raise
 
 
+def _embedding_text_present(value: object) -> int:
+    return int(value is not None and bool(str(value).strip()))
+
+
+def _register_embedding_text_present(conn: sqlite3.Connection) -> None:
+    # SQLite's TRIM only strips ASCII spaces, so blank detection uses Python's
+    # str.strip() (all Unicode whitespace, e.g. "\v\f"). A blank summary is
+    # never embeddable, and sending one makes Voyage reject the whole batch.
+    conn.create_function(
+        "lcm_embedding_text_present", 1, _embedding_text_present, deterministic=True
+    )
+
+
