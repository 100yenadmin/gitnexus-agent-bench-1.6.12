+describe('C: system includes stay outside the repository, local includes resolve', () => {
+  const files = new Set(['src/stdio.h', 'include/util.h', 'include/sys/types.h', 'src/main.c']);
+  // What `scanHeaderFiles` hands the resolver in a real pass: the `.h` paths
+  // the C file set would otherwise lack. Both shapes must hold the property.
+  const headerConfig: ReadonlySet<string> = new Set([
+    'src/stdio.h',
+    'include/util.h',
+    'include/sys/types.h',
+  ]);
+  const cFilesOnly = new Set(['src/main.c']);
+  const resolve = (targetRaw: string, allFilePaths: ReadonlySet<string>, config?: unknown) =>
+    filesOf(
+      SCOPE_RESOLVERS.get(SupportedLanguages.C)!.resolveImportTarget(
+        targetRaw,
+        'src/main.c',
+        allFilePaths,
+        config,
+      ),
+    );
+
+  it.each([
+    ['<stdio.h>', 'sibling decoy'],
+    ['<util.h>', 'suffix decoy'],
+    ['<sys/types.h>', 'nested suffix decoy'],
+    ['<include/util.h>', 'exact-path decoy'],
+    [' <stdio.h> ', 'whitespace-padded spelling'],
+  ])('%s (%s) resolves to nothing', (targetRaw) => {
+    expect(resolve(targetRaw, files)).toEqual([]);
+    expect(resolve(targetRaw, cFilesOnly, headerConfig)).toEqual([]);
+  });
+
+  it.each([
+    ['stdio.h', 'src/stdio.h'],
+    ['util.h', 'include/util.h'],
+    ['sys/types.h', 'include/sys/types.h'],
+    ['include/util.h', 'include/util.h'],
+  ])('quoted "%s" resolves to %s', (targetRaw, expected) => {
+    expect(resolve(targetRaw, files)).toEqual([expected]);
+    expect(resolve(targetRaw, cFilesOnly, headerConfig)).toEqual([expected]);
+  });
+});
