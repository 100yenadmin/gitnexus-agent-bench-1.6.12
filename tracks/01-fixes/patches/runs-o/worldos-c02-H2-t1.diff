+class PendingSpellAttack(_StrictModel):
+    """A spell that requires an attack roll, cast but not yet resolved by attack().
+
+    When cast_spell returns automated=False and attack_roll=True (e.g., Guiding Bolt),
+    the spell slot is consumed but the attack is NOT resolved until the DM calls attack().
+    The action economy gate would normally reject that attack as "already cast a spell",
+    but attack-roll spells are a SINGLE action in 5e (SRD 5.2: "spellcasting time" includes
+    the attack roll as part of the action). Record this pending spell on the caster so the
+    next attack() on a matching target bypasses the gate, then clears this record.
+
+    ADDITIVE: Combat.pending_spell_attack defaults to None, so every existing snapshot
+    deserializes unchanged and campaigns that never cast an attack-roll spell behave
+    identically."""
+
+    source_id: str  # the caster's character id (matched against attack()'s attacker)
+    target_ids: list[str]  # targets the spell can hit (matched against attack()'s target)
+    spell: str  # the spell's canonical name (for reference/debugging)
+    round: int  # the combat round when cast (so it clears on next_turn, not lingering across rounds)
+
+
