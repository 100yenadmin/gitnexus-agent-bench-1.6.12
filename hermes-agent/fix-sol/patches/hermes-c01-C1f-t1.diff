+@pytest.mark.platforms("posix")
+@pytest.mark.parametrize("command", ["claude", "claude-code", "acme-cli"])
+@pytest.mark.parametrize("on_path", [False, True])
+def test_claude_install_prefix_resolution(tmp_path, monkeypatch, command, on_path):
+    from agent.anthropic_adapter import find_claude_code_cli
+    from hermes_cli.auth import (
+        AuthError, get_external_process_provider_status,
+        resolve_external_process_provider_credentials,
+    )
+
+    monkeypatch.setenv("HOME", str(tmp_path))
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path / "hermes"))
+    monkeypatch.delenv("ACME_CLI_PATH", raising=False)
+    prefix = tmp_path / ".local" / "bin"
+    path_dir = tmp_path / "path"
+    prefix.mkdir(parents=True)
+    path_dir.mkdir()
+    installed = prefix / command
+    installed.write_text("#!/bin/sh\nexit 0\n")
+    installed.chmod(0o755)
+    expected = installed
+    if on_path:
+        expected = path_dir / command
+        expected.write_text("#!/bin/sh\nexit 0\n")
+        expected.chmod(0o755)
+    monkeypatch.setenv("PATH", str(path_dir))
+    provider = "claude-cli-acp-test"
+    register_provider(_AcmeACPProfile(
+        name=provider, display_name="CLI discovery test",
+        auth_type="external_process", process_command=command,
+        base_url=f"process://{provider}",
+    ))
+
+    status = get_external_process_provider_status(provider)
+    if command == "acme-cli":
+        assert find_claude_code_cli(command) is None
+        assert find_claude_code_cli(str(installed)) is None
+    if command == "acme-cli" and not on_path:
+        assert status["configured"] is False
+        assert status["resolved_command"] is None
+        with pytest.raises(AuthError, match="Could not find"):
+            resolve_external_process_provider_credentials(provider)
+    else:
+        if command != "acme-cli":
+            assert find_claude_code_cli(command) == str(expected)
+        assert status["configured"] is True
+        assert status["resolved_command"] == str(expected)
+        assert resolve_external_process_provider_credentials(provider)["command"] == str(expected)
