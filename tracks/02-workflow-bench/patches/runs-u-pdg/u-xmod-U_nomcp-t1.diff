index 0000000..fc3c960
--- /dev/null
+++ b/gitnexus/test/unit/parse-retry.test.ts
@@ -0,0 +1,253 @@
+import { describe, expect, it, beforeEach, afterEach } from 'vitest';
+import { EventEmitter } from 'node:events';
+import path from 'node:path';
+import { pathToFileURL } from 'node:url';
+import fs from 'node:fs';
+import os from 'node:os';
+import type { Worker } from 'node:worker_threads';
+import {
+  classifyWorkerFailure,
+  decideFileRetry,
+  fileRetryBackoffMs,
+  FILE_RETRY_BACKOFF_BASE_MS,
+  FILE_RETRY_BACKOFF_CAP_MS,
+  MAX_TRANSIENT_FILE_RETRIES,
+} from '../../src/core/ingestion/workers/parse-retry.js';
+import { createWorkerPool } from '../../src/core/ingestion/workers/worker-pool.js';
+
+const OOM = {
+  source: 'uncaught-error' as const,
+  message: 'Worker terminated due to reaching memory limit: JS heap out of memory',
+  code: 'ERR_WORKER_OUT_OF_MEMORY',
+};
+
+describe('classifyWorkerFailure', () => {
+  it('treats a worker heap-cap OOM as transient', () => {
+    expect(classifyWorkerFailure(OOM)).toBe('transient');
+  });
+
+  it('treats resource-exhaustion errno codes as transient (code or message)', () => {
+    for (const code of ['EAGAIN', 'EMFILE', 'ENFILE', 'ENOMEM', 'EBUSY', 'ETIMEDOUT']) {
+      expect(classifyWorkerFailure({ source: 'uncaught-error', message: 'x', code })).toBe(
+        'transient',
+      );
+      expect(
+        classifyWorkerFailure({
+          source: 'worker-error',
+          message: `${code}: resource temporarily unavailable, open '/x/shard.bin'`,
+        }),
+      ).toBe('transient');
+    }
+  });
+
+  it('treats JS error classes from parser logic as deterministic', () => {
+    expect(
+      classifyWorkerFailure({
+        source: 'worker-error',
+        message: "Cannot read properties of undefined (reading 'type')",
+        stack: "TypeError: Cannot read properties of undefined (reading 'type')\n    at walk",
+      }),
+    ).toBe('deterministic');
+    expect(
+      classifyWorkerFailure({
+        source: 'uncaught-error',
+        message: 'Maximum call stack size exceeded',
+      }),
+    ).toBe('deterministic');
+  });
+
+  it('treats parse-error messages as deterministic', () => {
+    expect(
+      classifyWorkerFailure({ source: 'worker-error', message: 'Failed to parse src/a.ts' }),
+    ).toBe('deterministic');
+    expect(
+      classifyWorkerFailure({ source: 'worker-error', message: 'Unexpected token } at 3:4' }),
+    ).toBe('deterministic');
+  });
+
+  it('lets a deterministic error class win over a transient marker in its text', () => {
+    expect(
+      classifyWorkerFailure({
+        source: 'worker-error',
+        message: 'bad EBUSY handling',
+        stack: 'TypeError: bad EBUSY handling\n    at f',
+      }),
+    ).toBe('deterministic');
+  });
+
+  it('does not read the stack frames as a parse error', () => {
+    // Every worker stack names parse-worker.js; only the first line counts.
+    expect(
+      classifyWorkerFailure({
+        ...OOM,
+        stack: 'Error [ERR_WORKER_OUT_OF_MEMORY]: ...\n    at parseFile (parse-worker.js:1:1)',
+      }),
+    ).toBe('transient');
+  });
+
+  it('treats native crashes, deserialization and protocol failures as deterministic', () => {
+    expect(classifyWorkerFailure({ source: 'exit', exitCode: 134 })).toBe('deterministic');
+    expect(classifyWorkerFailure({ source: 'uncaught-error', message: 'segfault' })).toBe(
+      'deterministic',
+    );
+    expect(
+      classifyWorkerFailure({ source: 'messageerror', message: 'ENOMEM while deserializing' }),
+    ).toBe('deterministic');
+    expect(classifyWorkerFailure({ source: 'malformed-message' })).toBe('deterministic');
+  });
+});
+
+describe('fileRetryBackoffMs', () => {
+  it('grows exponentially and stays inside [ceil/2, ceil]', () => {
+    for (let i = 0; i < 6; i++) {
+      const ceil = Math.min(FILE_RETRY_BACKOFF_CAP_MS, FILE_RETRY_BACKOFF_BASE_MS * 2 ** i);
+      expect(fileRetryBackoffMs(i, () => 0)).toBe(Math.floor(ceil / 2));
+      expect(fileRetryBackoffMs(i, () => 0.999999)).toBe(ceil);
+    }
+  });
+
+  it('is capped', () => {
+    expect(fileRetryBackoffMs(30, () => 0.999999)).toBe(FILE_RETRY_BACKOFF_CAP_MS);
+  });
+});
+
+describe('decideFileRetry', () => {
+  it('allows exactly 2 transient retries by default, then fails the file', () => {
+    expect(MAX_TRANSIENT_FILE_RETRIES).toBe(2);
+    const first = decideFileRetry(OOM, 0, undefined, () => 0);
+    expect(first).toEqual({
+      action: 'retry',
+      retryIndex: 0,
+      delayMs: Math.floor(FILE_RETRY_BACKOFF_BASE_MS / 2),
+    });
+    const second = decideFileRetry(OOM, 1, undefined, () => 0);
+    expect(second).toEqual({ action: 'retry', retryIndex: 1, delayMs: FILE_RETRY_BACKOFF_BASE_MS });
+    expect(decideFileRetry(OOM, 2)).toEqual({ action: 'fail', reason: 'retries-exhausted' });
+  });
+
+  it('never retries a deterministic parse error, even with budget left', () => {
+    expect(
+      decideFileRetry({ source: 'worker-error', message: 'x', stack: 'SyntaxError: x' }, 0),
+    ).toEqual({ action: 'fail', reason: 'deterministic' });
+  });
+
+  it('honors a custom budget', () => {
+    expect(decideFileRetry(OOM, 0, 0)).toEqual({ action: 'fail', reason: 'retries-exhausted' });
+  });
+});
+
+// ── Pool integration: the decision is actually applied on worker death ──────
+
+type Action = { kind: 'ok' } | { kind: 'error'; message: string; code?: string; stack?: string };
+
+const actions: Action[] = [];
+let spawned = 0;
+
+class FakeWorker extends EventEmitter {
+  constructor() {
+    super();
+    spawned++;
+    queueMicrotask(() => this.emit('message', { type: 'ready' }));
+  }
+
+  postMessage(msg: unknown): void {
+    const m = msg as { type?: string; files?: { path: string }[] };
+    if (m?.type !== 'sub-batch') return;
+    const action = actions.shift();
+    if (!action) return;
+    const files = m.files ?? [];
+    queueMicrotask(async () => {
+      if (action.kind === 'ok') {
+        this.emit('message', { type: 'progress', filesProcessed: files.length });
+        this.emit('message', { type: 'sub-batch-done' });
+        await Promise.resolve();
+        this.emit('message', { type: 'result', data: files.map((f) => f.path) });
+        return;
+      }
+      this.emit('message', { type: 'starting-file', path: files[0].path });
+      const err = Object.assign(new Error(action.message), { code: action.code });
+      if (action.stack) err.stack = action.stack;
+      this.emit('error', err);
+    });
+  }
+
+  async terminate(): Promise<number> {
+    this.emit('exit', 0);
+    return 0;
+  }
+}
+
+let tempDir: string;
+let workerUrl: URL;
+
+beforeEach(() => {
+  actions.length = 0;
+  spawned = 0;
+  tempDir = fs.mkdtempSync(path.join(os.tmpdir(), 'gitnexus-parse-retry-'));
+  const workerPath = path.join(tempDir, 'fake-worker.js');
+  fs.writeFileSync(workerPath, '// fake');
+  workerUrl = pathToFileURL(workerPath) as URL;
+});
+
+afterEach(() => {
+  fs.rmSync(tempDir, { recursive: true, force: true });
+});
+
+const makePool = () =>
+  createWorkerPool(workerUrl, 1, {
+    workerFactory: () => new FakeWorker() as unknown as Worker,
+    consecutiveFailureThreshold: 3,
+    maxRespawnsPerSlot: 5,
+  });
+
+const oomAction: Action = {
+  kind: 'error',
+  message: 'Worker terminated due to reaching memory limit: JS heap out of memory',
+  code: 'ERR_WORKER_OUT_OF_MEMORY',
+};
+
+describe('worker pool per-file transient retry', () => {
+  it('retries a transient failure and recovers the file without quarantine', async () => {
+    const pool = makePool();
+    actions.push(oomAction, oomAction, { kind: 'ok' });
+    const results = await pool.dispatch<{ path: string; content: string }, string[]>([
+      { path: 'src/flaky.ts', content: '' },
+      { path: 'src/other.ts', content: '' },
+    ]);
+    expect(results).toEqual([['src/flaky.ts', 'src/other.ts']]);
+    expect(pool.getQuarantinedPaths()).toEqual([]);
+    expect(spawned).toBe(3);
+    await pool.terminate();
+  });
+
+  it('marks the file failed after 2 retries are exhausted', async () => {
+    // Threshold 3 would trip on 3 consecutive deaths if retry deaths counted;
+    // they must not, so the file reaches quarantine and the rest completes.
+    const pool = makePool();
+    actions.push(oomAction, oomAction, oomAction, { kind: 'ok' });
+    const results = await pool.dispatch<{ path: string; content: string }, string[]>([
+      { path: 'src/flaky.ts', content: '' },
+      { path: 'src/other.ts', content: '' },
+    ]);
+    expect(results).toEqual([['src/other.ts']]);
+    expect(pool.getQuarantinedPaths()).toEqual(['src/flaky.ts']);
+    expect(spawned).toBe(4);
+    await pool.terminate();
+  });
+
+  it('does not retry a deterministic parse error', async () => {
+    const pool = makePool();
+    actions.push(
+      { kind: 'error', message: 'boom', stack: 'TypeError: boom\n    at walk' },
+      { kind: 'ok' },
+    );
+    const results = await pool.dispatch<{ path: string; content: string }, string[]>([
+      { path: 'src/bad.ts', content: '' },
+      { path: 'src/other.ts', content: '' },
+    ]);
+    expect(results).toEqual([['src/other.ts']]);
+    expect(pool.getQuarantinedPaths()).toEqual(['src/bad.ts']);
+    expect(spawned).toBe(2);
+    await pool.terminate();
+  });
+});
