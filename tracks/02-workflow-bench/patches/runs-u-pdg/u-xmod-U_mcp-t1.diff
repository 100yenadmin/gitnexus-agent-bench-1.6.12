diff --git a/gitnexus/test/unit/parse-retry.test.ts b/gitnexus/test/unit/parse-retry.test.ts
new file mode 100644
index 0000000..6926458
--- /dev/null
+++ b/gitnexus/test/unit/parse-retry.test.ts
@@ -0,0 +1,188 @@
+import { describe, it, expect } from 'vitest';
+import {
+  classifyParseFailure,
+  createParseRetryTracker,
+  decideParseRetry,
+  DEFAULT_MAX_PARSE_RETRIES,
+  parseRetryBackoffMs,
+  type ParseFailure,
+} from '../../src/core/ingestion/workers/parse-retry.js';
+
+const noJitter = () => 1;
+
+describe('classifyParseFailure', () => {
+  it.each<[string, ParseFailure]>([
+    ['worker exit (native crash / signal)', { source: 'exit', message: 'exited with code 134' }],
+    ['unrecognized uncaught worker error', { source: 'uncaught-error', message: 'boom' }],
+    [
+      'EMFILE errno code',
+      { source: 'uncaught-error', message: 'too many open files', code: 'EMFILE' },
+    ],
+    [
+      'EAGAIN surfaced through a worker-reported error',
+      { source: 'worker-error-message', message: 'write EAGAIN: resource temporarily unavailable' },
+    ],
+    [
+      'ENOMEM in the stack header',
+      {
+        source: 'worker-error-message',
+        message: 'x',
+        stack: 'Error: ENOMEM: cannot allocate\n    at f',
+      },
+    ],
+  ])('treats %s as transient', (_label, failure) => {
+    expect(classifyParseFailure(failure)).toBe('transient');
+  });
+
+  it.each<[string, ParseFailure]>([
+    [
+      'a worker-caught throw',
+      { source: 'worker-error-message', message: 'Cannot read properties of undefined' },
+    ],
+    [
+      'a SyntaxError from the parser',
+      {
+        source: 'uncaught-error',
+        message: 'Unexpected token',
+        stack: 'SyntaxError: Unexpected token\n    at p',
+      },
+    ],
+    [
+      'a TypeError thrown uncaught',
+      {
+        source: 'uncaught-error',
+        message: 'x is not a function',
+        stack: 'TypeError: x is not a function',
+      },
+    ],
+    ['stack overflow', { source: 'uncaught-error', message: 'Maximum call stack size exceeded' }],
+    [
+      'worker heap-cap OOM (code)',
+      { source: 'uncaught-error', message: 'Worker terminated', code: 'ERR_WORKER_OUT_OF_MEMORY' },
+    ],
+    [
+      'worker heap-cap OOM (message)',
+      { source: 'uncaught-error', message: 'ERR_WORKER_OUT_OF_MEMORY: heap limit' },
+    ],
+    ['an explicit parse error', { source: 'uncaught-error', message: 'Parse error at line 3' }],
+    ['a postMessage deserialization failure', { source: 'messageerror', message: 'clone failed' }],
+    ['a malformed protocol message', { source: 'malformed-message' }],
+  ])('treats %s as deterministic', (_label, failure) => {
+    expect(classifyParseFailure(failure)).toBe('deterministic');
+  });
+
+  it('prefers a transient errno over a deterministic error name', () => {
+    expect(
+      classifyParseFailure({
+        source: 'uncaught-error',
+        message: 'EMFILE: too many open files',
+        stack: 'TypeError: EMFILE: too many open files',
+      }),
+    ).toBe('transient');
+  });
+
+  it('heap-cap OOM wins even when an errno also appears', () => {
+    expect(
+      classifyParseFailure({
+        source: 'uncaught-error',
+        code: 'ERR_WORKER_OUT_OF_MEMORY',
+        message: 'ENOMEM',
+      }),
+    ).toBe('deterministic');
+  });
+});
+
+describe('decideParseRetry', () => {
+  it('never retries a deterministic failure, even with budget left', () => {
+    expect(decideParseRetry('deterministic', 0)).toEqual({ retry: false, reason: 'deterministic' });
+  });
+
+  it('retries a transient failure up to 2 times by default, then gives up', () => {
+    expect(DEFAULT_MAX_PARSE_RETRIES).toBe(2);
+    const first = decideParseRetry('transient', 0, undefined, noJitter);
+    const second = decideParseRetry('transient', 1, undefined, noJitter);
+    const third = decideParseRetry('transient', 2, undefined, noJitter);
+    expect(first).toMatchObject({ retry: true, retryNumber: 1 });
+    expect(second).toMatchObject({ retry: true, retryNumber: 2 });
+    expect(third).toEqual({ retry: false, reason: 'retries-exhausted' });
+  });
+
+  it('maxRetries 0 disables retry', () => {
+    expect(
+      decideParseRetry('transient', 0, { maxRetries: 0, baseDelayMs: 100, maxDelayMs: 1000 }),
+    ).toEqual({ retry: false, reason: 'retries-exhausted' });
+  });
+});
+
+describe('parseRetryBackoffMs', () => {
+  const policy = { baseDelayMs: 100, maxDelayMs: 1_000 };
+
+  it('doubles per retry and caps at maxDelayMs', () => {
+    expect(parseRetryBackoffMs(1, policy, noJitter)).toBe(100);
+    expect(parseRetryBackoffMs(2, policy, noJitter)).toBe(200);
+    expect(parseRetryBackoffMs(3, policy, noJitter)).toBe(400);
+    expect(parseRetryBackoffMs(10, policy, noJitter)).toBe(1_000);
+  });
+
