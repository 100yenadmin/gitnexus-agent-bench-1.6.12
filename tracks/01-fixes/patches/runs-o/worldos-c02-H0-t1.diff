+def test_pending_spell_attack_clears_on_next_turn(tmp_path, monkeypatch):
+    """A pending spell attack should be cleared when next_turn is called, even if
+    the attack was never resolved."""
+    monkeypatch.setenv("WORLDOS_STATE_DIR", str(tmp_path))
+    cid = server.create_campaign("AE1270c")["id"]
+    cleric = server.create_character(
+        cid, "Maren", kind="player", class_name="Cleric", apply_srd_defaults=True
+    )["id"]
+    server.update_character(cid, cleric, patch={"initiative_bonus": 100})
+    server.learn_spells(cid, cleric, ["Guiding Bolt"])
+    server.prepare_spells(cid, cleric, ["Guiding Bolt"])
+    server.update_character(
+        cid, cleric, patch={"spell_slots": {"1": {"maximum": 2, "used": 0}}}
+    )
+    goblin = server.create_character(cid, "Goblin", kind="monster", max_hp=20, armor_class=10)["id"]
+    server.update_character(cid, goblin, patch={"initiative_bonus": -100})
+    server.start_combat(cid, [cleric, goblin])
+
+    # Cast Guiding Bolt — sets pending_spell_attack
+    server.cast_spell(cid, cleric, "Guiding Bolt", target_id=goblin)
+
+    # Verify pending_spell_attack is set before next_turn by checking internal state
+    from server import _require
+    c = _require(cid)
+    assert c.combat.pending_spell_attack is not None
+
+    # Call next_turn to advance to the next combatant (goblin)
+    server.next_turn(cid)
+
+    # Verify pending_spell_attack is cleared
+    c = _require(cid)
+    assert c.combat.pending_spell_attack is None
+
+
