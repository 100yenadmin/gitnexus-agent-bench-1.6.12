+def test_issue_836_same_root_is_isolated_by_home_and_symlinks_agree(tmp_path):
+    one, two = tmp_path / "one", tmp_path / "two"
+    for home in (one, two):
+        home.mkdir()
+        _state_db(home, [("S", None, None)])
+    link = tmp_path / "link"
+    link.symlink_to(one, target_is_directory=True)
+    engine = LCMEngine(config=LCMConfig(database_path=str(tmp_path / "lcm.db")), hermes_home=str(one))
+    engine.on_session_start("S", platform="cli", context_length=200_000)
+    try:
+        first, problem = engine._host_uid_lineage_key()
+        assert (first, problem) == (_lineage(one, "S"), None)
+        row = engine._store.append("S", _m("user", "one"))
+        engine._store.add_host_uid_bindings(first, [(row, "same-uid", "canonical", None)])
+        engine._hermes_home = str(two)
+        second, problem = engine._host_uid_lineage_key()
+        assert (second, problem) == (_lineage(two, "S"), None)
+        assert second != first
+        assert engine._store.host_uid_bindings_for(second, {"same-uid"}) == {}
+        engine._hermes_home = str(link)
+        assert engine._host_uid_lineage_key() == (first, None)
+    finally:
+        engine.shutdown()
