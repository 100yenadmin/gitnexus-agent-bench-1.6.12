+
+describe('C: system includes stay outside the repository, quoted includes resolve', () => {
+  // Every decoy is reachable through the quoted spelling in the same workspace,
+  // so each `<…>` miss is a refusal rather than an empty corpus.
+  const files = ['src/main.c', 'src/stdio.h', 'include/sys/types.h', 'include/util.h'];
+  const resolve = (targetRaw: string): readonly string[] =>
+    filesOf(
+      SCOPE_RESOLVERS.get(SupportedLanguages.C)!.resolveImportTarget(
+        targetRaw,
+        'src/main.c',
+        new Set(files),
+        undefined,
+        { parsedFiles: [] },
+      ),
+    );
+
+  it.each([
+    ['<stdio.h>', 'same-directory sibling'],
+    ['<sys/types.h>', 'nested-path suffix'],
+    ['<util.h>', 'basename suffix'],
+  ])('%s does not resolve to the %s', (system) => {
+    expect(resolve(system)).toEqual([]);
+  });
+
+  it.each([
+    ['stdio.h', 'src/stdio.h'],
+    ['sys/types.h', 'include/sys/types.h'],
+    ['util.h', 'include/util.h'],
+  ])('quoted %s resolves to %s', (quoted, expected) => {
+    expect(resolve(quoted)).toEqual([expected]);
+  });
+});
