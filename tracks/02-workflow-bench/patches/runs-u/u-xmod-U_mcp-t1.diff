+/**
+ * Per-file transient-failure retry layer for the parse worker pool.
+ *
+ * When a worker fails while a file is in flight, the pool's default response
+ * is to quarantine that file (mark it failed) and move on. That is the right
+ * call for a deterministic failure — a file that trips a parser bug or a
+ * malformed-input throw will fail the same way every time — but it wrongly
+ * drops a file whose failure was environmental (`EMFILE`, `EAGAIN`, `ENOMEM`,
+ * a timed-out read). This module decides, per failure, whether the in-flight
+ * file earns another attempt and how long to back off before it.
+ *
+ * Classification is deliberately conservative: a failure is `transient` only
+ * when its reason carries a recognised transient signature AND no
+ * deterministic marker. Anything unrecognised (native crash exit codes, heap
+ * OOM, protocol errors, JS exceptions) stays `deterministic`, so a file that
+ * reliably kills a worker is still quarantined on its first failure and never
+ * burns extra respawns or trips the circuit breaker through retries.
+ *
+ * Session-scoped like {@link ./quarantine.ts}: one tracker per
+ * `createWorkerPool` invocation.
+ */
+
+/** Retries granted to a file after its first transient failure. */
+export const DEFAULT_PARSE_MAX_RETRIES = 2;
+/** Backoff before the first retry; doubles on each subsequent retry. */
+export const DEFAULT_PARSE_RETRY_BASE_MS = 200;
+/** Upper bound on a single retry backoff. */
+export const DEFAULT_PARSE_RETRY_CAP_MS = 2_000;
+
+export type ParseFailureKind = 'transient' | 'deterministic';
+
+/**
+ * Errno codes / phrases that indicate a resource or I/O hiccup rather than a
+ * property of the file itself.
+ */
+const TRANSIENT_PATTERNS: readonly RegExp[] = [
+  /\b(?:EAGAIN|EMFILE|ENFILE|ENOMEM|EBUSY|ETIMEDOUT|EINTR|ECONNRESET|EPIPE|EWOULDBLOCK)\b/,
+  /resource temporarily unavailable/i,
+  /too many open files/i,
+  /operation timed out/i,
+];
+
+/**
+ * Markers of a failure that will recur on every attempt: JS exceptions raised
+ * by the parse code itself, explicit parse errors, and the worker hitting its
+ * heap cap (the file's size is what caused it). These override any transient
+ * signature found in the same reason.
+ */
+const DETERMINISTIC_PATTERNS: readonly RegExp[] = [
+  /\b(?:SyntaxError|TypeError|RangeError|ReferenceError)\b/,
+  /\bparse error\b/i,
+  /\bfailed to parse\b/i,
+  /ERR_WORKER_OUT_OF_MEMORY|heap cap/,
+];
+
+/** Classify a worker failure reason. Unrecognised reasons are deterministic. */
+export function classifyParseFailure(reason: string): ParseFailureKind {
+  if (DETERMINISTIC_PATTERNS.some((re) => re.test(reason))) return 'deterministic';
+  if (TRANSIENT_PATTERNS.some((re) => re.test(reason))) return 'transient';
+  return 'deterministic';
+}
+
+/**
+ * Backoff before retry number `retry` (1-based): exponential from `baseMs`,
+ * capped at `capMs`, with "equal jitter" — a uniform draw in `[d/2, d]` — so
+ * concurrent retries de-synchronize without ever retrying immediately.
+ */
+export function parseRetryBackoffMs(
+  retry: number,
+  baseMs: number = DEFAULT_PARSE_RETRY_BASE_MS,
+  capMs: number = DEFAULT_PARSE_RETRY_CAP_MS,
+  random: () => number = Math.random,
+): number {
+  const ceil = Math.min(capMs, baseMs * 2 ** Math.max(0, retry - 1));
+  const half = ceil / 2;
+  return Math.round(half + random() * half);
+}
+
+export type ParseRetryDecision =
+  | { action: 'retry'; kind: 'transient'; retry: number; delayMs: number }
+  | { action: 'fail'; kind: ParseFailureKind; failures: number };
+
+export interface ParseRetryOptions {
+  maxRetries?: number;
+  baseMs?: number;
+  capMs?: number;
+  random?: () => number;
+}
+
+export interface ParseRetryTracker {
+  /**
+   * Record a failure of `path` with the given worker `reason` and decide
+   * whether to retry it (with backoff) or mark it failed.
+   */
+  recordFailure(path: string, reason: string): ParseRetryDecision;
+  /** Transient retries already granted to `path`. */
+  retriesFor(path: string): number;
+}
+
+export function createParseRetryTracker(options: ParseRetryOptions = {}): ParseRetryTracker {
+  const maxRetries = options.maxRetries ?? DEFAULT_PARSE_MAX_RETRIES;
+  const baseMs = options.baseMs ?? DEFAULT_PARSE_RETRY_BASE_MS;
+  const capMs = options.capMs ?? DEFAULT_PARSE_RETRY_CAP_MS;
+  const random = options.random ?? Math.random;
+  const retries = new Map<string, number>();
+
+  return {
+    recordFailure(path, reason) {
+      const kind = classifyParseFailure(reason);
+      const used = retries.get(path) ?? 0;
+      if (kind === 'deterministic' || used >= maxRetries) {
+        return { action: 'fail', kind, failures: used + 1 };
+      }
+      const retry = used + 1;
+      retries.set(path, retry);
+      return {
+        action: 'retry',
+        kind,
+        retry,
+        delayMs: parseRetryBackoffMs(retry, baseMs, capMs, random),
+      };
+    },
+    retriesFor: (path) => retries.get(path) ?? 0,
+  };
+}
