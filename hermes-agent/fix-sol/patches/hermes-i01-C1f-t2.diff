+
+
+@pytest.mark.parametrize("transport", ["anthropic_messages", "chat_completions"])
+@pytest.mark.parametrize("block", [
+    {"type": "thinking", "thinking": "I considered the factors.", "signature": "sig-abc"},
+    {"type": "redacted_thinking", "data": "opaque-thinking"},
+])
+def test_signed_thinking_continues_to_visible_answer(tmp_path, monkeypatch, transport, block):
+    agent = _build_agent(tmp_path, monkeypatch)
+    agent.api_mode = transport
+    if transport == "anthropic_messages":
+        agent.provider = "anthropic"
+        responses = [
+            SimpleNamespace(content=[SimpleNamespace(**block)], stop_reason="end_turn", usage=None),
+            SimpleNamespace(content=[SimpleNamespace(type="text", text="391 = 17 x 23.")],
+                            stop_reason="end_turn", usage=None),
+        ]
+    else:
+        first = _reasoning_only_response()
+        first.choices[0].message.reasoning_details = [block]
+        second = _truly_empty_response()
+        second.choices[0].message.content = "391 = 17 x 23."
+        responses = [first, second]
+    monkeypatch.setattr(agent, "_interruptible_api_call", lambda api_kwargs: responses.pop(0))
+
+    result = agent.run_conversation("factor 391")
+
+    assert result["final_response"] == "391 = 17 x 23."
+    assert result["api_calls"] == 2
+    assert result["messages"][-1]["content"] == "391 = 17 x 23."
+    assert not any(row.get("api_content") for row in result["messages"])
+
+
+@pytest.mark.parametrize("carrier_type, expected_calls", [
+    ("claude-subscription-directsdk-experimental.native_assistant", 2),
+    ("another-plugin.native_assistant", 2),
+    ("reasoning.text", 1),
+])
+def test_native_carrier_is_not_an_answer(tmp_path, monkeypatch, carrier_type, expected_calls):
+    agent = _build_agent(tmp_path, monkeypatch)
+    first = _reasoning_only_response()
+    first.choices[0].message.reasoning_details = [{
+        "type": carrier_type,
+        "messages": [{"role": "assistant", "content": [
+            {"type": "thinking", "thinking": "Summary", "signature": "sig-abc"},
+        ]}],
+    }]
+    second = _truly_empty_response()
+    second.choices[0].message.content = "391 = 17 x 23."
+    responses = [first, second]
+    monkeypatch.setattr(agent, "_interruptible_api_call", lambda api_kwargs: responses.pop(0))
+
+    result = agent.run_conversation("factor 391")
+
+    assert result["api_calls"] == expected_calls
+    assert result["final_response"] == (
+        "391 = 17 x 23." if expected_calls == 2 else first.choices[0].message.reasoning
+    )
