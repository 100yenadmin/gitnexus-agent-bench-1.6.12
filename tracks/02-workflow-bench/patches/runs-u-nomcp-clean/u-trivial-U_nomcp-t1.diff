diff --git a/gitnexus/test/unit/status-json-alias.test.ts b/gitnexus/test/unit/status-json-alias.test.ts
new file mode 100644
index 0000000..2373ed5
--- /dev/null
+++ b/gitnexus/test/unit/status-json-alias.test.ts
@@ -0,0 +1,51 @@
+import { spawnSync } from 'node:child_process';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+import { CLI_SPAWN_PREFIX } from '../helpers/cli-entry.js';
+
+function runCli(args: string[], cwd: string) {
+  return spawnSync(process.execPath, [...CLI_SPAWN_PREFIX, ...args], {
+    cwd,
+    encoding: 'utf8',
+    env: {
+      ...process.env,
+      GITNEXUS_HOME: path.join(cwd, '.gitnexus-home'),
+      GITNEXUS_NO_UPDATE_NOTIFIER: '1',
+    },
+  });
+}
+
+describe('gitnexus status -j alias', () => {
+  let repoDir: string;
+
+  beforeAll(() => {
+    repoDir = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), 'gitnexus-status-j-')));
+    const init = spawnSync('git', ['init', '-q'], { cwd: repoDir, encoding: 'utf8' });
+    expect(init.status).toBe(0);
+  });
+
+  afterAll(() => {
+    fs.rmSync(repoDir, { recursive: true, force: true });
+  });
+
+  it('documents -j as the short form of --json in help', () => {
+    const result = runCli(['status', '--help'], repoDir);
+    expect(result.status).toBe(0);
+    expect(result.stdout).toMatch(/-j, --json/);
+  });
+
+  it('emits the same machine-readable output for -j as for --json', () => {
+    const short = runCli(['status', '-j'], repoDir);
+    const long = runCli(['status', '--json'], repoDir);
+
+    expect(short.status).toBe(0);
+    expect(long.status).toBe(0);
+
+    const shortJson = JSON.parse(short.stdout.trim());
+    const longJson = JSON.parse(long.stdout.trim());
+    expect(shortJson).toEqual(longJson);
+    expect(shortJson).toMatchObject({ schemaVersion: 1, error: 'not-indexed' });
+  });
+});
