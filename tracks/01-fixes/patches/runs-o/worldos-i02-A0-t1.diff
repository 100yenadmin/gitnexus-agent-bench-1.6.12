+def _relocate_off_blocked_rest_cell(c: "Campaign", location: "Location", ch: "Character") -> bool:
+    """#1511: if ``ch.stage_cell`` sits on a cell that is rest-blocked in ``location``'s scene grid
+    (a wall/prop the fight's own grid allowed, another stander, or off the rest grid), move it to
+    the nearest walkable rest cell. Prefers cells reachable from where it stands (so nobody is
+    dropped into a walled-off pocket), nearest-first with a stable (y, x) tiebreak; falls back to
+    the nearest free cell anywhere. Leaves the cell untouched when it is already fine, when the
+    location has no scene grid, or when no free cell exists. Returns True iff it moved."""
+    sc = getattr(ch, "stage_cell", None)
+    grid = getattr(location, "scene_grid", None)
+    if sc is None or grid is None:
+        return False
+    if ch.location_id and ch.location_id != location.id:
+        return False
+    width, height, blocked = rest_blocked_cells(c, location, exclude_id=ch.id)
+    if width <= 0 or height <= 0:
+        return False
+    cell = (int(sc[0]), int(sc[1]))
+    # rest_blocked_cells drops the mover's own cell, so re-check terrain under it explicitly.
+    terrain = {(x, y) for x, y in scene_grid_mod.impassable_cells(grid, width, height)}
+    blocked = blocked | terrain
+    in_bounds = 0 <= cell[0] < width and 0 <= cell[1] < height
+    if in_bounds and cell not in blocked:
+        return False
+
+    def _rank(p: tuple[int, int]) -> tuple[int, int, int]:
+        return (combat_grid.chebyshev_cells(p, cell), p[1], p[0])
+
+    candidates: set[tuple[int, int]] = set()
+    if in_bounds:
+        candidates = combat_grid.reachable(cell, width + height, set(), width, height, impassable=blocked)
+    if not candidates:
+        candidates = {
+            (x, y) for x in range(width) for y in range(height) if (x, y) not in blocked
+        }
+    if not candidates:
+        return False
+    ch.stage_cell = min(candidates, key=_rank)
+    return True
 
 
