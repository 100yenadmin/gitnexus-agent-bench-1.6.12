+def _coerce_query_arg(value: Any) -> str:
+    """Normalize a model-supplied ``query`` argument to stripped text.
+
+    Models sometimes send ``null`` (common right after compaction) or a bare
+    number. ``None`` maps to ``""`` so callers return the documented
+    "No query provided" payload; any other value is searched as its text form
+    (so ``0`` becomes ``"0"`` rather than being treated as missing).
+    """
+    if value is None:
+        return ""
+    if isinstance(value, bytes):
+        value = value.decode("utf-8", errors="replace")
+    return str(value).strip()
+
+
