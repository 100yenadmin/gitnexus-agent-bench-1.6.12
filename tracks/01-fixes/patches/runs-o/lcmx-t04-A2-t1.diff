@@ -276,11 +276,14 @@ def _unwrap_summary_contract(content: str, nonce: str, max_tokens: int) -> str:
     opening_tag = f'<lcm-summary nonce="{nonce}">'
     closing_tag = "</lcm-summary>"
     stripped = content.strip()
+    # The closing tag carries no nonce, so a faithful body may legitimately
+    # quote it (e.g. a transcript that discussed the envelope).  The anchored
+    # endswith check pins the real terminator; only the nonce-bearing opening
+    # tag must be unique.
     if (
         not stripped.startswith(opening_tag)
         or not stripped.endswith(closing_tag)
         or stripped.count(opening_tag) != 1
-        or stripped.count(closing_tag) != 1
     ):
         return ""
     body = stripped[len(opening_tag) : -len(closing_tag)].strip()
