+@pytest.mark.parametrize("blocker", ["occupied", "impassable", "both"])
+def test_path_helpers_allow_blocked_start_only(blocker):
+    start, goal, blocked_goal = (0, 0), (1, 0), (2, 0)
+    cells = {start, blocked_goal}
+    occupied = cells if blocker in ("occupied", "both") else set()
+    impassable = cells if blocker in ("impassable", "both") else set()
+    assert combat_grid.shortest_path(start, goal, occupied, 3, 1, impassable) == [goal]
+    assert combat_grid.shortest_path(start, start, occupied, 3, 1, impassable) == []
+    assert combat_grid.shortest_path(start, blocked_goal, occupied, 3, 1, impassable) is None
+    assert combat_grid.reachable(start, 3, occupied, 3, 1, impassable) == {goal}
+    assert cells == {start, blocked_goal}  # caller-owned blocker sets remain untouched
+
