+    )
+    with (
+        patch("hermes_cli.plugins.has_hook", return_value=False),
+        patch("hermes_cli.plugins.invoke_hook", return_value=[]),
+    ):
+        result = agent.run_conversation("answer then update housekeeping")
+
+    assert result["final_response"] == "Here is the answer." + footer
+    assert result["response_reused"] is reused
+    assert result["turn_exit_reason"] == (
+        "text_response(finish_reason=stop)" if follow_up else "fallback_prior_turn_content"
+    )
