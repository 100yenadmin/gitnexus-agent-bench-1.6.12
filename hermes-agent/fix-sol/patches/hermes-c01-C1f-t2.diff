+@pytest.mark.platforms("posix")
+@pytest.mark.parametrize("command", ["claude", "claude-code"])
+def test_cli_discovery_and_setup_token_share_the_resolver(monkeypatch, tmp_path, command):
+    from agent import anthropic_credentials as credentials
+
+    monkeypatch.setenv("HOME", str(tmp_path))
+    monkeypatch.setenv("PATH", str(tmp_path / "empty-path"))
+    monkeypatch.setattr(adapter, "_CLAUDE_CODE_PREFIXES", ("~/.local/bin",))
+    installed = _install(tmp_path / ".local/bin", command)
+    assert adapter.find_claude_code_cli(command) == installed
+
+    on_path = _install(tmp_path / "path", command)
+    monkeypatch.setenv("PATH", str(tmp_path / "path"))
+    assert adapter.find_claude_code_cli(command) == on_path
+    assert adapter.find_claude_code_cli("other-cli") is None
+    assert adapter.find_claude_code_cli(installed) is None
+
+    # Resolve at call time through the adapter's public monkeypatch seam.
+    lookups = []
+    def finder(name):
+        lookups.append(name)
+        return installed
+
+    monkeypatch.setattr(adapter, "find_claude_code_cli", finder)
+    monkeypatch.setattr(credentials, "read_claude_code_credentials", lambda: None)
+    monkeypatch.delenv("CLAUDE_CODE_OAUTH_TOKEN", raising=False)
+    monkeypatch.delenv("ANTHROPIC_TOKEN", raising=False)
+    calls = []
+    monkeypatch.setattr(credentials.subprocess, "run", lambda cmd: calls.append(cmd))
+    assert credentials.run_oauth_setup_token() is None
+    assert lookups == ["claude"]
+    assert calls == [[installed, "setup-token"]]
