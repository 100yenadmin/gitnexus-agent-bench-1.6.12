@@ -36,6 +36,53 @@ def _response(*, content, finish_reason, tool_calls=None):
     return SimpleNamespace(choices=[choice], model="test/model", usage=None)
 
 
+@pytest.mark.parametrize(
+    ("followup", "append_footer", "reused"),
+    [("", False, True), ("Done.", False, False), ("", True, False)],
+)
+def test_housekeeping_response_reuse_tracks_provenance(followup, append_footer, reused):
+    with (
+        patch("model_tools.get_tool_definitions", return_value=_tool_defs("todo_list")),
+        patch("model_tools.check_toolset_requirements", return_value={}),
+        patch("agent.process_bootstrap.OpenAI"),
+    ):
+        agent = AIAgent(
+            api_key="test-key", base_url="https://example.invalid/v1",
+            quiet_mode=True, skip_context_files=True, skip_memory=True,
+        )
+    agent._cached_system_prompt = "Stable prompt."
+    agent.compression_enabled = False
+    agent.save_trajectories = False
+    agent.valid_tool_names = {"todo_list"}
+    answers = iter([
+        _response(content="Done.", finish_reason="tool_calls",
+                  tool_calls=[_tool_call("todo_list", "todo1")]),
+        _response(content=followup, finish_reason="stop"),
+    ])
+    agent._interruptible_api_call = lambda _kwargs: next(answers)
+    delivered = []
+    agent.interim_assistant_callback = lambda text, **kw: delivered.append(text)
+
+    def footer(_agent, text, _logger):
+        return text + "\n\nExtra text." if append_footer else text
+
+    with (
+        patch("model_tools.handle_function_call", return_value="ok"),
+        patch.object(agent, "_persist_session"),
+        patch.object(agent, "_cleanup_task_resources"),
+        patch("agent.turn_finalizer._append_file_mutation_footer", side_effect=footer),
+        patch("hermes_cli.plugins.invoke_hook", return_value=[]),
+    ):
+        result = agent.run_conversation("finish the task")
+
+    assert delivered == ["Done."]
+    assert result["response_reused"] is reused
+    assert result["final_response"] == ("Done.\n\nExtra text." if append_footer else "Done.")
+    assert result["turn_exit_reason"] == (
+        "fallback_prior_turn_content" if not followup else "text_response(finish_reason=stop)"
+    )
+
+
