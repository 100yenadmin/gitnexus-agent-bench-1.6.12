+@pytest.mark.parametrize("mode", ["full_text", "semantic", "hybrid"])
+@pytest.mark.parametrize("query", [0, 0.0, 42])
+@pytest.mark.parametrize("provider_fails", [False, True])
+def test_grep_numeric_query_is_searched(
+    semantic_engine, monkeypatch, mode, query, provider_fails
+):
+    text = str(query)
+    semantic_engine._store.append(
+        "session-a", {"role": "user", "content": f"numeric query {text}"}
+    )
+    node_id = _add_summary(semantic_engine, f"numeric query {text}", created_at=1.0)
+    _seed_vectors(semantic_engine, [(node_id, [1.0, 0.0])])
+    provider = MockProvider()
+
+    def resolve(_config):
+        if provider_fails:
+            raise RuntimeError("provider unavailable")
+        return provider
+
+    monkeypatch.setattr(lcm_tools, "resolve_provider", resolve)
+    payload = json.loads(
+        lcm_tools.lcm_grep({"query": query, "mode": mode}, engine=semantic_engine)
+    )
+    assert payload["query"] == text
+    assert payload["results"]
+    if mode != "full_text":
+        if provider_fails:
+            assert payload["degraded_to_fts"] is True
+        else:
+            assert provider.queries == [text]
+
