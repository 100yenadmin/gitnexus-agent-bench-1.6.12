+def casting_time_kind(casting_time: Optional[str]) -> str:
+    """Classify a spell's casting time into the action-economy resource it spends:
+    "bonus" | "reaction" | "long" (minutes/hours — not castable in a 6-second round) |
+    "action" (the default, incl. a missing/unknown value). Accepts both the curated
+    spelling ("1 bonus action", "10 minutes") and the srd524 one ("bonus-action", "minute")."""
+    ct = str(casting_time or "").strip().lower().replace("-", " ")
+    if "bonus" in ct:
+        return "bonus"
+    if "reaction" in ct:
+        return "reaction"
+    if "minute" in ct or "hour" in ct:
+        return "long"
+    return "action"
+
+
