+
+
+# ── #1447 follow-up: move advisories reach the resolved entry's result ─────────────────
+
+
+def test_in_budget_move_result_has_no_advisory_keys(grid_fight):
+    """A legal, in-budget move's result is exactly {to_cell, to_zone} — no extra keys."""
+    cid, hero, gob = grid_fight
+    out = combat_loop.resolve_player_turn(cid, hero, Intent(kind="move", to_cell=(3, 0)))
+    assert out["ok"] is True, out
+    assert out["resolved"]["result"] == {"to_cell": (3, 0), "to_zone": ""}
+
+
+def test_over_budget_move_surfaces_movement_illegal(grid_fight):
+    """Speed 30 at cell size 5 = a 6-cell budget; a 7-cell move still lands (advisory) and the
+    verb's movement_illegal note is copied into the resolved result."""
+    cid, hero, gob = grid_fight
+    out = combat_loop.resolve_player_turn(cid, hero, Intent(kind="move", to_cell=(7, 0)))
+    assert out["ok"] is True, out
+    assert _cell(cid, hero) == (7, 0)  # advisory-only: the move still happened
+    illegal = out["resolved"]["result"]["movement_illegal"]
+    assert illegal["budget_cells"] == 6
+    assert illegal["cost_cells"] == 7
+    assert "move_blocked" not in out["resolved"]["result"]
+
+
+def test_blocked_move_surfaces_move_blocked(grid_fight):
+    """A move onto an impassable cell is rejected (mover stays put) and the verb's move_blocked
+    note is copied into the resolved result."""
+    cid, hero, gob = grid_fight
+    server.set_grid(cid, 20, 20, obstacles=[[3, 0]])
+    assert _cell(cid, hero) == (0, 0)
+    out = combat_loop.resolve_player_turn(cid, hero, Intent(kind="move", to_cell=(3, 0)))
+    assert out["ok"] is True, out
+    assert _cell(cid, hero) == (0, 0)
+    blocked = out["resolved"]["result"]["move_blocked"]
+    assert blocked["target"] == [3, 0]
+    assert "movement_illegal" not in out["resolved"]["result"]
