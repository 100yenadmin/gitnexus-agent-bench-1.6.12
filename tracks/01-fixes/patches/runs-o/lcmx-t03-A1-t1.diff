+_BLANK_SUMMARIES = ["", "   ", "\v\f", "　\n\t"]
+
+
+def _blank_out(engine, node_ids: list[int]) -> None:
+    conn = sqlite3.connect(engine._store.db_path)
+    try:
+        conn.executemany(
+            "UPDATE summary_nodes SET summary = ? WHERE node_id = ?",
+            [
+                (_BLANK_SUMMARIES[index % len(_BLANK_SUMMARIES)], node_id)
+                for index, node_id in enumerate(node_ids)
+            ],
+        )
+        conn.commit()
+    finally:
+        conn.close()
+
+
+@pytest.mark.parametrize(
+    ("value", "blank"),
+    [
+        (None, 1),
+        ("", 1),
+        ("  \t\n", 1),
+        ("\v\f", 1),
+        ("　 ", 1),
+        ("x", 0),
+        ("  x  ", 0),
+    ],
+)
+def test_embedding_text_is_blank_matches_python_strip(value, blank):
+    assert command_mod._embedding_text_is_blank(value) == blank
+
+
+def test_dry_run_excludes_blank_summaries_from_counts(monkeypatch, tmp_path):
+    engine = _engine(tmp_path)
+    node_ids = _seed(engine, 6)
+    _blank_out(engine, node_ids[:4])
+    provider = FakeProvider()
+    monkeypatch.setattr(command_mod, "resolve_provider", lambda _config, **_kw: provider)
+
+    result = handle_lcm_command("embed backfill", engine)
+
+    assert "pending: 2" in result
+    assert "selected: 2" in result
+    assert provider.calls == []
+
+
+def test_apply_never_sends_blank_summaries(monkeypatch, tmp_path):
+    engine = _engine(tmp_path)
+    node_ids = _seed(engine, 6)
+    _blank_out(engine, node_ids[:4])
+    provider = FakeProvider()
+    monkeypatch.setattr(command_mod, "resolve_provider", lambda _config, **_kw: provider)
+
+    result = handle_lcm_command("embed backfill --apply --limit 3", engine)
+
+    assert "selected: 2" in result
+    assert "embedded: 2" in result
+    assert "remaining: 0" in result
+    assert provider.calls == [["summary-5", "summary-4"]]
+    assert _meta_ids(engine) == [str(node_ids[4]), str(node_ids[5])]
+
+
+def test_retry_uncertain_skips_blank_rows_and_keeps_their_markers(
+    monkeypatch, tmp_path
+):
+    engine = _engine(tmp_path)
+    node_ids = _seed(engine, 3)
+    _mark_uncertain(engine, node_ids)
+    _blank_out(engine, [node_ids[0], node_ids[2]])
+    provider = FakeProvider()
+    monkeypatch.setattr(command_mod, "resolve_provider", lambda _config, **_kw: provider)
+
+    result = handle_lcm_command(
+        "embed backfill --apply --retry-uncertain", engine
+    )
+
+    assert "selected: 1" in result
+    assert "embedded: 1" in result
+    assert provider.calls == [["summary-1"]]
+    assert _meta_ids(engine) == [str(node_ids[1])]
+    assert _inflight_rows(engine) == [
+        (str(node_ids[0]), "uncertain"),
+        (str(node_ids[2]), "uncertain"),
+    ]
+
