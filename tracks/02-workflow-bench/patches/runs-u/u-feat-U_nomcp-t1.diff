+/**
+ * Validate and normalise the optional `list_repos` `name_contains` filter.
+ *
+ * @internal Exported for unit testing; not part of the public API surface.
+ *
+ * Returns the lower-cased needle, or `undefined` when the filter is omitted or
+ * empty (an empty substring matches every repo, so it is the same as no
+ * filter). A non-string value is REJECTED, consistent with the pagination
+ * arguments — the backend is the real validation boundary.
+ */
+export function parseListReposNameFilter(
+  params: { name_contains?: unknown } | null | undefined,
+): string | undefined {
+  const value = params?.name_contains;
+  if (value === undefined || value === null) return undefined;
+  if (typeof value !== 'string') {
+    throw new Error(
+      `list_repos: "name_contains" must be a string (received ${JSON.stringify(value)})`,
+    );
+  }
+  return value === '' ? undefined : value.toLowerCase();
+}
+
+/**
+ * Keep only repos whose name contains `needle` (already lower-cased by
+ * {@link parseListReposNameFilter}), case-insensitively. Applied BEFORE
+ * pagination so `total`/`hasMore`/`nextOffset` describe the filtered set.
+ *
+ * @internal Exported for unit testing and the repository-policy wrapper.
+ */
+export function filterReposByName<T extends { name: string }>(
+  repos: T[],
+  needle: string | undefined,
+): T[] {
+  if (needle === undefined) return repos;
+  return repos.filter((r) => r.name.toLowerCase().includes(needle));
+}
