diff --git a/servers/engine/tests/test_combat_action_economy.py b/servers/engine/tests/test_combat_action_economy.py
new file mode 100644
index 0000000..69e2b1a
--- /dev/null
+++ b/servers/engine/tests/test_combat_action_economy.py
@@ -0,0 +1,174 @@
+"""#778: casting, attacking and declared actions share a turn's resources."""
+
+import pytest
+
+import server
+from models import Combat
+
+
+@pytest.fixture
+def fight(tmp_path, monkeypatch):
+    monkeypatch.setenv("WORLDOS_STATE_DIR", str(tmp_path))
+    cid = server.create_campaign("action economy")["id"]
+    ids = [server.create_character(cid, name, kind="player", max_hp=100)["id"]
+           for name in ("Caster", "Target")]
+    server.start_combat(cid, ids)
+    actor = server.get_state(cid)["current_turn"]
+    target = next(i for i in ids if i != actor)
+    server.update_character(cid, actor, {"spell_slots": {
+        1: {"maximum": 5, "used": 0}, 3: {"maximum": 5, "used": 0},
+        5: {"maximum": 5, "used": 0},
+    }})
+    return cid, actor, target
+
+
+def strike(fight):
+    cid, actor, target = fight
+    return server.attack(cid, actor, target, attack_bonus=0, damage_dice="1")
+
+
+def cast(fight, spell="Fire Bolt"):
+    cid, actor, _ = fight
+    return server.cast_spell(cid, actor, spell)
+
+
+@pytest.mark.parametrize("first", ["cast", "attack", "action", "skip"])
+def test_action_spell_rejected_after_action_spent(fight, first):
+    cid, actor, _ = fight
+    if first == "cast":
+        cast(fight)
+    elif first == "attack":
+        strike(fight)
+    else:
+        assert server.use_action(cid, actor, first)["ok"]
+    before = server.get_state(cid)
+    with pytest.raises(ValueError, match="already used its action"):
+        cast(fight, "Fireball")
+    assert server.get_state(cid) == before
+
+
+@pytest.mark.parametrize("first,message", [("cast", "already cast a spell"),
+                                           ("skip", "skipped this turn")])
+def test_attack_rejected_after_cast_or_skip(fight, first, message):
+    cid, actor, _ = fight
+    if first == "cast":
+        cast(fight)
+    else:
+        server.use_action(cid, actor, "skip")
+    before = server.get_state(cid)
+    with pytest.raises(ValueError, match=message):
+        strike(fight)
+    assert server.get_state(cid) == before
+    assert not server.use_action(cid, actor, "action")["ok"]
+
+
+@pytest.mark.parametrize("srd_only", [False, True])
+@pytest.mark.parametrize("following", ["action", "cast", "attack"])
+def test_bonus_spell_leaves_action_available(fight, monkeypatch, srd_only, following):
+    if srd_only:
+        # Exercise the bundled SRD's 'bonus-action' rather than curated '1 bonus action'.
+        monkeypatch.setattr(server.spells, "spell_data", lambda name: None)
+    cast(fight, "Healing Word")
+    cid, actor, _ = fight
+    state = server._require(cid).combat
+    assert state.bonus_action_used and not state.action_used
+    assert state.action_purpose == ""
+    if following == "action":
+        assert server.use_action(cid, actor, "action")["ok"]
+    elif following == "cast":
+        cast(fight, "Fireball")
+    else:
+        strike(fight)
+    with pytest.raises(ValueError, match="already used its bonus action"):
+        cast(fight, "Healing Word")
+
+
+def test_bonus_spell_honors_declared_bonus(fight):
+    cid, actor, _ = fight
+    assert server.use_action(cid, actor, "bonus")["ok"]
+    with pytest.raises(ValueError, match="already used its bonus action"):
+        cast(fight, "Healing Word")
+
+
+@pytest.mark.parametrize("spell", ["Mending", "Raise Dead"])
+def test_long_casting_time_rejected_before_spend(fight, spell):
+    before = server.get_state(fight[0])
+    with pytest.raises(ValueError, match="casting time"):
+        cast(fight, spell)
+    assert server.get_state(fight[0]) == before
+
+
+@pytest.mark.parametrize("first", ["cast", "attack", "action", "skip"])
+@pytest.mark.parametrize("following", ["cast", "attack", "action"])
+def test_action_surge_reopens_shared_action(fight, first, following):
+    cid, actor, _ = fight
+    server.set_class_resource(cid, actor, "action_surge", max=1, recharge="short")
+    if first == "cast":
+        cast(fight)
+    elif first == "attack":
+        strike(fight)
+    else:
+        server.use_action(cid, actor, first)
+    server.use_resource(cid, actor, "action_surge")
+    if following == "cast":
+        cast(fight)
+        with pytest.raises(ValueError, match="already cast a spell"):
+            strike(fight)
+    else:
+        if following == "action":
+            assert server.use_action(cid, actor, "action")["ok"]
+        strike(fight)
+        with pytest.raises(ValueError):
+            strike(fight)
+    with pytest.raises(ValueError, match="already used its action"):
+        cast(fight)
+
+
+def test_declared_action_keeps_extra_attack(fight):
+    cid, actor, _ = fight
+    server.update_character(cid, actor, {"extra_attacks": 1})
+    assert server.use_action(cid, actor, "action")["ok"]
+    strike(fight)
+    strike(fight)
+    with pytest.raises(ValueError, match="no attacks left"):
+        strike(fight)
+
+
+def test_surge_after_cast_grants_only_one_attack_action(fight):
+    cid, actor, _ = fight
+    server.update_character(cid, actor, {"extra_attacks": 1})
+    server.set_class_resource(cid, actor, "action_surge", max=1, recharge="short")
+    cast(fight)
+    server.use_resource(cid, actor, "action_surge")
+    strike(fight)
+    strike(fight)
+    with pytest.raises(ValueError, match="no attacks left"):
+        strike(fight)
+
+
+@pytest.mark.parametrize("purpose", ["cast", "skip"])
+def test_next_turn_resets_action_purpose(fight, purpose):
+    cid, actor, _ = fight
+    if purpose == "cast":
+        cast(fight)
+    else:
+        server.use_action(cid, actor, "skip")
+    assert server._require(cid).combat.action_purpose == purpose
+    server.next_turn(cid)
+    assert server._require(cid).combat.action_purpose == ""
+    assert not server._require(cid).combat.action_used
+
+
+def test_old_combat_snapshot_defaults_action_purpose():
+    snapshot = Combat(action_used=True).model_dump()
+    snapshot.pop("action_purpose")
+    assert Combat.model_validate(snapshot).action_purpose == ""
+
+
+def test_on_turn_reaction_spell_preserves_action(fight):
+    cid, actor, _ = fight
+    cast(fight, "Shield")
+    assert not server._require(cid).combat.action_used
+    strike(fight)
+    with pytest.raises(ValueError, match="reaction"):
+        cast(fight, "Shield")
