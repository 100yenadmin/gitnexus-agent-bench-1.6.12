+# ==================== #1270: attack-roll spells bypass action-economy gate =====
+
+def test_guiding_bolt_then_attack_allowed(tmp_path, monkeypatch):
+    """#1270: Guiding Bolt (an attack-roll spell) must NOT block a subsequent
+    attack — the spell's attack roll is part of the same casting action (SRD 5.2),
+    so the next attack() call on the target bypasses the action-economy gate."""
+    monkeypatch.setenv("WORLDOS_STATE_DIR", str(tmp_path))
+    cid = server.create_campaign("AE1270")["id"]
+    cleric = server.create_character(
+        cid, "Maren", kind="player", class_name="Cleric", apply_srd_defaults=True
+    )["id"]
+    server.update_character(cid, cleric, patch={"initiative_bonus": 100})
+    server.learn_spells(cid, cleric, ["Guiding Bolt"])
+    server.prepare_spells(cid, cleric, ["Guiding Bolt"])
+    server.update_character(
+        cid, cleric, patch={"spell_slots": {"1": {"maximum": 2, "used": 0}}}
+    )
+    goblin = server.create_character(cid, "Goblin", kind="monster", max_hp=20, armor_class=10)["id"]
+    server.start_combat(cid, [cleric, goblin])
+    assert server.get_state(cid)["current_turn"] == cleric
+
+    # Cast Guiding Bolt — an attack-roll spell that is not automated
+    gb = server.cast_spell(cid, cleric, "Guiding Bolt", target_id=goblin)
+    assert gb["spell"] == "Guiding Bolt"
+    assert gb.get("automated") is False
+    assert gb.get("attack_roll") is True
+
+    # The attack() call should be allowed because the spell's attack is part of the action
+    result = server.attack(cid, cleric, goblin, attack_bonus=5, damage_dice="1d8")
+    assert result["hit"] is not None  # attack resolved
+    assert result["attacks_made_this_turn"] == 1
+
+
+def test_guiding_bolt_then_attack_on_different_target_rejected(tmp_path, monkeypatch):
+    """If a Guiding Bolt was cast at target A, attacking target B should still be
+    rejected by the action-economy gate (different target, not the spell attack)."""
+    monkeypatch.setenv("WORLDOS_STATE_DIR", str(tmp_path))
+    cid = server.create_campaign("AE1270b")["id"]
+    cleric = server.create_character(
+        cid, "Maren", kind="player", class_name="Cleric", apply_srd_defaults=True
+    )["id"]
+    server.update_character(cid, cleric, patch={"initiative_bonus": 100})
+    server.learn_spells(cid, cleric, ["Guiding Bolt"])
+    server.prepare_spells(cid, cleric, ["Guiding Bolt"])
+    server.update_character(
+        cid, cleric, patch={"spell_slots": {"1": {"maximum": 2, "used": 0}}}
+    )
+    goblin1 = server.create_character(cid, "Goblin1", kind="monster", max_hp=20, armor_class=10)["id"]
+    goblin2 = server.create_character(cid, "Goblin2", kind="monster", max_hp=20, armor_class=10)["id"]
+    server.start_combat(cid, [cleric, goblin1, goblin2])
+
+    # Cast Guiding Bolt at goblin1
+    server.cast_spell(cid, cleric, "Guiding Bolt", target_id=goblin1)
+
+    # Attack goblin2 (different target) should still be rejected
+    with pytest.raises(ValueError, match="already cast a spell"):
+        server.attack(cid, cleric, goblin2, attack_bonus=5, damage_dice="1d8")
+
