index 0000000..7d28c0b
--- /dev/null
+++ b/gitnexus/src/core/ingestion/workers/parse-retry.ts
@@ -0,0 +1,119 @@
+/**
+ * Bounded per-file retry for transient parse-worker failures.
+ *
+ * Before this layer, the first worker death attributed to a file quarantined
+ * that file for the rest of the pool's life — so a one-off fault (the OS
+ * killing the worker thread, a lost postMessage payload) permanently dropped
+ * a perfectly parseable file from the index. This module decides, per
+ * failure, whether the file earns another attempt:
+ *
+ * - **Deterministic** failures reproduce on every attempt with the same input,
+ *   so retrying only burns respawns: a parse error the worker caught and
+ *   reported (`{type:'error'}`), an uncaught throw carrying a JS stack, the
+ *   worker hitting its own heap cap on the file, or a protocol violation.
+ *   These are marked failed (quarantined) immediately.
+ * - **Transient** failures carry no evidence that the input is at fault: the
+ *   worker thread exiting without a JS-level error, or a `messageerror` (the
+ *   result was lost in transit). These are retried up to
+ *   {@link DEFAULT_MAX_TRANSIENT_RETRIES} times with exponential backoff, and
+ *   only then marked failed.
+ *
+ * Pure decision logic with no timers or pool state, so the retry/no-retry
+ * contract is unit-testable without spawning workers.
+ */
+
+/** Which pool-side signal reported the worker failure. */
+export type ParseWorkerFailureKind =
+  /** Worker caught an error and posted `{type:'error'}`. */
+  | 'worker-error-message'
+  /** Node `'error'` event: an uncaught throw escaped the worker. */
+  | 'uncaught-error'
+  /** Node `'error'` event with `ERR_WORKER_OUT_OF_MEMORY` (worker heap cap). */
+  | 'heap-oom'
+  /** Worker posted a message without a `type` discriminant. */
+  | 'malformed-message'
+  /** Worker thread exited without first reporting a JS-level error. */
+  | 'exit'
+  /** Main thread failed to deserialize a worker message. */
+  | 'messageerror';
+
+export type ParseFailureClass = 'transient' | 'deterministic';
+
+/** Retries after the first failed attempt, so a file gets up to 3 attempts. */
+export const DEFAULT_MAX_TRANSIENT_RETRIES = 2;
+export const DEFAULT_RETRY_BASE_DELAY_MS = 100;
+export const DEFAULT_RETRY_MAX_DELAY_MS = 2_000;
+
+export function classifyParseWorkerFailure(kind: ParseWorkerFailureKind): ParseFailureClass {
+  switch (kind) {
+    case 'exit':
+    case 'messageerror':
+      return 'transient';
+    case 'worker-error-message':
+    case 'uncaught-error':
+    case 'heap-oom':
+    case 'malformed-message':
+      return 'deterministic';
+    default: {
+      const _exhaustive: never = kind;
+      void _exhaustive;
+      return 'deterministic';
+    }
+  }
+}
+
+/**
+ * Backoff before retry number `retry` (1-based): base·2^(retry-1), capped at
+ * `maxDelayMs`. Deterministic (no jitter) — retries are per-file and rare, so
+ * there is no herd to de-synchronize.
+ */
+export function parseRetryDelayMs(
+  retry: number,
+  baseDelayMs: number = DEFAULT_RETRY_BASE_DELAY_MS,
+  maxDelayMs: number = DEFAULT_RETRY_MAX_DELAY_MS,
+): number {
+  if (retry < 1 || baseDelayMs <= 0) return 0;
+  return Math.min(maxDelayMs, baseDelayMs * 2 ** (retry - 1));
+}
+
+export type ParseRetryDecision =
+  | { readonly action: 'retry'; readonly retry: number; readonly delayMs: number }
+  | { readonly action: 'fail'; readonly failureClass: ParseFailureClass; readonly retries: number };
+
+export interface ParseRetryTracker {
+  /**
+   * Record a failure attributed to `path` and decide whether to retry it.
+   * Deterministic failures always return `fail`; transient failures return
+   * `retry` until the path has used its retry budget, then `fail`.
+   */
+  recordFailure(path: string, kind: ParseWorkerFailureKind): ParseRetryDecision;
+  /** Retries already granted to `path`. */
+  retriesFor(path: string): number;
+}
+
+export interface ParseRetryOptions {
+  maxRetries?: number;
+  baseDelayMs?: number;
+  maxDelayMs?: number;
+}
+
+/** One tracker per pool: retry budgets are session-scoped like quarantine. */
+export function createParseRetryTracker(options: ParseRetryOptions = {}): ParseRetryTracker {
+  const maxRetries = Math.max(0, Math.floor(options.maxRetries ?? DEFAULT_MAX_TRANSIENT_RETRIES));
+  const baseDelayMs = options.baseDelayMs ?? DEFAULT_RETRY_BASE_DELAY_MS;
+  const maxDelayMs = options.maxDelayMs ?? DEFAULT_RETRY_MAX_DELAY_MS;
+  const retries = new Map<string, number>();
+  return {
+    recordFailure(path, kind) {
+      const used = retries.get(path) ?? 0;
+      const failureClass = classifyParseWorkerFailure(kind);
+      if (failureClass === 'deterministic' || used >= maxRetries) {
+        return { action: 'fail', failureClass, retries: used };
+      }
+      const retry = used + 1;
+      retries.set(path, retry);
+      return { action: 'retry', retry, delayMs: parseRetryDelayMs(retry, baseDelayMs, maxDelayMs) };
+    },
+    retriesFor: (path) => retries.get(path) ?? 0,
+  };
+}
