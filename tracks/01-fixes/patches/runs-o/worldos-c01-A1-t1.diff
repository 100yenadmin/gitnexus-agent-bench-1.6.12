+def spell_casting_cost(casting_time) -> str:
+    """Classify a spell's casting time into the action-economy resource it spends (#778):
+    ``"action"`` | ``"bonus"`` | ``"reaction"`` | ``"long"`` (minutes/hours — not castable
+    in a 6-second combat round). Accepts both the curated spelling ("1 bonus action",
+    "1 action", "1 minute") and the SRD one ("bonus-action", "action", "hour"). An empty
+    or unrecognised value is treated as an action (the 5e default)."""
+    ct = str(casting_time or "").strip().lower()
+    if "bonus" in ct:
+        return "bonus"
+    if "reaction" in ct:
+        return "reaction"
+    if "minute" in ct or "hour" in ct:
+        return "long"
+    return "action"
+
+
+def actions_spent(*, action_used: bool, attacks_made: int, per_action: int) -> int:
+    """How many whole actions the current combatant has spent this turn (#778). Attacks
+    count in chunks of one Attack action (``per_action`` strikes each, rounded up); a spent
+    action with no attacks (a generic use_action, disengage, dash, skip) counts as one.
+    Casts are recorded by advancing ``attacks_made`` to the next action boundary, so they
+    are counted here too."""
+    per = max(1, int(per_action))
+    n = -(-max(0, int(attacks_made)) // per)
+    if action_used and n == 0:
+        n = 1
+    return n
+
+
