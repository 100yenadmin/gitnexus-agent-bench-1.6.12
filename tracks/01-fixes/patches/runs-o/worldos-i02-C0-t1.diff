+@pytest.mark.parametrize("final,expected", [((4, 2), (3, 1)), ((2, 1), (2, 0)),
+                                           ((8, 2), (4, 0))])
+def test_end_combat_relocates_rest_blocked_survivor(staged, final, expected):
+    cid, hero, ally, goblin, loc_id = staged
+    server.start_combat(cid, [hero, ally, goblin])
+    c = server._require(cid)
+    cb = next(cb for cb in c.combat.order if cb.character_id == hero)
+    cb.x, cb.y = final  # The combat grid allowed a cell the rest grid cannot.
+    server.save_campaign(c)
+    server.end_combat(cid, resolution="cleared")
+    c = server._require(cid)
+    assert tuple(c.characters[hero].stage_cell) == expected
+    assert expected not in server.rest_blocked_cells(c, c.locations[loc_id], exclude_id=hero)[2]
+
+
+def test_end_combat_relocation_avoids_other_survivor_final_cell(staged):
+    cid, hero, ally, goblin, _ = staged
+    server.start_combat(cid, [hero, ally, goblin])
+    c = server._require(cid)
+    for cb in c.combat.order:
+        if cb.character_id == hero:
+            cb.x, cb.y = (4, 2)
+        elif cb.character_id == ally:
+            cb.x, cb.y = (3, 1)
+    server.save_campaign(c)
+    server.end_combat(cid, resolution="cleared")
+    c = server._require(cid)
+    assert tuple(c.characters[ally].stage_cell) == (3, 1)
+    assert tuple(c.characters[hero].stage_cell) == (4, 1)
+
+
+@pytest.mark.parametrize("scene", ["absent", "full"])
+def test_end_combat_without_free_rest_cell(staged, scene):
+    cid, hero, ally, goblin, loc_id = staged
+    server.start_combat(cid, [hero, ally, goblin])
+    c = server._require(cid)
+    cb = next(cb for cb in c.combat.order if cb.character_id == hero)
+    cb.x, cb.y = (4, 2)
+    if scene == "absent":
+        c.locations[loc_id].scene_grid = None
+    else:
+        grid = c.locations[loc_id].scene_grid
+        grid.cells = []
+        grid.cell_default.walkable = False
+    server.save_campaign(c)
+    server.end_combat(cid, resolution="cleared")
+    c = server._require(cid)
+    assert c.characters[hero].stage_cell == ((4, 2) if scene == "absent" else None)
