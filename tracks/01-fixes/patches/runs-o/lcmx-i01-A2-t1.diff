diff --git a/tests/test_issue_750_deep_summaries_at_scale.py b/tests/test_issue_750_deep_summaries_at_scale.py
new file mode 100644
index 0000000..92edeaa
--- /dev/null
+++ b/tests/test_issue_750_deep_summaries_at_scale.py
@@ -0,0 +1,77 @@
+"""#750: assembly and unlimited-depth condensation see every summary depth at any session size.
+
+Both used to derive the session's depths from ``get_session_nodes`` (capped at 1000 rows, ordered depth-first),
+so once a session had ~1000 leaves the deeper levels fell off the end of the row list and stopped rendering."""
+
+from __future__ import annotations
+
+from hermes_lcm.config import LCMConfig
+from hermes_lcm.dag import SummaryNode
+from hermes_lcm.engine import LCMEngine
+
+SID = "S"
+
+
+def _engine(tmp_path, **config) -> LCMEngine:
+    settings = {"fresh_tail_count": 2, "max_assembly_tokens": 1_000_000,
+                "database_path": str(tmp_path / "lcm.db"), **config}
+    engine = LCMEngine(config=LCMConfig(**settings))
+    engine.on_session_start(SID, platform="telegram", context_length=2_000_000, conversation_id="conv")
+    return engine
+
+
+def _build_dag(dag, *, leaves: int = 1024, fanin: int = 4, top: int = 3, session_id: str = SID) -> dict:
+    """``leaves`` depth-0 nodes condensed ``fanin``-to-1 up to depth ``top``; returns {depth: [node ids]}."""
+    ids: dict[int, list[int]] = {0: []}
+    clock = 1_000.0
+    for i in range(leaves):
+        clock += 1
+        ids[0].append(dag.add_node(SummaryNode(
+            session_id=session_id, depth=0, summary=f"leaf {i}", token_count=3,
+            source_ids=[i + 1], source_type="messages", created_at=clock)))
+    for depth in range(1, top + 1):
+        ids[depth] = []
+        below = ids[depth - 1]
+        for group in range(0, len(below), fanin):
+            clock += 1
+            ids[depth].append(dag.add_node(SummaryNode(
+                session_id=session_id, depth=depth, summary=f"d{depth} node {group // fanin}", token_count=3,
+                source_ids=below[group:group + fanin], source_type="nodes", created_at=clock)))
+    return ids
+
+
+def test_get_session_depths_is_uncapped_ascending_and_session_scoped(tmp_path):
+    engine = _engine(tmp_path)
+    dag = engine._dag
+    assert dag.get_session_depths(SID) == []
+    _build_dag(dag)
+    _build_dag(dag, leaves=8, top=1, session_id="other")
+    assert dag.get_session_depths(SID) == [0, 1, 2, 3]
+    assert dag.get_session_depths("other") == [0, 1]
+    assert dag.get_session_depths("unknown") == []
+    # The existing reader keeps its row cap.
+    assert len(dag.get_session_nodes(SID)) == 1000
+    assert {n.depth for n in dag.get_session_nodes(SID)} == {0}
+
+
+def test_assembly_renders_depth_three_with_1024_leaves(tmp_path):
+    engine = _engine(tmp_path)
+    ids = _build_dag(engine._dag)
+    messages = engine._assemble_context({"role": "system", "content": "system prompt"},
+                                        [{"role": "user", "content": "hi"}])
+    text = "\n".join(str(m.get("content")) for m in messages)
+    for node_id in ids[3]:
+        assert f"(d3, node {node_id})" in text
+    # d3 is the uncondensed top; everything below it is condensed away.
+    assert "(d0," not in text and "(d2," not in text
+
+
+def test_unlimited_depth_condensation_reaches_past_1000_leaves(tmp_path, monkeypatch):
+    engine = _engine(tmp_path, incremental_max_depth=-1, condensation_fanin=4)
+    _build_dag(engine._dag)
+    probed: list[int] = []
+    monkeypatch.setattr(engine._dag, "get_uncondensed_at_depth",
+                        lambda session_id, depth, **_kw: probed.append(depth) or [])
+    assert engine._maybe_condense(force_overflow=True) == 0
+    # upper = deepest depth + 1, so depth 3 is still a candidate for building depth 4.
+    assert probed == [0, 1, 2, 3]
