diff --git a/servers/engine/tests/test_qa_unresolved_spell_attack.py b/servers/engine/tests/test_qa_unresolved_spell_attack.py
new file mode 100644
index 0000000..a8d5652
--- /dev/null
+++ b/servers/engine/tests/test_qa_unresolved_spell_attack.py
@@ -0,0 +1,89 @@
+"""#1270: qa/assert_behavioral.py WARNs (never fails) on an unresolved spell-attack leg.
+
+A cast_spell result with ``automated: false, attack_roll: true`` spends the slot but owes a
+follow-up attack() by the caster. If next_turn arrives first, the bolt was burned for nothing —
+the gate prints ``[WARN] unresolved_spell_attack`` and stays GREEN.
+"""
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[3]
+GATE = ROOT / "qa" / "assert_behavioral.py"
+STATE = {"characters": {"pc1": {"kind": "player", "name": "Maren", "current_hp": 10, "max_hp": 10}},
+         "party": ["pc1"]}
+# every run makes one plain dice roll so the unrelated (fatal) dice_used floor stays green
+BASE_CALLS = [("roll", {"expression": "1d20"}, {"total": 11})]
+
+GB_RESULT = {"spell": "Guiding Bolt", "level": 1, "automated": False, "attack_roll": True}
+
+
+def _calls_to_events(calls: list[tuple[str, dict, object]]) -> list[dict]:
+    """[(tool, input, result_obj)] -> paired tool_use / tool_result stream events."""
+    events: list[dict] = [{"type": "assistant", "message": {"content": [
+        {"type": "text", "text": "The fight is on."}]}}]
+    for n, (tool, inp, result) in enumerate(calls):
+        tid = f"t{n}"
+        events.append({"type": "assistant", "message": {"content": [
+            {"type": "tool_use", "id": tid, "name": f"mcp__worldos-engine__{tool}", "input": inp}]}})
+        events.append({"type": "user", "message": {"content": [
+            {"type": "tool_result", "tool_use_id": tid,
+             "content": [{"type": "text", "text": json.dumps(result)}]}]}})
+    return events
+
+
+def _run(tmp_path: Path, calls) -> subprocess.CompletedProcess:
+    run = tmp_path / "run.jsonl"
+    run.write_text("".join(json.dumps(e) + "\n" for e in _calls_to_events(BASE_CALLS + list(calls))), encoding="utf-8")
+    st = tmp_path / "state.json"
+    st.write_text(json.dumps(STATE), encoding="utf-8")
+    return subprocess.run([sys.executable, str(GATE), str(run), str(st)],
+                          capture_output=True, text=True)
+
+
+def test_unresolved_attack_roll_cast_before_next_turn_warns_but_never_fails(tmp_path):
+    r = _run(tmp_path, [
+        ("cast_spell", {"character_id": "pc1", "spell_name": "Guiding Bolt", "target_id": "gob"},
+         GB_RESULT),
+        ("next_turn", {}, {"round": 1}),
+    ])
+    assert r.returncode == 0, r.stdout + r.stderr
+    assert "[WARN] unresolved_spell_attack" in r.stdout, r.stdout
+    assert "[FAIL] unresolved_spell_attack" not in r.stdout
+    assert "Guiding Bolt" in r.stdout
+
+
+def test_resolved_spell_attack_passes(tmp_path):
+    r = _run(tmp_path, [
+        ("cast_spell", {"character_id": "pc1", "spell_name": "Guiding Bolt", "target_id": "gob"},
+         GB_RESULT),
+        ("attack", {"attacker_id": "pc1", "target_id": "gob"}, {"hit": True, "target": "gob"}),
+        ("next_turn", {}, {"round": 1}),
+    ])
+    assert r.returncode == 0, r.stdout + r.stderr
+    assert "[PASS] unresolved_spell_attack" in r.stdout, r.stdout
+
+
+def test_attack_on_another_target_does_not_resolve_the_leg(tmp_path):
+    r = _run(tmp_path, [
+        ("cast_spell", {"character_id": "pc1", "spell_name": "Guiding Bolt", "target_id": "gob"},
+         GB_RESULT),
+        ("attack", {"attacker_id": "pc1", "target_id": "orc"}, {"hit": True, "target": "orc"}),
+        ("next_turn", {}, {"round": 1}),
+    ])
+    assert r.returncode == 0, r.stdout + r.stderr
+    assert "[WARN] unresolved_spell_attack" in r.stdout, r.stdout
+
+
+def test_automated_or_save_casts_emit_no_key(tmp_path):
+    r = _run(tmp_path, [
+        ("cast_spell", {"character_id": "pc1", "spell_name": "Fire Bolt", "target_id": "gob"},
+         {"spell": "Fire Bolt", "automated": True}),
+        ("cast_spell", {"character_id": "pc1", "spell_name": "Sacred Flame", "target_id": "gob"},
+         {"spell": "Sacred Flame", "automated": False, "attack_roll": False}),
+        ("next_turn", {}, {"round": 1}),
+    ])
+    assert r.returncode == 0, r.stdout + r.stderr
+    assert "unresolved_spell_attack" not in r.stdout, r.stdout
diff --git a/servers/engine/tests/test_spell_attack_leg.py b/servers/engine/tests/test_spell_attack_leg.py
new file mode 100644
index 0000000..8cf2107
--- /dev/null
+++ b/servers/engine/tests/test_spell_attack_leg.py
@@ -0,0 +1,204 @@
+"""#1270: the attack-roll leg of a cast spell passes the cast→attack action-economy gate.
+
+Repro: a cleric casts Guiding Bolt (cast_spell -> automated:false, attack_roll:true), so the
+DM must resolve the hit with attack(). Before the fix the #778 gate refused that attack ("already
+cast a spell this turn and cannot also attack"): the slot was spent, the bolt dealt 0, and its
+pending on-hit rider stayed on the caster even after the target died. Under SRD 5.2 the spell
+attack is part of the same casting action — Combat.pending_spell_attack lets exactly ONE
+same-turn strike by the caster on a listed target through, then clears.
+"""
+
+import pytest
+
+import server
+import store
+from dice import DiceRoll
+from models import Combat
+
+
+@pytest.fixture(autouse=True)
+def isolated(tmp_path, monkeypatch):
+    monkeypatch.setenv("WORLDOS_STATE_DIR", str(tmp_path))
+    yield
+
+
+def _d20_roll(natural: int):
+    """dice.roll stub: forces the d20 natural face (deterministic hit/miss + initiative ties ->
+    input order); damage rolls a fixed 6."""
+    def _roll(expression: str, advantage: bool = False, disadvantage: bool = False, seed=None,
+              crit_min: int = 20) -> DiceRoll:
+        if expression.startswith("1d20"):
+            mod = 0
+            if "+" in expression:
+                mod = int(expression.split("+", 1)[1])
+            elif "-" in expression.split("d", 1)[1]:
+                mod = -int(expression.rsplit("-", 1)[1])
+            return DiceRoll(
+                expression=expression, total=natural + mod, rolls=[natural], modifier=mod,
+                detail=f"{expression}[{natural}] = {natural + mod}", is_d20=True,
+                natural=natural, crit=(natural == 20), fumble=(natural == 1),
+            )
+        return DiceRoll(expression=expression, total=6, rolls=[3], detail=f"{expression}[3] = 6")
+    return _roll
+
+
+def _cleric(cid, name="Maren"):
+    c = server.create_character(
+        cid, name, kind="player", class_name="Cleric", apply_srd_defaults=True,
+        abilities={"wisdom": 16, "constitution": 12},
+    )["id"]
+    server.learn_spells(cid, c, ["Guiding Bolt", "Sacred Flame"])
+    server.prepare_spells(cid, c, ["Guiding Bolt"])
+    return c
+
+
+def _foe(cid, name="Goblin", hp=60, ac=10):
+    return server.create_character(cid, name, kind="monster", max_hp=hp, armor_class=ac)["id"]
+
+
+def _psa(cid):
+    return store.load_campaign(cid).combat.pending_spell_attack
+
+
+def _fight(monkeypatch, *, foe_hp=60, extra_foe=False):
+    """[cleric, foe(, foe2)] in initiative order, cleric's turn, round 1."""
+    cid = server.create_campaign("S")["id"]
+    cleric = _cleric(cid)
+    foe = _foe(cid, hp=foe_hp)
+    ids = [cleric, foe]
+    foe2 = None
+    if extra_foe:
+        foe2 = _foe(cid, name="Hobgoblin")
+        ids.append(foe2)
+    monkeypatch.setattr(server.dice_mod, "roll", _d20_roll(15))  # ties -> input order; hits AC 10
+    server.start_combat(cid, ids)
+    assert server.get_state(cid)["current_turn"] == cleric
+    return cid, cleric, foe, foe2
+
+
+def _bolt_attack(cid, cleric, target):
+    return server.attack(cid, cleric, target, attack_bonus=5, damage_dice="4d6",
+                         damage_type="radiant", is_ranged=True)
+
+
+def test_old_snapshot_loads_with_no_pending_spell_attack():
+    assert Combat().pending_spell_attack is None
+    legacy = Combat.model_validate({"active": True, "round": 2, "action_purpose": "cast"})
+    assert legacy.pending_spell_attack is None
+
+
+def test_guiding_bolt_cast_then_attack_resolves_the_bolt(monkeypatch):
+    """THE BUG: cast(GB) spends the slot, then the spell's own attack() must be allowed — it
+    deals damage, materializes the on-hit rider, and clears the owed-leg record."""
+    cid, cleric, foe, _ = _fight(monkeypatch)
+    out = server.cast_spell(cid, cleric, "Guiding Bolt", target_id=foe)
+    assert out["automated"] is False and out["attack_roll"] is True
+    psa = _psa(cid)
+    assert psa is not None
+    assert psa.source_id == cleric and psa.target_ids == [foe]
+    assert psa.spell == "Guiding Bolt" and psa.round == 1
+
+    res = _bolt_attack(cid, cleric, foe)
+    assert res["hit"] is True
+    assert res["spell_attack_leg"] == "Guiding Bolt"
+    assert server.get_character(cid, foe)["current_hp"] < 60  # the bolt dealt damage
+    assert res.get("on_hit_effect_applied") == ["Guiding Bolt"]
+    assert server.get_character(cid, cleric)["pending_on_hit_riders"] == []
+    assert _psa(cid) is None
+    # the leg spends no Attack-action budget
+    camp = store.load_campaign(cid)
+    assert camp.combat.action_attacks_made == 0 and camp.combat.action_purpose == "cast"
+
+
+def test_second_attack_after_the_spell_leg_is_refused(monkeypatch):
+    cid, cleric, foe, _ = _fight(monkeypatch)
+    server.cast_spell(cid, cleric, "Guiding Bolt", target_id=foe)
+    _bolt_attack(cid, cleric, foe)
+    with pytest.raises(ValueError, match="already cast a spell this turn"):
+        server.attack(cid, cleric, foe, attack_bonus=4, damage_dice="1d8+2")
+
+
+def test_attack_on_an_unlisted_target_is_refused(monkeypatch):
+    cid, cleric, foe, foe2 = _fight(monkeypatch, extra_foe=True)
+    server.cast_spell(cid, cleric, "Guiding Bolt", target_id=foe)
+    with pytest.raises(ValueError, match="already cast a spell this turn"):
+        _bolt_attack(cid, cleric, foe2)
+    # the refused strike changed nothing — the owed leg on the real target still stands
+    assert _psa(cid) is not None
+    assert _bolt_attack(cid, cleric, foe)["spell_attack_leg"] == "Guiding Bolt"
+
+
+def test_independent_attack_after_a_non_attack_spell_is_still_refused(monkeypatch):
+    """A save spell (Sacred Flame: attack_roll False) sets no owed leg — the #778 gate holds."""
+    cid, cleric, foe, _ = _fight(monkeypatch)
+    out = server.cast_spell(cid, cleric, "Sacred Flame", target_id=foe)
+    assert out["automated"] is False and out["attack_roll"] is False
+    assert _psa(cid) is None
+    with pytest.raises(ValueError, match="already cast a spell this turn"):
+        server.attack(cid, cleric, foe, attack_bonus=4, damage_dice="1d8+2")
+
+
+def test_double_cast_stays_refused(monkeypatch):
+    cid, cleric, foe, _ = _fight(monkeypatch)
+    server.cast_spell(cid, cleric, "Guiding Bolt", target_id=foe)
