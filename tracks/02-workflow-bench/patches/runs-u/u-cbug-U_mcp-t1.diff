+/**
+ * Is `targetRaw` the angle-bracket spelling of a system include
+ * (`<stdio.h>`)?
+ *
+ * `#include <…>` searches only the compiler's system/`-I` include paths, never
+ * the including file's directory, and the repository's file set says nothing
+ * about which of its directories (if any) are on that path. A repo file that
+ * merely shares the header's name — `src/stdio.h` beside `#include <stdio.h>` —
+ * is therefore not evidence of anything, and resolving to it fabricates an
+ * IMPORTS edge into unrelated code (#2953). The quoted spelling (`"stdio.h"`,
+ * passed bare as `stdio.h`) is unaffected and keeps the lookup below.
+ */
+export function isCSystemIncludeTarget(targetRaw: string): boolean {
+  return targetRaw.length > 2 && targetRaw.startsWith('<') && targetRaw.endsWith('>');
+}
