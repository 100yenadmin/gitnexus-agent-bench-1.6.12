+
+
+@pytest.mark.parametrize("block", [
+    {"type": "thinking", "thinking": "I considered the factors.", "signature": "sig-abc"},
+    {"type": "redacted_thinking", "data": "opaque-test-data"},
+])
+def test_native_anthropic_thinking_only_stop_continues_to_answer(loop_agent, block):
+    loop_agent.api_mode = "anthropic_messages"
+    loop_agent.provider = "anthropic"
+    loop_agent.model = "claude-opus-4-7"
+    loop_agent._anthropic_base_url = "https://api.anthropic.com"
+    loop_agent._is_anthropic_oauth = False
+    answer = "391 = 17 x 23."
+    responses = [
+        SimpleNamespace(content=[SimpleNamespace(**block)], stop_reason="end_turn", usage=None),
+        SimpleNamespace(content=[SimpleNamespace(type="text", text=answer)], stop_reason="end_turn", usage=None),
+    ]
+    with patch.object(loop_agent, "_interruptible_api_call", side_effect=responses):
+        result = _run(loop_agent, [], user_message="factor 391")
+
+    assert result["api_calls"] == 2
+    assert result["final_response"] == answer
+    assert result["messages"][-1]["content"] == answer
+    assert all(not m.get("api_content") for m in result["messages"])
+
+
