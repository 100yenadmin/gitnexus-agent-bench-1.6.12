+def test_retry_uncertain_skips_blank_summaries(monkeypatch, tmp_path):
+    engine = _engine(tmp_path)
+    dag = SummaryDAG(engine._store.db_path)
+    try:
+        node_0 = dag.add_node(SummaryNode(
+            session_id="session-a",
+            depth=0,
+            summary="real-0",
+            source_token_count=100,
+            created_at=1.0,
+            latest_at=1.0,
+        ))
+        node_1 = dag.add_node(SummaryNode(
+            session_id="session-a",
+            depth=0,
+            summary="",
+            source_token_count=100,
+            created_at=2.0,
+            latest_at=2.0,
+        ))
+        node_2 = dag.add_node(SummaryNode(
+            session_id="session-a",
+            depth=0,
+            summary="real-2",
+            source_token_count=100,
+            created_at=3.0,
+            latest_at=3.0,
+        ))
+    finally:
+        dag.close()
+
+    store = VectorStore(engine._store.db_path, config=engine._config)
+    try:
+        store.register_profile("model-a", "ollama", 2)
+    finally:
+        store.close()
+
+    identity = _mark_uncertain(engine, [node_0, node_1, node_2])
+
+    provider = FakeProvider()
+    monkeypatch.setattr(command_mod, "resolve_provider", lambda _config, **_kw: provider)
+
+    result = handle_lcm_command("embed backfill --apply --retry-uncertain", engine)
+
+    assert "status: partial" in result
+    assert "embedded: 2" in result
+    assert sorted(provider.calls[0]) == ["real-0", "real-2"]
+    assert _meta_ids(engine) == [str(node_0), str(node_2)]
+    inflight = _inflight_rows(engine)
+    found_blank_uncertain = False
+    for embedded_id, state in inflight:
+        if embedded_id == str(node_1):
+            assert state == "uncertain"
+            found_blank_uncertain = True
+    assert found_blank_uncertain
