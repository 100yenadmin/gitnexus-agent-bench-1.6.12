+++ b/qa/test_behavioral_gate_unresolved_spell_attack.py
@@ -0,0 +1,87 @@
+"""#1270 — `unresolved_spell_attack` behavioral WARN.
+
+A cast_spell returning automated:false + attack_roll:true (Guiding Bolt) leaves the hit to a
+follow-up attack() by the caster. If next_turn fires first, the slot was spent for nothing.
+The gate surfaces that as a [WARN] — it never fails the run.
+
+Run with the engine venv (single-process):
+    uv run --directory servers/engine python -m pytest \
+        ../../qa/test_behavioral_gate_unresolved_spell_attack.py -q -p no:xdist
+"""
+
+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+_GATE = Path(__file__).resolve().parent / "assert_behavioral.py"
+
+_GB_RESULT = {"spell": "Guiding Bolt", "automated": False, "attack_roll": True}
+
+
+def _call(tid: str, name: str, inp: dict, result: dict) -> list[dict]:
+    return [
+        {"type": "assistant", "message": {"content": [
+            {"type": "tool_use", "id": tid, "name": f"mcp__engine__{name}", "input": inp}]}},
+        {"type": "user", "message": {"content": [
+            {"type": "tool_result", "tool_use_id": tid,
+             "content": [{"type": "text", "text": json.dumps(result)}], "is_error": False}]}},
+    ]
+
+
+def _state() -> dict:
+    return {
+        "party": ["pc1"], "leveling_mode": "xp", "day": 2, "time_of_day": "evening",
+        "current_location_id": "loc_camp",
+        "characters": {"pc1": {"name": "Maren", "kind": "player", "xp": 300,
+                               "location_id": "loc_camp"}},
+        "locations": {"loc_start": {"name": "Tavern", "visited": True},
+                      "loc_camp": {"name": "Camp", "visited": True}},
+    }
+
+
+def _run(tmp_path: Path, events: list[dict]) -> tuple[int, str]:
+    run, st = tmp_path / "run.jsonl", tmp_path / "state.json"
+    run.write_text("\n".join(json.dumps(e) for e in events) + "\n", encoding="utf-8")
+    st.write_text(json.dumps(_state()), encoding="utf-8")
+    p = subprocess.run([sys.executable, str(_GATE), str(run), str(st)],
+                       capture_output=True, text=True)
+    return p.returncode, (p.stdout or "") + (p.stderr or "")
+
+
+def _cast() -> list[dict]:
+    return _call("t_cast", "cast_spell",
+                 {"character_id": "pc1", "spell_name": "Guiding Bolt", "target_id": "gob"},
+                 _GB_RESULT)
+
+
+def test_unresolved_cast_before_next_turn_warns_never_fails(tmp_path):
+    base_rc, _ = _run(tmp_path, _call("t_nt", "next_turn", {}, {"round": 1}))
+    rc, out = _run(tmp_path, _cast() + _call("t_nt", "next_turn", {}, {"round": 1}))
+    assert "[WARN] unresolved_spell_attack" in out, out
+    assert "[FAIL] unresolved_spell_attack" not in out
+    assert rc == base_rc  # the WARN never changes the run's verdict
+
+
+def test_cast_resolved_by_attack_does_not_warn(tmp_path):
+    events = (
+        _cast()
+        + _call("t_atk", "attack", {"attacker_id": "pc1", "target_id": "gob",
+                                    "attack_bonus": 5, "damage_dice": "4d6"}, {"hit": True})
+        + _call("t_nt", "next_turn", {}, {"round": 1})
+    )
+    _rc, out = _run(tmp_path, events)
+    assert "unresolved_spell_attack" not in out, out
+
+
+def test_automated_cast_does_not_warn(tmp_path):
+    events = (
+        _call("t_cast", "cast_spell", {"character_id": "pc1", "spell_name": "Fire Bolt",
+                                       "target_id": "gob"},
+              {"spell": "Fire Bolt", "automated": True})
+        + _call("t_nt", "next_turn", {}, {"round": 1})
+    )
+    _rc, out = _run(tmp_path, events)
+    assert "unresolved_spell_attack" not in out, out
