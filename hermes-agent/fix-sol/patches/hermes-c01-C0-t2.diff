diff --git a/tests/hermes_cli/test_claude_code_cli_resolution.py b/tests/hermes_cli/test_claude_code_cli_resolution.py
new file mode 100644
index 00000000..2a78e031
--- /dev/null
+++ b/tests/hermes_cli/test_claude_code_cli_resolution.py
@@ -0,0 +1,69 @@
+"""Claude Code installs remain reachable from a backend with a bare PATH."""
+
+import os
+
+import pytest
+
+from providers import register_provider
+from providers.base import ProviderProfile
+
+
+@pytest.mark.parametrize(
+    "command,prefix,on_path,executable",
+    [
+        ("claude", ".local/bin", False, True),
+        ("claude-code", ".claude/local", False, True),
+        ("claude", ".npm-global/bin", False, True),
+        ("claude", ".local/bin", True, True),
+        ("unrelated-cli", ".local/bin", False, True),
+        ("unrelated-cli", ".local/bin", True, True),
+        ("claude", ".local/bin", False, False),
+    ],
+)
+def test_provider_resolves_only_claude_install_prefixes(
+    tmp_path, monkeypatch, command, prefix, on_path, executable
+):
+    from agent import anthropic_adapter
+    from hermes_cli.auth import (
+        AuthError,
+        get_external_process_provider_status,
+        resolve_external_process_provider_credentials,
+    )
+
+    monkeypatch.setenv("HOME", str(tmp_path))
+    monkeypatch.setenv("USERPROFILE", str(tmp_path))
+    # Exclude machine-wide installs so a missing executable is deterministic.
+    monkeypatch.setattr(
+        anthropic_adapter, "_CLAUDE_CODE_PREFIXES",
+        tuple(p for p in anthropic_adapter._CLAUDE_CODE_PREFIXES if p.startswith("~/")),
+    )
+    bindir = tmp_path / "path"
+    bindir.mkdir()
+    monkeypatch.setenv("PATH", str(bindir))
+    filename = command + (".exe" if os.name == "nt" and on_path else "")
+    installed = tmp_path / prefix / command
+    installed.parent.mkdir(parents=True)
+    installed.write_text("#!/bin/sh\nexit 0\n")
+    installed.chmod(0o755 if executable else 0o644)
+    path_cli = bindir / filename
+    if on_path:
+        path_cli.write_text("#!/bin/sh\nexit 0\n")
+        path_cli.chmod(0o755)
+
+    provider_id = "claude-cli-acp-test"
+    register_provider(ProviderProfile(
+        name=provider_id, auth_type="external_process", process_command=command,
+        base_url=f"process://{provider_id}",
+    ))
+    expected = path_cli if on_path else installed if command in ("claude", "claude-code") and executable else None
+    status = get_external_process_provider_status(provider_id)
+    assert status["configured"] is (expected is not None)
+    assert status["resolved_command"] == (str(expected) if expected else None)
+    if expected:
+        assert resolve_external_process_provider_credentials(provider_id)["command"] == str(expected)
+    else:
+        with pytest.raises(AuthError, match="Could not find"):
+            resolve_external_process_provider_credentials(provider_id)
+
+    found = anthropic_adapter.find_claude_code_cli(command)
+    assert found == (str(expected) if expected and command in ("claude", "claude-code") else None)
