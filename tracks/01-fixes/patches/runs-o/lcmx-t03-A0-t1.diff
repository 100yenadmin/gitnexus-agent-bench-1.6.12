+def _summary_text_is_embeddable(value: object) -> int:
+    """SQL predicate: 1 when a summary has non-whitespace text, else 0.
+
+    SQLite's TRIM only strips ASCII spaces, so blank detection uses Python's
+    ``str.strip()`` definition of whitespace (e.g. ``"\\v\\f"`` is blank).
+    """
+    if isinstance(value, bytes):
+        value = value.decode("utf-8", errors="replace")
+    return 1 if isinstance(value, str) and value.strip() else 0
+
+
+def _register_embeddable_text_function(conn: sqlite3.Connection) -> None:
+    conn.create_function(
+        "lcm_summary_has_text", 1, _summary_text_is_embeddable, deterministic=True
+    )
+
