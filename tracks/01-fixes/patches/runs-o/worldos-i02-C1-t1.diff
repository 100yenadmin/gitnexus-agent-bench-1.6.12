+@pytest.mark.parametrize("final_cell", [(4, 2), (2, 1)])
+def test_end_combat_relocates_rest_blocked_survivor(staged, final_cell):
+    cid, hero, ally, _goblin, loc_id = staged
+    c = server._require(cid)
+    # An old rest placement on the same prop must not exempt it from exit validation.
+    c.characters[hero].stage_cell = final_cell
+    server.save_campaign(c)
+    server.start_combat(cid, [hero, ally])
+    server.set_grid(cid, 5, 3, obstacles=[])
+    server.place_combatant_at_coords(cid, hero, *final_cell)
+    c = server._require(cid)
+    width, height, blocked = server.rest_blocked_cells(c, c.locations[loc_id])
+    free = {(x, y) for x in range(width) for y in range(height)} - blocked
+    server.end_combat(cid)
+    c = server._require(cid)
+    landed = tuple(c.characters[hero].stage_cell)
+    assert landed in free
+    from combat_grid import chebyshev_cells
+    assert chebyshev_cells(landed, final_cell) == min(
+        chebyshev_cells(cell, final_cell) for cell in free
+    )
+    assert server.walk_to(cid, hero, *final_cell)["walked"] is False
+
+
+def test_end_combat_relocation_avoids_rest_occupants_and_other_survivors(staged):
+    cid, hero, ally, _goblin, loc_id = staged
+    server.start_combat(cid, [hero, ally])
+    server.set_grid(cid, 5, 3, obstacles=[])
+    c = server._require(cid)
+    # Every adjacent open cell except (3,2) is occupied at rest.
+    c.locations[loc_id].scene_grid.spawns = {"npc:sentry": [(3, 1), (4, 1)]}
+    for cb in c.combat.order:
+        cb.x, cb.y = (4, 2)  # both survived on the same now-solid crate
+    server.save_campaign(c)
+    server.end_combat(cid)
+    c = server._require(cid)
+    cells = [tuple(c.characters[cid].stage_cell) for cid in (hero, ally)]
+    assert (3, 2) in cells
+    assert len(set(cells)) == 2
+    assert all(cell not in {(3, 1), (4, 1), (4, 2), (2, 1), (2, 2)} for cell in cells)
+
+
+def test_end_combat_full_rest_grid_leaves_survivor_unplaced(staged):
+    cid, hero, _ally, _goblin, loc_id = staged
+    server.start_combat(cid, [hero])
+    server.place_combatant_at_coords(cid, hero, 0, 0)
+    c = server._require(cid)
+    grid = c.locations[loc_id].scene_grid
+    grid.cells = []
+    grid.cell_default.walkable = False
+    server.save_campaign(c)
+    server.end_combat(cid)
+    assert server._require(cid).characters[hero].stage_cell is None
+
+
+def test_end_combat_without_rest_grid_preserves_final_cell(staged):
+    cid, hero, _ally, _goblin, loc_id = staged
+    server.start_combat(cid, [hero])
+    server.place_combatant_at_coords(cid, hero, 0, 2)
+    c = server._require(cid)
+    c.locations[loc_id].scene_grid = None
+    server.save_campaign(c)
+    server.end_combat(cid)
+    assert tuple(server._require(cid).characters[hero].stage_cell) == (0, 2)
+
+
 def test_full_loop_rest_to_combat_to_rest_continuity(staged):
     """The scripted NO-TELEPORT loop end to end: rest (walk) → combat (seed) → combat move →
     rest (write-back). Assert continuity at BOTH seams with no actor jump."""
