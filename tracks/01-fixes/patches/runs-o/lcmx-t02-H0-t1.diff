+def _parse_query(value: Any) -> tuple[str | None, str | None]:
+    """Safely coerce a query parameter to a string, stripping whitespace.
+
+    Returns (query_string, error). If query is None, empty, or contains only
+    whitespace, returns (None, "No query provided").
+    """
+    if value is None:
+        return None, "No query provided"
+    # Convert to string, handling numeric types and other types
+    query = str(value).strip()
+    if not query:
+        return None, "No query provided"
+    return query, None
+
