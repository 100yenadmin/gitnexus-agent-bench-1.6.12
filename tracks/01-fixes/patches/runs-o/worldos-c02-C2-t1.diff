     rc, out = _run_gate(tmp_path, events, {"leveling_mode": "milestone"})
     assert rc == 0, out
     assert "[PASS] guiding_bolt_advantage_consumed" in out, out
+
+
+def _spell_attack_events(*, resolved=False, wrong_target=False, rejected=False, automated=False):
+    events = [
+        _assistant_tool_use("cast", "mcp__engine__cast_spell",
+                            {"character_id": "pc1", "target_id": "foe"}),
+        _user_tool_result("cast", json.dumps({"automated": automated, "attack_roll": True})),
+    ]
+    if resolved:
+        events += [
+            _assistant_tool_use("atk", "mcp__engine__attack",
+                                {"attacker_id": "pc1", "target_id": "other" if wrong_target else "foe"}),
+            _user_tool_result("atk", json.dumps({"hit": False}), is_error=rejected),
+        ]
+    events += [_assistant_tool_use("turn", "mcp__engine__next_turn", {}),
+               _user_tool_result("turn", "{}")]
+    return events
+
+
+def test_unresolved_spell_attack_warns_without_failing(tmp_path):
+    rc, out = _run_gate(tmp_path, _spell_attack_events(), {})
+    assert rc == 0, out
+    assert "[WARN] unresolved_spell_attack" in out
+
+
+def test_resolved_spell_attack_miss_has_no_warning(tmp_path):
+    rc, out = _run_gate(tmp_path, _spell_attack_events(resolved=True), {})
+    assert rc == 0, out
+    assert "[WARN] unresolved_spell_attack" not in out
+
+
+def test_wrong_target_spell_attack_still_warns(tmp_path):
+    rc, out = _run_gate(tmp_path, _spell_attack_events(resolved=True, wrong_target=True), {})
+    assert rc == 0, out
+    assert "[WARN] unresolved_spell_attack" in out
+
+
+def test_rejected_spell_attack_still_warns(tmp_path):
+    _rc, out = _run_gate(tmp_path, _spell_attack_events(resolved=True, rejected=True), {})
+    assert "[WARN] unresolved_spell_attack" in out
+
+
+def test_automated_spell_attack_has_no_warning(tmp_path):
+    rc, out = _run_gate(tmp_path, _spell_attack_events(automated=True), {})
+    assert rc == 0, out
+    assert "[WARN] unresolved_spell_attack" not in out
