+@pytest.mark.parametrize("previewed", [False, True])
+@pytest.mark.parametrize("append_footer", [False, True])
+def test_verification_reuse_requires_preview_and_unchanged_text(agent, monkeypatch, previewed, append_footer):
+    def model_call(_kwargs):
+        if previewed:
+            agent._record_streamed_assistant_text("composed report")
+        return _response()
+
+    agent._interruptible_api_call = model_call
+    agent._handle_max_iterations = MagicMock(return_value="replacement summary")
+    monkeypatch.setenv("HERMES_VERIFY_ON_STOP", "1")
+    if append_footer:
+        monkeypatch.setattr("agent.turn_finalizer._append_file_mutation_footer",
+                            lambda _agent, text, _logger: text + "\nFooter")
+    with (
+        patch("agent.verification_stop.build_verify_on_stop_nudge", return_value="verify it"),
+        patch("hermes_cli.plugins.invoke_hook", return_value=[]),
+    ):
+        result = agent.run_conversation("edit changed.py")
+
+    assert result["final_response"] == "composed report" + ("\nFooter" if append_footer else "")
+    assert result["response_reused"] is (previewed and not append_footer)
+
+
+@pytest.mark.parametrize("tool_name", ["memory", "todo_list", "skill_manage", "session_search"])
+@pytest.mark.parametrize("followup", ["", "Done."])
+def test_housekeeping_reuse_is_provenance_not_text_equality(agent, monkeypatch, tool_name, followup):
+    agent.max_iterations = 3
+    agent.iteration_budget.max_total = 3
+    agent.valid_tool_names = [tool_name]
+    first = _response("Done.")
+    first.choices[0].message.tool_calls = [SimpleNamespace(
+        id="housekeeping", type="function",
+        function=SimpleNamespace(name=tool_name, arguments="{}"),
+    )]
+    first.choices[0].finish_reason = "tool_calls"
+    answers = iter([first, _response(followup)])
+    agent._interruptible_api_call = lambda _kwargs: next(answers)
+
+    def execute(_message, messages, *_args):
+        messages.append({"role": "tool", "tool_call_id": "housekeeping", "content": "ok"})
+
+    agent._execute_tool_calls = execute
+    monkeypatch.setenv("HERMES_VERIFY_ON_STOP", "0")
+    with patch("hermes_cli.plugins.invoke_hook", return_value=[]):
+        result = agent.run_conversation("finish the task")
+
+    assert result["final_response"] == "Done."
+    assert result["response_reused"] is (not followup)
+    assert (result["turn_exit_reason"] == "fallback_prior_turn_content") is (not followup)
diff --git a/tests/tui_gateway/test_turn_payload_response_reused.py b/tests/tui_gateway/test_turn_payload_response_reused.py
new file mode 100644
index 00000000..503b0273
--- /dev/null
+++ b/tests/tui_gateway/test_turn_payload_response_reused.py
@@ -0,0 +1,38 @@
+"""Reuse provenance survives completion payload construction and wire validation."""
+
+import contextlib
+from types import SimpleNamespace
+
+import pytest
+import tui_gateway.server as srv
+
+
+@pytest.mark.parametrize("text, reused, expected", [
+    ("Here is the answer.", True, True),
+    ("Here is the answer.", False, False),
+    ("Here is the answer.", None, False),
+    ("", True, False),
+])
+def test_completion_reuse_flag_requires_nonempty_text(monkeypatch, text, reused, expected):
+    monkeypatch.setattr(srv, "_get_usage", lambda _agent: {})
+    monkeypatch.setattr(srv, "render_message", lambda _text, _cols: None)
+    monkeypatch.setattr(srv, "_clear_inflight_turn", lambda _session: None)
+    agent = SimpleNamespace(_session_title_hint="Scratch")
+    result = {"final_response": text}
+    if reused is not None:
+        result["response_reused"] = reused
+    st = SimpleNamespace(
+        result=result, agent=agent, terminal_callback=None,
+        receipt_committed=True, receipt_attempted=False, marker_key="", error_retained=False,
+        error_detail="", prompt_text="ping",
+    )
+    session = {"pending_title": None, "session_key": "k",
+               "history_lock": contextlib.nullcontext(), "agent": agent}
+
+    payload, _, _ = srv._complete_turn_payload(session, st, None, 80)
+    wire = srv._event_frame("message.complete", "sid", payload)["params"]["payload"]
+    for value in (payload, wire):
+        if expected:
+            assert value["response_reused"] is True
+        else:
+            assert "response_reused" not in value
