diff --git a/qa/test_behavioral_gate_unresolved_spell_attack.py b/qa/test_behavioral_gate_unresolved_spell_attack.py
new file mode 100644
index 0000000..3828eb6
--- /dev/null
+++ b/qa/test_behavioral_gate_unresolved_spell_attack.py
@@ -0,0 +1,99 @@
+"""`unresolved_spell_attack` behavioral WARN (#1270).
+
+A cast_spell returning automated:false + attack_roll:true (Guiding Bolt) leaves the hit to a
+follow-up attack() by the caster. If next_turn fires first, the slot was spent for 0 damage.
+The gate WARNs on that pattern and never fails the run; a run with no such cast emits nothing.
+
+Run with the engine venv (single-process):
+    uv run --directory servers/engine python -m pytest \
+        ../../qa/test_behavioral_gate_unresolved_spell_attack.py -q -p no:xdist
+"""
+
+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+_GATE = Path(__file__).resolve().parent / "assert_behavioral.py"
+
+
+def _use(tid: str, name: str, inp: dict) -> dict:
+    return {"type": "assistant", "message": {"content": [
+        {"type": "tool_use", "id": tid, "name": f"mcp__engine__{name}", "input": inp}]}}
+
+
+def _res(tid: str, obj: dict, is_error: bool = False) -> dict:
+    return {"type": "user", "message": {"content": [
+        {"type": "tool_result", "tool_use_id": tid,
+         "content": [{"type": "text", "text": json.dumps(obj)}], "is_error": is_error}]}}
+
+
+def _call(tid: str, name: str, inp: dict, obj: dict, is_error: bool = False) -> list[dict]:
+    return [_use(tid, name, inp), _res(tid, obj, is_error)]
+
+
+_STATE = {
+    "party": ["pc1"],
+    "leveling_mode": "xp",
+    "day": 2,
+    "time_of_day": "evening",
+    "current_location_id": "loc_camp",
+    "characters": {"pc1": {"name": "Maren", "kind": "player", "xp": 300, "location_id": "loc_camp"}},
+    "locations": {"loc_start": {"name": "Tavern", "visited": True},
+                  "loc_camp": {"name": "Camp", "visited": True}},
+}
+
+_BOLT = ("cast_spell", {"character_id": "pc1", "spell_name": "Guiding Bolt", "target_id": "gob"},
+         {"spell": "Guiding Bolt", "automated": False, "attack_roll": True})
+
+
+def _run(tmp_path: Path, events: list[dict]) -> tuple[int, str, dict]:
+    run, st = tmp_path / "run.jsonl", tmp_path / "state.json"
+    events = _call("t_roll", "roll", {"sides": 20}, {"total": 12}) + events
+    run.write_text("\n".join(json.dumps(e) for e in events) + "\n", encoding="utf-8")
+    st.write_text(json.dumps(_STATE), encoding="utf-8")
+    proc = subprocess.run([sys.executable, str(_GATE), str(run), str(st)],
+                          capture_output=True, text=True)
+    out = (proc.stdout or "") + (proc.stderr or "")
+    marks = {}
+    for line in out.splitlines():
+        line = line.strip()
+        for tag in ("[PASS]", "[WARN]", "[FAIL]"):
+            if line.startswith(tag):
+                marks[line[len(tag):].strip().split(" — ", 1)[0].split()[0]] = tag.strip("[]")
+    return proc.returncode, out, marks
+
+
+def test_unresolved_cast_before_next_turn_warns_not_fails(tmp_path):
+    rc, out, marks = _run(tmp_path, _call("t1", *_BOLT) + _call("t2", "next_turn", {}, {"round": 1}))
+    assert marks.get("unresolved_spell_attack") == "WARN", out
+    assert "[WARN] unresolved_spell_attack" in out
+    assert rc == 0, out
+
+
+def test_resolved_by_caster_attack_passes(tmp_path):
+    events = (_call("t1", *_BOLT)
+              + _call("t2", "attack", {"attacker_id": "pc1", "target_id": "gob"}, {"hit": True})
+              + _call("t3", "next_turn", {}, {"round": 1}))
+    rc, out, marks = _run(tmp_path, events)
+    assert marks.get("unresolved_spell_attack") == "PASS", out
+
+
+def test_refused_or_other_attacker_does_not_resolve(tmp_path):
+    events = (_call("t1", *_BOLT)
+              + _call("t2", "attack", {"attacker_id": "pc1", "target_id": "gob"},
+                      {"error": "refused"}, is_error=True)
+              + _call("t3", "attack", {"attacker_id": "gob", "target_id": "pc1"}, {"hit": False})
+              + _call("t4", "next_turn", {}, {"round": 1}))
+    rc, out, marks = _run(tmp_path, events)
+    assert marks.get("unresolved_spell_attack") == "WARN", out
+
+
+def test_no_qualifying_cast_emits_nothing(tmp_path):
+    events = (_call("t1", "cast_spell", {"character_id": "pc1", "spell_name": "Fire Bolt"},
+                    {"spell": "Fire Bolt", "automated": True})
+              + _call("t2", "next_turn", {}, {"round": 1}))
+    rc, out, marks = _run(tmp_path, events)
+    assert "unresolved_spell_attack" not in marks, out
