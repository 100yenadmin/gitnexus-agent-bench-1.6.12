+def _has_native_thinking(assistant_message: Any) -> bool:
+    """Signed Anthropic thinking and native replay carriers are never answers.
+
+    Detect the payload rather than the route: plugins can replay native Claude
+    turns through chat completions, with a separately generated thinking summary.
+    """
+    for detail in getattr(assistant_message, "reasoning_details", None) or []:
+        if not isinstance(detail, dict):
+            continue
+        kind = detail.get("type")
+        if isinstance(kind, str) and kind.endswith(".native_assistant"):
+            return True
+        if kind in ("thinking", "redacted_thinking") and (detail.get("signature") or detail.get("data")):
+            return True
+    return False
+
