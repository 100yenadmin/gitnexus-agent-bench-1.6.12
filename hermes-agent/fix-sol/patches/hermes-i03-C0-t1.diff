diff --git a/tests/hermes_cli/test_config_set_model_mapping.py b/tests/hermes_cli/test_config_set_model_mapping.py
new file mode 100644
index 00000000..a2076009
--- /dev/null
+++ b/tests/hermes_cli/test_config_set_model_mapping.py
@@ -0,0 +1,58 @@
+"""Bare model mapping literals must not become model identifiers."""
+
+import pytest
+import hermes_yaml as yaml
+
+from hermes_cli.config import set_config_value
+
+
+@pytest.fixture
+def config_path(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    path = tmp_path / "config.yaml"
+    path.write_text(
+        "# Keep this comment\n"
+        "model:\n"
+        "  default: glm-5.3-flash\n"
+        "  provider: zai\n"
+        "  context_length: 128000\n"
+        "agent:\n"
+        "  max_turns: 7\n"
+    )
+    return path
+
+
+@pytest.mark.parametrize("literal", [
+    '{"provider": "openai-codex", "default": "gpt-6.1-sol"}',
+    '{"provider": "openrouter", "default": "z-ai/glm-5.3-flash"}',
+    '{provider: openai-codex, default: gpt-6.1-sol}',
+    'provider: openai-codex\ndefault: gpt-6.1-sol',
+    'provider: openai-codex',
+])
+@pytest.mark.parametrize("force", [False, True])
+def test_model_mapping_requires_force(config_path, capsys, literal, force):
+    before = config_path.read_bytes()
+    if not force:
+        with pytest.raises(SystemExit) as exc:
+            set_config_value("model", literal)
+        assert exc.value.code == 1
+        assert config_path.read_bytes() == before
+        message = capsys.readouterr().err
+        assert "model.provider" in message
+        assert "model.default" in message
+        assert "--force" in message
+    else:
+        set_config_value("model", literal, force=True)
+        saved = yaml.safe_load(config_path.read_text())
+        assert saved["model"] == yaml.safe_load(literal)
+        assert saved["agent"] == {"max_turns": 7}
+        assert "# Keep this comment" in config_path.read_text()
+
+
+@pytest.mark.parametrize("key", ["model", "model.default"])
+@pytest.mark.parametrize("model_id", ["gpt-5.6-sol", "z-ai/glm-5.3-flash"])
+def test_plain_model_id_preserves_siblings(config_path, key, model_id):
+    set_config_value(key, model_id)
+    assert yaml.safe_load(config_path.read_text())["model"] == {
+        "default": model_id, "provider": "zai", "context_length": 128000,
+    }
